#!/bin/bash
# The commit hook (.git/hooks/pre-commit runs it; a fresh clone links it with
# `ln -s ../../tools/pre-commit .git/hooks/pre-commit`): no private word in
# what the commit adds, and, when it changes a dependency or a license, no
# dependency under a license deny.toml doesn't approve, other than the
# known failures docs/deferred.md names, and no part of Ectomatter under
# another license than its own (tools/licenses.sh checks the files as they
# are).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
tools/private-words.sh --staged || exit 1
if git diff --cached --name-only | grep -qE '(^|/)(Cargo\.toml|Cargo\.lock|deny\.toml|core\.json)$|^docs/deferred\.md$|^LICENSES?(/|$)|^REUSE\.toml$' \
  || [ -n "$(git diff --cached --name-only --diff-filter=AR)" ]; then
  tools/licenses.sh
  case $? in 0|3) ;; *) echo "commit stopped: a license isn't approved (deny.toml), isn't Ectomatter's, or a carried file isn't in REUSE.toml"; exit 1 ;; esac
fi
