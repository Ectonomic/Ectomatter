{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ectodeck",
  "version": "0.1.0",
  "identifier": "com.ectonomic.ectodeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ectodeck",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}