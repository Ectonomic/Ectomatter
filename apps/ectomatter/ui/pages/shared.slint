// What the main window's pages share: the rows and items Rust hands them (each
// struct here is exported from app.slint for Rust), and the page parts drawn
// from them.

import { Space, Radius, Font, Line, Size, Part, Stroke, Shadow, Ink } from "tokens.slint";
import { Fold, RecordButton, Tag, RadioRow, EffectTile, WordButton, ScrollBar, LinkButton, SmallCap, FieldBox, CheckBox, StarButton, SegSwitch, DropField, PageBox } from "../system/system.slint";

// a key over the keyboard: where it is in the drawing's units, from the
// drawing's top left, and how it shows
export struct KeyItem {
    pos: int,
    x: float,
    y: float,
    w: float,
    h: float,
    molded: bool,
    remap: string,
    // its cap's top is pale: what is printed on it reads in dark ink
    pale: bool,
    selected: bool,
    pressed: bool,
    // in the area the pointer is over on the Lighting page
    zoned: bool,
    // a click on it does something here (shows the hand)
    clickable: bool,
}

// a picture over the keyboard (a slider knob, the display, its glass), where
// it goes in the keyboard's own pixels
export struct Overlay {
    image: image,
    x: length,
    y: length,
    w: length,
    h: length,
    // a knob: how far its track runs, and how far along it the slider is (0 to 1)
    travel: length,
    frac: float,
    // how strongly it shows: the display's glass as the lab sets its sheen
    opacity: float,
}

// one of the chosen key's two layers: what it does when pressed, and with Fn held
export struct LayerItem {
    title: string,
    kind: string,
    label: string,
    nothing: bool,
    held: [string],
    macro: bool,
    listening: bool,
}

// one of the Lighting page's effects: its name, its small picture, whether it is chosen
export struct EffectItem {
    name: string,
    icon: image,
    on: bool,
    // how its picture moves while chosen: 0 still, 1 breathing, 2 flashing, 3 rolling, 4 twinkling, 5 a press fading
    motion: int,
}

// the Key library: every key and slider, in the groups the keyboard has them in
export struct LibRow {
    // the key's place in the keyboard's reports, or a slider's: -1 the first, -2 the second
    id: int,
    cap: string,
    name: string,
    // what it does on the layer shown, where that is other than its factory job
    job: string,
    rebound: bool,
    chosen: bool,
}
export struct LibGroup {
    name: string,
    count: int,
    rebound: int,
    open: bool,
    rows: [LibRow],
}
// a tab at the top of the Key library: one of the device's layers, its name
// and the key that brings it (a cap's words; none for the layer with nothing held)
export struct LayerTab {
    name: string,
    cap: string,
}
// a checkbox with its words
export struct CheckItem {
    name: string,
    on: bool,
}

// a page in the Screen tab's playlist: its name, what it does next, its
// picture, its place in the order, whether the screen shows it, and whether
// it is first, last or the only page
export struct PlPage {
    name: string,
    // how long it shows (or, on the page playing, the time left) and how it comes in
    line1: string,
    line2: string,
    // the screen's picture of it, and the screen's own background round it
    pic: image,
    field: color,
    // the page on the keyboard's screen now; its first line says so; paused there
    on: bool,
    now: bool,
    paused: bool,
    // whether it can be taken off (not the last page)
    removable: bool,
    // in the Library: the place its card shows in (another's place while the Library makes
    // room for a layout carried along it), and whether it is the one carried
    at: int,
    carried: bool,
}

// one turn of the playlist on its panel: its screen's bar's left edge and
// length (as long as its time, the strip fitted to its width), its page's
// name, whether the screen shows it, whether it is being carried, its time in
// words (for its tag) and as its bar's end shows it (none while it's the only
// turn or it stays), whether it stays until the layouts are switched, and how
// it comes in after the turn before it (0 Wipe, 1 Dissolve, 2 Type, 3 Cut), by
// number and by name
export struct PlBlock {
    key: int,
    x: length,
    w: length,
    name: string,
    on: bool,
    away: bool,
    secs: string,
    time: string,
    stays: bool,
    way: int,
    way-name: string,
}

// a row of the mouse page's list: a button and its job, or a light, its effect and its color
export struct MouseRow {
    name: string,
    job: string,
    chosen: bool,
    // a job other than the factory's
    rebound: bool,
    swatch: color,
    swatched: bool,
}
// a button's words beside the mouse's picture: its name, its job, which side, how far down
export struct MouseCall {
    name: string,
    job: string,
    left: bool,
    top: length,
    chosen: bool,
    rebound: bool,
}
// a piece of the mouse's picture, placed on it: where its corner is from the
// picture's, and its size
export struct MousePatch {
    img: image,
    x: length,
    y: length,
    w: length,
    h: length,
}

// a device on Home's desk: which picture (0 the keyboard, which the window
// draws in its place, 1 the mouse), its name and what is said under it, where
// it is on the desk and its size, whether it is plugged in, and whether the
// pointer is over it
// a device in the rail, as it sits on Home's desk: its place (its page), its
// name, and what sort it is, for its glyph
export struct RailDevice {
    place: string,
    name: string,
    kind: string,
}

export struct DeskItem {
    kind: int,
    name: string,
    sub: string,
    x: length,
    y: length,
    w: length,
    h: length,
    off: bool,
    hover: bool,
    // its name lies over a pad it could be lost on (a picture, or a light color)
    backed: bool,
}

// a pad drawn on Home's desk (the window draws it on the ground): its box on
// the desk and its corners' radius, whether it's chosen, whether the pointer
// is over it, and whether it's the one being drawn
export struct DeskPad {
    x: length,
    y: length,
    w: length,
    h: length,
    r: length,
    chosen: bool,
    hover: bool,
    drawing: bool,
}

// a game's cover in the Library's grid: its name, its picture (none while it's
// read) with its corners rounded, its place on the page, and whether it's a favorite
export struct LibCover {
    name: string,
    pic: image,
    x: length,
    y: length,
    w: length,
    h: length,
    fav: bool,
}

// a row of the Library's Apps tab: its name, what it changes, where it came
// from, and its icon, if it has one
export struct LibApp {
    name: string,
    sub: string,
    from: string,
    icon: image,
    has-icon: bool,
}

// a row of the Screen tab's Game launch: whether it shows anything, its words, the
// layout it shows (by name), until when, whether its bar is selected (its layout on the
// screen above), and whether a layout carried from Layouts is over its bar
export struct GlRow {
    on: bool,
    words: string,
    layout: string,
    until: string,
    chosen: bool,
    over: bool,
}

// a run of words under a game's picture, placed by the window: its words,
// whether they're a number to stand out in ink, and where they start
// an entry of a Library page's On this page: a section's name, what it changes here (in
// a lighter shade when it's this page's own), and where the section is
export struct LibToc {
    name: string,
    sub: string,
    set: bool,
    y: length,
}

export struct LibFact {
    text: string,
    strong: bool,
    x: length,
}

// a key over the keyboard: the edge it shows when pointed at or chosen, a
// press (held down on the keyboard, or by the pointer here), and its new
// meaning printed at the foot of its cap
export component KeyBox inherits Rectangle {
    in property <KeyItem> k;
    in property <length> unit;      // one of the drawing's units
    in property <length> cqw;       // a hundredth of the keyboard's width
    out property <bool> hover: ta.has-hover;
    callback clicked;
    callback hovered(bool);
    x: root.k.x * root.unit;
    y: root.k.y * root.unit;
    width: root.k.w * root.unit;
    height: root.k.h * root.unit;
    border-radius: (root.k.molded ? 0.13 : 0.24) * root.cqw;
    background: root.k.pressed || ta.pressed ? #00000052 : transparent;
    border-width: root.k.zoned ? 2px : root.k.selected ? 1.5px : ta.has-hover ? 1px : 0;
    border-color: root.k.zoned ? Ink.ink : root.k.selected ? #ffffffe0 : #8c8c8c;
    if ta.has-hover && !root.k.selected: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: root.k.molded ? #ffffff1f : #ffffff1a;
    }
    if root.k.remap != "": Text {
        x: 0.5 * root.cqw;
        width: parent.width - root.cqw;
        y: parent.height - 0.66 * root.cqw - self.height;
        text: root.k.remap;
        font-family: "Barlow Semi Condensed";
        font-weight: Font.strong;
        font-size: 0.78 * root.cqw;
        letter-spacing: 0.0078 * root.cqw;
        color: root.k.pale ? #303030 : #e8e8e8;
        horizontal-alignment: center;
        overflow: elide;
    }
    // a changed key is marked by a short gray line along its cap's front edge
    if root.k.remap != "": Rectangle {
        x: parent.width * 0.32;
        width: parent.width * 0.36;
        y: parent.height - 0.2 * root.cqw - 2px;
        height: 2px;
        border-radius: self.height / 2;
        background: root.k.pale ? #5c5c5c : #bdbdbd;
    }
    ta := TouchArea {
        mouse-cursor: root.k.clickable ? pointer : default;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

// The effects, three across: each a well with its small picture under a
// film and its name; the chosen one lit, and only its picture moving
export component EffectGrid inherits PageBox {
    in property <[EffectItem]> effects;
    callback chose(int);
    // whether the chosen effect's picture moves: the page is drawn again only while it does
    in property <bool> moving;
    // how wide each tile shows its picture, for the pictures to be drawn that wide
    out property <length> pic-w: root.tw - 2 * Part.tile-inset;
    title: "Effect";
    property <length> tw: (self.width - 2 * Space.pad - 2 * Space.inline) / 3;
    property <duration> t: root.moving ? animation-tick() : 0ms;
    for fx[i] in root.effects: EffectTile {
        x: Space.pad + mod(i, 3) * (root.tw + Space.inline);
        y: Size.box-head + floor(i / 3) * (Size.tile + Space.inline);
        width: root.tw;
        name: fx.name;
        icon: fx.icon;
        on: fx.on;
        motion: fx.motion;
        blank: fx.name == "Off";
        t: root.t;
        clicked => { root.chose(i); }
    }
}

// One of the screen's two states, as a folder tab on the top of the screen's box, as wide
// as its name: open, in the box's charcoal and running on into it, its feet curving into
// the box's top edge (the left one not on the first tab, which sits on the box's square
// corner); shut, its name quieter on the page, lit a little under the pointer.
// The layer the Keys tab edits, as folder tabs across the top of the Key
// library, sharing its width and edge to edge with it: the open one in the
// box's own color, running on into it, its inner corners rounded against the
// others; the others dark, curving into the box where they meet it, a half
// step lighter under the pointer and never as light as the open one. Each its
// key (a blank cap for the layer with nothing held, Fn for Function) and its
// name. A device with one layer has one tab, the box's heading.
export component LayerSwitch inherits Rectangle {
    in property <int> layer;
    in property <[LayerTab]> layers: [{ name: "Base", cap: "" }, { name: "Function", cap: "Fn" }];
    callback chosen(int);
    height: 50px; // art: the layer tabs, drawn
    // the pointer over a tab that is not open
    property <bool> shut-hover;
    // the dark tabs' color, at rest or under the pointer
    property <color> shut: root.shut-hover ? Ink.stage : Ink.well;
    // behind them all, the dark tabs' color, which shows round the open tab's inner corners
    Rectangle {
        border-top-left-radius: Radius.box;
        border-top-right-radius: Radius.box;
        background: root.shut;
    }
    for l[i] in root.layers: t := Rectangle {
        property <bool> open: root.layer == i;
        property <bool> first: i == 0;
        property <bool> last: i == root.layers.length - 1;
        x: i * root.width / root.layers.length;
        width: root.width / root.layers.length;
        // a dark tab curves into the box where it meets the open one: the box's
        // color in that corner, under the tab's rounded corner
        if !t.open && (root.layer == i + 1 || root.layer == i - 1): Rectangle {
            x: root.layer == i + 1 ? parent.width - 10px : 0; // art: the layer tabs, drawn
            y: parent.height - 10px; // art: the layer tabs, drawn
            width: 10px; // art: the layer tabs, drawn
            height: 10px; // art: the layer tabs, drawn
            background: Ink.box;
        }
        Rectangle {
            border-top-left-radius: t.first ? Radius.box : t.open ? Radius.box - 2px : 0; // art: the layer tabs, drawn
            border-top-right-radius: t.last ? Radius.box : t.open ? Radius.box - 2px : 0; // art: the layer tabs, drawn
            border-bottom-left-radius: !t.open && root.layer == i - 1 ? Radius.box - 2px : 0; // art: the layer tabs, drawn
            border-bottom-right-radius: !t.open && root.layer == i + 1 ? Radius.box - 2px : 0; // art: the layer tabs, drawn
            background: t.open ? Ink.box : root.shut;
        }
        // the layer's key, a small cap
        Rectangle {
            x: 16px; // art: the layer tabs, drawn
            y: (parent.height - 24px) / 2; // art: the layer tabs, drawn
            width: 30px; // art: the layer tabs, drawn
            height: 24px; // art: the layer tabs, drawn
            border-radius: Radius.tiny + 1px; // art: the layer tabs, drawn
            background: t.open ? Ink.well : Ink.box;
            border-width: Stroke.line;
            border-color: t.open ? Ink.off : Ink.seam;
            if l.cap != "": Text {
                text: l.cap;
                font-family: Font.ui;
                font-size: Font.small;
                font-weight: Font.strong;
                color: root.layer == i || tab.has-hover ? Ink.bright : Ink.soft;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if l.cap == "": Rectangle {
                x: (parent.width - 12px) / 2; // art: the layer tabs, drawn
                y: 15px; // art: the layer tabs, drawn
                width: 12px; // art: the layer tabs, drawn
                height: 2px; // art: the layer tabs, drawn
                border-radius: self.height / 2;
                background: Ink.edge-hover;
            }
        }
        Text {
            x: 56px; // art: the layer tabs, drawn
            width: parent.width - self.x - 12px; // art: the layer tabs, drawn
            height: parent.height;
            text: l.name;
            overflow: elide;
            font-family: Font.ui;
            // (the size and weight of the boxes' titles)
            font-size: Font.text;
            font-weight: Font.strong;
            color: t.open ? Ink.ink : tab.has-hover ? Ink.dim : Ink.quiet;
            vertical-alignment: center;
        }
        // the open tab is already chosen: only the others answer the pointer
        tab := TouchArea {
            enabled: !t.open;
            mouse-cursor: t.open ? MouseCursor.default : MouseCursor.pointer;
            clicked => {
                root.shut-hover = false;
                root.chosen(i);
            }
            changed has-hover => { root.shut-hover = self.has-hover && !t.open; }
        }
    }
}

// The Key library: a find box, then the groups, each closing to its heading,
// a key lit while chosen; its jobs show only where a key is rebound.
export component KeyLibrary inherits PageBox {
    in property <[LibGroup]> groups;
    // a key or slider newly chosen: how far down the list its row is; each new one scrolls to it
    in property <length> reveal-y;
    in property <int> reveal-n;
    changed reveal-n => {
        lib-flick.content-y = -max(0, min(root.reveal-y - 40px, lib-flick.content-height - lib-flick.height)); // art: the row a little under the list's top
    }
    in-out property <string> query;
    callback toggle(string);
    callback find(string);
    callback pick(int);
    // the layer shown, as tabs at the box's top (the keyboard's two, or the device's own)
    in property <int> layer;
    in property <[LayerTab]> layers: [{ name: "Base", cap: "" }, { name: "Function", cap: "Fn" }];
    callback layer-chosen(int);
    // what the find box asks for, in the device's own words
    in property <string> placeholder: "Find a key or what it does";
    property <length> top: 50px; // art: the list's top, under the layer tabs
    LayerSwitch {
        x: 0;
        y: 0;
        width: parent.width;
        layer: root.layer;
        layers: root.layers;
        chosen(i) => { root.layer-chosen(i); }
    }
    // find a key, or what it does, under the tabs (Escape goes on to the page)
    FieldBox {
        x: Space.pad;
        y: root.top + Space.pad;
        width: parent.width - 2 * Space.pad;
        placeholder: root.placeholder;
        keeps-escape: false;
        text <=> root.query;
        edited => { root.find(self.text); }
    }
    // the groups, Space.inline under the find box, their rows Space.inline in from the box's
    // sides, as a list's in a box are
    lib-flick := Flickable {
        x: Space.inline;
        y: root.top + Space.pad + Size.control + Space.inline;
        width: parent.width - 2 * Space.inline;
        height: parent.height - self.y - Space.inline;
        mouse-drag-pan-enabled: false;
        VerticalLayout {
            alignment: start;
            for g in root.groups: VerticalLayout {
                // the group's heading: it opens and closes the group; how many keys it has
                // (and how many are rebound) at its right
                Fold {
                    text: g.name;
                    open: g.open;
                    small: true;
                    clicked => { root.toggle(g.name); }
                    HorizontalLayout {
                        x: parent.width - self.preferred-width - Space.inline;
                        width: self.preferred-width;
                        spacing: Space.inline;
                        if g.rebound > 0: Text {
                            text: g.rebound + " rebound";
                            font-family: Font.ui;
                            font-size: Font.caption;
                            color: Ink.warn;
                            vertical-alignment: center;
                        }
                        Text {
                            text: g.count;
                            font-family: Font.ui;
                            font-size: Font.caption;
                            color: Ink.quiet;
                            vertical-alignment: center;
                        }
                    }
                }
                // its keys, set in under the group's name (at its words, as the Fold sets them)
                if g.open: VerticalLayout {
                    padding-left: Part.fold-in;
                    for r in g.rows: Rectangle {
                        height: Size.control;
                        border-radius: Radius.control;
                        background: r.chosen ? (row-ta.has-hover ? Ink.pick-hover : Ink.pick) : row-ta.has-hover ? Ink.hover-box : transparent;
                        SmallCap {
                            x: 6px; // art: a key's row: its cap, its name, what it does
                            y: 4px; // art: a key's row: its cap, its name, what it does
                            text: r.cap;
                            size: r.cap.character-count > 3 ? 9.5px : Font.small;  // art: a long name small on its cap, as a key prints it
                        }
                        Text {
                            x: 50px; // art: a key's row: its cap, its name, what it does
                            width: parent.width - 50px - 150px; // art: a key's row: its cap, its name, what it does
                            height: parent.height;
                            text: r.name;
                            font-family: Font.ui;
                            font-size: Font.control;
                            color: r.chosen ? Ink.bright : Ink.dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 150px; // art: a key's row: its cap, its name, what it does
                            width: 142px; // art: a key's row: its cap, its name, what it does
                            height: parent.height;
                            text: r.job;
                            font-family: Font.ui;
                            font-size: Font.note;
                            color: r.rebound ? Ink.warn : Ink.quiet;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick(r.id); }
                        }
                    }
                }
            }
        }
    }
    // its scrollbar, at the box's right edge beside the list, as a ScrollBox's
    ScrollBar {
        x: parent.width - Part.scroll-in;
        y: lib-flick.y;
        height: lib-flick.height;
        view: lib-flick.height;
        content: lib-flick.content-height;
        offset: -lib-flick.content-y;
        framed: false;
        thumb-color: Ink.edge;
        scroll-to(o) => { lib-flick.content-y = -o; }
    }
}

// Game mode: what G/PC turns on, and the keys it blocks, two columns
export component GameBox inherits PageBox {
    in property <[CheckItem]> items;
    callback toggled(int);
    title: "Game mode";
    // its note, then the keys two to a line, Space.row under it, Space.tight between lines
    property <length> lines-top: Size.box-head + note.preferred-height + Space.row;
    property <length> pitch: Size.quiet + Space.tight;
    // how tall what it holds is (the page gives the box this much at least)
    out property <length> need: self.lines-top + ceil(root.items.length / 2) * self.pitch - Space.tight + Space.pad;
    note := Text {
        x: Space.pad;
        y: Size.box-head;
        width: parent.width - 2 * Space.pad;
        text: "The G/PC button turns game mode on and off. These keys do nothing while it's on:";
        font-family: Font.ui;
        font-size: Font.note;
        color: Ink.quiet;
        wrap: word-wrap;
    }
    for c[i] in root.items: CheckBox {
        x: Space.pad + mod(i, 2) * (parent.width - 2 * Space.pad) / 2;
        y: root.lines-top + floor(i / 2) * root.pitch;
        width: (parent.width - 2 * Space.pad) / 2 - Space.inline;
        text: c.name;
        on: c.on;
        clicked => { root.toggled(i); }
    }
}

// a game's cover in the Library: its picture, corners rounded, on a shadow;
// lifted a little under the pointer, with a hairline round it; its name under
// it in two lines at most; and under the pointer a star over its corner, to
// make it a favorite or not
export component LibCoverView inherits Rectangle {
    in property <LibCover> c;
    callback open();
    callback star();
    x: root.c.x;
    y: root.c.y;
    width: root.c.w;
    height: root.c.h + Space.inline + Size.cover-name;
    property <bool> hot: ta.has-hover || star-b.hover;
    card := Rectangle {
        y: ta.pressed ? -1px : root.hot ? -3px : 0;
        animate y { duration: 140ms; }
        width: root.c.w;
        height: root.c.h;
        border-radius: Radius.control;
        background: Ink.box;
        drop-shadow-blur: root.hot ? Shadow.float.blur : Shadow.lift.blur;
        drop-shadow-offset-y: root.hot ? Shadow.float.y : Shadow.lift.y;
        drop-shadow-color: root.hot ? Shadow.float.color : Shadow.lift.color;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.c.pic;
        }
        Rectangle {
            border-radius: Radius.control;
            border-width: root.hot ? Stroke.line : 0;
            border-color: Ink.white.with-alpha(0.149);
        }
    }
    Text {
        x: 0;
        y: root.c.h + Space.inline;
        width: root.c.w;
        height: Size.cover-name;
        text: root.c.name;
        font-family: Font.ui;
        font-size: Font.control;
        color: root.hot ? Ink.ink : Ink.dim;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    // the star, Space.inline in from the cover's corner, while the pointer is on the cover
    star-b := StarButton {
        x: root.c.w - Space.inline - self.width;
        y: card.y + Space.inline;
        on-picture: true;
        on: root.c.fav;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: 120ms; }
        clicked => { root.star(); }
    }
}

// one page of the playlist, as a card: its words on the left, the screen's
// picture of it on the right in a bay of the screen's own color; the page on
// the screen now marked by the active profile's bar, half the card's height
export component PlCard inherits Rectangle {
    in property <PlPage> p;
    in property <bool> hovered;
    border-radius: Radius.panel;
    background: root.hovered ? Ink.hover-well : Ink.well;
    animate background { duration: 120ms; }
    // the picture first, two pixels to a dot, in a bay: a 6px gutter of the screen's own background, rounded
    Rectangle {
        x: 12px; // art: a layout's card: its screen's picture and its words
        y: (parent.height - self.height) / 2;
        width: 260px + 12px; // art: a layout's card: its screen's picture and its words
        height: 52px + 12px; // art: a layout's card: its screen's picture and its words
        border-radius: Radius.control;
        background: root.p.field;
        Image {
            x: 6px; // art: a layout's card: its screen's picture and its words
            y: 6px; // art: a layout's card: its screen's picture and its words
            width: 260px; // art: a layout's card: its screen's picture and its words
            height: 52px; // art: a layout's card: its screen's picture and its words
            source: root.p.pic;
        }
    }
    // then its name, and at most two lines on what it shows (fitted by the page), the three
    // in the card's middle; room kept at the card's right for Edit, which the pointer shows there
    property <int> lines: root.p.line2 != "" ? 2 : root.p.line1 != "" ? 1 : 0;
    property <length> words-w: root.width - 358px; // art: a layout's card: its screen's picture and its words
    property <length> words-y: (root.height - 20px - (root.lines > 0 ? 2px + root.lines * 17px : 0)) / 2; // art: a layout's card: its screen's picture and its words
    Text {
        x: 300px; // art: a layout's card: its screen's picture and its words
        y: root.words-y;
        width: root.words-w;
        height: 20px; // art: a layout's card: its screen's picture and its words
        text: root.p.name;
        font-family: Font.ui;
        font-size: Font.text;
        font-weight: Font.strong;
        color: Ink.bright;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.p.line1 != "": Text {
        x: 300px; // art: a layout's card: its screen's picture and its words
        y: root.words-y + 22px; // art: a layout's card: its screen's picture and its words
        width: root.words-w;
        height: 17px; // art: a layout's card: its screen's picture and its words
        text: root.p.line1;
        font-family: Font.ui;
        font-size: Font.note;
        color: Ink.soft;
        vertical-alignment: center;
    }
    if root.p.line2 != "": Text {
        x: 300px; // art: a layout's card: its screen's picture and its words
        y: root.words-y + 39px; // art: a layout's card: its screen's picture and its words
        width: root.words-w;
        height: 17px; // art: a layout's card: its screen's picture and its words
        text: root.p.line2;
        font-family: Font.ui;
        font-size: Font.note;
        color: Ink.soft;
        vertical-alignment: center;
    }
}

// how a turn comes in, as its way bar on the strip shows it: a column sweeping
// across what is already there, cells changing, a letter with the cursor
// after it, a plain edge
export component WayGlyph inherits Rectangle {
    in property <int> way;
    in property <color> ink;
    width: 12px;
    height: 12px;
    if root.way == 0: Rectangle {
        x: 0;
        y: 0;
        width: 12px;
        height: 12px;
        Rectangle {
            x: 1px;
            y: 1.5px;
            width: 10px;
            height: 9px;
            border-radius: 1.6px;
            border-width: 1.2px;
            border-color: root.ink;
        }
        Rectangle {
            x: 1.6px;
            y: 2.1px;
            width: 4.2px;
            height: 7.8px;
            border-radius: 0.6px;
            background: root.ink;
            opacity: 0.45;
        }
        Rectangle {
            x: 5.7px;
            y: 2.2px;
            width: 1.4px;
            height: 7.6px;
            background: root.ink;
        }
    }
    if root.way == 1: Rectangle {
        x: 0;
        y: 0;
        width: 12px;
        height: 12px;
        Rectangle { x: 1px; y: 1px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; }
        Rectangle { x: 6.6px; y: 6.6px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; }
        Rectangle { x: 6.6px; y: 1px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; opacity: 0.35; }
        Rectangle { x: 1px; y: 6.6px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; opacity: 0.35; }
    }
    if root.way == 2: Path {
        x: 0;
        y: 0;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M1.5 2h6M4.5 2v7.5M8.5 10h2.5";
        fill: transparent;
        stroke: root.ink;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }
    if root.way == 3: Rectangle {
        x: 5.2px;
        y: 1px;
        width: 1.6px;
        height: 10px;
        border-radius: self.width / 2;
        background: root.ink;
    }
}

// The chosen key: what it is and its factory job, then the job it does on
// the layer shown: a kind (Key, Media, Mouse, Macro, Profile, Keyboard,
// Nothing), the job itself, or Record to take the next key pressed.
export component KeyDetail inherits PageBox {
    // the kinds of job, and their glyphs on the switch's 24 grid (the keyboard's, unless a device has its own)
    in property <[string]> kinds: ["Key", "Media", "Mouse", "Macro", "Profile", "Screen", "Keyboard", "Nothing"];
    // (Screen's is the Screen Editor button's glyph, drawn on this switch's 24 grid)
    in property <[string]> kind-icons: ["M4 5h16v14H4zM9 10h6M12 10v5", "M5 6l8 6-8 6zM15 6v12M19 6v12", "M7 3.5h10v17H7zM12 7v3", "M4 7h10M4 12h16M4 17h7", "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z", "M3.9 5.1h16.2a2.4 2.4 0 0 1 2.4 2.4v9a2.4 2.4 0 0 1-2.4 2.4H3.9A2.4 2.4 0 0 1 1.5 16.5V7.5a2.4 2.4 0 0 1 2.4-2.4zM6 9.3h12M6 12h9M6 14.7h10.5", "M3 7h18v10H3zM7 11h1M11 11h1M15 11h1M8 14h8", "M4 12a8 8 0 1 0 16 0a8 8 0 1 0-16 0M6.5 17.5l11-11"];
    // whether a job can be taken from a key pressed, and whether the box closes
    in property <bool> recordable: true;
    in property <bool> closable: true;
    in property <string> cap;
    in property <string> factory;
    in property <string> state;
    in property <bool> rebound;
    in property <bool> layer-rebound;
    in property <string> layer-title;
    in property <int> kind;
    in property <string> job;
    in property <bool> listening;
    in property <bool> menu-open;
    // whether the open menu keeps a column for ticks (not when nothing in it is ticked)
    in property <bool> menu-marks: true;
    in property <string> note;
    callback done();
    callback reset();
    callback kind-picked(int, length, length, length);
    callback job-clicked(length, length, length, length);
    callback record();
    // how tall what it holds is (the page gives the box this much at least)
    out property <length> need: Size.box-head + body.preferred-height + Space.pad;
    // Done, at the title's line, its words at the box's padding
    if root.closable: LinkButton {
        x: parent.width - Space.pad + Part.quiet-pad - self.width;
        y: Part.title-top + (Line.title - self.height) / 2;
        text: "Done";
        clicked => { root.done(); }
    }
    // a stacked form: the key, then its layer's job (the kind of job, the job, its note)
    body := VerticalLayout {
        x: Space.pad;
        y: Size.box-head;
        width: parent.width - 2 * Space.pad;
        height: self.preferred-height;
        spacing: Space.pad;
        // the key: its cap, large, what it is from the factory and what it is now, and
        // Back to factory at the right
        HorizontalLayout {
            spacing: Space.pad;
            SmallCap {
                width: 54px; // art: the key's cap, drawn
                height: 48px; // art: the key's cap, drawn
                text: root.cap;
                size: root.cap.character-count > 3 ? Font.small : Font.lead;
            }
            VerticalLayout {
                alignment: center;
                spacing: Space.list;
                Text {
                    text: root.factory;
                    font-family: Font.ui;
                    font-size: Font.note;
                    color: Ink.soft;
                    overflow: elide;
                }
                Text {
                    text: root.state;
                    font-family: Font.ui;
                    font-size: Font.note;
                    color: Ink.quiet;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                WordButton {
                    text: "Back to factory";
                    enabled: root.rebound;
                    on-box: true;
                    clicked => { root.reset(); }
                }
            }
        }
        // its job on the layer: the layer's name (Rebound at its right while the job isn't the
        // factory's), Space.label over the kind of job, the job Space.inline under that (and
        // Record beside it), and its note Space.tight under the job
        VerticalLayout {
            spacing: Space.label;
            HorizontalLayout {
                height: Line.text;
                Text {
                    text: root.layer-title;
                    font-family: Font.ui;
                    font-size: Font.note;
                    font-weight: Font.strong;
                    color: Ink.dim;
                    vertical-alignment: center;
                }
                if root.layer-rebound: VerticalLayout {
                    alignment: center;
                    Tag {
                        text: "Rebound";
                        warn: true;
                    }
                }
            }
            VerticalLayout {
                spacing: Space.inline;
                SegSwitch {
                    tall: true;
                    options: root.kinds;
                    icons: root.kind-icons;
                    chosen: root.kind;
                    picked(i, x, y, h) => { root.kind-picked(i, x, y, h); }
                }
                VerticalLayout {
                    spacing: Space.tight;
                    HorizontalLayout {
                        spacing: Space.inline;
                        DropField {
                            text: root.job;
                            open: root.menu-open;
                            clicked(x, y, h) => { root.job-clicked(x, y, h, self.width); }
                        }
                        // Record: takes the next key pressed on the keyboard
                        if root.recordable: VerticalLayout {
                            alignment: center;
                            RecordButton {
                                on: root.listening;
                                on-text: "Press a key…";
                                clicked => { root.record(); }
                            }
                        }
                    }
                    if root.note != "": Text {
                        text: root.note;
                        font-family: Font.ui;
                        font-size: Font.caption;
                        color: Ink.quiet;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component SliderDetail inherits PageBox {
    in property <string> side;
    in property <float> at;
    // what the firmware can't do yet with the job chosen, if anything
    in property <string> note;
    in property <[CheckItem]> choices;
    callback done();
    callback picked(int);
    // how tall what it holds is (the page gives the box this much at least)
    out property <length> need: Size.box-head + body.preferred-height + Space.pad;
    // Done, at the title's line, its words at the box's padding
    LinkButton {
        x: parent.width - Space.pad + Part.quiet-pad - self.width;
        y: Part.title-top + (Line.title - self.height) / 2;
        text: "Done";
        clicked => { root.done(); }
    }
    // (as wide at every place as at the slider's top, so the bar never shifts)
    pct-most := Text {
        visible: false;
        text: "100%";
        font-family: Font.ui;
        font-size: Font.note;
        font-weight: Font.medium;
    }
    // a stacked form: where the slider sits now, what it controls, and a note
    body := VerticalLayout {
        x: Space.pad;
        y: Size.box-head;
        width: parent.width - 2 * Space.pad;
        height: self.preferred-height;
        spacing: Space.pad;
        // where it sits now: a reading, not a control, a thin bar filled to where the
        // slider is and how far that is, Space.row after it
        VerticalLayout {
            spacing: Space.label;
            Text {
                text: "Where the " + root.side + " slider on the keyboard sits now";
                font-family: Font.ui;
                font-size: Font.note;
                color: Ink.quiet;
            }
            HorizontalLayout {
                height: Line.text;
                spacing: Space.row;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 6px; // art: the slider's track, as the Slider's
                        border-radius: self.height / 2;
                        background: Ink.well;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: root.at * parent.width;
                            border-radius: 3px; // art: the slider's track, as the Slider's
                            background: Ink.soft;
                            animate width { duration: 120ms; easing: ease-out; }
                        }
                    }
                }
                Text {
                    width: pct-most.preferred-width;
                    text: round(root.at * 100) + "%";
                    font-family: Font.ui;
                    font-size: Font.note;
                    font-weight: Font.medium;
                    color: Ink.dim;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
        // what it controls: one of its jobs, Space.list between them
        VerticalLayout {
            spacing: Space.label;
            Text {
                text: "Controls";
                font-family: Font.ui;
                font-size: Font.note;
                font-weight: Font.strong;
                color: Ink.dim;
            }
            VerticalLayout {
                spacing: Space.list;
                for c[i] in root.choices: RadioRow {
                    text: c.name;
                    on: c.on;
                    clicked => { root.picked(i); }
                }
            }
        }
        Text {
            text: root.note == "" ? "The same on every profile, while Ectomatter is open." : "The same on every profile, while Ectomatter is open. " + root.note;
            font-family: Font.ui;
            font-size: Font.caption;
            color: Ink.quiet;
            wrap: word-wrap;
        }
    }
}

// The mouse's picture in its layers, as mouse_art draws them: the mouse over
// its shadow, the chosen button picked out and the one under the pointer a
// shade lighter, then each light's groups in its color of the moment (the
// drawing's order: what lies under the buttons, then what lies over them).
// Drawn for one size and shown `k` times it; its lights shown, or not.
export component MouseLayers inherits Rectangle {
    in property <image> base;
    in property <float> k: 1;
    in property <bool> lit: true;
    // (false where the window draws the mouse itself, in HDR, under the page)
    in property <bool> drawn: true;
    in property <MousePatch> picked;
    in property <bool> picked-shown;
    in property <MousePatch> over;
    in property <bool> over-shown;
    in property <MousePatch> logo-under;
    in property <MousePatch> wheel-under;
    in property <MousePatch> logo;
    in property <MousePatch> wheel;
    in property <color> logo-tint;
    in property <color> wheel-tint;
    if root.drawn: Image {
        width: parent.width;
        height: parent.height;
        source: root.base;
    }
    if root.drawn && root.picked-shown: Image {
        x: root.picked.x * root.k;
        y: root.picked.y * root.k;
        width: root.picked.w * root.k;
        height: root.picked.h * root.k;
        source: root.picked.img;
    }
    if root.drawn && root.over-shown: Image {
        x: root.over.x * root.k;
        y: root.over.y * root.k;
        width: root.over.w * root.k;
        height: root.over.h * root.k;
        source: root.over.img;
        colorize: #ffffff14;
    }
    if root.drawn && root.lit: Image {
        x: root.logo-under.x * root.k;
        y: root.logo-under.y * root.k;
        width: root.logo-under.w * root.k;
        height: root.logo-under.h * root.k;
        source: root.logo-under.img;
        colorize: root.logo-tint;
    }
    if root.drawn && root.lit: Image {
        x: root.wheel-under.x * root.k;
        y: root.wheel-under.y * root.k;
        width: root.wheel-under.w * root.k;
        height: root.wheel-under.h * root.k;
        source: root.wheel-under.img;
        colorize: root.wheel-tint;
    }
    if root.drawn && root.lit: Image {
        x: root.logo.x * root.k;
        y: root.logo.y * root.k;
        width: root.logo.w * root.k;
        height: root.logo.h * root.k;
        source: root.logo.img;
        colorize: root.logo-tint;
    }
    if root.drawn && root.lit: Image {
        x: root.wheel.x * root.k;
        y: root.wheel.y * root.k;
        width: root.wheel.w * root.k;
        height: root.wheel.h * root.k;
        source: root.wheel.img;
        colorize: root.wheel-tint;
    }
    @children
}

// a grip on the chosen pad's edge or corner, which sizes the pad: the edges
// it moves (1 left, 2 top, 4 right, 8 bottom, two together at a corner), and
// where the pad is on the desk, for its presses to say where they are there
export component PadGrip inherits TouchArea {
    in property <int> edges;
    in property <length> ox;
    in property <length> oy;
    callback grip(int, length, length);
    callback pan(length, length);
    callback drag(length, length);
    callback let-go();
    mouse-cursor: root.edges == 1 ? MouseCursor.w-resize : root.edges == 2 ? MouseCursor.n-resize : root.edges == 4 ? MouseCursor.e-resize : root.edges == 8 ? MouseCursor.s-resize
        : root.edges == 3 ? MouseCursor.nw-resize : root.edges == 6 ? MouseCursor.ne-resize : root.edges == 12 ? MouseCursor.se-resize : MouseCursor.sw-resize;
    pointer-event(e) => {
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            root.grip(root.edges, root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y);
        }
        if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
            root.pan(root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y);
        }
        if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
            root.let-go();
        }
    }
    moved => { root.drag(root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); }
}
