// Ectomatter's own settings: its bar, every page's, and under it the form
// (src/ecto_settings.rs), which scrolls.
// The window binds each property and callback here to its own of the same
// name (app.slint, `settings-page`).

import { Size } from "tokens.slint";
import { PageBar, Cell, CellView } from "../system/system.slint";
import { AboutPage, AboutFact } from "about.slint";
export { AboutFact, AboutLine, AboutCredit } from "about.slint";

export component SettingsPage inherits Rectangle {
    callback cell-left(int, int, bool);
    callback cell-pick(int, int, length, length, length, length);
    callback cell-slide(int, float);
    callback cell-typed(int, int, string);
    in property <[Cell]> cells;
    in property <image> keyboard-tile;
    in property <image> mouse-tile;
    in property <[image]> package-tiles;
    in property <image> mark-tile;
    // what was just done here, or what went wrong (`said-bad`), in the bar
    in property <string> said;
    in property <bool> said-bad;
    // the tab open, by its place in the bar (src/ecto_settings.rs, Tab), and a tab chosen
    in property <int> tab;
    callback tab-chosen(int);
    in-out property <string> place;
    in property <length> settings-h;
    in-out property set-flick-content-height <=> set-flick.content-height;
    in-out property set-flick-content-y <=> set-flick.content-y;
    in-out property set-flick-height <=> set-flick.height;
    // About (the last tab), drawn by its own page: ui/pages/about.slint
    in property <image> about-blob;
    in property <image> about-mark;
    in property <string> about-eyebrow;
    in property <[string]> about-lead;
    in property <[string]> about-legal;
    in property <[AboutFact]> about-facts;
    in property <string> about-trouble;
    callback about-build();
    callback about-license();
    callback about-fact-link(int);
    callback about-poke(length, length, length, length);

    set-flick := Flickable {
        y: Size.bar;
        height: parent.height - Size.bar;
        content-height: root.tab == 3 ? max(self.height, about.need) : root.settings-h;
        mouse-drag-pan-enabled: false;
        for c in root.cells: CellView {
            c: c;
            glyph: root.keyboard-tile;
            glyph2: root.mouse-tile;
            glyphs: root.package-tiles;
            logo: root.mark-tile;
            pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
            field-left(id, index, kept) => { root.cell-left(id, index, kept); }
            slide(id, v) => { root.cell-slide(id, v); }
            typed(id, index, t) => { root.cell-typed(id, index, t); }
        }
        about := AboutPage {
            visible: root.tab == 3;
            width: parent.width;
            height: max(set-flick.height, self.need);
            view-h: set-flick.height;
            blob: root.about-blob;
            mark: root.about-mark;
            eyebrow: root.about-eyebrow;
            lead: root.about-lead;
            legal: root.about-legal;
            facts: root.about-facts;
            trouble: root.about-trouble;
            build => { root.about-build(); }
            license => { root.about-license(); }
            fact-link(i) => { root.about-fact-link(i); }
            poke(x, y, w, h) => { root.about-poke(x, y, w, h); }
        }
    }
    PageBar {
        y: 0;
        title: "Settings";
        tabs: ["General", "Devices", "Plugins", "About"];
        tab: root.tab;
        tab-chosen(i) => { root.tab-chosen(i); }
        status: root.said;
        status-bad: root.said-bad;
    }
}
