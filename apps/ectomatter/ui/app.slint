// Ectomatter's main window, drawn natively: the title bar, the rail, the home,
// and the Z10's page, as the web app showed them before the HDR work began
// (commit cd9ea82: window.css, shell.css, style.css, and device.css over it).
// The device's page: the keyboard in a dark box of its own, the tab's boxes
// under it, flat grays told apart by shade with no outlines or dividing
// lines, and a chosen item shown lighter, as in the rail.
//
// The keyboard is not drawn here. The page leaves a hole where it goes, and
// the window draws the keyboard's HDR picture into that hole, under anything
// the page draws over it: the keys' edges, their new meanings, a press, the
// slider knobs, the display and its glass.

import "fonts/Barlow-400.ttf";
import "fonts/Barlow-500.ttf";
import "fonts/Barlow-600.ttf";
import "fonts/BarlowSemiCondensed-500.ttf";
import "fonts/BarlowSemiCondensed-600.ttf";
import "fonts/Geist-400.ttf";
import "fonts/Geist-500.ttf";
import "fonts/Geist-600.ttf";
// commands as they are typed, in a typeface whose letters are all one width (Custom Scripts)
import "../../../crates/ectomatter-draw/typefaces/JetBrainsMono.ttf";

// The window's shades, darkest to lightest: the frame (title bar, rail),
// the page, the boxes on it. Wells (fields, tracks, tiles, the profiles'
// panel) sit darker than the box they are in. Every control has four
// states, each a step apart and none the color behind it: at rest, under
// the pointer (in a well, on a box), chosen, chosen under the pointer.
// whether a box in the main window is being typed in: Ctrl+Z is then the box's own
export global Typing {
    in-out property <bool> on;
}

export global Ink {
    in-out property <color> frame: #0e0e10;
    in-out property <color> title: #131316;
    in-out property <color> base: #18181b;
    in-out property <color> box: #1f1f23;
    in-out property <color> well: #131316;
    // the mouse's stage, as its approved mock has it: lighter than the keyboard's
    // well, as a black mouse needs
    in-out property <color> stage: #1b1b1f;
    in-out property <color> hover-well: #24242a;
    in-out property <color> hover-box: #2a2a30;
    in-out property <color> pick: #36363d;
    in-out property <color> pick-hover: #3e3e46;
    in-out property <color> pop: #27272c;
    in-out property <color> line: #2b2b30;
    in-out property <color> ink: #f4f4f5;
    in-out property <color> bright: #f4f4f5;
    in-out property <color> dim: #d4d4d8;
    in-out property <color> soft: #a1a1aa;
    in-out property <color> quiet: #74747c;
    in-out property <color> warn: #f0b35a;
    in-out property <color> bad: #ff8a80;
    in-out property <color> good: #8fd6a1;
    // the shades the pages used before they had names for their parts
    in-out property <color> shade1: #1f1f23;
    in-out property <color> shade2: #2a2a30;
    in-out property <color> shade3: #36363d;
    in-out property <color> shade4: #3e3e46;
    // a slider's track
    in-out property <color> track: #131316;
}

// how many clickable things the pointer is over: the window shows the hand
// while it is over any. Each counts itself in and out as it is pointed at,
// so the order two neighbors hear the pointer in does not matter.

// a profile's button in the panel's head
export struct ProfileItem {
    n: int,
    name: string,
    sub: string,
    active: bool,
    current: bool,
    dirty: bool,
    // how many of its settings differ from what the keyboard holds
    unsaved: int,
    // its color sample: one color, or up to four across it
    colors: int,
    c1: color,
    c2: color,
    c3: color,
    c4: color,
}

// a key over the keyboard: where it is in the drawing's units, from the
// drawing's top left, and how it shows
export struct KeyItem {
    pos: int,
    x: float,
    y: float,
    w: float,
    h: float,
    molded: bool,
    remap: string,
    // its cap's top is pale: what is printed on it reads in dark ink
    pale: bool,
    selected: bool,
    pressed: bool,
    // in the area the pointer is over on the Lighting page
    zoned: bool,
    // a click on it does something here (shows the hand)
    clickable: bool,
}

// a picture over the keyboard (a slider knob, the display, its glass), where
// it goes in the keyboard's own pixels
export struct Overlay {
    image: image,
    x: length,
    y: length,
    w: length,
    h: length,
    // a knob: how far its track runs, and how far along it the slider is (0 to 1)
    travel: length,
    frac: float,
    // how strongly it shows: the display's glass as the lab sets its sheen
    opacity: float,
}

// one of the chosen key's two layers: what it does when pressed, and with Fn held
export struct LayerItem {
    title: string,
    kind: string,
    label: string,
    nothing: bool,
    held: [string],
    macro: bool,
    listening: bool,
}

// one of the Lighting page's effects: its name, its small picture, whether it is chosen
export struct EffectItem {
    name: string,
    icon: image,
    on: bool,
    // how its picture moves while chosen: 0 still, 1 breathing, 2 flashing, 3 rolling, 4 twinkling, 5 a press fading
    motion: int,
}

// the Key library: every key and slider, in the groups the keyboard has them in
export struct LibRow {
    // the key's place in the keyboard's reports, or -1 the dimmer, -2 the volume slider
    id: int,
    cap: string,
    name: string,
    // what it does on the layer shown, where that is other than its factory job
    job: string,
    rebound: bool,
    chosen: bool,
}
export struct LibGroup {
    name: string,
    count: int,
    rebound: int,
    open: bool,
    rows: [LibRow],
}
// a tab at the top of the Key library: one of the device's layers, its name
// and the key that brings it (a cap's words; none for the layer with nothing held)
export struct LayerTab {
    name: string,
    cap: string,
}
// a checkbox with its words
export struct CheckItem {
    name: string,
    on: bool,
}

// a piece of the Lighting page's tile, placed by the window: text, a color
// swatch, a checkbox, a slider, a switch and its buttons, an area chip, a
// button, the reset at the foot
export struct Cell {
    kind: int,
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    // an icon drawn in place of its words, on a 24-unit square: its filled
    // shapes and its lines (2 units wide), as SVG path data (a sensor's cell,
    // kind 51, carries its driver's name and its reading in them)
    fill: string,
    lines: string,
    color: color,
    on: bool,
    value: float,
    id: int,
    index: int,
    style: int,
}

// a page in the Screen tab's playlist: its name, what it does next, its
// picture, its place in the order, whether the screen shows it, and whether
// it is first, last or the only page
export struct PlPage {
    name: string,
    // how long it shows (or, on the page playing, the time left) and how it comes in
    line1: string,
    line2: string,
    // the screen's picture of it, and the screen's own background round it
    pic: image,
    field: color,
    // the page on the keyboard's screen now; its first line says so; paused there
    on: bool,
    now: bool,
    paused: bool,
    // whether it can be taken off (not the last page)
    removable: bool,
    // in the Library: the place its card shows in (another's place while the Library makes
    // room for a layout carried along it), and whether it is the one carried
    at: int,
    carried: bool,
}

// one turn of the playlist on its panel: its screen's bar's left edge and
// length (as long as its time, the strip fitted to its width), its page's
// name, whether the screen shows it, whether it is being carried, its time in
// words (for its tag) and as its bar's end shows it (none while it's the only
// turn or it stays), whether it stays until the layouts are switched, and how
// it comes in after the turn before it (0 Wipe, 1 Dissolve, 2 Type, 3 Cut), by
// number and by name
export struct PlBlock {
    key: int,
    x: length,
    w: length,
    name: string,
    on: bool,
    away: bool,
    secs: string,
    time: string,
    stays: bool,
    way: int,
    way-name: string,
}

// a row of the mouse page's list: a button and its job, or a light, its effect and its color
export struct MouseRow {
    name: string,
    job: string,
    chosen: bool,
    // a job other than the factory's
    rebound: bool,
    swatch: color,
    swatched: bool,
}
// a button's words beside the mouse's picture: its name, its job, which side, how far down
export struct MouseCall {
    name: string,
    job: string,
    left: bool,
    top: length,
    chosen: bool,
    rebound: bool,
}
// a piece of the mouse's picture, placed on it: where its corner is from the
// picture's, and its size
export struct MousePatch {
    img: image,
    x: length,
    y: length,
    w: length,
    h: length,
}

// a device on Home's desk: which picture (0 the keyboard, which the window
// draws in its place, 1 the mouse), its name and what is said under it, where
// it is on the desk and its size, whether it is plugged in, and whether the
// pointer is over it
// a device in the rail, as it sits on Home's desk: its place (its page), its
// name, and what sort it is, for its glyph
export struct RailDevice {
    place: string,
    name: string,
    kind: string,
}

export struct DeskItem {
    kind: int,
    name: string,
    sub: string,
    x: length,
    y: length,
    w: length,
    h: length,
    off: bool,
    hover: bool,
    // its name lies over a pad it could be lost on (a picture, or a light color)
    backed: bool,
}

// a pad drawn on Home's desk (the window draws it on the ground): its box on
// the desk and its corners' radius, whether it's chosen, whether the pointer
// is over it, and whether it's the one being drawn
export struct DeskPad {
    x: length,
    y: length,
    w: length,
    h: length,
    r: length,
    chosen: bool,
    hover: bool,
    drawing: bool,
}

// a game's cover in the Library's grid: its name, its picture (none while it's
// read) with its corners rounded, its place on the page, and whether it's a favorite
export struct LibCover {
    name: string,
    pic: image,
    x: length,
    y: length,
    w: length,
    h: length,
    fav: bool,
}

// a row of the Library's Apps tab: its name, what it changes, where it came
// from, and its icon, if it has one
export struct LibApp {
    name: string,
    sub: string,
    from: string,
    icon: image,
    has-icon: bool,
}

// a row of the Screen tab's Game launch: whether it shows anything, its words, the
// layout it shows (by name), until when, whether its bar is selected (its layout on the
// screen above), and whether a layout carried from Layouts is over its bar
export struct GlRow {
    on: bool,
    words: string,
    layout: string,
    until: string,
    chosen: bool,
    over: bool,
}

// a run of words under a game's picture, placed by the window: its words,
// whether they're a number to stand out in ink, and where they start
// an entry of a Library page's On this page: a section's name, what it changes here (in
// a lighter shade when it's this page's own), and where the section is
export struct LibToc {
    name: string,
    sub: string,
    set: bool,
    y: length,
}

export struct LibFact {
    text: string,
    strong: bool,
    x: length,
}

// a row in a menu: 0 a choice, 1 a heading, 2 a rule, 3 a note, 4 a choice
// in red (one that deletes), 5 a choice that can't be made now
export struct MenuRow {
    kind: int,
    label: string,
    tag: string,
    tick: bool,
    sub: string,
    // a chip before its name (a scene's colors), in a column kept for it in every row
    // of a menu that has chips (chipped, the chip left empty to keep the column);
    // a pencil at its right under the pointer, to change it (a scene of the person's own)
    chip: image,
    chipped: bool,
    edit: bool,
}

// one of the window's own buttons: minimize, maximize, close
component WinButton inherits Rectangle {
    in property <string> commands;
    in property <length> size: 14px;
    in property <bool> danger;
    // (the close button, at the window's corner: rounded as the window is)
    in property <length> corner;
    callback clicked;
    width: 40px;
    border-top-right-radius: root.corner;
    background: ta.has-hover ? (root.danger ? #dc2626 : #2e2e2e) : transparent;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        fill: transparent;
        stroke: ta.has-hover ? (root.danger ? #ffffff : #f5f5f5) : #a3a3a3;
        stroke-width: 1.4px * root.size / 16px;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// an item on the rail: a 40px square with its glyph, which the rail's blade
// widens to take its name; closed, the name shows beside it when pointed at
component RailItem inherits Rectangle {
    in property <image> glyph;
    in property <string> name;
    in property <bool> on;
    in property <bool> open;
    in property <float> reveal;      // how far the blade's names have come in, 0 to 1
    out property <bool> hover: ta.has-hover;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    background: root.on ? (ta.has-hover ? Ink.pick : Ink.hover-box) : ta.has-hover ? Ink.box : transparent;
    Image {
        x: 9px;
        y: 9px;
        width: 22px;
        height: 22px;
        source: root.glyph;
        colorize: (root.on || ta.has-hover) ? Ink.bright : Ink.soft;
    }
    if root.reveal > 0: Text {
        x: 9px + 22px + 12px - 6px * (1 - root.reveal);
        width: parent.width - self.x - 9px;
        height: parent.height;
        text: root.name;
        font-family: "Geist";
        font-weight: 500;
        font-size: 13.5px;
        color: (root.on || ta.has-hover) ? Ink.bright : Ink.soft;
        opacity: root.reveal;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover && !root.open: Rectangle {
        x: 50px;
        y: (parent.height - self.height) / 2;
        width: tip.preferred-width + 18px;
        height: tip.preferred-height + 10px;
        border-radius: 6px;
        background: Ink.shade4;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000b3;
        tip := Text {
            text: root.name;
            font-family: "Geist";
            font-size: 12.5px;
            color: Ink.bright;
        }
    }
}

// a tab in the device's bar: quiet, then ink with its underline when chosen
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    width: label.preferred-width + 28px;
    label := Text {
        y: 0;
        height: parent.height - 2px;
        text: root.text;
        font-family: "Geist";
        font-size: 14.5px;
        font-weight: 500;
        color: (root.selected || ta.has-hover) ? Ink.ink : Ink.quiet;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// a button with words: filled gray (the page's ghost buttons, which here have
// no outline) or primary (ink), 13px, radius 8, a pixel down under a press
component WordButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <color> fill: Ink.shade1;
    in property <color> fill-hover: Ink.shade2;
    // as wide as it is given, rather than as its words
    in property <length> wide: 0;
    // a filled glyph before its words, on a 14-unit square (Play's triangle)
    in property <string> icon;
    out property <bool> hover: ta.has-hover && root.enabled;
    out property <bool> down: ta.pressed && root.enabled;
    callback clicked;
    height: root.primary ? 32px : 30px;
    property <length> icon-w: root.icon != "" ? 14px + 8px : 0;
    width: root.wide > 0 ? root.wide : label.preferred-width + 24px + root.icon-w + (root.primary ? 2px : 0);
    border-radius: 8px;
    // turned off, the whole button fades to 35% over the page's ground, as the
    // web app's does; faded piece by piece, its words would come out lighter
    property <color> face: root.primary ? (ta.has-hover && root.enabled ? #ffffff : Ink.ink) : ta.has-hover && root.enabled ? root.fill-hover : root.fill;
    property <color> ink: root.primary ? Ink.base : Ink.ink;
    background: root.enabled ? root.face : root.face.mix(Ink.base, 0.35);
    if root.icon != "": Path {
        x: (parent.width - label.width - root.icon-w) / 2;
        y: (parent.height - 14px) / 2 + (ta.pressed && root.enabled ? 1px : 0);
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: root.icon;
        fill: root.enabled ? root.ink : root.ink.mix(Ink.base, 0.35);
    }
    label := Text {
        x: (parent.width - self.width + root.icon-w) / 2;
        y: (parent.height - self.height) / 2 + (ta.pressed && root.enabled ? 1px : 0);
        text: root.text;
        font-family: "Geist";
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        color: root.enabled ? root.ink : root.ink.mix(Ink.base, 0.35);
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// a quiet button with words and no fill, as "Press a key" is
component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    height: 28px;
    width: label.preferred-width + 18px;
    border-radius: 6px;
    background: root.on ? #f0b35a14 : ta.has-hover ? #ffffff0f : transparent;
    label := Text {
        y: (parent.height - self.height) / 2 + (ta.pressed ? 1px : 0);
        text: root.text;
        font-family: "Geist";
        font-size: 13px;
        font-weight: 500;
        color: root.on ? Ink.warn : ta.has-hover ? Ink.ink : Ink.dim;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// the small ring that turns while the keyboard is read
component Spinner inherits Rectangle {
    width: 16px;
    height: 16px;
    property <angle> a: mod(animation-tick() / 800ms, 1) * 360deg;
    Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Ink.line;
    }
    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: transparent;
        stroke: Ink.ink;
        stroke-width: 2px;
        commands: "M " + (8 + 7 * cos(root.a)) + " " + (8 + 7 * sin(root.a)) + " A 7 7 0 0 1 " + (8 + 7 * cos(root.a + 90deg)) + " " + (8 + 7 * sin(root.a + 90deg));
    }
}

// a key over the keyboard: the edge it shows when pointed at or chosen, a
// press (held down on the keyboard, or by the pointer here), and its new
// meaning printed at the foot of its cap
component KeyBox inherits Rectangle {
    in property <KeyItem> k;
    in property <length> unit;      // one of the drawing's units
    in property <length> cqw;       // a hundredth of the keyboard's width
    out property <bool> hover: ta.has-hover;
    callback clicked;
    callback hovered(bool);
    x: root.k.x * root.unit;
    y: root.k.y * root.unit;
    width: root.k.w * root.unit;
    height: root.k.h * root.unit;
    border-radius: (root.k.molded ? 0.13 : 0.24) * root.cqw;
    background: root.k.pressed || ta.pressed ? #00000052 : transparent;
    border-width: root.k.zoned ? 2px : root.k.selected ? 1.5px : ta.has-hover ? 1px : 0;
    border-color: root.k.zoned ? Ink.ink : root.k.selected ? #ffffffe0 : #8c8c8c;
    if ta.has-hover && !root.k.selected: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: root.k.molded ? #ffffff1f : #ffffff1a;
    }
    if root.k.remap != "": Text {
        x: 0.5 * root.cqw;
        width: parent.width - root.cqw;
        y: parent.height - 0.66 * root.cqw - self.height;
        text: root.k.remap;
        font-family: "Barlow Semi Condensed";
        font-weight: 600;
        font-size: 0.78 * root.cqw;
        letter-spacing: 0.0078 * root.cqw;
        color: root.k.pale ? #303030 : #e8e8e8;
        horizontal-alignment: center;
        overflow: elide;
    }
    // a changed key is marked by a short gray line along its cap's front edge
    if root.k.remap != "": Rectangle {
        x: parent.width * 0.32;
        width: parent.width * 0.36;
        y: parent.height - 0.2 * root.cqw - 2px;
        height: 2px;
        border-radius: 1px;
        background: root.k.pale ? #5c5c5c : #bdbdbd;
    }
    ta := TouchArea {
        mouse-cursor: root.k.clickable ? pointer : default;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

// a drop-down: its way back (on a page of it), a search, then its rows. It
// A scrollbar, as WebKit drew the page's: a thin thumb in a dark rim, lighter
// while the pointer is on it or it is held. Its thumb is dragged, or a press
// on its track takes the thumb there; the wheel scrolls the area as ever. The
// area itself never scrolls by dragging it, as a web page does not.
component ScrollBar inherits Rectangle {
    // how much of the area shows, how much there is, and how far it is scrolled
    in property <length> view;
    in property <length> content;
    in property <length> offset;
    in property <color> thumb-color: #4c4c4c;
    // the page's has a dark rim round the thumb; a list's is the thumb alone
    in property <bool> framed: true;
    callback scroll-to(length);
    width: 12px;
    visible: root.content > root.view + 1px;
    property <length> travel: max(1px, root.content - root.view);
    property <length> th: max(24px, root.height * root.view / max(1px, root.content));
    property <length> ty: min(1, max(0, root.offset / root.travel)) * (root.height - root.th);
    property <length> grab;
    property <bool> held;
    pure function at(y: length) -> length {
        max(0px, min(root.travel, (y - root.grab) / max(1px, root.height - root.th) * root.travel))
    }
    Rectangle {
        x: parent.width - 7px;
        y: root.ty;
        width: 5px;
        height: root.th;
        border-radius: 2px;
        background: root.framed ? #191919 : transparent;
        Rectangle {
            x: 1px;
            width: 3px;
            border-radius: 1.5px;
            background: bar-ta.has-hover || root.held ? #6e6e6e : root.thumb-color;
        }
    }
    bar-ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                if (self.mouse-y >= root.ty && self.mouse-y < root.ty + root.th) {
                    root.grab = self.mouse-y - root.ty;
                } else {
                    root.grab = root.th / 2;
                    root.scroll-to(root.at(self.mouse-y));
                }
                root.held = true;
            }
            if (e.kind == PointerEventKind.up) {
                root.held = false;
            }
        }
        moved => {
            if (self.pressed) {
                root.scroll-to(root.at(self.mouse-y));
            }
        }
        // the wheel over the bar scrolls the area, as it does over the area
        scroll-event(e) => {
            root.scroll-to(max(0px, min(root.travel, root.offset - e.delta-y)));
            accept
        }
    }
}

// lifts off by shade and shadow, without an edge.
component Menu inherits Rectangle {
    in property <[MenuRow]> rows;
    // whether its rows keep a column for a tick: none in a menu that never ticks what is chosen
    in property <bool> marks: true;
    in property <string> placeholder;
    in property <bool> back;
    in property <bool> search: true;
    in-out property <string> query;
    callback chose(int);
    // a row's pencil pressed
    callback edit(int);
    callback go-back();
    callback typed(string);
    callback enter();
    callback dismiss();
    callback field-done(int, string);
    border-radius: 10px;
    background: Ink.shade2;
    drop-shadow-blur: 34px;
    drop-shadow-offset-y: 14px;
    drop-shadow-color: #00000080;
    property <length> back-h: root.back ? 33px : 0;
    public function focus-search() {
        search.focus();
    }
    public function blur-search() {
        search.clear-focus();
    }
    if root.back: Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 33px;
        border-radius: 7px;
        background: back-ta.has-hover ? #ffffff12 : transparent;
        Text {
            x: 10px + 14px + 8px;
            height: parent.height;
            text: "‹ Back";
            font-family: "Geist";
            font-size: 13.5px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        back-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.go-back(); }
        }
    }
    property <length> search-h: root.search ? 33px + 6px : 0;
    Rectangle {
        visible: root.search;
        x: 6px;
        y: 6px + back-h;
        width: parent.width - 12px;
        height: 33px;
        border-radius: 7px;
        background: Ink.shade1;
        if search.text == "": Text {
            x: 10px;
            height: parent.height;
            text: root.placeholder;
            font-family: "Geist";
            font-size: 13px;
            color: #9a9a9a;
            vertical-alignment: center;
        }
        search := TextInput {
            changed has-focus => { Typing.on = self.has-focus; }
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.query;
            font-family: "Geist";
            font-size: 13px;
            color: Ink.ink;
            vertical-alignment: center;
            single-line: true;
            edited => { root.typed(self.text); }
            accepted => { root.enter(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.dismiss();
                    return accept;
                }
                reject
            }
        }
    }
    mflick := Flickable {
        x: 6px;
        y: 6px + back-h + search-h;
        width: parent.width - 12px;
        height: parent.height - self.y - 6px;
        content-height: list.preferred-height;
        mouse-drag-pan-enabled: false;
        list := VerticalLayout {
            for row[i] in root.rows: Rectangle {
                height: row.kind == 1 ? 28px : row.kind == 2 ? 11px : 33px;
                background: (row.kind == 0 || row.kind == 4 || row.kind == 7) && (item.has-hover || (row.edit && pen.has-hover)) ? #ffffff12 : transparent;
                border-radius: 7px;
                if row.kind == 1: Text {
                    x: 10px;
                    y: 7px;
                    height: 17px;
                    text: row.label;
                    font-family: "Geist";
                    font-size: 12px;
                    color: Ink.soft;
                    vertical-alignment: center;
                }
                if row.kind == 2: Rectangle {
                    x: 4px;
                    y: 5px;
                    width: parent.width - 8px;
                    height: 1px;
                    // (the app's line is too near the menu's own gray to be seen on it)
                    background: #ffffff17;
                }
                if row.kind == 3: Text {
                    x: 10px;
                    height: parent.height;
                    text: row.label;
                    font-family: "Geist";
                    font-size: 13px;
                    color: Ink.quiet;
                    vertical-alignment: center;
                }
                // a way to somewhere else to find more (the Sensor Feed box in Settings), under the choices
                if row.kind == 7: Text {
                    x: root.marks ? 32px : 12px;
                    height: parent.height;
                    text: row.label;
                    font-family: "Geist";
                    font-size: 13px;
                    color: item.has-hover ? Ink.dim : Ink.soft;
                    vertical-alignment: center;
                }
                // a choice with a number to type beside it: its label chooses, the field sets
                if row.kind == 6: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        width: 14px;
                        text: row.tick ? "✓" : "";
                        font-family: "Geist";
                        font-size: 13.5px;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.label;
                        font-family: "Geist";
                        font-size: 13.5px;
                        color: Ink.ink;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.chose(i); }
                        }
                    }
                    Rectangle {
                        width: 64px + 6px;
                        Rectangle {
                            x: 6px;
                            y: (parent.height - 24px) / 2;
                            width: 64px;
                            height: 24px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Ink.line;
                            background: Ink.base;
                            TextInput {
                                x: 7px;
                                width: parent.width - 14px;
                                height: parent.height;
                                text: row.tag;
                                font-family: "Geist";
                                font-size: 13px;
                                color: Ink.ink;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { root.field-done(i, self.text); }
                                changed has-focus => { Typing.on = self.has-focus; if (!self.has-focus && self.text != row.tag) { root.field-done(i, self.text); } }
                            }
                        }
                    }
                    Text {
                        text: row.sub == "" ? "ms" : row.sub;
                        font-family: "Geist";
                        font-size: 13.5px;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                }
                if row.kind == 0 || row.kind == 4 || row.kind == 5: HorizontalLayout {
                    opacity: row.kind == 5 ? 0.35 : 1;
                    padding-left: root.marks ? 10px : 12px;
                    padding-right: 10px;
                    spacing: root.marks ? 8px : 0;
                    // (a column for ticks only in a menu that ticks what is chosen)
                    Text {
                        width: root.marks ? 14px : 0;
                        text: row.tick ? "✓" : "";
                        font-family: "Geist";
                        font-size: 13.5px;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                    if row.chipped: Rectangle {
                        width: 14px + 2px;
                        Image {
                            x: 0;
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                            source: row.chip;
                            image-fit: fill;
                        }
                    }
                    if row.tag != "": Rectangle {
                        width: tag.preferred-width + 12px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: tag.preferred-height + 2px;
                            border-width: 1px;
                            border-color: Ink.line;
                            border-radius: 4px;
                            tag := Text {
                                text: row.tag;
                                font-family: "Geist";
                                font-size: 10.5px;
                                color: Ink.quiet;
                            }
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: row.label;
                        font-family: "Geist";
                        font-size: 13.5px;
                        color: row.kind == 4 ? Ink.bad : Ink.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // (what a row says on its right never crowds out its own name)
                    if row.sub != "": Text {
                        max-width: root.width * 0.55;
                        text: row.sub;
                        font-family: "Geist";
                        font-size: 12px;
                        color: Ink.quiet;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                item := TouchArea {
                    enabled: row.kind == 0 || row.kind == 4 || row.kind == 7;
                    mouse-cursor: pointer;
                    clicked => { root.chose(i); }
                }
                if row.edit && (item.has-hover || pen.has-hover): Rectangle {
                    x: parent.width - 30px;
                    y: (parent.height - 24px) / 2;
                    width: 24px;
                    height: 24px;
                    border-radius: 6px;
                    background: pen.has-hover ? #ffffff14 : transparent;
                    Path {
                        width: 13px;
                        height: 13px;
                        viewbox-width: 14;
                        viewbox-height: 14;
                        commands: "M9.6 2.2l2.2 2.2-7 7H2.6V9.2ZM8.3 3.5l2.2 2.2";
                        fill: transparent;
                        stroke: pen.has-hover ? Ink.bright : Ink.soft;
                        stroke-width: 1.3px;
                    }
                }
                pen := TouchArea {
                    x: parent.width - 30px;
                    width: row.edit ? 24px : 0;
                    enabled: row.edit;
                    mouse-cursor: pointer;
                    clicked => { root.edit(i); }
                }
            }
        }
    }
    ScrollBar {
        x: parent.width - 12px;
        y: mflick.y;
        height: mflick.height;
        view: mflick.height;
        content: mflick.content-height;
        offset: -mflick.content-y;
        framed: false;
        thumb-color: #525252;
        scroll-to(o) => { mflick.content-y = -o; }
    }
}

// one piece of the Lighting page's tile, drawn where the window placed it
component CellView inherits Rectangle {
    in property <Cell> c;
    callback pick(int, int, length, length, length);
    callback slide(int, float);
    // typed into a box: its id, its index (which of the boxes with that id) and what it holds now
    callback typed(int, int, string);
    // a number typed into its box and set, by Enter or by leaving the box
    callback entered(int, string);
    // the pointer over a zone, or no longer; a box typed in, or no longer
    callback hovered(int, bool);
    callback focused(int, bool);
    // a slider double-clicked, to put it back as it was
    callback reset(int);
    // a pad pressed or dragged on: where, as a share of it across and down
    callback pad(int, float, float);
    in property <image> glyph;
    in property <image> glyph2;
    // each package's own glyph (a device's tile with style 2 on: the package that many past 2)
    in property <[image]> glyphs;
    // the scenes' glyph (a device glyph's style -1), and the chips a dropdown can show
    // before its words (its value, one more than the chip's place)
    in property <image> glyph3;
    in property <[image]> chips;
    x: root.c.x;
    y: root.c.y;
    width: root.c.w;
    height: root.c.h;
    // the Lighting page's words: a group's heading in small capitals (33), a color's hex
    // code (34), a setting's name (35), the words at a slider's ends (36 left, 37 right)
    // a command, as it was typed (41), cut off with an ellipsis where it runs long
    if root.c.kind == 0 && root.c.style == 41: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: "JetBrains Mono";
        font-size: 12px;
        color: Ink.dim;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.c.kind == 0 && root.c.style >= 33 && root.c.style != 41: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: "Geist";
        // (39: the device a Sensors tab shows, on its first line; 42: a heading inside a
        // plugin's section, in capitals; 43: what a status says, beside its dot; 44: a
        // row's value that's only to read, quieter)
        font-size: root.c.style == 33 ? 10.5px : root.c.style == 34 || root.c.style == 42 ? 12px : root.c.style == 35 ? 12.5px : root.c.style == 38 || root.c.style == 39 ? 13.5px : root.c.style == 43 || root.c.style == 44 ? 14px : 11px;
        font-weight: root.c.style == 33 || root.c.style == 38 ? 600 : root.c.style == 34 || root.c.style == 39 || root.c.style == 42 ? 500 : 400;
        letter-spacing: root.c.style == 33 ? 0.95px : root.c.style == 42 ? 1.2px : 0;
        color: root.c.style == 38 || root.c.style == 39 || root.c.style == 43 ? Ink.bright : root.c.style == 35 || root.c.style == 34 ? Ink.dim : root.c.style == 44 ? Ink.soft : Ink.quiet;
        horizontal-alignment: root.c.style == 37 ? right : left;
        vertical-alignment: center;
    }
    // text: a row's name, a column's heading, a note, the empty tile's words, a slider's value
    if root.c.kind == 0 && root.c.style < 33: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: "Geist";
        // 0 a row's name, 1 a heading, 2 a note, 3 an empty tile's words, 4 a slider's value, 5 a value,
        // 6 a list's item, 7 the page's title, 8 a device's name, 9 its state, 10 the temperature,
        // 11 the weather's words, 12 a fact, 13 its value, 14 the credit, 19 a note in its own color,
        // 20 a menu's words in their own color, 21 a small word in its own color, 22 a stronger word in its own color
        font-size: root.c.style == 1 ? 13px : root.c.style == 2 || root.c.style == 19 ? 12.5px : root.c.style == 3 ? 14px : root.c.style == 4 ? 13px
            : root.c.style == 7 ? 20px : root.c.style == 8 ? 14.5px : root.c.style == 9 || root.c.style == 22 ? 12.5px : root.c.style == 10 ? 22px
            : root.c.style == 12 || root.c.style == 13 ? 13px : root.c.style == 14 ? 12px : root.c.style == 21 ? 11.5px : 13.5px;
        font-weight: root.c.style == 1 || root.c.style == 8 || root.c.style == 10 || root.c.style == 13 || root.c.style == 22 ? 500 : root.c.style == 7 ? 600 : 400;
        letter-spacing: root.c.style == 7 ? -0.4px : root.c.style == 10 ? -0.44px : 0;
        color: root.c.style >= 19 && root.c.style <= 22 ? root.c.color
            : root.c.style == 1 || root.c.style == 9 || root.c.style == 12 ? Ink.soft : root.c.style == 2 || root.c.style == 3 || root.c.style == 14 ? Ink.quiet
            : root.c.style == 5 || root.c.style == 8 ? Ink.bright : root.c.style == 7 || root.c.style == 10 ? Ink.ink : Ink.dim;
        horizontal-alignment: root.c.style == 4 ? right : left;
        vertical-alignment: center;
    }
    // a color: a swatch that opens the color picker
    if root.c.kind == 1: Rectangle {
        border-radius: 8px;
        background: root.c.color;
        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: sw.has-hover ? #ffffff66 : #ffffff2e;
        }
        sw := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a checkbox and its words
    if root.c.kind == 2: Rectangle {
        Rectangle {
            x: 0;
            y: 0.5px;
            width: 18px;
            height: 18px;
            border-radius: 5px;
            background: root.c.on ? (tick-ta.has-hover ? Ink.bright : Ink.dim) : tick-ta.has-hover ? Ink.hover-box : Ink.well;
            border-width: root.c.on ? 0 : 1px;
            border-color: tick-ta.has-hover ? #6a6a74 : #4a4a52;
            if root.c.on: Path {
                width: 18px;
                height: 18px;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                fill: transparent;
                stroke: Ink.base;
                stroke-width: 2px;
            }
        }
        Text {
            x: 28px;
            width: parent.width - 28px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13.5px;
            color: tick-ta.has-hover ? Ink.bright : Ink.dim;
            vertical-alignment: center;
        }
        tick-ta := TouchArea {
            mouse-cursor: pointer;
            // which box, and the state it is turned to
            clicked => { root.pick(root.c.id, root.c.index * 2 + (root.c.on ? 0 : 1), 0, 0, 0); }
        }
    }
    // a slider: a thin track and a round knob, which follows the pointer while held
    if root.c.kind == 3: Rectangle {
        property <float> at: drag.pressed ? max(0, min(1, (drag.mouse-x - 8px) / (self.width - 16px))) : root.c.value;
        Rectangle {
            y: (parent.height - 4px) / 2;
            height: 4px;
            border-radius: 2px;
            background: Ink.track;
        }
        Rectangle {
            x: parent.at * (parent.width - 16px);
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Ink.ink;
        }
        drag := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.slide(root.c.id, max(0, min(1, (self.mouse-x - 8px) / (self.width - 16px))));
                }
            }
            moved => {
                if (self.pressed) {
                    root.slide(root.c.id, max(0, min(1, (self.mouse-x - 8px) / (self.width - 16px))));
                }
            }
            double-clicked => { root.reset(root.c.id); }
        }
    }
    // a switch's ground
    if root.c.kind == 4: Rectangle {
        border-radius: 10px;
        background: Ink.well;
    }
    // a box in its color, rounded at its ends: a mark on a track, a rule between readings
    if root.c.kind == 16: Rectangle {
        border-radius: min(self.width, self.height) / 2;
        background: root.c.color;
    }
    // a place that tells the page when the pointer is over it, under the words it covers
    if root.c.kind == 17: TouchArea {
        changed has-hover => { root.hovered(root.c.id, self.has-hover); }
    }
    // a pad to move something on, both ways at once: where the pointer is on it
    if root.c.kind == 18: TouchArea {
        mouse-cursor: move;
        changed has-hover => { root.hovered(root.c.id, self.has-hover); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pad(root.c.id, max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
            }
        }
        moved => {
            if (self.pressed) {
                root.pad(root.c.id, max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
            }
        }
    }
    // a tile, under the pieces on it
    // (style 27: a panel over the page, raised off it; 28: the page behind one,
    // dimmed; 30: the row of a menu that is in use)
    // (style 2: the Sensor Feed box with its first tab open, square under that tab)
    if root.c.kind == 9: Rectangle {
        border-radius: root.c.style == 30 ? 7px : root.c.style == 1 ? 12px : 14px;
        border-top-left-radius: root.c.style == 2 ? 0 : root.c.style == 30 ? 7px : root.c.style == 1 ? 12px : 14px;
        background: root.c.style == 27 ? Ink.pop : root.c.style == 28 ? #131316b8 : root.c.style == 30 ? Ink.shade4 : Ink.shade1;
        border-width: root.c.style == 27 ? 1px : 0;
        border-color: #3a3a41;
        drop-shadow-blur: root.c.style == 27 ? 28px : 0;
        drop-shadow-offset-y: root.c.style == 27 ? 10px : 0;
        drop-shadow-color: root.c.style == 27 ? #00000099 : transparent;
    }
    // a device's glyph on its square (style 1: the second device's, the mouse)
    if root.c.kind == 12: Rectangle {
        border-radius: 10px;
        background: Ink.well;
        // (30 on Settings' 48 square, and as much of a smaller one)
        Image {
            width: floor(parent.width * 0.625 / 1px) * 1px;
            height: self.width;
            source: root.c.style == -1 ? root.glyph3 : root.c.style >= 2 ? root.glyphs[root.c.style - 2] : root.c.style == 1 ? root.glyph2 : root.glyph;
            colorize: Ink.soft;
        }
    }
    // the weather's box (style 1: a folder's path in a plugin's section, its corners
    // smaller; 2: the settings nested under one, a shade off the box)
    if root.c.kind == 13: Rectangle {
        border-radius: root.c.style == 1 ? 8px : 10px;
        background: root.c.style == 2 ? #ffffff06 : Ink.well;
    }
    // a state's dot: 0 unknown, 1 good, 2 bad, 3 read from the weather
    if root.c.kind == 14: Rectangle {
        border-radius: 3.5px;
        background: root.c.style == 1 ? Ink.good : root.c.style == 2 ? Ink.bad : root.c.style == 3 ? Ink.warn : #5c5c66;
    }
    // a tab of the Sensor Feed box, as the Screen tab's own: rounded above, the open one in the
    // box's color and running on into it on its feet (none on the first's left, where the
    // box's corner is square), the others the page's own until the pointer is on them; an
    // amber dot after a part's name when its readings can't come in (style 1: the first
    // tab, 2: with its dot, 3: both)
    if root.c.kind == 50: tab := Rectangle {
        property <bool> first: root.c.style == 1 || root.c.style == 3;
        if root.c.on && !tab.first: Rectangle {
            x: -10px;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            background: Ink.box;
            Rectangle {
                background: Ink.base;
                border-bottom-right-radius: 10px;
            }
        }
        if root.c.on: Rectangle {
            x: parent.width;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            background: Ink.box;
            Rectangle {
                background: Ink.base;
                border-bottom-left-radius: 10px;
            }
        }
        Rectangle {
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
            background: root.c.on || tab-ta.has-hover ? Ink.box : transparent;
        }
        tab-words := Text {
            x: 18px;
            height: parent.height;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13px;
            font-weight: 500;
            color: root.c.on ? Ink.bright : tab-ta.has-hover ? Ink.dim : Ink.soft;
            vertical-alignment: center;
        }
        if root.c.style >= 2: Rectangle {
            x: tab-words.x + tab-words.width + 7px;
            y: (parent.height - 6px) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Ink.warn;
        }
        // (the open tab is already chosen: only the others answer the pointer)
        tab-ta := TouchArea {
            enabled: !root.c.on;
            mouse-cursor: root.c.on ? MouseCursor.default : MouseCursor.pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0); }
        }
    }
    // over a device's name in the Sensor Feed box: under the pointer, a while after it comes to
    // rest, its whole name where the row's is shorter (`text`), and where its readings come
    // from (`fill`), in a box like the app's menus
    if root.c.kind == 52: Rectangle {
        Tooltip {
            Rectangle {
                border-radius: 8px;
                background: Ink.hover-box;
                border-width: 1px;
                border-color: #3a3a41;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #00000080;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 2px;
                    if root.c.text != "": Text {
                        text: root.c.text;
                        font-family: "Geist";
                        font-size: 12.5px;
                        font-weight: 500;
                        color: Ink.bright;
                    }
                    Text {
                        text: root.c.fill;
                        font-family: "Geist";
                        font-size: 12px;
                        color: Ink.soft;
                    }
                }
            }
        }
    }
    // a sensor in the Sensor Feed box: its checkbox, its name (as wide as `value` allows), its
    // driver's name in gray (`fill`), its reading at its right (`lines`), and under the
    // pointer a pencil to rename it, whose click is the next control's; or a run of like
    // readings folded into one line, a chevron for its checkbox, how many are checked at its
    // right (style 0: a sensor, 1: one whose reading can't be right, its reading amber, 2: a
    // run, 3: a run opened, 4: a sensor being renamed, its line to type in over it)
    if root.c.kind == 51: chip := Rectangle {
        property <bool> run: root.c.style == 2 || root.c.style == 3;
        property <bool> hot: (chip-ta.has-hover || pen-ta.has-hover) && root.c.style != 4;
        border-radius: 7px;
        background: self.hot ? Ink.hover-well : transparent;
        chip-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0); }
        }
        if !chip.run: Rectangle {
            x: 8px;
            y: (parent.height - 15px) / 2;
            width: 15px;
            height: 15px;
            border-radius: 4.5px;
            background: root.c.on ? (chip.hot ? Ink.bright : Ink.dim) : chip.hot ? Ink.hover-box : Ink.well;
            border-width: root.c.on ? 0 : 1px;
            border-color: #4a4a52;
            if root.c.on: Path {
                width: 15px;
                height: 15px;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                fill: transparent;
                stroke: Ink.base;
                stroke-width: 2.2px;
            }
        }
        if chip.run: Path {
            x: 10px;
            y: (parent.height - 10px) / 2;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: root.c.style == 3 ? "M2 3.5l3 3 3-3" : "M3.5 2l3 3-3 3";
            fill: transparent;
            stroke: Ink.soft;
            stroke-width: 1.4px;
        }
        chip-name := Text {
            x: 31px;
            width: root.c.style == 4 ? 0 : min(self.preferred-width, root.c.value * 1px - (chip.hot && !chip.run ? 30px : 0));
            height: parent.height;
            text: root.c.text;
            font-family: "Geist";
            font-size: 12.5px;
            color: root.c.on || (chip.run && chip.hot) ? Ink.bright : Ink.dim;
            vertical-alignment: center;
            overflow: elide;
            visible: root.c.style != 4;
        }
        if root.c.fill != "" && root.c.style != 4: Text {
            x: chip-name.x + chip-name.width + 8px;
            height: parent.height;
            text: root.c.fill;
            font-family: "Geist";
            font-size: 11.5px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        chip-val := Text {
            x: parent.width - 8px - self.width - (chip.hot && !chip.run ? 30px : 0);
            height: parent.height;
            text: root.c.lines;
            font-family: "Geist";
            font-size: 12.5px;
            color: root.c.style == 1 ? Ink.warn : chip.run ? Ink.quiet : root.c.on ? Ink.dim : Ink.soft;
            vertical-alignment: center;
            visible: root.c.style != 4;
        }
        Rectangle {
            x: parent.width - 8px - 22px;
            y: (parent.height - 20px) / 2;
            width: 22px;
            height: 20px;
            border-radius: 5px;
            visible: chip.hot && !chip.run;
            background: pen-ta.has-hover ? Ink.pick : transparent;
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M4 20h4L19 9l-4-4L4 16z";
                fill: transparent;
                stroke: pen-ta.has-hover ? Ink.bright : Ink.soft;
                stroke-width: 1.8px;
                stroke-line-join: round;
            }
            pen-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(root.c.id + 1, root.c.index, 0, 0, 0); }
            }
        }
    }
    // a line to type in: the profile's name, or the weather's place
    // (style 7: a sensor's new name, typed on its chip: Enter, or leaving it, gives it,
    // Escape takes it back)
    if root.c.kind == 10: Rectangle {
        border-radius: root.c.style == 7 ? 6px : 8px;
        background: root.c.style == 7 ? Ink.base : Ink.well;
        border-width: root.c.style == 7 ? 1px : 0;
        border-color: #4a4a52;
        if root.c.style == 2 && input.text == "": Text {
            x: 10px;
            height: parent.height;
            text: "Find a typeface";
            font-family: "Geist";
            font-size: 13.5px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        if (root.c.style == 4 || root.c.style == 5) && input.text == "": Text {
            x: 10px;
            height: 34px;
            text: "None";
            font-family: "Geist";
            font-size: 13.5px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        // (style 8: a value in a plugin's section, in the face whose letters are all one
        // width, what it holds when empty in gray; Enter or leaving it gives it, Escape
        // takes it back)
        if root.c.style == 8 && input.text == "": Text {
            x: 12px;
            height: parent.height;
            text: root.c.fill;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: #8a8a92;
            vertical-alignment: center;
        }
        // (style 9: a name to give, what it holds when empty in gray, as the scene form's Name)
        if root.c.style == 9 && input.text == "": Text {
            x: 10px;
            height: parent.height;
            text: root.c.fill;
            font-family: "Geist";
            font-size: 13.5px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        if root.c.style == 3 && input.text == "": Text {
            x: 10px;
            height: parent.height;
            text: "Setup name";
            font-family: "Geist";
            font-size: 13.5px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        if root.c.style == 1 && input.text == "": Text {
            x: 11px;
            height: parent.height;
            text: "Search for a city or town";
            font-family: "Geist";
            font-size: 13.5px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        // (a key's text: what the page sets it to, unless it is being typed in)
        property <string> shown: root.c.text;
        changed shown => {
            if (root.c.style >= 4 && !input.has-focus && input.text != self.shown) {
                input.text = self.shown;
            }
        }
        // a key's picture in place of its text (style 6): a frame, its file's
        // name, and the button that takes it off
        if root.c.style == 6: Path {
            x: 11px;
            y: (34px - 14px) / 2;
            width: 16px;
            height: 14px;
            viewbox-width: 16;
            viewbox-height: 14;
            commands: "M1.5 1.5h13v11h-13z M3.5 10.5l3.5-4 2.5 2.5 1.5-1.5 2.5 3";
            fill: transparent;
            stroke: Ink.quiet;
            stroke-width: 1.2px;
        }
        if root.c.style == 6: Text {
            x: 34px;
            width: parent.width - 34px - 36px;
            height: 34px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13.5px;
            color: Ink.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        // (the box tells the page the pointer is over it, for its note)
        if root.c.style == 6: TouchArea {
            width: parent.width - 36px;
            height: parent.height;
            changed has-hover => { root.hovered(root.c.id, self.has-hover); }
        }
        if root.c.style == 6: Rectangle {
            x: parent.width - 32px;
            y: 3px;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: off.has-hover ? #ffffff14 : transparent;
            Text {
                text: "×";
                font-size: 17px;
                color: off.has-hover ? Ink.ink : Ink.quiet;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            off := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(root.c.id, 2, 0, 0, 0); }
            }
        }
        // a key's text: its glyphs' button, which gives the box the keys and opens their list
        if root.c.style == 4 || root.c.style == 5: Rectangle {
            x: parent.width - 32px;
            y: 3px;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: glyphs.has-hover ? #ffffff14 : transparent;
            Text {
                text: "⌘";
                font-size: 15px;
                color: glyphs.has-hover ? Ink.ink : Ink.quiet;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // (the box's text chosen as it takes the keys, so a glyph takes its
            // place; with the cursor already in the box, a glyph goes there)
            glyphs := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (!input.has-focus) {
                        input.focus();
                        input.select-all();
                    }
                    root.pick(root.c.id, 1, 0, 0, 0);
                }
            }
        }
        input := TextInput {
            visible: root.c.style != 6;
            enabled: root.c.style != 6;
            property <bool> plugin-value: root.c.style == 8;
            x: self.plugin-value ? 12px : root.c.style == 1 ? 11px : root.c.style == 7 ? 8px : 10px;
            y: root.c.style == 5 ? 8px : 0;
            width: parent.width - 2 * self.x - (root.c.style >= 4 && root.c.style <= 6 ? 30px : 0);
            height: root.c.style == 5 ? parent.height - 16px : parent.height;
            text: root.c.text;
            font-family: self.plugin-value ? "JetBrains Mono" : "Geist";
            font-size: self.plugin-value ? 12px : root.c.style == 7 ? 12.5px : 13.5px;
            // (a value its page follows from elsewhere, in gray)
            color: self.plugin-value ? (root.c.on && !self.has-focus ? Ink.soft : Ink.dim) : root.c.style == 1 || root.c.style == 7 ? Ink.bright : Ink.ink;
            vertical-alignment: root.c.style == 5 ? top : center;
            single-line: root.c.style != 5;
            edited => { root.typed(root.c.id, root.c.index, self.text); }
            changed has-focus => {
                Typing.on = self.has-focus;
                if (root.c.style >= 4 && root.c.style <= 6) {
                    root.focused(root.c.id, self.has-focus);
                }
                if (root.c.style == 7 && !self.has-focus) {
                    root.pick(root.c.id, 1, 0, 0, 0);
                }
                if (self.plugin-value && !self.has-focus) {
                    root.pick(root.c.id, root.c.index, 1px, 0, 0);
                }
            }
            // (style 3, a name to give, and 7: it takes the keys as it shows, all of
            // it chosen; Enter gives it, Escape cancels)
            init => {
                if (root.c.style == 3 || root.c.style == 7) {
                    self.focus();
                    self.select-all();
                }
            }
            accepted => {
                if (root.c.style == 3 || root.c.style == 7) {
                    root.pick(root.c.id, 1, 0, 0, 0);
                }
                if (self.plugin-value) {
                    self.clear-focus();
                }
            }
            key-pressed(e) => {
                if (self.plugin-value && e.text == Key.Escape) {
                    root.pick(root.c.id, root.c.index, 2px, 0, 0);
                    self.text = root.c.text;
                    self.clear-focus();
                    return accept;
                }
                if ((root.c.style == 3 || root.c.style == 7 || root.c.style == 9) && e.text == Key.Escape) {
                    root.pick(root.c.id, 2, 0, 0, 0);
                    return accept;
                }
                if (root.c.style >= 4 && root.c.style <= 6 && e.text == Key.Escape) {
                    self.clear-focus();
                    return accept;
                }
                reject
            }
        }
    }
    // a number to type, as the lab's values are: Enter or leaving the
    // box sets it, Escape puts it back as it was; set elsewhere (its slider),
    // the box follows unless it is being typed in
    if root.c.kind == 15: Rectangle {
        property <string> shown: root.c.text;
        changed shown => {
            if (!num.has-focus) {
                num.text = self.shown;
            }
        }
        border-radius: 6px;
        background: Ink.well;
        border-width: 1px;
        border-color: num.has-focus ? #6a6a74 : box-ta.has-hover ? #4a4a52 : #34343a;
        box-ta := TouchArea {
            mouse-cursor: text;
            clicked => { num.focus(); }
        }
        num := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13px;
            color: Ink.bright;
            horizontal-alignment: right;
            vertical-alignment: center;
            single-line: true;
            accepted => {
                root.entered(root.c.id, self.text);
                self.clear-focus();
            }
            changed has-focus => {
                Typing.on = self.has-focus;
                root.focused(root.c.id, self.has-focus);
                if (self.has-focus) {
                    self.select-all();
                } else if (self.text != root.c.text) {
                    root.entered(root.c.id, self.text);
                }
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    self.text = root.c.text;
                    self.clear-focus();
                    return accept;
                }
                reject
            }
        }
    }
    // a button that opens a menu of choices, as the key editor's action button
    if root.c.kind == 11: Rectangle {
        border-radius: 8px;
        background: dd.has-hover ? Ink.shade3 : Ink.shade2;
        Text {
            x: 10px;
            width: parent.width - 39px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13px;
            color: Ink.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        Path {
            x: parent.width - 19px;
            y: (parent.height - 6px) / 2;
            width: 9px;
            height: 6px;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M1 1l4 4 4-4";
            fill: transparent;
            stroke: Ink.quiet;
            stroke-width: 1.35px;
        }
        dd := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a switch's choice, an area chip, a button, the reset: words on a shade
    // (style 24: it opens a list, a chevron after its words; 25: a key on the
    // lab's map, its words small; 26: not to be chosen here, its words
    // faint; 29: the page round a menu, which shuts it, with no shade or hand; 33: a small
    // button, as a card's Make main)
    if root.c.kind >= 5 && root.c.kind <= 8: Rectangle {
        // (style 36: a card that opens, in the well's shade on a box: a script's; 37: a
        // button that can't be used now, faded)
        opacity: root.c.style == 37 ? 0.4 : 1;
        border-radius: root.c.style == 36 ? 10px : root.c.style == 25 ? 4px : root.c.kind == 5 ? 7px : root.c.kind == 8 || root.c.style == 33 ? 6px : 8px;
        background: root.c.style == 36 ? (b.has-hover ? Ink.hover-well : Ink.well)
            : root.c.on ? (b.has-hover ? Ink.pick-hover : Ink.pick)
            : root.c.style == 26 ? transparent
            : root.c.style == 31 ? (b.has-hover ? Ink.pick : Ink.hover-box)
            : root.c.kind == 5 ? (b.has-hover ? Ink.hover-well : transparent)
            : root.c.kind == 8 ? (b.has-hover && root.c.style != 29 ? #ffffff0f : transparent)
            : (b.has-hover ? Ink.pick : Ink.hover-box);
        // style 32: a color's button, its color in a small square before its words
        if root.c.style == 32: Rectangle {
            x: 9px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            border-radius: 4px;
            background: root.c.color;
            border-width: 1px;
            border-color: #ffffff33;
        }
        // style 35: an icon before its words, drawn as the bar's buttons draw theirs (its lines, on 16 units)
        if root.c.style == 35: Path {
            x: 12px;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: root.c.lines;
            fill: transparent;
            stroke: Ink.ink;
            stroke-width: 1.14px;
            stroke-line-cap: round;
        }
        // style 31 with an icon's shapes: the icon, as its key prints it
        if root.c.style == 31 && (root.c.fill != "" || root.c.lines != ""): Rectangle {
            x: (parent.width - 20px) / 2;
            y: (parent.height - 20px) / 2;
            width: 20px;
            height: 20px;
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.c.fill;
                fill: b.has-hover ? #ffffff : Ink.dim;
            }
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.c.lines;
                fill: transparent;
                stroke: b.has-hover ? #ffffff : Ink.dim;
                stroke-width: 1.67px;
            }
        }
        Text {
            x: root.c.style == 32 ? 32px : root.c.style == 35 ? 12px + 14px + 7px : (parent.width - self.width) / 2 - (root.c.style == 24 ? 7px : 0);
            y: (parent.height - self.height) / 2 + (b.pressed && (root.c.kind == 7 || root.c.kind == 8) ? 1px : 0);
            text: root.c.text;
            font-family: "Geist";
            font-size: root.c.style == 25 ? 10.5px : root.c.style == 31 ? 17px : root.c.style == 33 ? 12px : root.c.kind == 8 ? 12.5px : 13px;
            font-weight: root.c.kind >= 7 && root.c.style != 33 ? 500 : 400;
            color: root.c.on ? Ink.bright : root.c.style == 26 ? #5a5a60 : root.c.style == 33 ? (b.has-hover ? Ink.bright : Ink.dim) : root.c.kind == 8 ? (b.has-hover ? Ink.ink : Ink.quiet) : root.c.kind == 7 ? Ink.ink : b.has-hover ? #ffffff : Ink.dim;
        }
        if root.c.style == 24 || root.c.style == 32: Path {
            x: parent.width - 19px;
            y: (parent.height - 6px) / 2;
            width: 9px;
            height: 6px;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M1 1l4 4 4-4";
            fill: transparent;
            stroke: root.c.on ? #171717 : Ink.quiet;
            stroke-width: 1.35px;
        }
        b := TouchArea {
            enabled: root.c.style != 26 && root.c.style != 37;
            mouse-cursor: root.c.style == 29 ? MouseCursor.default : MouseCursor.pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
            // style 23: it tells the page the pointer is over it, as a zone does
            changed has-hover => {
                if (root.c.style == 23 || root.c.style == 31 || root.c.style == 32) {
                    root.hovered(root.c.id, self.has-hover);
                }
            }
        }
    }
    // ---- the Lighting page's own pieces, in the shades of its boxes
    // a value in a small well; style 1, a warning's tag, outlined in amber
    // (style 2: on a well, a step lighter than it; 3: a card's Main card, on the box)
    // (style 4: a tag on a well, in the box's shade, its words quiet: a script's Every game)
    if root.c.kind == 40: Rectangle {
        border-radius: root.c.style == 1 ? 4px : root.c.style == 4 ? 5px : 6px;
        background: root.c.style == 1 ? transparent : root.c.style == 2 ? Ink.hover-box : root.c.style == 3 ? Ink.pick : root.c.style == 4 ? Ink.box : Ink.well;
        border-width: root.c.style == 1 ? 1px : 0;
        border-color: #f0b35a73;
        Text {
            text: root.c.text;
            font-family: "Geist";
            font-size: root.c.style == 1 ? 11px : root.c.style == 2 ? 12px : 11.5px;
            font-weight: root.c.style == 1 || root.c.style == 2 || root.c.style == 3 || root.c.style == 4 ? 400 : 500;
            color: root.c.style == 1 ? Ink.warn : root.c.style == 2 || root.c.style == 3 ? Ink.bright : root.c.style == 4 ? Ink.quiet : Ink.dim;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // a slider on a well, filled to its place in its color; the knob follows the pointer while held
    // (style 1: in a box of the well's own shade, the track a step lighter than it; style 2: the
    // same track on the page itself, the knob ringed in the page's shade; style 3: the lighter
    // track in a box's shade; style 4: as 3, with a notch at its middle, its default, which holds
    // the knob as it passes)
    if root.c.kind == 41: filled := Rectangle {
        property <float> held: max(0, min(1, (fdrag.mouse-x - 9px) / (self.width - 18px)));
        property <float> at: fdrag.pressed ? (root.c.style == 4 && abs(self.held - 0.5) <= 0.04 ? 0.5 : self.held) : root.c.value;
        Rectangle {
            y: 7px;
            height: 6px;
            border-radius: 3px;
            background: root.c.style >= 1 ? Ink.hover-box : Ink.well;
            clip: true;
            Rectangle {
                x: 0;
                width: 9px + filled.at * (parent.width - 18px);
                border-radius: 3px;
                background: root.c.color;
            }
        }
        // the notch: a short line across the track at its middle, under the knob
        if root.c.style == 4: Rectangle {
            x: 9px + 0.5 * (parent.width - 18px) - 1px;
            y: 3px;
            width: 2px;
            height: 14px;
            border-radius: 1px;
            background: Ink.quiet;
        }
        // the knob, ringed in the box's color
        Rectangle {
            property <length> d: fdrag.has-hover || fdrag.pressed ? 19.5px : 18px;
            x: parent.at * (parent.width - 18px) + 9px - self.d / 2 - 3px;
            y: 10px - self.d / 2 - 3px;
            width: self.d + 6px;
            height: self.d + 6px;
            border-radius: self.width / 2;
            background: root.c.style == 2 ? Ink.base : root.c.style == 1 ? Ink.well : Ink.box;
            drop-shadow-blur: 6px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #000000aa;
            Rectangle {
                x: 3px;
                y: 3px;
                width: parent.d;
                height: parent.d;
                border-radius: self.width / 2;
                background: #fafafa;
            }
        }
        fdrag := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.slide(root.c.id, max(0, min(1, (self.mouse-x - 9px) / (self.width - 18px))));
                }
            }
            moved => {
                if (self.pressed) {
                    root.slide(root.c.id, max(0, min(1, (self.mouse-x - 9px) / (self.width - 18px))));
                }
            }
            double-clicked => { root.reset(root.c.id); }
        }
    }
    // a color's dot, ringed while the picker is open on it; style 1 opens the picker for any color
    // (in a cell under 28 across, as a narrow box has them: the dot 20 across, its ring a
    // hairline of the brightest ink, kept apart from it by the box's own shade)
    if root.c.kind == 42 && root.c.style != 2: dotcell := Rectangle {
        property <bool> small: root.width < 28px;
        border-radius: self.width / 2;
        border-width: root.c.on ? (self.small ? 1.5px : 2px) : 0;
        border-color: self.small ? Ink.bright : Ink.dim;
        Rectangle {
            property <length> d: dotcell.small ? (dot-ta.has-hover ? 22px : 20px) : dot-ta.has-hover ? 26px : 24px;
            x: (parent.width - self.d) / 2;
            y: (parent.height - self.d) / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: root.c.style == 1 ? (dot-ta.has-hover ? Ink.hover-box : transparent) : root.c.color;
            border-width: root.c.style == 1 || !dotcell.small ? 1px : 0;
            border-color: root.c.style == 1 ? (dot-ta.has-hover ? #8a8a94 : #4a4a52) : #ffffff2a;
            if root.c.style == 1: Path {
                width: dotcell.small ? 10px : 12px;
                height: dotcell.small ? 10px : 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M6 1.5v9M1.5 6h9";
                fill: transparent;
                stroke: dot-ta.has-hover ? Ink.bright : Ink.soft;
                stroke-width: 1.5px;
            }
        }
        dot-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // style 2: a color's dot and its code as one button, lit under the pointer and while the
    // picker is open on it (the screen's default backlight, on the page itself)
    if root.c.kind == 42 && root.c.style == 2: Rectangle {
        border-radius: 7px;
        background: code-ta.has-hover || root.c.on ? Ink.hover-box : transparent;
        Rectangle {
            x: 4px;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: root.c.color;
            border-width: 1px;
            border-color: #ffffff2a;
        }
        Text {
            x: 32px;
            width: parent.width - 32px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13px;
            color: Ink.bright;
            vertical-alignment: center;
        }
        code-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a piece of a run of colors, from its color to the next (its red, green and blue packed in
    // `value`, as 65536 r + 256 g + b); style says which ends are round
    if root.c.kind == 43: Rectangle {
        property <color> next: rgb(floor(root.c.value / 65536), mod(floor(root.c.value / 256), 256), mod(root.c.value, 256));
        border-top-left-radius: mod(root.c.style, 2) == 1 ? 5px : 0;
        border-bottom-left-radius: mod(root.c.style, 2) == 1 ? 5px : 0;
        border-top-right-radius: root.c.style >= 2 ? 5px : 0;
        border-bottom-right-radius: root.c.style >= 2 ? 5px : 0;
        background: @linear-gradient(90deg, root.c.color 0%, self.next 100%);
    }
    // a switch's choice on its well, its icon before its words if it has one (style 1:
    // one that can't be chosen, its words faint)
    if root.c.kind == 44: Rectangle {
        property <bool> off: root.c.style == 1;
        border-radius: 6px;
        background: root.c.on ? (ch-ta.has-hover ? Ink.pick-hover : Ink.pick) : ch-ta.has-hover && !self.off ? Ink.hover-well : transparent;
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            if root.c.lines != "": Path {
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.c.lines;
                fill: transparent;
                stroke: root.c.on || ch-ta.has-hover ? Ink.bright : Ink.soft;
                stroke-width: 1.8px;
            }
            Text {
                text: root.c.text;
                font-family: "Geist";
                font-size: 12.5px;
                color: root.c.style == 1 ? #5d5d64 : root.c.on || ch-ta.has-hover ? Ink.bright : Ink.soft;
                vertical-alignment: center;
            }
        }
        ch-ta := TouchArea {
            enabled: root.c.style != 1;
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // an area's chip: outlined, white when chosen (with a tick, style 1); it tells the page the pointer is over it
    if root.c.kind == 45: Rectangle {
        // (style 1 ticked when chosen; style 2 faded, the whole keyboard lit;
        // value 1 when the pointer is over its area on the keyboard's picture)
        property <bool> hot: ar-ta.has-hover || root.c.value > 0.5;
        border-radius: 14px;
        background: root.c.on ? (self.hot ? Ink.pick-hover : Ink.pick) : self.hot ? Ink.hover-well : Ink.well;
        opacity: root.c.style == 2 && !self.hot ? 0.45 : 1;
        HorizontalLayout {
            padding-left: root.c.on ? 9px : 12px;
            padding-right: 12px;
            spacing: 5px;
            if root.c.on: Path {
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M5 12.5l4.5 4.5L19 7.5";
                fill: transparent;
                stroke: Ink.bright;
                stroke-width: 2.6px;
            }
            Text {
                text: root.c.text;
                font-family: "Geist";
                font-size: 12.5px;
                color: root.c.on || ar-ta.has-hover || root.c.value > 0.5 ? Ink.bright : Ink.soft;
                vertical-alignment: center;
            }
        }
        ar-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
            changed has-hover => { root.hovered(root.c.index, self.has-hover); }
        }
    }
    // a dropdown on a well: what is chosen, and a chevron
    // a dropdown on a well (style 1: its value followed from elsewhere, in gray)
    // (style 2: its value needs choosing again, an amber line round it)
    if root.c.kind == 46: Rectangle {
        border-radius: 8px;
        background: dr-ta.has-hover || root.c.on ? Ink.hover-box : Ink.well;
        border-width: root.c.style == 2 ? 1px : 0;
        border-color: #f0b35a80;
        if root.c.value > 0: Image {
            x: 12px;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            source: root.chips[round(root.c.value) - 1];
            image-fit: fill;
        }
        Text {
            x: root.c.value > 0 ? 12px + 14px + 9px : 12px;
            width: parent.width - self.x - 28px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13px;
            color: root.c.style == 1 ? Ink.soft : Ink.bright;
            vertical-alignment: center;
            overflow: elide;
        }
        Path {
            x: parent.width - 24px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M3 4.5l3 3 3-3";
            fill: transparent;
            stroke: Ink.quiet;
            stroke-width: 1.6px;
        }
        dr-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a link in a sentence: its words brighter than the note round them, which select it
    if root.c.kind == 18: Text {
        text: root.c.text;
        font-family: "Geist";
        font-size: 12.5px;
        color: il-ta.has-hover ? #ffffff : Ink.bright;
        vertical-alignment: center;
        il-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a quiet link: Reset (with its icon), Select all, Scatter colors (style 1: a text
    // button in a plugin's section, its icon on 14 units; 2: the same, not to be used now, faded)
    if root.c.kind == 47: quiet := Rectangle {
        property <bool> tb: root.c.style == 1 || root.c.style == 2;
        border-radius: 6px;
        opacity: root.c.style == 2 ? 0.4 : 1;
        background: q-ta.has-hover ? (self.tb ? #ffffff0f : Ink.hover-box) : transparent;
        HorizontalLayout {
            padding-left: 9px;
            padding-right: 9px;
            spacing: 6px;
            if root.c.lines != "": Path {
                y: (parent.height - 13px) / 2;
                width: 13px;
                height: 13px;
                viewbox-width: quiet.tb ? 14 : 24;
                viewbox-height: quiet.tb ? 14 : 24;
                commands: root.c.lines;
                fill: transparent;
                stroke: q-ta.has-hover ? (quiet.tb ? Ink.ink : Ink.bright) : quiet.tb ? Ink.dim : Ink.soft;
                stroke-width: quiet.tb ? 1.2px : 1.9px;
                stroke-line-join: round;
            }
            Text {
                text: root.c.text;
                font-family: "Geist";
                font-size: quiet.tb ? 13px : 12.5px;
                font-weight: 500;
                color: q-ta.has-hover ? (quiet.tb ? Ink.ink : Ink.bright) : quiet.tb ? Ink.dim : Ink.soft;
                vertical-alignment: center;
            }
        }
        q-ta := TouchArea {
            enabled: root.c.style != 2;
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a thing the firmware adds: a tick, then its name
    if root.c.kind == 49: Rectangle {
        Path {
            x: 0;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M5 12.5l4.5 4.5L19 7.5";
            fill: transparent;
            stroke: Ink.good;
            stroke-width: 2.4px;
        }
        Text {
            x: 19px;
            width: parent.width - 19px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13px;
            color: Ink.dim;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // a fold's heading in a plugin's section: its chevron (turned down while open) and its
    // words, which open and shut it
    if root.c.kind == 53: Rectangle {
        Path {
            x: 0;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: root.c.on ? "M2.5 4.5l3.5 3.5 3.5-3.5" : "M4.5 2.5l3.5 3.5-3.5 3.5";
            fill: transparent;
            stroke: fold-ta.has-hover ? Ink.ink : Ink.soft;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        Text {
            x: 20px;
            width: parent.width - 20px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13.5px;
            color: fold-ta.has-hover ? Ink.ink : Ink.soft;
            vertical-alignment: center;
        }
        fold-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0); }
        }
    }
    // a checkbox on a box, and its words (style 1: one that can't be changed now, faint and
    // unticked; 2: one held on by another setting, ticked in gray)
    if root.c.kind == 48: Rectangle {
        property <bool> off: root.c.style == 1;
        property <bool> held: root.c.style == 2;
        property <bool> hot: cb-ta.has-hover && root.c.style == 0;
        Rectangle {
            x: 0;
            y: (parent.height - 18px) / 2;
            width: 18px;
            height: 18px;
            border-radius: 5px;
            background: parent.held ? #5d5d64 : parent.off ? transparent : root.c.on ? (parent.hot ? Ink.bright : Ink.dim) : parent.hot ? Ink.hover-box : Ink.well;
            border-width: (root.c.on && !parent.off) || parent.held ? 0 : 1px;
            border-color: parent.off ? #34343a : parent.hot ? #6a6a74 : #4a4a52;
            if (root.c.on && !parent.off) || parent.held: Path {
                width: 18px;
                height: 18px;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                fill: transparent;
                stroke: #131316;
                stroke-width: 2px;
            }
        }
        Text {
            x: 28px;
            width: parent.width - 28px;
            text: root.c.text;
            font-family: "Geist";
            font-size: 13px;
            color: parent.off ? #5d5d64 : parent.hot ? Ink.bright : Ink.dim;
            vertical-alignment: center;
        }
        cb-ta := TouchArea {
            enabled: root.c.style == 0;
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index * 2 + (root.c.on ? 0 : 1), 0, 0, 0); }
        }
    }
}

// a number or code in the color picker, its name under it
component PickField inherits VerticalLayout {
    in-out property <string> value;
    in property <string> label;
    in property <int> which;
    callback edited(int, string);
    callback enter();
    callback dismiss();
    spacing: 3px;
    Rectangle {
        height: 27px;
        border-radius: 6px;
        background: Ink.shade1;
        border-width: input.has-focus ? 1px : 0;
        border-color: #6a6a74;
        input := TextInput {
            changed has-focus => { Typing.on = self.has-focus; }
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text <=> root.value;
            font-family: "Geist";
            font-size: 12.5px;
            font-weight: 500;
            color: Ink.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(root.which, self.text); }
            accepted => { root.enter(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.dismiss();
                    return accept;
                }
                reject
            }
        }
    }
    Text {
        height: 15px;
        text: root.label;
        font-family: "Geist";
        font-size: 11px;
        color: Ink.quiet;
        horizontal-alignment: center;
    }
}

// a color to pick in one click: a preset, or one used lately
component Well inherits Rectangle {
    in property <color> c;
    callback clicked;
    width: 23.56px;
    height: 23.56px;
    // round, as every color dot in the app is
    border-radius: self.width / 2;
    background: root.c;
    Rectangle {
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: ta.has-hover ? #ffffff99 : #ffffff24;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// the color picker every swatch opens, laid out as design tools lay theirs:
// saturation across and brightness down for the chosen hue, the hue under it,
// the color as a hex code, as red, green and blue, and as hue, saturation and
// brightness, then preset colors and the ones used lately
component Picker inherits Rectangle {
    in property <float> hue;
    in property <float> sat;
    in property <float> val;
    in property <color> now;
    in property <color> pure;
    in property <image> sv-img;
    in property <image> hue-img;
    in-out property <string> t-hex;
    in-out property <string> t-r;
    in-out property <string> t-g;
    in-out property <string> t-b;
    in-out property <string> t-h;
    in-out property <string> t-s;
    in-out property <string> t-v;
    in property <[color]> presets;
    in property <[color]> recent;
    callback sv(float, float);
    callback hue-at(float);
    callback field(int, string);
    callback well(color);
    callback enter();
    callback dismiss();
    width: 264px;
    border-radius: 10px;
    background: Ink.shade2;
    drop-shadow-blur: 34px;
    drop-shadow-offset-y: 14px;
    drop-shadow-color: #00000080;
    // the square: white to the hue across, then to black downward
    Rectangle {
        x: 6px;
        y: 6px;
        width: 252px;
        height: 160px;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.sv-img;
            image-fit: fill;
        }
        sv-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.sv(max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
                }
            }
            moved => {
                if (self.pressed) {
                    root.sv(max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
                }
            }
        }
        Rectangle {
            x: root.sat * parent.width - 10px;
            y: (1 - root.val) * parent.height - 10px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: #00000066;
            Rectangle {
                x: 1px;
                y: 1px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: root.now;
                }
            }
        }
    }
    // the hue
    Rectangle {
        x: 6px;
        y: 6px + 160px + 10px;
        width: 252px;
        height: 12px;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.hue-img;
            image-fit: fill;
        }
        hue-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.hue-at(max(0, min(1, self.mouse-x / self.width)));
                }
            }
            moved => {
                if (self.pressed) {
                    root.hue-at(max(0, min(1, self.mouse-x / self.width)));
                }
            }
        }
        Rectangle {
            x: root.hue / 360 * parent.width - 10px;
            y: -4px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            border-width: 1px;
            border-color: #00000066;
            Rectangle {
                x: 1px;
                y: 1px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 2px;
                border-color: #ffffff;
            }
        }
    }
    // the color as numbers
    HorizontalLayout {
        x: 6px;
        y: 6px + 160px + 10px + 12px + 10px;
        width: 252px;
        height: 45px;
        spacing: 6px;
        PickField { horizontal-stretch: 1.7; label: "Hex"; which: 0; value <=> root.t-hex; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "R"; which: 1; value <=> root.t-r; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "G"; which: 2; value <=> root.t-g; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "B"; which: 3; value <=> root.t-b; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
    }
    HorizontalLayout {
        x: 6px;
        y: 6px + 160px + 10px + 12px + 10px + 45px + 10px;
        width: 252px;
        height: 45px;
        spacing: 6px;
        PickField { label: "H°"; which: 4; value <=> root.t-h; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { label: "S%"; which: 5; value <=> root.t-s; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { label: "B%"; which: 6; value <=> root.t-v; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
    }
    // preset colors, then the ones used lately
    Text {
        x: 6px;
        y: 308px;
        height: 16px;
        text: "Presets";
        font-family: "Geist";
        font-size: 11.5px;
        color: Ink.quiet;
    }
    for c[i] in root.presets: Well {
        x: 6px + i * (23.56px + 5px);
        y: 330px;
        c: c;
        clicked => { root.well(c); }
    }
    if root.recent.length > 0: Text {
        x: 6px;
        y: 363.56px;
        height: 16px;
        text: "Recent";
        font-family: "Geist";
        font-size: 11.5px;
        color: Ink.quiet;
    }
    for c[i] in root.recent: Well {
        x: 6px + i * (23.56px + 5px);
        y: 385.56px;
        c: c;
        clicked => { root.well(c); }
    }
}

// a device on the home: its glyph on a tile, its name under it
component Tile inherits Rectangle {
    in property <image> glyph;
    in property <string> name;
    callback clicked;
    width: 260px;
    height: 290px;
    Rectangle {
        y: 0;
        height: 260px;
        border-radius: 14px;
        background: ta.has-hover ? #303030 : Ink.shade1;
        animate background { duration: 150ms; easing: ease; }
        Image {
            width: 88px;
            height: 88px;
            source: root.glyph;
            colorize: ta.has-hover ? Ink.dim : Ink.soft;
        }
    }
    Text {
        y: 270px;
        height: 20px;
        text: root.name;
        font-family: "Geist";
        font-size: 14px;
        font-weight: 500;
        color: Ink.bright;
        horizontal-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A box on the page: a raised surface, no border, its title at its top left
// and anything beside the title at its top right.
component PageBox inherits Rectangle {
    in property <string> title;
    // where the title sits: lower when something comes before it in the box
    in property <length> title-y: 14px;
    // (clear inside a ScrollBox, which draws the box itself)
    in property <brush> fill: Ink.box;
    background: root.fill;
    border-radius: 12px;
    Text {
        x: 16px;
        y: root.title-y;
        height: 22px;
        text: root.title;
        font-family: "Geist";
        font-size: 13.5px;
        font-weight: 600;
        color: Ink.bright;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 120px;
    }
    @children
}

// a quiet text button at a box's top right (Collapse all, Done, Reset)
component BoxLink inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    width: words.preferred-width + 18px;
    border-radius: 6px;
    background: ta.has-hover && root.enabled ? Ink.hover-box : transparent;
    words := Text {
        x: 9px;
        height: parent.height;
        text: root.text;
        font-family: "Geist";
        font-size: 12.5px;
        font-weight: 500;
        color: !root.enabled ? Ink.quiet.with-alpha(0.6) : ta.has-hover ? Ink.bright : Ink.soft;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// a key's cap, small, as the Key library shows it
component SmallCap inherits Rectangle {
    in property <string> text;
    in property <length> size: 11px;
    width: 34px;
    height: 26px;
    // the cap's edge, deeper at its front, all of it following the rounded corners
    border-radius: 5px;
    background: #3a3a41;
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 4px;
        border-radius: 4px;
        background: Ink.well;
    }
    Text {
        y: 0;
        height: parent.height - 3px;
        text: root.text;
        font-family: "Geist";
        font-size: root.size;
        font-weight: 600;
        color: Ink.bright;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 4px;
        x: 2px;
    }
}

// The effects, three across: each a well with its small picture under a
// film and its name; the chosen one lit, and only its picture moving
component EffectGrid inherits PageBox {
    in property <[EffectItem]> effects;
    callback chose(int);
    // whether the chosen effect's picture moves: the page is drawn again only while it does
    in property <bool> moving;
    title: "Effect";
    property <length> tw: (self.width - 32px - 16px) / 3;
    property <duration> t: root.moving ? animation-tick() : 0ms;
    for fx[i] in root.effects: Rectangle {
        x: 16px + mod(i, 3) * (root.tw + 8px);
        y: 48px + floor(i / 3) * (76px + 8px);
        width: root.tw;
        height: 76px;
        border-radius: 10px;
        background: fx.on ? (fx-ta.has-hover ? Ink.pick-hover : Ink.pick) : fx-ta.has-hover ? Ink.hover-box : Ink.well;
        Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: 40px;
            border-radius: 6px;
            clip: true;
            background: fx.name == "Off" ? Ink.hover-box : #0c0e10;
            property <float> phase: fx.on && fx.motion != 0 ? root.t / 1ms : 0;
            if fx.name != "Off": Image {
                // rolling: a picture twice as wide, slid along and round again;
                // Pulse, chosen: its five colors each as wide as the tile, one
                // shown at a time, jumping to the next as the keys do
                x: fx.on && fx.motion == 3 ? -mod(parent.phase / 3000, 1) * parent.width
                    : fx.on && fx.motion == 2 ? -mod(floor(parent.phase / 700), 5) * parent.width
                    : 0;
                width: fx.motion == 3 ? parent.width * 2 : fx.on && fx.motion == 2 ? parent.width * 5 : parent.width;
                height: parent.height;
                source: fx.icon;
                image-fit: fill;
                opacity: !fx.on ? 1
                    : fx.motion == 1 ? 0.3 + 0.7 * (0.5 - 0.5 * cos(parent.phase / 3000 * 360deg))
                    : fx.motion == 4 ? 0.55 + 0.45 * (0.5 - 0.5 * cos(parent.phase / 1600 * 360deg))
                    : fx.motion == 5 ? 1 - 0.75 * min(1, mod(parent.phase, 1400) / 1400)
                    : 1;
            }
            // the film every picture sits under
            Rectangle {
                background: Ink.pick.with-alpha(0.35);
            }
        }
        Text {
            y: 53px;
            height: 15px;
            width: parent.width;
            text: fx.name;
            font-family: "Geist";
            font-size: 12px;
            font-weight: fx.on ? 500 : 400;
            color: fx.on || fx-ta.has-hover ? Ink.bright : Ink.soft;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        fx-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chose(i); }
        }
    }
}

// One of the screen's two states, as a folder tab on the top of the screen's box, as wide
// as its name: open, in the box's charcoal and running on into it, its feet curving into
// the box's top edge (the left one not on the first tab, which sits on the box's square
// corner); shut, its name quieter on the page, lit a little under the pointer.
component StateTab inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    in property <bool> first;
    callback clicked;
    width: words.preferred-width + 36px;
    height: 36px;
    if root.open && !root.first: Rectangle {
        x: -10px;
        y: parent.height - 10px;
        width: 10px;
        height: 10px;
        background: Ink.well;
        Rectangle {
            background: Ink.base;
            border-bottom-right-radius: 10px;
        }
    }
    if root.open: Rectangle {
        x: parent.width;
        y: parent.height - 10px;
        width: 10px;
        height: 10px;
        background: Ink.well;
        Rectangle {
            background: Ink.base;
            border-bottom-left-radius: 10px;
        }
    }
    Rectangle {
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        background: root.open ? Ink.well : tab-ta.has-hover ? Ink.box : transparent;
    }
    words := Text {
        x: 18px;
        height: parent.height;
        text: root.text;
        font-family: "Geist";
        font-size: 13px;
        font-weight: 500;
        color: root.open ? Ink.bright : tab-ta.has-hover ? Ink.dim : Ink.soft;
        vertical-alignment: center;
    }
    // the open tab is already chosen: only the other one answers the pointer
    tab-ta := TouchArea {
        enabled: !root.open;
        mouse-cursor: root.open ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// The layer the Keys tab edits, as folder tabs across the top of the Key
// library, sharing its width and edge to edge with it: the open one in the
// box's own color, running on into it, its inner corners rounded against the
// others; the others dark, curving into the box where they meet it, a half
// step lighter under the pointer and never as light as the open one. Each its
// key (a blank cap for the layer with nothing held, Fn for Function) and its
// name. A device with one layer has one tab, the box's heading.
component LayerSwitch inherits Rectangle {
    in property <int> layer;
    in property <[LayerTab]> layers: [{ name: "Base", cap: "" }, { name: "Function", cap: "Fn" }];
    callback chosen(int);
    height: 50px;
    // the pointer over a tab that is not open
    property <bool> shut-hover;
    // the dark tabs' color, at rest or under the pointer
    property <color> shut: root.shut-hover ? #1a1a1e : Ink.well;
    // behind them all, the dark tabs' color, which shows round the open tab's inner corners
    Rectangle {
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        background: root.shut;
    }
    for l[i] in root.layers: t := Rectangle {
        property <bool> open: root.layer == i;
        property <bool> first: i == 0;
        property <bool> last: i == root.layers.length - 1;
        x: i * root.width / root.layers.length;
        width: root.width / root.layers.length;
        // a dark tab curves into the box where it meets the open one: the box's
        // color in that corner, under the tab's rounded corner
        if !t.open && (root.layer == i + 1 || root.layer == i - 1): Rectangle {
            x: root.layer == i + 1 ? parent.width - 10px : 0;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            background: Ink.box;
        }
        Rectangle {
            border-top-left-radius: t.first ? 12px : t.open ? 10px : 0;
            border-top-right-radius: t.last ? 12px : t.open ? 10px : 0;
            border-bottom-left-radius: !t.open && root.layer == i - 1 ? 10px : 0;
            border-bottom-right-radius: !t.open && root.layer == i + 1 ? 10px : 0;
            background: t.open ? Ink.box : root.shut;
        }
        // the layer's key, a small cap
        Rectangle {
            x: 16px;
            y: (parent.height - 24px) / 2;
            width: 30px;
            height: 24px;
            border-radius: 5px;
            background: t.open ? Ink.well : Ink.box;
            border-width: 1px;
            border-color: t.open ? #5a5a62 : #3a3a41;
            if l.cap != "": Text {
                text: l.cap;
                font-family: "Geist";
                font-size: 10.5px;
                font-weight: 600;
                color: root.layer == i || tab.has-hover ? Ink.bright : Ink.soft;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if l.cap == "": Rectangle {
                x: (parent.width - 12px) / 2;
                y: 15px;
                width: 12px;
                height: 2px;
                border-radius: 1px;
                background: #6a6a72;
            }
        }
        Text {
            x: 56px;
            width: parent.width - self.x - 12px;
            height: parent.height;
            text: l.name;
            overflow: elide;
            font-family: "Geist";
            // (the size and weight of the boxes' titles)
            font-size: 13.5px;
            font-weight: 600;
            color: t.open ? Ink.ink : tab.has-hover ? Ink.dim : Ink.quiet;
            vertical-alignment: center;
        }
        // the open tab is already chosen: only the others answer the pointer
        tab := TouchArea {
            enabled: !t.open;
            mouse-cursor: t.open ? MouseCursor.default : MouseCursor.pointer;
            clicked => {
                root.shut-hover = false;
                root.chosen(i);
            }
            changed has-hover => { root.shut-hover = self.has-hover && !t.open; }
        }
    }
}

// A box under the keyboard that holds more than its height: the box itself,
// rounded, and what it holds (`need` tall) scrolling inside it, with the Key
// library's scrollbar at its edge when there is more than shows.
component ScrollBox inherits Rectangle {
    in property <length> need;
    in property <brush> fill: Ink.box;
    background: root.fill;
    border-radius: 12px;
    clip: true;
    sb-flick := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-height: max(root.need, root.height);
        mouse-drag-pan-enabled: false;
        @children
    }
    ScrollBar {
        x: parent.width - 12px;
        y: 8px;
        height: parent.height - 16px;
        view: sb-flick.height;
        content: sb-flick.viewport-height;
        offset: -sb-flick.viewport-y;
        framed: false;
        thumb-color: #4a4a52;
        scroll-to(o) => { sb-flick.viewport-y = -o; }
    }
}

// The Key library: a find box, then the groups, each closing to its heading,
// a key lit while chosen; its jobs show only where a key is rebound.
component KeyLibrary inherits PageBox {
    in property <[LibGroup]> groups;
    // a key or slider newly chosen: how far down the list its row is; each new one scrolls to it
    in property <length> reveal-y;
    in property <int> reveal-n;
    changed reveal-n => {
        lib-flick.viewport-y = -max(0, min(root.reveal-y - 40px, lib-flick.viewport-height - lib-flick.height));
    }
    in-out property <string> query;
    callback toggle(string);
    callback find(string);
    callback pick(int);
    // the layer shown, as tabs at the box's top (the keyboard's two, or the device's own)
    in property <int> layer;
    in property <[LayerTab]> layers: [{ name: "Base", cap: "" }, { name: "Function", cap: "Fn" }];
    callback layer-chosen(int);
    // what the find box asks for, in the device's own words
    in property <string> placeholder: "Find a key or what it does";
    property <length> top: 50px;
    LayerSwitch {
        x: 0;
        y: 0;
        width: parent.width;
        layer: root.layer;
        layers: root.layers;
        chosen(i) => { root.layer-chosen(i); }
    }
    // find a key, or what it does, under the tabs
    Rectangle {
        x: 16px;
        y: root.top + 16px;
        width: parent.width - 32px;
        height: 34px;
        border-radius: 8px;
        background: find-in.has-focus ? Ink.hover-well : Ink.well;
        if find-in.text == "": Text {
            x: 12px;
            height: parent.height;
            text: root.placeholder;
            font-family: "Geist";
            font-size: 13px;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        find-in := TextInput {
            changed has-focus => { Typing.on = self.has-focus; }
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text <=> root.query;
            font-family: "Geist";
            font-size: 13px;
            color: Ink.bright;
            single-line: true;
            vertical-alignment: center;
            edited => { root.find(self.text); }
        }
    }
    lib-flick := Flickable {
        x: 8px;
        y: root.top + 60px;
        width: parent.width - 16px;
        height: parent.height - root.top - 60px - 10px;
        mouse-drag-pan-enabled: false;
        VerticalLayout {
            alignment: start;
            for g in root.groups: VerticalLayout {
                // the group's heading: it opens and closes the group
                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: head-ta.has-hover ? Ink.hover-box : transparent;
                    Path {
                        x: 6px;
                        y: 9px;
                        width: 12px;
                        height: 12px;
                        viewbox-width: 12;
                        viewbox-height: 12;
                        commands: g.open ? "M3 4.5l3 3 3-3" : "M4.5 3l3 3-3 3";
                        fill: transparent;
                        stroke: Ink.quiet;
                        stroke-width: 1.6px;
                    }
                    Text {
                        x: 24px;
                        height: parent.height;
                        text: g.name;
                        font-family: "Geist";
                        font-size: 12px;
                        font-weight: 500;
                        color: head-ta.has-hover ? Ink.bright : Ink.soft;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        x: parent.width - self.preferred-width - 8px;
                        width: self.preferred-width;
                        spacing: 10px;
                        if g.rebound > 0: Text {
                            text: g.rebound + " rebound";
                            font-family: "Geist";
                            font-size: 11.5px;
                            color: Ink.warn;
                            vertical-alignment: center;
                        }
                        Text {
                            text: g.count;
                            font-family: "Geist";
                            font-size: 11.5px;
                            color: Ink.quiet;
                            vertical-alignment: center;
                        }
                    }
                    head-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle(g.name); }
                    }
                }
                // its keys, set in under the group's name
                if g.open: VerticalLayout {
                    padding-left: 18px;
                    for r in g.rows: Rectangle {
                        height: 34px;
                        border-radius: 7px;
                        background: r.chosen ? (row-ta.has-hover ? Ink.pick-hover : Ink.pick) : row-ta.has-hover ? Ink.hover-box : transparent;
                        SmallCap {
                            x: 6px;
                            y: 4px;
                            text: r.cap;
                            size: r.cap.character-count > 3 ? 9.5px : 11px;
                        }
                        Text {
                            x: 50px;
                            width: parent.width - 50px - 150px;
                            height: parent.height;
                            text: r.name;
                            font-family: "Geist";
                            font-size: 13px;
                            color: r.chosen ? Ink.bright : Ink.dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 150px;
                            width: 142px;
                            height: parent.height;
                            text: r.job;
                            font-family: "Geist";
                            font-size: 12.5px;
                            color: r.rebound ? Ink.warn : Ink.quiet;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick(r.id); }
                        }
                    }
                }
            }
        }
    }
    // its scrollbar, at the box's right edge beside the list
    ScrollBar {
        x: parent.width - 12px;
        y: lib-flick.y;
        height: lib-flick.height;
        view: lib-flick.height;
        content: lib-flick.viewport-height;
        offset: -lib-flick.viewport-y;
        framed: false;
        thumb-color: #4a4a52;
        scroll-to(o) => { lib-flick.viewport-y = -o; }
    }
}

// a checkbox: a well with a tick when on, its words beside it
// a line to type into on a form, its words until something is typed (in the typeface whose
// letters are all one width, for a command)
component FieldBox inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> mono;
    callback edited();
    callback accepted();
    callback escape();
    height: 36px;
    border-radius: 8px;
    background: Ink.well;
    clip: true;
    if field-in.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-family: "Geist";
        font-size: 13px;
        color: #8a8a92;
        vertical-alignment: center;
        overflow: elide;
    }
    field-in := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        font-family: root.mono ? "JetBrains Mono" : "Geist";
        font-size: root.mono ? 12px : 13px;
        color: Ink.ink;
        vertical-alignment: center;
        single-line: true;
        changed has-focus => { Typing.on = self.has-focus; }
        edited => { root.edited(); }
        accepted => { root.accepted(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.escape();
                return accept;
            }
            reject
        }
    }
}

component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 26px;
    Rectangle {
        x: 0;
        y: (parent.height - 17px) / 2;
        width: 17px;
        height: 17px;
        border-radius: 5px;
        background: root.on ? (ta.has-hover ? Ink.bright : Ink.dim) : ta.has-hover ? Ink.hover-box : Ink.well;
        border-width: root.on ? 0 : 1px;
        border-color: #4a4a52;
        if root.on: Path {
            width: 17px;
            height: 17px;
            viewbox-width: 18;
            viewbox-height: 18;
            commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
            fill: transparent;
            stroke: Ink.base;
            stroke-width: 2px;
        }
    }
    Text {
        x: 27px;
        width: parent.width - 27px;
        height: parent.height;
        text: root.text;
        font-family: "Geist";
        font-size: 13px;
        color: Ink.dim;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Game mode: what G/PC turns on, and the keys it blocks, two columns
component GameBox inherits PageBox {
    in property <[CheckItem]> items;
    callback toggled(int);
    title: "Game mode";
    Text {
        x: 16px;
        y: 46px;
        width: parent.width - 32px;
        text: "The G/PC button turns game mode on and off. These keys do nothing while it's on:";
        font-family: "Geist";
        font-size: 12.5px;
        color: Ink.quiet;
        wrap: word-wrap;
    }
    for c[i] in root.items: CheckBox {
        x: 16px + mod(i, 2) * (parent.width - 32px) / 2;
        y: 92px + floor(i / 2) * 30px;
        width: (parent.width - 32px) / 2 - 8px;
        text: c.name;
        on: c.on;
        clicked => { root.toggled(i); }
    }
}

// the Library's star, outlined, or filled for a favorite, on a 16-unit square
global Star {
    out property <string> path: "M8 1.9l1.8 3.8 4.1.5-3 2.9.8 4.1L8 11.2l-3.7 2 .8-4.1-3-2.9 4.1-.5Z";
}

// a game's cover in the Library: its picture, corners rounded, on a shadow;
// lifted a little under the pointer, with a hairline round it; its name under
// it in two lines at most; and under the pointer a star over its corner, to
// make it a favorite or not
component LibCoverView inherits Rectangle {
    in property <LibCover> c;
    callback open();
    callback star();
    x: root.c.x;
    y: root.c.y;
    width: root.c.w;
    height: root.c.h + 9px + 34px;
    property <bool> hot: ta.has-hover || star-ta.has-hover;
    card := Rectangle {
        y: ta.pressed ? -1px : root.hot ? -3px : 0;
        animate y { duration: 140ms; }
        width: root.c.w;
        height: root.c.h;
        border-radius: 8px;
        background: Ink.box;
        drop-shadow-blur: root.hot ? 30px : 18px;
        drop-shadow-offset-y: root.hot ? 14px : 6px;
        drop-shadow-color: root.hot ? #000000aa : #00000066;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.c.pic;
        }
        Rectangle {
            border-radius: 8px;
            border-width: root.hot ? 1px : 0;
            border-color: #ffffff26;
        }
    }
    Text {
        x: 0;
        y: root.c.h + 9px;
        width: root.c.w;
        height: 34px;
        text: root.c.name;
        font-family: "Geist";
        font-size: 13px;
        color: root.hot ? Ink.ink : Ink.dim;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    Rectangle {
        x: root.c.w - 7px - 30px;
        y: card.y + 7px;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: star-ta.has-hover ? #2a2a30f2 : #111114d9;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: 120ms; }
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: Star.path;
            fill: root.c.fav ? Ink.ink : transparent;
            stroke: Ink.ink;
            stroke-width: 1.3px;
        }
        star-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.star(); }
        }
    }
}

// a square button with the star, for a game's page: filled once it's a favorite
component StarButton inherits Rectangle {
    in property <bool> on;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: ta.has-hover ? Ink.shade2 : Ink.shade1;
    Path {
        y: (parent.height - 14px) / 2 + (ta.pressed ? 1px : 0);
        width: 14px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: Star.path;
        fill: root.on ? Ink.ink : transparent;
        stroke: Ink.ink;
        stroke-width: 1.3px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// one page of the playlist, as a card: its words on the left, the screen's
// picture of it on the right in a bay of the screen's own color; the page on
// the screen now marked by the active profile's bar, half the card's height
component PlCard inherits Rectangle {
    in property <PlPage> p;
    in property <bool> hovered;
    border-radius: 10px;
    background: root.hovered ? Ink.hover-well : Ink.well;
    animate background { duration: 120ms; }
    // the picture first, two pixels to a dot, in a bay: a 6px gutter of the screen's own background, rounded
    Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 260px + 12px;
        height: 52px + 12px;
        border-radius: 7px;
        background: root.p.field;
        Image {
            x: 6px;
            y: 6px;
            width: 260px;
            height: 52px;
            source: root.p.pic;
        }
    }
    // then its name, and at most two lines on what it shows (fitted by the page), the three
    // in the card's middle; room kept at the card's right for Edit, which the pointer shows there
    property <int> lines: root.p.line2 != "" ? 2 : root.p.line1 != "" ? 1 : 0;
    property <length> words-w: root.width - 358px;
    property <length> words-y: (root.height - 20px - (root.lines > 0 ? 2px + root.lines * 17px : 0)) / 2;
    Text {
        x: 300px;
        y: root.words-y;
        width: root.words-w;
        height: 20px;
        text: root.p.name;
        font-family: "Geist";
        font-size: 13.5px;
        font-weight: 600;
        color: Ink.bright;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.p.line1 != "": Text {
        x: 300px;
        y: root.words-y + 22px;
        width: root.words-w;
        height: 17px;
        text: root.p.line1;
        font-family: "Geist";
        font-size: 12.5px;
        color: Ink.soft;
        vertical-alignment: center;
    }
    if root.p.line2 != "": Text {
        x: 300px;
        y: root.words-y + 39px;
        width: root.words-w;
        height: 17px;
        text: root.p.line2;
        font-family: "Geist";
        font-size: 12.5px;
        color: Ink.soft;
        vertical-alignment: center;
    }
}

// how a turn comes in, as its way bar on the strip shows it: a column sweeping
// across what is already there, cells changing, a letter with the cursor
// after it, a plain edge
component WayGlyph inherits Rectangle {
    in property <int> way;
    in property <color> ink;
    width: 12px;
    height: 12px;
    if root.way == 0: Rectangle {
        x: 0;
        y: 0;
        width: 12px;
        height: 12px;
        Rectangle {
            x: 1px;
            y: 1.5px;
            width: 10px;
            height: 9px;
            border-radius: 1.6px;
            border-width: 1.2px;
            border-color: root.ink;
        }
        Rectangle {
            x: 1.6px;
            y: 2.1px;
            width: 4.2px;
            height: 7.8px;
            border-radius: 0.6px;
            background: root.ink;
            opacity: 0.45;
        }
        Rectangle {
            x: 5.7px;
            y: 2.2px;
            width: 1.4px;
            height: 7.6px;
            background: root.ink;
        }
    }
    if root.way == 1: Rectangle {
        x: 0;
        y: 0;
        width: 12px;
        height: 12px;
        Rectangle { x: 1px; y: 1px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; }
        Rectangle { x: 6.6px; y: 6.6px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; }
        Rectangle { x: 6.6px; y: 1px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; opacity: 0.35; }
        Rectangle { x: 1px; y: 6.6px; width: 4.4px; height: 4.4px; border-radius: 0.8px; background: root.ink; opacity: 0.35; }
    }
    if root.way == 2: Path {
        x: 0;
        y: 0;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M1.5 2h6M4.5 2v7.5M8.5 10h2.5";
        fill: transparent;
        stroke: root.ink;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }
    if root.way == 3: Rectangle {
        x: 5.2px;
        y: 1px;
        width: 1.6px;
        height: 10px;
        border-radius: 0.8px;
        background: root.ink;
    }
}

// Edit or Remove among a turn's time and buttons: a small line glyph on their dark backing
component StripIcon inherits Rectangle {
    in property <string> commands;
    callback clicked;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: ta.pressed ? Ink.pick : ta.has-hover ? Ink.hover-box : transparent;
    Path {
        x: 4px;
        y: 4px;
        width: 12px;
        height: 12px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: ta.has-hover ? Ink.bright : Ink.soft;
        stroke-width: 1.8px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Pause, at the head of the playlist's panel; Play while the playlist is paused
component PlayButton inherits Rectangle {
    in property <bool> paused;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: ta.pressed ? Ink.pick-hover : ta.has-hover ? Ink.pick : Ink.hover-box;
    Path {
        x: 8px;
        y: 8px;
        width: 12px;
        height: 12px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.paused ? "M8 5.5v13a1 1 0 0 0 1.5.9l10-6.5a1 1 0 0 0 0-1.7l-10-6.6A1 1 0 0 0 8 5.5z"
            : "M7 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM15 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z";
        fill: Ink.bright;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// a segmented switch on a well: the chosen part a step lighter
component SegSwitch inherits Rectangle {
    in property <[string]> options;
    in property <[string]> icons;
    in property <int> chosen;
    in property <bool> tall;
    callback picked(int, length, length, length);
    height: root.tall ? 50px : 34px;
    border-radius: 9px;
    background: Ink.well;
    for o[i] in root.options: Rectangle {
        x: 3px + i * (parent.width - 6px) / root.options.length;
        y: 3px;
        width: (parent.width - 6px) / root.options.length - (i < root.options.length - 1 ? 2px : 0);
        height: parent.height - 6px;
        border-radius: 6px;
        background: root.chosen == i ? (seg-ta.has-hover ? Ink.pick-hover : Ink.pick) : seg-ta.has-hover ? Ink.hover-well : transparent;
        if root.tall && root.icons.length > i: Path {
            x: (parent.width - 15px) / 2;
            y: 7px;
            width: 15px;
            height: 15px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icons[i];
            fill: transparent;
            stroke: root.chosen == i || seg-ta.has-hover ? Ink.bright : Ink.soft;
            stroke-width: 1.7px;
        }
        Text {
            y: root.tall ? 25px : 0;
            width: parent.width;
            height: root.tall ? 16px : parent.height;
            text: o;
            font-family: "Geist";
            font-size: root.tall ? 11px : 12.5px;
            color: root.chosen == i || seg-ta.has-hover ? Ink.bright : Ink.soft;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        seg-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(i, self.absolute-position.x, self.absolute-position.y, self.height); }
        }
    }
}

// a dropdown on a well: what is chosen, and a chevron
component DropField inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    callback clicked(length, length, length);
    height: 36px;
    border-radius: 8px;
    background: ta.has-hover || root.open ? Ink.hover-box : Ink.well;
    Text {
        x: 12px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.text;
        font-family: "Geist";
        font-size: 13px;
        color: Ink.bright;
        vertical-alignment: center;
        overflow: elide;
    }
    Path {
        x: parent.width - 24px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M3 4.5l3 3 3-3";
        fill: transparent;
        stroke: Ink.quiet;
        stroke-width: 1.6px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}

// The chosen key: what it is and its factory job, then the job it does on
// the layer shown: a kind (Key, Media, Mouse, Macro, Profile, Keyboard,
// Nothing), the job itself, or Record to take the next key pressed.
component KeyDetail inherits PageBox {
    // the kinds of job, and their glyphs on the switch's 24 grid (the keyboard's, unless a device has its own)
    in property <[string]> kinds: ["Key", "Media", "Mouse", "Macro", "Profile", "Screen", "Keyboard", "Nothing"];
    // (Screen's is the Screen Editor button's glyph, drawn on this switch's 24 grid)
    in property <[string]> kind-icons: ["M4 5h16v14H4zM9 10h6M12 10v5", "M5 6l8 6-8 6zM15 6v12M19 6v12", "M7 3.5h10v17H7zM12 7v3", "M4 7h10M4 12h16M4 17h7", "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z", "M3.9 5.1h16.2a2.4 2.4 0 0 1 2.4 2.4v9a2.4 2.4 0 0 1-2.4 2.4H3.9A2.4 2.4 0 0 1 1.5 16.5V7.5a2.4 2.4 0 0 1 2.4-2.4zM6 9.3h12M6 12h9M6 14.7h10.5", "M3 7h18v10H3zM7 11h1M11 11h1M15 11h1M8 14h8", "M4 12a8 8 0 1 0 16 0a8 8 0 1 0-16 0M6.5 17.5l11-11"];
    // whether a job can be taken from a key pressed, and whether the box closes
    in property <bool> recordable: true;
    in property <bool> closable: true;
    in property <string> cap;
    in property <string> factory;
    in property <string> state;
    in property <bool> rebound;
    in property <bool> layer-rebound;
    in property <string> layer-title;
    in property <int> kind;
    in property <string> job;
    in property <bool> listening;
    in property <bool> menu-open;
    // whether the open menu keeps a column for ticks (not when nothing in it is ticked)
    in property <bool> menu-marks: true;
    in property <string> note;
    callback done();
    callback reset();
    callback kind-picked(int, length, length, length);
    callback job-clicked(length, length, length);
    callback record();
    if root.closable: BoxLink {
        x: parent.width - self.width - 10px;
        y: 12px;
        text: "Done";
        clicked => { root.done(); }
    }
    SmallCap {
        x: 16px;
        y: 50px;
        width: 54px;
        height: 48px;
        text: root.cap;
        size: root.cap.character-count > 3 ? 11px : 15px;
    }
    VerticalLayout {
        x: 84px;
        y: 50px;
        width: parent.width - 84px - 150px;
        height: 48px;
        alignment: center;
        spacing: 3px;
        Text {
            text: root.factory;
            font-family: "Geist";
            font-size: 12.5px;
            color: Ink.soft;
            overflow: elide;
        }
        Text {
            text: root.state;
            font-family: "Geist";
            font-size: 12.5px;
            color: Ink.quiet;
            overflow: elide;
        }
    }
    WordButton {
        x: parent.width - self.width - 16px;
        y: 58px;
        text: "Back to factory";
        enabled: root.rebound;
        fill: Ink.hover-box;
        fill-hover: Ink.pick;
        clicked => { root.reset(); }
    }
    Text {
        x: 16px;
        y: 116px;
        height: 24px;
        text: root.layer-title;
        font-family: "Geist";
        font-size: 12.5px;
        font-weight: 600;
        color: Ink.dim;
        vertical-alignment: center;
    }
    if root.layer-rebound: Rectangle {
        x: parent.width - self.width - 16px;
        y: 118px;
        width: pill.preferred-width + 16px;
        height: 20px;
        border-radius: 10px;
        background: #f0b35a22;
        pill := Text {
            x: 8px;
            height: parent.height;
            text: "Rebound";
            font-family: "Geist";
            font-size: 11px;
            color: Ink.warn;
            vertical-alignment: center;
        }
    }
    SegSwitch {
        x: 16px;
        y: 148px;
        width: parent.width - 32px;
        tall: true;
        options: root.kinds;
        icons: root.kind-icons;
        chosen: root.kind;
        picked(i, x, y, h) => { root.kind-picked(i, x, y, h); }
    }
    DropField {
        x: 16px;
        y: 208px;
        width: parent.width - 32px - (root.recordable ? 104px : 0);
        text: root.job;
        open: root.menu-open;
        clicked(x, y, h) => { root.job-clicked(x, y, h); }
    }
    // Record: takes the next key pressed on the Z10
    if root.recordable: Rectangle {
        x: parent.width - 16px - 96px;
        y: 208px;
        width: 96px;
        height: 36px;
        border-radius: 8px;
        background: root.listening ? #f0b35a1a : rec-ta.has-hover ? Ink.hover-box : transparent;
        border-width: 1px;
        border-color: root.listening ? Ink.warn : rec-ta.has-hover ? #6a6a72 : #45454c;
        HorizontalLayout {
            alignment: center;
            spacing: 7px;
            Rectangle {
                width: 7px;
                Rectangle {
                    y: (parent.height - 7px) / 2;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.listening ? Ink.warn : #e05a4f;
                    opacity: root.listening ? 0.4 + 0.6 * abs(cos(animation-tick() / 1000ms * 180deg)) : 1;
                }
            }
            Text {
                text: root.listening ? "Press a key…" : "Record";
                font-family: "Geist";
                font-size: 12.5px;
                color: root.listening ? Ink.warn : rec-ta.has-hover ? Ink.bright : Ink.soft;
                vertical-alignment: center;
            }
        }
        rec-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.record(); }
        }
    }
    if root.note != "": Text {
        x: 16px;
        y: 254px;
        width: parent.width - 32px;
        text: root.note;
        font-family: "Geist";
        font-size: 12px;
        color: Ink.quiet;
        wrap: word-wrap;
    }
}

// A slider chosen in the Key library: where it sits now, and what it controls.
// a button on the device's bar: its glyph, drawn in lines, and its name if it has one
component BarButton inherits Rectangle {
    in property <string> text;
    in property <string> commands;
    // the lines' ends and corners rounded
    in property <bool> round;
    callback clicked;
    // a whole number of pixels wide, so its glyph's lines land on the pixel grid
    width: ceil(row.preferred-width / 1px) * 1px;
    Rectangle {
        x: 0;
        y: (parent.height - 30px) / 2;
        width: parent.width;
        height: 30px;
        border-radius: 8px;
        background: ta.has-hover ? Ink.shade2 : Ink.shade1;
        // (with no name, a square round its glyph)
        row := HorizontalLayout {
            padding-left: root.text == "" ? 8px : 12px;
            padding-right: root.text == "" ? 8px : 12px;
            spacing: 7px;
            alignment: start;
            Path {
                width: 14px;
                height: 14px;
                y: (30px - 14px) / 2;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: root.commands;
                fill: transparent;
                stroke: Ink.ink;
                stroke-width: 1.14px;
                stroke-line-cap: root.round ? LineCap.round : LineCap.butt;
            }
            if root.text != "": Text {
                text: root.text;
                font-family: "Geist";
                font-size: 13px;
                font-weight: 500;
                color: Ink.ink;
                vertical-alignment: center;
            }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

component SliderDetail inherits PageBox {
    in property <string> side;
    in property <float> at;
    // what the firmware can't do yet with the job chosen, if anything
    in property <string> note;
    in property <[CheckItem]> choices;
    callback done();
    callback picked(int);
    BoxLink {
        x: parent.width - self.width - 10px;
        y: 12px;
        text: "Done";
        clicked => { root.done(); }
    }
    Text {
        x: 16px;
        y: 46px;
        text: "Where the " + root.side + " slider on the keyboard sits now";
        font-family: "Geist";
        font-size: 12.5px;
        color: Ink.quiet;
    }
    // a reading, not a control: a thin bar filled to where the slider is, and how far that is
    Rectangle {
        x: 16px;
        y: 81px;
        width: parent.width - 32px - 56px;
        height: 6px;
        border-radius: 3px;
        background: Ink.well;
        clip: true;
        Rectangle {
            x: 0;
            width: root.at * parent.width;
            border-radius: 3px;
            background: Ink.soft;
            animate width { duration: 120ms; easing: ease-out; }
        }
    }
    Text {
        x: parent.width - 16px - 46px;
        y: 76px;
        width: 46px;
        height: 16px;
        text: round(root.at * 100) + "%";
        font-family: "Geist";
        font-size: 12.5px;
        font-weight: 500;
        color: Ink.dim;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        x: 16px;
        y: 112px;
        text: "Controls";
        font-family: "Geist";
        font-size: 12.5px;
        font-weight: 600;
        color: Ink.dim;
    }
    for c[i] in root.choices: Rectangle {
        x: 12px;
        y: 138px + i * 36px;
        width: parent.width - 24px;
        height: 34px;
        border-radius: 8px;
        background: c.on ? (opt-ta.has-hover ? Ink.pick-hover : Ink.pick) : opt-ta.has-hover ? Ink.hover-box : transparent;
        Rectangle {
            x: 10px;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: c.on ? 4px : 1.5px;
            border-color: c.on ? Ink.bright : #6a6a72;
        }
        Text {
            x: 34px;
            height: parent.height;
            text: c.name;
            font-family: "Geist";
            font-size: 13px;
            color: c.on ? Ink.bright : Ink.dim;
            vertical-alignment: center;
        }
        opt-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(i); }
        }
    }
    Text {
        x: 16px;
        y: 138px + root.choices.length * 36px + 8px;
        width: parent.width - 32px;
        text: root.note == "" ? "The same on every profile, while Ectomatter is open." : "The same on every profile, while Ectomatter is open. " + root.note;
        font-family: "Geist";
        font-size: 12px;
        color: Ink.quiet;
        wrap: word-wrap;
    }
}

// a row of the anchoring column's lists: a profile or a layer. At rest the
// well shows through; under the pointer a step lighter; chosen lighter still,
// and lighter again under the pointer.
component AnchorRow inherits Rectangle {
    in property <bool> chosen;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    height: 48px;
    border-radius: 8px;
    background: root.chosen ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover ? Ink.hover-well : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

// a small capitals heading over one of the column's lists
component AnchorHead inherits Text {
    height: 30px;
    font-family: "Geist";
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.9px;
    color: Ink.quiet;
    vertical-alignment: center;
}

// The anchoring column under the keyboard: the profiles (the one the Z10 is
// running marked by a white bar at its edge, the one being edited lit). The
// layers are a switch over the Key library; Save and Discard are in the device's bar. Choices go top to bottom: a profile, then a layer, then a key.
// For a device whose profiles Ectomatter keeps, as many as you want (`kept`),
// the one in use has a menu beside its pencil and a last row makes a new one.
component AnchorColumn inherits VerticalLayout {
    in property <[ProfileItem]> profiles;
    in property <bool> kept;
    // the menu on the profile being edited, as profiles Ectomatter keeps have, for a
    // device that keeps its own (no New profile row for it)
    in property <bool> has-menu: false;
    callback choose(int);
    callback rename(string);
    callback add();
    callback menu(length, length, length);
    in-out property <bool> renaming;
    spacing: 12px;
    alignment: start;

    // the profiles
    Rectangle {
        background: Ink.well;
        border-radius: 12px;
        height: plist.preferred-height;
        plist := VerticalLayout {
            padding: 8px;
            padding-top: 4px;
            spacing: 2px;
            AnchorHead {
                x: 6px;
                text: "PROFILES";
            }
            for p in root.profiles: AnchorRow {
                chosen: p.current;
                clicked => { root.renaming = false; root.choose(p.n); }
                // the profile the Z10 is running: a white bar at its edge
                Rectangle {
                    x: 8px;
                    y: (parent.height - 28px) / 2;
                    width: 4px;
                    height: 28px;
                    border-radius: 2px;
                    background: p.active ? Ink.bright : transparent;
                }
                if !(p.current && root.renaming): VerticalLayout {
                    x: 20px;
                    width: parent.width - 20px - ((root.kept || root.has-menu) && p.current ? 62px : 34px);
                    alignment: center;
                    Text {
                        text: p.name;
                        font-family: "Geist";
                        font-size: 13px;
                        font-weight: 500;
                        color: p.current ? Ink.bright : Ink.dim;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: p.sub;
                            font-family: "Geist";
                            font-size: 11.5px;
                            color: Ink.quiet;
                        }
                        if p.unsaved > 0: Text {
                            text: "·  " + p.unsaved + " unsaved";
                            font-family: "Geist";
                            font-size: 11.5px;
                            color: Ink.warn;
                        }
                    }
                }
                // the profile being edited, renamed in place
                if p.current && root.renaming: Rectangle {
                    x: 16px;
                    y: 8px;
                    width: parent.width - 24px;
                    height: 32px;
                    border-radius: 7px;
                    background: Ink.box;
                    border-width: 1px;
                    border-color: Ink.warn;
                    // (a click on the box, off the words and the tick, stays in it
                    // rather than reaching the row under it, which would drop the name)
                    TouchArea {
                        mouse-cursor: text;
                        clicked => { name-in.focus(); }
                    }
                    name-in := TextInput {
                        changed has-focus => { Typing.on = self.has-focus; }
                        x: 9px;
                        width: parent.width - 9px - 32px;
                        height: parent.height;
                        text: p.name;
                        font-family: "Geist";
                        font-size: 13px;
                        color: Ink.bright;
                        selection-background-color: #f0b35a55;
                        vertical-alignment: center;
                        single-line: true;
                        init => { self.focus(); self.select-all(); }
                        accepted => { root.rename(self.text); root.renaming = false; }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) { root.renaming = false; return accept; }
                            return reject;
                        }
                    }
                    // a tick at the box's end, which keeps the name as Enter does
                    Rectangle {
                        x: parent.width - 4px - 24px;
                        y: (parent.height - 24px) / 2;
                        width: 24px;
                        height: 24px;
                        border-radius: 5px;
                        background: ok-ta.pressed ? Ink.pick : ok-ta.has-hover ? Ink.hover-box : transparent;
                        Path {
                            x: 3px;
                            y: 3px;
                            width: 18px;
                            height: 18px;
                            viewbox-width: 18;
                            viewbox-height: 18;
                            commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                            fill: transparent;
                            stroke: ok-ta.has-hover ? Ink.bright : Ink.soft;
                            stroke-width: 1.8px;
                        }
                        ok-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.rename(name-in.text); root.renaming = false; }
                        }
                    }
                }
                // the pencil, on the profile being edited
                if p.current && !root.renaming: Rectangle {
                    x: parent.width - (root.kept || root.has-menu ? 60px : 32px);
                    y: (parent.height - 26px) / 2;
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: pen-ta.has-hover ? Ink.pick-hover : transparent;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 14px;
                        height: 14px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M4 20h4L19 9l-4-4L4 16z";
                        fill: transparent;
                        stroke: pen-ta.has-hover ? Ink.bright : Ink.quiet;
                        stroke-width: 1.8px;
                    }
                    pen-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.renaming = true; }
                    }
                }
                // and its menu: Duplicate, Use with an app, Delete
                if (root.kept || root.has-menu) && p.current && !root.renaming: Rectangle {
                    x: parent.width - 32px;
                    y: (parent.height - 26px) / 2;
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: dots-ta.has-hover ? Ink.pick-hover : transparent;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 14px;
                        height: 14px;
                        viewbox-width: 14;
                        viewbox-height: 14;
                        commands: "M1.7 7a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0zM5.7 7a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0zM9.7 7a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0z";
                        fill: dots-ta.has-hover ? Ink.bright : Ink.quiet;
                    }
                    dots-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.menu(self.absolute-position.x, self.absolute-position.y, self.height); }
                    }
                }
            }
            // a new profile, last
            if root.kept: new-row := AnchorRow {
                chosen: false;
                clicked => { root.renaming = false; root.add(); }
                HorizontalLayout {
                    x: 20px;
                    spacing: 8px;
                    alignment: start;
                    Path {
                        y: (parent.height - 12px) / 2;
                        width: 12px;
                        height: 12px;
                        viewbox-width: 12;
                        viewbox-height: 12;
                        commands: "M6 1.5v9M1.5 6h9";
                        stroke: new-row.hover ? Ink.bright : Ink.soft;
                        stroke-width: 1.8px;
                        fill: transparent;
                    }
                    Text {
                        text: "New profile";
                        font-family: "Geist";
                        font-size: 13px;
                        color: new-row.hover ? Ink.bright : Ink.soft;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The mouse's picture in its layers, as mouse_art draws them: the mouse over
// its shadow, the chosen button picked out and the one under the pointer a
// shade lighter, then each light's groups in its color of the moment (the
// drawing's order: what lies under the buttons, then what lies over them).
// Drawn for one size and shown `k` times it; its lights shown, or not.
component MouseLayers inherits Rectangle {
    in property <image> base;
    in property <float> k: 1;
    in property <bool> lit: true;
    // (false where the window draws the mouse itself, in HDR, under the page)
    in property <bool> drawn: true;
    in property <MousePatch> picked;
    in property <bool> picked-shown;
    in property <MousePatch> over;
    in property <bool> over-shown;
    in property <MousePatch> logo-under;
    in property <MousePatch> wheel-under;
    in property <MousePatch> logo;
    in property <MousePatch> wheel;
    in property <color> logo-tint;
    in property <color> wheel-tint;
    if root.drawn: Image {
        width: parent.width;
        height: parent.height;
        source: root.base;
    }
    if root.drawn && root.picked-shown: Image {
        x: root.picked.x * root.k;
        y: root.picked.y * root.k;
        width: root.picked.w * root.k;
        height: root.picked.h * root.k;
        source: root.picked.img;
    }
    if root.drawn && root.over-shown: Image {
        x: root.over.x * root.k;
        y: root.over.y * root.k;
        width: root.over.w * root.k;
        height: root.over.h * root.k;
        source: root.over.img;
        colorize: #ffffff14;
    }
    if root.drawn && root.lit: Image {
        x: root.logo-under.x * root.k;
        y: root.logo-under.y * root.k;
        width: root.logo-under.w * root.k;
        height: root.logo-under.h * root.k;
        source: root.logo-under.img;
        colorize: root.logo-tint;
    }
    if root.drawn && root.lit: Image {
        x: root.wheel-under.x * root.k;
        y: root.wheel-under.y * root.k;
        width: root.wheel-under.w * root.k;
        height: root.wheel-under.h * root.k;
        source: root.wheel-under.img;
        colorize: root.wheel-tint;
    }
    if root.drawn && root.lit: Image {
        x: root.logo.x * root.k;
        y: root.logo.y * root.k;
        width: root.logo.w * root.k;
        height: root.logo.h * root.k;
        source: root.logo.img;
        colorize: root.logo-tint;
    }
    if root.drawn && root.lit: Image {
        x: root.wheel.x * root.k;
        y: root.wheel.y * root.k;
        width: root.wheel.w * root.k;
        height: root.wheel.h * root.k;
        source: root.wheel.img;
        colorize: root.wheel-tint;
    }
    @children
}

// a grip on the chosen pad's edge or corner, which sizes the pad: the edges
// it moves (1 left, 2 top, 4 right, 8 bottom, two together at a corner), and
// where the pad is on the desk, for its presses to say where they are there
component PadGrip inherits TouchArea {
    in property <int> edges;
    in property <length> ox;
    in property <length> oy;
    callback grip(int, length, length);
    callback pan(length, length);
    callback drag(length, length);
    callback let-go();
    mouse-cursor: root.edges == 1 ? MouseCursor.w-resize : root.edges == 2 ? MouseCursor.n-resize : root.edges == 4 ? MouseCursor.e-resize : root.edges == 8 ? MouseCursor.s-resize
        : root.edges == 3 ? MouseCursor.nw-resize : root.edges == 6 ? MouseCursor.ne-resize : root.edges == 12 ? MouseCursor.se-resize : MouseCursor.sw-resize;
    pointer-event(e) => {
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            root.grip(root.edges, root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y);
        }
        if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
            root.pan(root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y);
        }
        if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
            root.let-go();
        }
    }
    moved => { root.drag(root.ox + self.x + self.mouse-x, root.oy + self.y + self.mouse-y); }
}

export component AppWindow inherits Window {
    in property <bool> is-maximized;
    in property <image> mark;
    in property <image> home-glyph;
    in property <image> keyboard-glyph;
    in property <image> keyboard-tile;
    // the mouse (SteelSeries' core): its glyphs, whether Ectomatter has met it, and
    // whether it is plugged in (1) or not (2)
    in property <image> mouse-glyph;
    in property <image> mouse-tile;
    in property <bool> mouse-known;
    // the devices in the rail, as they sit on Home's desk, left to right
    in property <[RailDevice]> rail-devices;
    in property <int> mouse-conn;
    in property <image> settings-glyph;
    // the lab's flask, and whether its window is open
    in property <bool> lab-open;
    in property <int> tab: 0;
    in-out property <string> place: "home";
    in-out property <bool> rail-open;

    // the Library (games_page.rs): its glyph in the rail; which shows (0 the
    // Library's tabs, 1 a game's or an app's page, Every game's among them) and
    // its tab (0 Favorites, 1 Games, 2 Apps); the words under the bar; what is
    // typed in its find box, and the store and sort dropdowns' words and widths
    in property <image> library-glyph;
    // each package's glyph (packages.rs's order): for a device's row in the Library, and Settings' tiles
    in property <[image]> package-glyphs;
    in property <[image]> package-tiles;
    in property <int> gl-view;
    in property <int> gl-tab;
    in property <string> gl-hint;
    in-out property <string> gl-query;
    in property <string> gl-find-hint;
    in property <string> gl-store;
    in property <length> gl-store-w: 120px;
    in property <string> gl-sort;
    in property <length> gl-sort-w: 150px;
    // the covers, the Apps tab's rows, and what shows where neither has any: its two lines
    in property <[LibCover]> gl-covers;
    in property <[LibApp]> gl-apps;
    in property <string> gl-empty;
    in property <string> gl-empty-sub;
    in property <length> gl-page-h;
    // a page of its own: its name in the bar, whether it's Every game's (no star, no Play), a
    // favorite, startable; its picture at the top with its facts; its sections, laid out by the window
    in property <string> gl-name;
    in property <bool> gl-every;
    in property <bool> gl-fav;
    in property <bool> gl-playable;
    in property <bool> gl-has-hero;
    in property <image> gl-hero;
    in property <[LibFact]> gl-facts;
    in property <length> gl-facts-w;
    in property <[Cell]> gl-cells;
    // a page's On this page, beside its sections where there's room: its entries, where it
    // sits (it stays in view as the page scrolls), and what it says under them; a jump to a
    // section, told by its count
    in property <[LibToc]> gl-toc;
    in property <length> gl-toc-x;
    in property <length> gl-toc-w;
    in property <length> gl-toc-top;
    in property <string> gl-toc-foot;
    in property <length> gl-jump-y;
    in property <int> gl-jump-n;
    callback gl-toc-jump(int);
    // (a jump from On this page: the section near the top, as far as the page goes)
    changed gl-jump-n => {
        gl-flick.viewport-y = -max(0, min(root.gl-jump-y, gl-flick.viewport-height - gl-flick.height));
    }
    // the form for a script (gl-modal 3): its words, what's typed into it, its choices
    in property <string> gl-script-title;
    in property <string> gl-script-sub;
    in property <string> gl-script-start-label;
    in property <string> gl-script-quit-label;
    in-out property <string> gl-script-name;
    in-out property <string> gl-script-start;
    in-out property <string> gl-script-quit;
    in property <bool> gl-script-wait;
    in property <bool> gl-script-keep;
    in property <string> gl-script-limit;
    in property <string> gl-script-wait-label;
    in property <string> gl-script-keep-label;
    in property <string> gl-script-warning;
    // the form for a variable in a plugin's section (gl-modal 5): its words, its name and
    // value as typed, and why it can't be added as it is
    in property <string> gl-var-title;
    in property <string> gl-var-sub;
    in-out property <string> gl-var-name;
    in-out property <string> gl-var-value;
    in property <bool> gl-var-editing;
    in property <string> gl-var-warning;
    callback gl-var-typed();
    callback gl-var-remove();
    // the form for adding a plugin (gl-modal 4): its GitHub address as typed, the file
    // chosen, what it is once found (its name and version, what it's for, what it can
    // do), and where the looking stands (in red where it went wrong)
    in property <string> gl-plugin-title;
    in property <string> gl-plugin-sub;
    in-out property <string> gl-plugin-address;
    in property <string> gl-plugin-file;
    in property <string> gl-plugin-found;
    in property <string> gl-plugin-found-sub;
    in property <string> gl-plugin-can;
    in property <string> gl-plugin-state;
    in property <bool> gl-plugin-bad;
    callback gl-plugin-choose-file();
    callback gl-plugin-typed();
    in property <string> gl-script-limit-note;
    in property <bool> gl-script-editing;
    callback gl-script-wait-toggle();
    callback gl-script-keep-toggle();
    callback gl-script-limit-menu(length, length, length);
    callback gl-script-remove();
    callback gl-script-typed();
    // what was last done or went wrong, at the bar's right for a moment
    in property <string> gl-said;
    in property <bool> gl-said-bad;
    // a page's game or app can be taken out of the Library (one added by hand, or an
    // app that's there for its ties); and Undo, just after
    in property <bool> gl-removable;
    in property <bool> gl-undo-shown;
    callback gl-remove();
    callback gl-undo();
    // the form open over the Library (0 none, 1 Add a game, 2 Add an app): the program
    // chosen (none yet: empty), the name typed, the apps to choose from and the one chosen
    in property <int> gl-modal;
    in property <string> gl-program;
    in-out property <string> gl-name-typed;
    in property <string> gl-name-hint;
    in property <[LibApp]> gl-seen;
    in property <int> gl-seen-chosen: -1;
    in property <bool> gl-can-add;
    out property <length> gl-width: content-w;
    out property <length> gl-scroll: -gl-flick.content-y;
    callback gl-tab-chosen(int);
    callback gl-find(string);
    callback gl-store-menu(length, length, length);
    callback gl-sort-menu(length, length, length);
    callback gl-open(int);
    callback gl-star(int);
    callback gl-every-page();
    callback gl-add();
    callback gl-back();
    callback gl-star-page();
    callback gl-play();
    callback gl-choose-program();
    callback gl-add-done();
    callback gl-modal-close();
    callback gl-seen-pick(int);

    // how the keyboard is: 0 being looked for, 1 connected, 2 not connected, 3 left to other programs
    in property <int> conn-state: 0;
    in property <string> conn-text: "Looking for the keyboard…";
    in property <string> conn-chip;
    // what was last done, in the device's bar: 0 said quietly, 1 went well, 2 went wrong
    in property <string> status-text;
    in property <int> status-kind;
    // while the keyboard is read: 1 reading, 2 it could not be reached, 3 control is off; 0 read
    in property <int> boot: 1;
    in property <string> boot-title: "Reading your keyboard";
    in property <string> boot-text: "Loading its profiles and macros. This takes a few seconds.";
    in property <[ProfileItem]> profiles;
    in property <[KeyItem]> keys;
    in property <float> units: 649;
    in property <float> units-high: 260;
    // what is drawn over the keyboard: the slider knobs, the display, its glass
    in property <[Overlay]> overlays;
    // the Lighting page: its effects, and its tile's pieces as the window lays them out
    in property <string> slider-note;
    // the Key library scrolled to a row newly chosen
    in property <length> lib-reveal-y;
    in property <int> lib-reveal-n;
    // Undo offered beside "Saved", for a moment after a change
    in property <bool> undo-shown;
    callback undo(bool);
    in property <[EffectItem]> effects;
    // the chosen effect's picture moves; what the boxes beside the effects hold (0 an effect's
    // settings, 1 the keys dark, 2 the brush), the first one's title, and their heights
    in property <bool> effect-moves;
    in property <int> light-kind;
    in property <string> light-title;
    // the title of the box of where and when the effect plays, from the keyboard's description
    in property <string> place-title;
    in property <length> set-h;
    in property <length> place-h;
    in property <[Cell]> place-cells;
    // the pointer over an area on the Lighting page: the keyboard dims around it
    in property <bool> dimming;
    callback area-hover(int, bool);
    in property <[Cell]> cells;
    in property <length> tile-height;
    in property <length> settings-h;
    out property <length> settings-scroll: set-flick.content-y;
    // Settings scrolled to a place on its page (its Sensor Feed box), as far as it scrolls
    in property <length> settings-goto: -1px;
    changed settings-goto => {
        if (root.settings-goto >= 0) {
            set-flick.content-y = -min(root.settings-goto, max(0px, root.settings-h - set-flick.height));
        }
    }
    // the keyboard is showing the page's preview
    in property <bool> live;
    // the Screen tab: the screen as it is now, drawn large and as the playlist's
    // picture of Stats; the launch sequence's picture beside its checkbox; what
    // is playing (0 playing, 1 paused, 2 another program has the screen, 3 the
    // keyboard's screen isn't there); whether launches break in; and which of
    // the screen's two states its box has open: the profile's playlist, which
    // Ectomatter plays, or (screen-closed) the onboard layout, which the keyboard
    // shows by itself, told to the page as it changes
    in property <image> lcd-big;
    // the device's shadow on its box, round the device (the part under it is
    // in the device's own picture), and how far past the device it reaches
    in property <image> board-shadow;
    in property <length> board-shadow-margin;
    in property <int> lcd-state;
    in-out property <bool> screen-closed: false;
    // the third tab open, Game launch: what the keyboard's screen shows as a game starts and
    // as one quits, a row each (see games_page.rs and lcd_player.rs)
    in-out property <bool> screen-game: false;
    in property <[GlRow]> gl-rows;
    callback gl-row-on(int);
    callback gl-row-pick(int);
    callback gl-row-until(int, length, length, length);
    // a layout carried over the rows: the row it's over (-1 neither), and its place in Layouts
    callback gl-carry-move(int, int);
    callback screen-state();
    // the second tab's row: whether the keyboard can keep an onboard layout (its
    // firmware build 5 on); the chooser's name and width, and its menu open; the
    // line beside it; a layout carried over the screen, which would land there
    in property <bool> ob-ready;
    in property <string> ob-name;
    in property <length> ob-chooser-w;
    in property <bool> ob-choosing;
    in property <string> ob-say;
    in property <bool> ob-over;
    callback ob-choose(length, length, length);
    callback lcd-pause();
    // the playlist's panel: the playlist's name, and the width its chooser
    // takes; the chooser's menu open; the name being changed in place, and
    // the name as typed so far; where the strip starts in the panel and how
    // wide it is, and how long each turn's way bar is (the page measures and
    // lays out all four)
    in property <string> pl-name;
    in property <length> pl-chooser-w: 80px;
    in property <bool> pl-choosing;
    in property <bool> pl-renaming;
    in-out property <string> pl-rename-text;
    in property <length> pl-track-x: 140px;
    in property <length> pl-track-w: 600px;
    in property <length> pl-way-w: 26px;
    property <length> pl-pre: root.pl-way-w + 1px;
    callback pl-choose(length, length, length);
    callback pl-rename-done(bool, string);
    // the strip: each turn; the room a carried screen will land in (no width,
    // none); turns following an edge being dragged at once; one turn only; a
    // script's screen showing, which the strip waits for, and what the strip
    // says about it
    in property <[PlBlock]> pl-blocks;
    in property <length> pl-slot-x;
    in property <length> pl-slot-w;
    in property <bool> pl-live;
    in property <bool> pl-single;
    // no turns at all: the screen shows blank until a layout is dragged in
    in property <bool> pl-empty;
    // the empty holding bar at the strip's end, for a layout to be dragged to (the whole
    // strip while the playlist is empty; no width while a carried layout's room shows instead)
    in property <length> pl-hold-x;
    in property <length> pl-hold-w;
    // select the holding bar for a menu of the layouts to add; that menu open
    callback pl-hold-menu(length, length, length);
    in property <bool> pl-adding;
    in property <bool> pl-dim;
    in property <string> pl-script;
    // the playhead: shown or not, on the way bar (the turn coming in) or the
    // screen's bar; where it stands while still, and while it moves, when on
    // animation-tick()'s clock its part of the turn began and how long it lasts
    in property <bool> pl-head;
    in property <bool> pl-in;
    in property <bool> pl-moving;
    in property <float> pl-p0;
    in property <duration> pl-t0;
    in property <duration> pl-len: 1ms;
    out property <duration> pl-tick: animation-tick();
    property <float> pl-p: root.pl-moving ? clamp((animation-tick() - root.pl-t0) / root.pl-len, 0, 1) : root.pl-p0;
    // the turn whose edge is being dragged, the turn whose mark has its menu open, and
    // the turn whose time has its menu open
    in-out property <int> pl-sizing: -1;
    in property <int> pl-menu: -1;
    in property <int> pl-timing: -1;
    // a screen carried to the strip, from the strip or the Library: where the
    // pointer holds it (in the Screen tab's right column), its name, and
    // whether it is settling into its room; and, for a layout carried along the
    // Library, the place it lands in there (-1 while it isn't over the Library)
    in-out property <bool> carry-on;
    in-out property <length> carry-x;
    in-out property <length> carry-y;
    in-out property <length> carry-gx;
    in-out property <length> carry-gy;
    in-out property <bool> carry-settle;
    in property <string> carry-name;
    in property <int> lib-gap: -1;
    callback pl-carry-start(int, int);
    // where along the strip it is, whether over the panel, and the Library's place under it
    callback pl-carry-move(length, bool, int);
    callback pl-carry-drop();
    callback pl-carry-cancel();
    callback pl-size(int, length);
    callback pl-size-done();
    callback pl-mark(int, length, length, length);
    // a turn's time selected: its menu of times, under the time (its place and size)
    callback pl-time(int, length, length, length, length);
    callback pl-back();
    // Layouts: every screen layout, its card, one opened in the layout
    // editor's window, a new one made there
    in property <[PlPage]> lib-pages;
    // a layout's card selected or right-clicked: its menu, where the pointer is
    callback lib-menu(int, length, length);
    // New screen layout selected: its menu, where the pointer is
    callback lib-new(length, length);
    // are you sure, before a layout is deleted, as the Macro Editor asks: the question,
    // what goes with the layout, and the button's words
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-do;
    // (the button that answers no: Cancel, or Keep before a sensor is unchecked)
    in property <string> confirm-keep: "Cancel";
    callback confirm-yes();
    callback confirm-no();
    // the playlist: a turn's layout opened in the layout editor, the turn
    // shown now, moved, taken off
    callback screen-edit(int);
    callback page-show(int);
    callback page-moved(int, int);
    callback page-remove(int);
    // what the screen is doing now, shown beside Pause
    in property <string> screen-status;
    // the chosen key, and its two layers
    in property <bool> key-open;
    // where the chosen key's editor is in the window, which a press on keeps the key chosen
    out property <length> key-tile-x: key-tile.absolute-position.x;
    out property <length> key-tile-y: key-tile.absolute-position.y;
    out property <length> key-tile-w: key-tile.width;
    out property <length> key-tile-h: key-tile.height;
    in property <string> key-name;
    in property <string> key-factory;
    in property <[LayerItem]> layers;
    in property <string> reset-label;
    // the open menu, and the button it hangs from
    in property <bool> menu-open;
    // whether the open menu keeps a column for ticks (not when nothing in it is ticked)
    in property <bool> menu-marks: true;
    in property <length> menu-ax;
    in property <length> menu-ay;
    in property <length> menu-ah;
    in property <length> menu-w: 300px;
    in property <[MenuRow]> menu-rows;
    in property <string> menu-placeholder;
    in property <bool> menu-back;
    in property <bool> menu-search: true;
    in-out property <string> menu-query;
    // where the menu hangs, fixed when it opens so it stays put while it is searched
    in property <length> menu-top;
    in property <length> menu-max;
    out property <length> menu-x: menu.x;
    out property <length> menu-y: menu.y;
    out property <length> menu-width: menu.width;
    out property <length> menu-height: menu.height;
    out property <length> window-height: root.height;
    out property <length> window-width: root.width;

    // where the mouse's picture goes on its page, and the stage that clips it,
    // in the window, for the window to draw the mouse there in HDR; and whether
    // it has, till when the stage's shade fills the hole
    out property <bool> mouse-hole-shown: root.place == "mouse" && root.mouse-tab < 2;
    out property <length> mouse-pic-wx: rail-w + pws-x + pws-w / 2 - 600px + 480px - root.mouse-pic-m;
    out property <length> mouse-pic-wy: bar + 56px + mouse-flick.content-y + head-end + 30px - root.mouse-pic-m;
    out property <length> mouse-stage-wx: rail-w + pws-x;
    out property <length> mouse-stage-wy: bar + 56px + mouse-flick.content-y + head-end;
    out property <length> mouse-stage-width: pws-w;
    in property <bool> mouse-hdr-ready;
    // where the keyboard goes, for the window to draw it there, when its page shows
    out property <bool> board-shown: root.place == "z10" && root.tab < 2;
    // the keyboard has been drawn: its knobs and display come with it, never before
    in property <bool> board-ready;
    in property <duration> knob-glide: 120ms;
    out property <length> board-x: rail-w + pws-x + kb-pad-x;
    out property <length> board-y: bar + 56px + flick.content-y + board-top;
    out property <length> board-width: board-w;
    out property <length> board-height: board-h;
    // the app's ground, which the window lays under the content
    out property <color> ground: Ink.base;
    out property <length> ground-x: rail-w;
    out property <length> ground-y: bar;
    out property <length> ground-radius: root.radius;
    // the hand, over what can be clicked
    // the rail's width, for the window to know when it has settled
    out property <length> rail-width: rail-w;

    callback minimize();
    callback maximize();
    callback close-window();
    callback drag();
    callback go(string);
    callback rail(string);
    // the mouse's page: its tab, the words over its picture, what went wrong
    in property <int> mouse-tab;
    in property <string> mouse-hint;
    in property <string> mouse-status;
    // the mouse's profiles, kept by Ectomatter: the list (once the mouse has been
    // met), the one in use's name open to change, what was last done to them,
    // and Undo for a moment after one is deleted
    in property <[ProfileItem]> mouse-profiles;
    in property <bool> mouse-profiles-shown;
    in-out property <bool> mouse-renaming;
    in property <string> mouse-said;
    in property <bool> mouse-undo-shown;
    callback mouse-profile-choose(int);
    callback mouse-profile-rename(string);
    callback mouse-profile-new();
    callback mouse-profile-menu(length, length, length);
    // the menu on the keyboard's profile being edited
    callback kb-profile-menu(length, length, length);
    // the desk's light on Home: what it plays (its short words; none while off), and its menu
    // Home's Scenes button: the scene on (none: "") and its chip; its menu opened
    in property <string> scene-name;
    in property <image> scene-chip;
    callback scene-menu(length, length, length);
    // a row's pencil in the open menu
    callback menu-edit(int);
    // the scene form, over the window: its title and words, whether it changes a scene
    // (Delete), the height of its pieces under its preview, the pieces, the preview, the
    // effect tiles (where they go, and whether they show), and its buttons and tiles
    in property <bool> scene-form;
    in property <string> scene-form-title;
    in property <string> scene-form-sub;
    in property <bool> scene-form-edit;
    in property <length> scene-form-h;
    in property <[Cell]> scene-cells;
    in property <image> scene-strip;
    in property <[EffectItem]> scene-tiles;
    in property <length> scene-tiles-y;
    in property <bool> scene-tiles-on;
    callback scene-tile(int);
    callback scene-form-close();
    callback scene-form-escape();
    callback scene-form-done();
    callback scene-form-delete();
    // each scene's chip (No scene's first), for the Library's Scene row; the scenes' glyph
    in property <[image]> scene-chips;
    in property <image> scene-glyph;
    // a scene's chip before the keyboard's and the mouse's Lighting hint, while the scene lights it
    in property <image> hint-chip;
    in property <bool> hint-chip-on;
    in property <image> mouse-hint-chip;
    in property <bool> mouse-hint-chip-on;
    callback mouse-undo();
    // its picture, and how far the picture's shadow reaches past the mouse;
    // over it, the chosen button picked out and the one under the pointer a
    // shade lighter, then each light's mask in the light's color of the moment
    in property <image> mouse-picture;
    in property <length> mouse-pic-m;
    in property <MousePatch> mouse-picked;
    in property <bool> mouse-picked-shown;
    in property <MousePatch> mouse-over;
    in property <bool> mouse-over-shown;
    // (each light in two layers, as the drawing has it: what lies under the
    // buttons, then what lies over everything)
    in property <MousePatch> mouse-logo-under;
    in property <MousePatch> mouse-wheel-under;
    in property <MousePatch> mouse-logo;
    in property <MousePatch> mouse-wheel;
    in property <color> mouse-logo-tint;
    in property <color> mouse-wheel-tint;
    // the hand over the picture, over something a click there chooses
    in property <bool> mouse-pic-hand;
    callback mouse-pic-moved(length, length, bool);
    callback mouse-pic-clicked(length, length);
    callback mouse-call-hover(int, bool);
    // each button's words beside the picture, and their lines and dots (the chosen button's apart)
    in property <[MouseCall]> mouse-calls;
    in property <string> mouse-lines;
    in property <string> mouse-dots;
    in property <string> mouse-line-on;
    in property <string> mouse-dot-on;
    // the list beside the boxes: the buttons, or the lights
    in property <[MouseRow]> mouse-rows;
    // Buttons: the Key library, as the keyboard's Keys tab has it: the mouse's
    // layers, its buttons in the groups its core gives them, what is typed to
    // find one, and a button newly chosen (on the picture, say) scrolled to
    in property <[LayerTab]> mouse-layers;
    in property <[LibGroup]> mouse-lib-groups;
    in-out property <string> mouse-lib-query;
    in property <length> mouse-lib-reveal-y;
    in property <int> mouse-lib-reveal-n;
    callback mouse-lib-toggle(string);
    callback mouse-lib-find(string);
    // the chosen button's Key detail box
    in property <string> mouse-cap;
    in property <string> mouse-title;
    in property <string> mouse-factory;
    in property <string> mouse-state;
    in property <bool> mouse-rebound;
    in property <int> mouse-kind;
    in property <[string]> mouse-kinds;
    in property <[string]> mouse-kind-icons;
    in property <string> mouse-job;
    in property <bool> mouse-menu-open;
    in property <string> mouse-note;
    // the chosen light's effects, and the boxes built as cells
    in property <[EffectItem]> mouse-effects;
    in property <bool> mouse-effect-moves;
    in property <length> mouse-cells-h;
    // Home's desk: its devices, edit mode, the desk moving round or a device
    // carried, the zoom's words, and the empty desk's words ("" with devices on it)
    in property <[DeskItem]> desk-items;
    in property <bool> desk-editing;
    in property <bool> desk-panning;
    in property <bool> desk-carrying;
    in property <string> desk-zoom;
    in property <string> desk-empty;
    // the pads drawn on the desk, the chosen one's place in them (-1, none),
    // its color, whether it has a picture, and what the desk says of the
    // picture last chosen for one, when it couldn't be used
    in property <[DeskPad]> desk-pads;
    in property <int> desk-pad-chosen: -1;
    in property <color> desk-pad-rgb;
    in property <bool> desk-pad-pictured;
    in property <string> desk-pad-note;
    // the chosen pad's size in words, and Draw your own chosen (the next drag
    // across the desk draws a pad)
    in property <string> desk-pad-size;
    in property <bool> desk-drawing;
    callback desk-add-pad(length, length, length);
    callback desk-pad-size-menu(length, length, length);
    callback desk-draw-cancel();
    callback desk-pad-hover(int, bool);
    callback desk-pad-edges(int, length, length);
    callback desk-pad-color(length, length, length);
    callback desk-pad-picture();
    callback desk-pad-no-picture();
    callback desk-pad-delete();
    // the keyboard on the desk (the window draws it in its place): its shadow
    // round it, and how many times its drawn size it shows (its knobs and glass
    // scale by that)
    in property <image> desk-kb-shadow;
    in property <length> desk-kb-shadow-m;
    in property <float> desk-kb-k: 1;
    // the mouse on the desk: its picture's layers as drawn for it, the shadow's
    // margin at that size, and how many times that size it shows
    in property <image> desk-mouse-picture;
    in property <length> desk-mouse-m;
    in property <float> desk-mouse-k: 1;
    in property <MousePatch> desk-mouse-logo-under;
    in property <MousePatch> desk-mouse-wheel-under;
    in property <MousePatch> desk-mouse-logo;
    in property <MousePatch> desk-mouse-wheel;
    // where the desk is in the window, and its room
    out property <length> desk-x: rail-w;
    out property <length> desk-y: bar;
    out property <length> desk-w: content-w;
    out property <length> desk-h: root.height - bar;
    callback desk-press(int, length, length);
    callback desk-pan(length, length);
    callback desk-move(length, length);
    callback desk-release();
    callback desk-wheel(length, length, length);
    callback desk-hover(int, bool);
    callback desk-arrange();
    callback desk-done();
    callback desk-zoom-step(int);
    // the room the page's boxes have across
    out property <length> mouse-w: pws-w;
    // whether a button is chosen; with none, what the All buttons box says
    // and whether any button can go back to the factory's job
    in property <bool> mouse-chosen;
    in property <string> mouse-all-note;
    in property <bool> mouse-any-rebound;
    callback mouse-reset-all();
    // the page's rows, and where they are in the window, for a press off the
    // chosen button to let it go: the page's column, its top as scrolled,
    // the stage's and the low row's
    property <length> mouse-stage-h: 470px;
    property <length> mouse-low-y: head-end + (root.mouse-tab < 2 ? mouse-stage-h + 14px : 0);
    // (on Buttons, the boxes in the row as tall as each other, as the Keys
    // tab has them: at least the Profiles box, at most the room under the
    // stage in the window (so they never run off its foot), between those as
    // tall as the chosen button's box needs, the same whether one is chosen
    // or not so the row stays put; the Key library scrolls inside its box)
    property <length> mouse-band-min: root.mouse-profiles-shown ? root.mouse-profiles.length * 50px + 92px : 0;
    property <length> mouse-band-max: max(mouse-band-min, mouse-flick.height - mouse-low-y - 24px);
    property <length> mouse-second-need: root.mouse-chosen && root.mouse-note != "" ? 320px : 270px;
    property <length> mouse-low-h: root.mouse-tab == 0 ? min(mouse-band-max, max(mouse-band-min, mouse-second-need)) : max(root.mouse-cells-h, 330px);
    // the list's width: the Key library's on Buttons, the lights' list on Lighting
    property <length> mouse-list-w: root.mouse-tab == 0 ? 440px : 240px;
    out property <length> mouse-wx: rail-w + pws-x;
    out property <length> mouse-wy: bar + 56px + mouse-flick.content-y;
    out property <length> mouse-stage-y: head-end;
    out property <length> mouse-stage-height: mouse-stage-h;
    out property <length> mouse-low-top: mouse-low-y;
    out property <length> mouse-low-height: mouse-low-h;
    callback mouse-tab-chosen(int);
    callback mouse-row(int);
    callback mouse-kind-picked(int, length, length, length);
    callback mouse-job-clicked(length, length, length);
    callback mouse-reset();
    callback mouse-effect(int);
    callback view-changed(int);
    callback choose-profile(int);
    callback key-clicked(int);
    callback key-hovered(int, bool);
    callback board-clicked();
    // whether a rebound key's new action is printed on it, and turning it on or off
    in property <bool> show-rebindings-on: true;
    callback show-rebindings();
    // the line over the keyboard, saying what to do on this tab
    in property <string> hint;
    // the layer the Keys tab edits (0 Base, 1 Function)
    in property <int> layer;
    callback layer-changed(int);
    callback rename-profile(string);
    // the Key library
    in property <[LibGroup]> lib-groups;
    in-out property <string> lib-query;
    callback lib-toggle(string);
    callback lib-find(string);
    // Game mode's keys
    in property <[CheckItem]> game-items;
    callback game-toggled(int);
    // the chosen key, on the layer shown
    in property <string> key-cap;
    in property <string> key-state;
    in property <bool> key-rebound;
    in property <bool> layer-rebound;
    in property <int> key-kind;
    in property <string> key-job;
    in property <bool> key-listening;
    in property <string> key-note;
    callback kind-picked(int, length, length, length);
    // a slider chosen in the library: 0 none, 1 the dimmer, 2 the volume slider
    in property <int> slider-chosen;
    in property <float> slider-at;
    in property <[CheckItem]> slider-choices;
    callback slider-chosen-at(int);
    callback slider-bind-at(int);
    callback action-menu(int, length, length, length);
    callback listen(int);
    callback reset-key();
    callback macro-editor(int);  // the layer whose macro to open, or -1
    callback mouse-macro-editor();
    callback screen-editor();
    callback menu-chose(int);
    callback menu-typed(string);
    callback menu-enter();
    callback menu-dismiss();
    callback menu-back-to();
    // a field in the open menu typed in and set, by its row
    callback menu-field(int, string);
    callback effect(int);
    callback cell-pick(int, int, length, length, length);
    callback cell-slide(int, float);
    callback cell-typed(int, int, string);

    background: transparent;
    default-font-family: "Barlow";
    default-font-size: 15px;

    property <length> radius: root.is-maximized ? 0 : 10px;
    property <length> bar: 36px;
    // the rail, opened into its blade, widens and the page narrows to make room
    property <length> rail-w: root.rail-open ? 232px : 60px;
    animate rail-w { duration: 220ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> reveal: root.rail-open ? 1 : 0;
    animate reveal { duration: 160ms; delay: 60ms; easing: ease; }
    property <length> content-w: root.width - rail-w;
    // the scrollbars stop short of the window's rounded corner
    property <length> bar-foot: root.radius > 0 ? 5px : 2px;
    // the page runs the window's width, a gutter either side
    property <length> pws-x: 24px;
    property <length> pws-w: content-w - 48px;
    // the keyboard fills the page's width, at the drawing's proportions, under the head
    // over the keyboard, one line: what to do here, and Show rebindings
    property <length> head-h: 36px;
    property <length> head-end: 12px + head-h + 6px;
    // the keyboard sits in a box of its own, a gutter round it
    property <length> kb-pad-x: 48px;
    property <length> kb-pad-y: 24px;
    property <length> board-top: head-end + kb-pad-y;
    // under the keyboard: the anchoring column (the profiles, what goes with
    // them), and beside it the tab's boxes
    // the Screen tab, in two columns: Profiles alone in the left one; in the right one
    // the screen's two states as folder tabs on a row over the screen's box, the default
    // backlight at the row's right end (it lights both); the box holding the screen and,
    // under it, the playlist on the first tab, or on the second the chooser of the layout
    // the keyboard keeps, with Layouts joined to the box's foot. The box is as tall as
    // Profiles. (`stage-h` is the screen's part of the box.)
    property <length> pl-panel-h: 56px;
    property <length> stage-h: anchor.preferred-height - pl-panel-h;
    property <length> tabs-h: 36px;
    // the box: as tall as Profiles, less whatever a narrow window takes off the screen's
    // height, so the row under the screen keeps its margin
    property <length> lcd-short: stage-h - 2 * bay-pad - 2 * kb-pad-y - lcd-h;
    property <length> box-h: anchor.preferred-height - lcd-short + (root.screen-game ? 40px : 0);
    // Layouts, joined to the box's foot: on the second tab only once the keyboard can keep a layout
    property <bool> shelf-on: !root.screen-closed || root.ob-ready;
    // the row under the screen in the box: the bay 16 in from the box's top, its gutter round the screen
    property <length> band-y: tabs-h + bay-pad + lcd-h + 2 * kb-pad-y;
    // the bay the screen sits in (the screen and its gutter), and the box's gray round the
    // bay, above and below it as at its sides
    property <length> bay-pad: 16px;
    // the screen as large as its box leaves it, the gutter and the padding kept, in whole
    // pixels (the page draws its picture at this size)
    out property <length> lcd-h: floor(min(stage-h - 2 * bay-pad - 2 * kb-pad-y, (under-w - 2 * bay-pad - 2 * kb-pad-y) / 5) / 1px) * 1px;
    out property <length> lcd-w: lcd-h * 5;
    // under the panel: the Library, its cards two to a row while each has room for its
    // picture and its words, otherwise one; after them, an empty block for a new screen
    out property <bool> shelf-two: (under-w - 32px - 8px) / 2 >= 454px;
    property <int> shelf-rows: shelf-two ? ceil((root.lib-pages.length + 1) / 2) : root.lib-pages.length + 1;
    property <length> shelf-h: 48px + shelf-rows * 104px - 8px + 16px;
    // the screen's own background, which its bay is
    in property <color> lcd-field: #0a0908;
    // (on the Screen tab, what is under the screen's box and its panel: the Library)
    property <length> under-top: root.tab == 3 ? head-end + tabs-h + box-h : head-end + board-h + 2 * kb-pad-y + 18px;
    // the playlist's name changed in place: where its field is in the window, so a press
    // away from it keeps the name
    out property <length> pl-rename-wx: rail-w + under-x + 16px;
    out property <length> pl-rename-wy: bar + 56px + flick.content-y + head-end + band-y + 14px;
    property <length> anchor-w: 240px;
    property <length> under-x: pws-x + anchor-w + 16px;
    out property <length> under-w: pws-w - anchor-w - 16px;
    property <length> board-w: pws-w - 2 * kb-pad-x;
    property <length> board-h: board-w * root.units-high / root.units;
    property <length> unit: board-w / root.units;
    property <length> cqw: board-w / 100;
    // the page's height under the device's bar: its head, the keyboard, what is under it, and the page's foot
    // Keys: the library, and its neighbor beside it, or under it where the page is narrow;
    // side by side, both reach the foot of the anchoring column
    // (the library, its layers' tabs at its top, and Game mode as tall as the Profiles
    // box; a chosen key's or slider's box as tall too, or as tall as it needs)
    property <length> lib-w: 440px;
    // Every block in a row is as tall as the others: at least the Profiles box,
    // at most the room under the keyboard in the window (so it never runs off
    // its foot), between those as tall as the tallest holds. What holds more
    // than that scrolls inside its block.
    property <length> band-min: anchor.preferred-height;
    property <length> room: flick.height - under-top - 24px;
    property <length> band-max: max(band-min, room);
    property <length> second-need: root.slider-chosen != 0 ? 328px : root.key-open ? (root.key-note != "" ? 320px : 270px) : 230px;
    property <length> keys-h: min(band-max, max(band-min, second-fits ? second-need : 0));
    property <length> lib-h: keys-h;
    property <length> second-w: root.key-open ? 460px : root.slider-chosen != 0 ? 360px : 340px;
    property <length> second-h: second-fits ? keys-h : max(band-min, second-need);
    property <bool> second-fits: lib-w + 12px + second-w <= under-w;
    // Lighting: the effects (300 wide), the effect's settings (360) and where and when
    // (320), side by side while they fit and wrapping under when they don't; the
    // boxes in a row as tall as its tallest, a single row reaching the anchor's foot
    property <length> lfx-h: 48px + 3 * 76px + 2 * 8px + 14px;
    property <bool> lfits1: 300px + 12px + 360px <= under-w;
    property <int> lr1: lfits1 ? 0 : 1;
    property <length> lx1: lfits1 ? 312px : 0;
    property <int> lr2: root.light-kind != 0 ? -1 : lfits1 ? (300px + 12px + 360px + 12px + 320px <= under-w ? 0 : 1) : (360px + 12px + 320px <= under-w ? 1 : 2);
    property <length> lx2: lr2 == 0 ? 684px : lr2 == 1 && !lfits1 ? 372px : 0;
    property <int> lrows: lr2 == 2 ? 3 : lr1 == 1 || lr2 == 1 ? 2 : 1;
    property <length> lneed0: max(lfx-h, max(lr1 == 0 ? root.set-h : 0, lr2 == 0 ? root.place-h : 0));
    property <length> lrow0: lrows == 1 ? min(band-max, max(band-min, lneed0)) : max(band-min, lneed0);
    property <length> lrow1: max(lr1 == 1 ? root.set-h : 0, lr2 == 1 ? root.place-h : 0);
    property <length> lrow2: lr2 == 2 ? root.place-h : 0;
    property <length> light-h: lrow0 + (lrows > 1 ? 12px + lrow1 : 0) + (lrows > 2 ? 12px + lrow2 : 0);
    property <length> tab-h: root.tab == 0 ? (second-fits ? keys-h : keys-h + 12px + second-h)
        : root.tab == 1 ? light-h : root.tab == 3 ? (shelf-on ? shelf-h : 0) : root.tile-height;
    property <length> under-board: 18px + max(anchor.preferred-height, tab-h);
    property <length> page-h: root.tab == 2 ? 12px + head-h + 6px + 24px + root.tile-height + 40px
        : root.tab == 3 ? max(head-end + anchor.preferred-height, under-top + tab-h) + 24px
        : board-top + board-h + kb-pad-y + under-board + 24px;
    // the page's scrollbar, as WebKit drew it: over the whole window, when the page is longer than it
    property <length> doc-h: bar + 56px + page-h;

    public function focus-menu() {
        menu.focus-search();
    }
    public function blur-menu() {
        menu.blur-search();
    }

    // the content: the home, Ectomatter's settings, or the device's page, on the
    // app's ground. The window lays the ground under the page itself, so that
    // nothing the page draws lies under the keyboard's hole.
    Rectangle {
        x: rail-w;
        y: bar;
        width: content-w;
        height: root.height - bar;

        // Home: the devices on a desk, each as its page draws it, to scale, its
        // name under it. Day to day the desk fits the window and a device opens
        // its page; Arrange shows the dots, the desk zooms and pans, and the
        // devices move onto the dots. (The window lays the dots and the
        // highlight under a device on the ground, and draws the keyboard.)
        if root.place == "home": Rectangle {
            desk-ta := TouchArea {
                // (in edit mode a drag on the empty desk moves round it; with
                // Draw your own on, it draws a pad)
                mouse-cursor: root.desk-panning ? MouseCursor.grabbing : root.desk-drawing ? MouseCursor.crosshair : MouseCursor.default;
                // (in edit mode a drag with the middle button moves around the desk)
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        root.desk-press(-1, self.mouse-x, self.mouse-y);
                    }
                    if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
                        root.desk-pan(self.mouse-x, self.mouse-y);
                    }
                    if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
                        root.desk-release();
                    }
                }
                moved => { root.desk-move(self.mouse-x, self.mouse-y); }
                scroll-event(e) => {
                    if (root.desk-editing) {
                        root.desk-wheel(self.mouse-x, self.mouse-y, e.delta-y);
                        return accept;
                    }
                    return reject;
                }
                // the pads, under the devices (the window draws them on the ground):
                // in edit mode, a ring round the one chosen or being drawn, and a
                // fainter one round the one the pointer is over; a drag on one
                // carries it, and the chosen one's edges and corners size it
                for p[j] in root.desk-pads: Rectangle {
                    x: p.x;
                    y: p.y;
                    width: p.w;
                    height: p.h;
                    if root.desk-editing && (p.chosen || (p.hover && !root.desk-carrying)): Rectangle {
                        border-radius: p.r;
                        border-width: p.chosen ? 1.5px : 1px;
                        border-color: p.chosen ? #ffffffe0 : #ffffff40;
                    }
                    if root.desk-editing && !p.drawing: TouchArea {
                        mouse-cursor: root.desk-drawing ? MouseCursor.crosshair : root.desk-carrying ? MouseCursor.grabbing : MouseCursor.grab;
                        changed has-hover => { root.desk-pad-hover(j, self.has-hover); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.desk-press(-1, p.x + self.mouse-x, p.y + self.mouse-y);
                            }
                            if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
                                root.desk-pan(p.x + self.mouse-x, p.y + self.mouse-y);
                            }
                            if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
                                root.desk-release();
                            }
                        }
                        moved => { root.desk-move(p.x + self.mouse-x, p.y + self.mouse-y); }
                    }
                    // (each its own element, placed as the pad's size has it: not
                    // a list made from its size, which a drag would make anew, and
                    // the grip held with it)
                    if root.desk-editing && p.chosen && !p.drawing: Rectangle {
                        PadGrip {
                            x: -5px;
                            y: 7px;
                            width: 10px;
                            height: p.h - 14px;
                            edges: 1;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: p.w - 5px;
                            y: 7px;
                            width: 10px;
                            height: p.h - 14px;
                            edges: 4;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: 7px;
                            y: -5px;
                            width: p.w - 14px;
                            height: 10px;
                            edges: 2;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: 7px;
                            y: p.h - 5px;
                            width: p.w - 14px;
                            height: 10px;
                            edges: 8;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: -7px;
                            y: -7px;
                            width: 14px;
                            height: 14px;
                            edges: 3;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: p.w - 7px;
                            y: -7px;
                            width: 14px;
                            height: 14px;
                            edges: 6;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: p.w - 7px;
                            y: p.h - 7px;
                            width: 14px;
                            height: 14px;
                            edges: 12;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: -7px;
                            y: p.h - 7px;
                            width: 14px;
                            height: 14px;
                            edges: 9;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                    }
                }
                for d[i] in root.desk-items: Rectangle {
                    x: d.x;
                    y: d.y;
                    width: d.w;
                    height: d.h;
                    // the keyboard: its shadow round its place, its knobs and the display's glass over it
                    if d.kind == 0: Image {
                        x: -root.desk-kb-shadow-m * root.desk-kb-k;
                        y: -root.desk-kb-shadow-m * root.desk-kb-k;
                        width: parent.width + 2 * root.desk-kb-shadow-m * root.desk-kb-k;
                        height: parent.height + 2 * root.desk-kb-shadow-m * root.desk-kb-k;
                        source: root.desk-kb-shadow;
                    }
                    if d.kind == 0: Rectangle {
                        // the keys held down on the keyboard, shaded as its page shades them
                        for k in root.keys: Rectangle {
                            visible: k.pressed;
                            x: k.x * d.w / root.units;
                            y: k.y * d.w / root.units;
                            width: k.w * d.w / root.units;
                            height: k.h * d.w / root.units;
                            border-radius: (k.molded ? 0.13 : 0.24) * d.w / 100;
                            background: #00000052;
                        }
                        for o in root.overlays: Image {
                            visible: root.board-ready;
                            property <float> along: o.frac;
                            animate along { duration: root.knob-glide; easing: linear; }
                            x: (o.x + self.along * o.travel) * root.desk-kb-k;
                            y: o.y * root.desk-kb-k;
                            opacity: o.opacity * (d.off ? 0.5 : 1);
                            width: o.w * root.desk-kb-k;
                            height: o.h * root.desk-kb-k;
                            source: o.image;
                            image-fit: fill;
                        }
                    }
                    // the mouse: the window draws it here in HDR, under the page; these
                    // layers only place it
                    if d.kind == 1: MouseLayers {
                        x: -root.desk-mouse-m * root.desk-mouse-k;
                        y: -root.desk-mouse-m * root.desk-mouse-k;
                        width: parent.width + 2 * root.desk-mouse-m * root.desk-mouse-k;
                        height: parent.height + 2 * root.desk-mouse-m * root.desk-mouse-k;
                        drawn: false;
                        k: root.desk-mouse-k;
                        opacity: d.off ? 0.5 : 1;
                        lit: !d.off;
                        base: root.desk-mouse-picture;
                        logo-under: root.desk-mouse-logo-under;
                        wheel-under: root.desk-mouse-wheel-under;
                        logo: root.desk-mouse-logo;
                        wheel: root.desk-mouse-wheel;
                        logo-tint: root.mouse-logo-tint;
                        wheel-tint: root.mouse-wheel-tint;
                    }
                    // in edit mode, a thin ring round the device the pointer is over
                    if root.desk-editing && d.hover && !root.desk-carrying: Rectangle {
                        x: -16px;
                        y: -16px;
                        width: parent.width + 32px;
                        height: parent.height + 16px + 58px;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: #ffffff1c;
                    }
                    // over a pad it could be lost on, its name on a backing of the
                    // app's own ground
                    if d.backed: Rectangle {
                        x: (parent.width - name-col.preferred-width) / 2 - 10px;
                        y: parent.height + 16px - 5px;
                        width: name-col.preferred-width + 20px;
                        height: name-col.preferred-height + 10px;
                        border-radius: 8px;
                        background: #18181bd9;
                    }
                    // its name under it, and under that whether it is plugged in
                    name-col := VerticalLayout {
                        x: (parent.width - self.preferred-width) / 2;
                        y: parent.height + 16px;
                        width: self.preferred-width;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Rectangle {
                                width: 7px;
                                Rectangle {
                                    y: (parent.height - 7px) / 2;
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: d.off ? Ink.bad : Ink.good;
                                }
                            }
                            Text {
                                text: d.name;
                                font-family: "Geist";
                                font-size: 13.5px;
                                font-weight: 500;
                                color: d.hover ? Ink.bright : Ink.dim;
                                height: 18px;
                                vertical-alignment: center;
                            }
                        }
                        if d.sub != "": Text {
                            text: d.sub;
                            font-family: "Geist";
                            font-size: 12px;
                            color: Ink.quiet;
                            horizontal-alignment: center;
                        }
                    }
                    // a press: outside edit mode, a click opens its page; in edit mode it carries it
                    TouchArea {
                        y: 0;
                        height: parent.height + 16px + 40px;
                        mouse-cursor: root.desk-editing ? (root.desk-carrying ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.pointer;
                        changed has-hover => { root.desk-hover(i, self.has-hover); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.desk-press(i, d.x + self.mouse-x, d.y + self.mouse-y);
                            }
                            // (the middle button's drag moves around the desk, over a device too)
                            if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
                                root.desk-pan(d.x + self.mouse-x, d.y + self.mouse-y);
                            }
                            if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
                                root.desk-release();
                            }
                        }
                        moved => { root.desk-move(d.x + self.mouse-x, d.y + self.mouse-y); }
                    }
                }
            }
            // day to day: the tab's words at the top left, Arrange at the top right
            if !root.desk-editing && root.desk-empty == "": Text {
                x: 24px;
                y: 12px;
                height: 36px;
                text: "Select a device to change it.";
                font-family: "Geist";
                font-size: 12.5px;
                color: Ink.quiet;
                vertical-alignment: center;
            }
            // Scenes, left of Arrange: the scene on, by its name and its chip (Scenes, with the
            // light's glyph, while none is on)
            if !root.desk-editing && root.desk-empty == "": Rectangle {
                x: parent.width - 24px - arrange-measure.preferred-width - 8px - self.width;
                y: 17px;
                height: 26px;
                width: light-row.preferred-width;
                border-radius: 6px;
                background: light-ta.has-hover ? Ink.hover-box : transparent;
                light-row := HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 7px;
                    if root.scene-name != "": Image {
                        y: 6px;
                        width: 14px;
                        height: 14px;
                        source: root.scene-chip;
                        image-fit: fill;
                    }
                    if root.scene-name == "": Path {
                        y: 6px;
                        width: 14px;
                        height: 14px;
                        viewbox-width: 14;
                        viewbox-height: 14;
                        // (a bulb's light: a ring, and its rays)
                        commands: "M7 4.6a2.4 2.4 0 1 0 0 4.8a2.4 2.4 0 1 0 0-4.8zM7 0.9v1.5M7 11.6v1.5M0.9 7h1.5M11.6 7h1.5M2.7 2.7l1.06 1.06M10.24 10.24l1.06 1.06M2.7 11.3l1.06-1.06M10.24 3.76l1.06-1.06";
                        fill: transparent;
                        stroke: light-ta.has-hover ? Ink.bright : Ink.soft;
                        stroke-width: 1.4px;
                        stroke-line-cap: LineCap.round;
                    }
                    Text {
                        text: root.scene-name == "" ? "Scenes" : "Scene: " + root.scene-name;
                        font-family: "Geist";
                        font-size: 12.5px;
                        font-weight: 500;
                        color: root.scene-name != "" || light-ta.has-hover ? Ink.bright : Ink.soft;
                        vertical-alignment: center;
                    }
                }
                light-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.scene-menu(self.absolute-position.x, self.absolute-position.y, self.height); }
                }
            }
            // (Arrange's width, for the Scenes button's place beside it)
            arrange-measure := HorizontalLayout {
                visible: false;
                padding-left: 9px;
                padding-right: 9px;
                spacing: 7px;
                Rectangle { width: 14px; }
                Text { text: "Arrange"; font-family: "Geist"; font-size: 12.5px; font-weight: 500; }
            }
            if !root.desk-editing && root.desk-empty == "": Rectangle {
                x: parent.width - self.width - 24px;
                y: 17px;
                height: 26px;
                width: arrange-row.preferred-width;
                border-radius: 6px;
                background: arrange-ta.has-hover ? Ink.hover-box : transparent;
                arrange-row := HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 7px;
                    Path {
                        y: 6px;
                        width: 14px;
                        height: 14px;
                        viewbox-width: 14;
                        viewbox-height: 14;
                        commands: "M7 1.5v11M1.5 7h11M7 1.5 5.4 3.1M7 1.5l1.6 1.6M7 12.5l-1.6-1.6M7 12.5l1.6-1.6M1.5 7l1.6-1.6M1.5 7l1.6 1.6M12.5 7l-1.6-1.6M12.5 7l-1.6 1.6";
                        fill: transparent;
                        stroke: arrange-ta.has-hover ? Ink.bright : Ink.soft;
                        stroke-width: 1.5px;
                        stroke-line-cap: LineCap.round;
                    }
                    Text {
                        text: "Arrange";
                        font-family: "Geist";
                        font-size: 12.5px;
                        font-weight: 500;
                        color: arrange-ta.has-hover ? Ink.bright : Ink.soft;
                        vertical-alignment: center;
                    }
                }
                arrange-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.desk-arrange(); }
                }
            }
            // edit mode: what to do and Done, on a bar of its own over the dots
            if root.desk-editing: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 14px;
                width: mode-row.preferred-width;
                height: 40px;
                border-radius: 10px;
                background: Ink.box;
                border-width: 1px;
                border-color: Ink.line;
                drop-shadow-blur: 28px;
                drop-shadow-offset-y: 10px;
                drop-shadow-color: #00000070;
                // (a press on the bar is the bar's, not the desk's under it)
                TouchArea {}
                mode-row := HorizontalLayout {
                    padding-left: root.desk-pad-chosen >= 0 ? 6px : 16px;
                    padding-right: 6px;
                    spacing: root.desk-pad-chosen >= 0 ? 6px : 10px;
                    alignment: start;
                    if root.desk-pad-chosen < 0: Text {
                        text: root.desk-drawing ? "Drag across the desk to draw your pad." : "Drag a device to where it sits on your desk.";
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.soft;
                        vertical-alignment: center;
                    }
                    // (a gap after the words, as wide as the bar's own between buttons)
                    if root.desk-pad-chosen < 0: Rectangle { width: 4px; }
                    // nothing chosen: a pad to add, at its maker's size or drawn
                    if root.desk-pad-chosen < 0 && !root.desk-drawing: VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Add pad";
                            height: 28px;
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.desk-add-pad(self.absolute-position.x, self.absolute-position.y, self.height); }
                        }
                    }
                    // drawing: put away unused
                    if root.desk-pad-chosen < 0 && root.desk-drawing: VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Cancel";
                            height: 28px;
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.desk-draw-cancel(); }
                        }
                    }
                    // a pad chosen: its size, its color, its picture, and taking it off the desk
                    if root.desk-pad-chosen >= 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: size-row.preferred-width;
                            border-radius: 8px;
                            background: size-ta.has-hover ? Ink.pick : Ink.hover-box;
                            size-row := HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text {
                                    text: root.desk-pad-size;
                                    font-family: "Geist";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Ink.ink;
                                    vertical-alignment: center;
                                }
                                Path {
                                    y: (parent.height - 12px) / 2;
                                    width: 12px;
                                    height: 12px;
                                    viewbox-width: 12;
                                    viewbox-height: 12;
                                    commands: "M3 4.5l3 3 3-3";
                                    fill: transparent;
                                    stroke: Ink.quiet;
                                    stroke-width: 1.6px;
                                }
                            }
                            size-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.desk-pad-size-menu(self.absolute-position.x, self.absolute-position.y, self.height); }
                            }
                        }
                    }
                    if root.desk-pad-chosen >= 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            width: color-row.preferred-width;
                            border-radius: 8px;
                            background: color-ta.has-hover ? Ink.pick : Ink.hover-box;
                            color-row := HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 12px;
                                spacing: 8px;
                                Rectangle {
                                    width: 14px;
                                    Rectangle {
                                        y: (parent.height - 14px) / 2;
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 4px;
                                        background: root.desk-pad-rgb;
                                        border-width: 1px;
                                        border-color: #ffffff2e;
                                    }
                                }
                                Text {
                                    text: "Color";
                                    font-family: "Geist";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Ink.ink;
                                    vertical-alignment: center;
                                }
                            }
                            color-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.desk-pad-color(self.absolute-position.x, self.absolute-position.y, self.height); }
                            }
                        }
                    }
                    if root.desk-pad-chosen >= 0: VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Choose a picture…";
                            height: 28px;
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.desk-pad-picture(); }
                        }
                    }
                    if root.desk-pad-chosen >= 0 && root.desk-pad-pictured: VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Remove picture";
                            height: 28px;
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.desk-pad-no-picture(); }
                        }
                    }
                    if root.desk-pad-chosen >= 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: pad-del-t.preferred-width + 24px;
                            height: 28px;
                            border-radius: 7px;
                            background: pad-del-ta.has-hover ? #74302a : #5c2420;
                            pad-del-t := Text { text: "Delete pad"; font-family: "Geist"; font-size: 13px; font-weight: 500; color: #fecaca; }
                            pad-del-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.desk-pad-delete(); }
                            }
                        }
                    }
                    if root.desk-pad-chosen >= 0 && root.desk-pad-note != "": Text {
                        text: root.desk-pad-note;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.bad;
                        vertical-alignment: center;
                    }
                    // (a gap before Done, as wide as the bar's own spacing)
                    if root.desk-pad-chosen >= 0: Rectangle { width: 8px; }
                    VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Done";
                            height: 28px;
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.desk-done(); }
                        }
                    }
                }
            }
            // edit mode: zoom, at the bottom right
            if root.desk-editing: Rectangle {
                x: parent.width - self.width - 24px;
                y: parent.height - self.height - 24px;
                width: zoom-row.preferred-width;
                height: 36px;
                border-radius: 10px;
                background: Ink.box;
                border-width: 1px;
                border-color: Ink.line;
                drop-shadow-blur: 22px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #00000060;
                TouchArea {}
                zoom-row := HorizontalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for z[j] in [{ t: "", how: -1 }, { t: root.desk-zoom, how: 0 }, { t: "", how: 1 }, { t: "Fit", how: 2 }]: Rectangle {
                        width: z.how == 0 ? 52px : z.how == 2 ? fit-t.preferred-width + 16px : 28px;
                        height: 28px;
                        border-radius: 7px;
                        background: zt.has-hover ? Ink.hover-box : transparent;
                        if z.how == -1 || z.how == 1: Path {
                            x: 8px;
                            y: 8px;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: z.how == 1 ? "M2 6h8M6 2v8" : "M2 6h8";
                            fill: transparent;
                            stroke: zt.has-hover ? Ink.bright : Ink.soft;
                            stroke-width: 1.6px;
                            stroke-line-cap: LineCap.round;
                        }
                        fit-t := Text {
                            visible: z.how == 0 || z.how == 2;
                            width: parent.width;
                            height: parent.height;
                            text: z.t;
                            font-family: "Geist";
                            font-size: 12.5px;
                            font-weight: 500;
                            color: zt.has-hover ? Ink.bright : Ink.soft;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        zt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.desk-zoom-step(z.how); }
                        }
                    }
                }
            }
            // before anything is plugged in: which devices Ectomatter works with
            if root.desk-empty != "": Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(480px, parent.width - 48px);
                text: root.desk-empty;
                font-family: "Geist";
                font-size: 14px;
                color: Ink.soft;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // the mouse's page, from the keyboard page's own parts: its bar, then
        // the tab's words, the mouse's picture (on Buttons with each button's
        // job beside it), and the tab's boxes
        Rectangle {
            visible: root.place == "mouse";
            property <length> stage-h: mouse-stage-h;
            property <length> low-y: mouse-low-y;
            property <length> low-h: mouse-low-h;
            // the Profiles box's room, first in the row on each tab whose settings
            // belong to a profile, and its height (rows of 50 under its heading,
            // then the row for a new one)
            property <length> pro-w: root.mouse-profiles-shown && root.mouse-tab < 3 ? 252px : 0;
            property <length> pro-y: root.mouse-tab < 2 ? low-y : head-end;
            property <length> pro-h: root.mouse-profiles.length * 50px + 92px;
            mouse-flick := Flickable {
                y: 56px;
                height: parent.height - 56px;
                content-height: max(low-y + (root.mouse-tab < 2 ? low-h : root.mouse-cells-h), pro-w > 0 ? pro-y + pro-h : 0) + 24px;
                mouse-drag-pan-enabled: false;
                if root.mouse-hint-chip-on: Image {
                    x: pws-x;
                    y: 12px + 11px;
                    width: 14px;
                    height: 14px;
                    source: root.mouse-hint-chip;
                    image-fit: fill;
                }
                Text {
                    x: pws-x + (root.mouse-hint-chip-on ? 24px : 0);
                    y: 12px;
                    height: 36px;
                    text: root.mouse-hint;
                    font-family: "Geist";
                    font-size: 12.5px;
                    color: root.mouse-hint-chip-on ? Ink.soft : Ink.quiet;
                    vertical-alignment: center;
                }
                // the stage: the mouse on its own shade, as its mock has it; the
                // window draws the mouse in the hole the shade leaves, in HDR
                if root.mouse-tab < 2: Rectangle {
                    x: pws-x;
                    y: head-end;
                    width: pws-w;
                    height: stage-h;
                    border-radius: 12px;
                    clip: true;
                    property <length> hx: max(0, self.width / 2 - 600px + 480px - root.mouse-pic-m);
                    property <length> hy: max(0, 30px - root.mouse-pic-m);
                    property <length> hx2: min(self.width, self.width / 2 - 600px + 720px + root.mouse-pic-m);
                    property <length> hy2: min(self.height, 440px + root.mouse-pic-m);
                    Rectangle { x: 0; y: 0; width: parent.width; height: hy; background: Ink.stage; }
                    Rectangle { x: 0; y: hy2; width: parent.width; height: parent.height - hy2; background: Ink.stage; }
                    Rectangle { x: 0; y: hy; width: hx; height: hy2 - hy; background: Ink.stage; }
                    Rectangle { x: hx2; y: hy; width: parent.width - hx2; height: hy2 - hy; background: Ink.stage; }
                    if !root.mouse-hdr-ready: Rectangle { x: hx; y: hy; width: hx2 - hx; height: hy2 - hy; background: Ink.stage; }
                    // the mock's own canvas, the mouse's middle at 600 of its 1092
                    Rectangle {
                        x: parent.width / 2 - 600px;
                        width: 1092px;
                        height: parent.height;
                        pic := MouseLayers {
                            x: 480px - root.mouse-pic-m;
                            y: 30px - root.mouse-pic-m;
                            width: 240px + 2 * root.mouse-pic-m;
                            height: 410px + 2 * root.mouse-pic-m;
                            drawn: false;
                            base: root.mouse-picture;
                            picked: root.mouse-picked;
                            picked-shown: root.mouse-picked-shown;
                            over: root.mouse-over;
                            over-shown: root.mouse-over-shown;
                            logo-under: root.mouse-logo-under;
                            wheel-under: root.mouse-wheel-under;
                            logo: root.mouse-logo;
                            wheel: root.mouse-wheel;
                            logo-tint: root.mouse-logo-tint;
                            wheel-tint: root.mouse-wheel-tint;
                            // a click on a button (or, on Lighting, a light) chooses it
                            pic-ta := TouchArea {
                                mouse-cursor: root.mouse-pic-hand ? pointer : default;
                                changed mouse-x => { root.mouse-pic-moved(self.mouse-x, self.mouse-y, self.has-hover); }
                                changed mouse-y => { root.mouse-pic-moved(self.mouse-x, self.mouse-y, self.has-hover); }
                                changed has-hover => { root.mouse-pic-moved(self.mouse-x, self.mouse-y, self.has-hover); }
                                clicked => { root.mouse-pic-clicked(self.mouse-x, self.mouse-y); }
                            }
                        }
                        if root.mouse-tab == 0: Rectangle {
                            Path {
                                width: 1092px;
                                height: 470px;
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-lines;
                                stroke: #4a4a52;
                                stroke-width: 1px;
                                fill: transparent;
                            }
                            Path {
                                width: 1092px;
                                height: 470px;
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-dots;
                                fill: #4a4a52;
                            }
                            Path {
                                width: 1092px;
                                height: 470px;
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-line-on;
                                stroke: Ink.dim;
                                stroke-width: 1px;
                                fill: transparent;
                            }
                            Path {
                                width: 1092px;
                                height: 470px;
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-dot-on;
                                fill: Ink.dim;
                            }
                            for c[i] in root.mouse-calls: Rectangle {
                                x: c.left ? 220px : 780px;
                                y: c.top;
                                width: 200px;
                                height: 40px;
                                Text {
                                    y: 0;
                                    width: parent.width;
                                    height: 16px;
                                    text: c.name;
                                    font-family: "Geist";
                                    font-size: 11px;
                                    letter-spacing: 0.2px;
                                    color: Ink.quiet;
                                    horizontal-alignment: c.left ? right : left;
                                }
                                Rectangle {
                                    x: c.left ? parent.width - self.width : 0;
                                    y: 17px;
                                    width: job-t.preferred-width + (c.chosen ? 16px : 0);
                                    height: 22px;
                                    border-radius: 6px;
                                    background: c.chosen ? Ink.pick : transparent;
                                    border-width: c.chosen ? 1px : 0;
                                    border-color: #ffffff40;
                                    job-t := Text {
                                        x: c.chosen ? 8px : 0;
                                        height: parent.height;
                                        text: c.job;
                                        font-family: "Geist";
                                        font-size: 12.5px;
                                        color: c.rebound ? Ink.warn : c.chosen ? Ink.bright : Ink.dim;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    changed has-hover => { root.mouse-call-hover(i, self.has-hover); }
                                    clicked => { root.mouse-row(i); }
                                }
                            }
                        }
                    }
                }
                // the profiles, first in the row, as the keyboard's are
                if pro-w > 0: AnchorColumn {
                    x: pws-x;
                    y: pro-y;
                    width: 240px;
                    profiles: root.mouse-profiles;
                    kept: true;
                    renaming <=> root.mouse-renaming;
                    choose(n) => { root.mouse-profile-choose(n); }
                    rename(t) => { root.mouse-profile-rename(t); }
                    add() => { root.mouse-profile-new(); }
                    menu(x, y, h) => { root.mouse-profile-menu(x, y, h); }
                }
                // Buttons: the Key library, as the keyboard's Keys tab has it, its
                // layer's tab at its top, a find box, and the buttons in their groups
                if root.mouse-tab == 0: KeyLibrary {
                    x: pws-x + pro-w;
                    y: low-y;
                    width: mouse-list-w;
                    height: low-h;
                    layer: 0;
                    layers: root.mouse-layers;
                    placeholder: "Find a button or what it does";
                    reveal-y: root.mouse-lib-reveal-y;
                    reveal-n: root.mouse-lib-reveal-n;
                    groups: root.mouse-lib-groups;
                    query <=> root.mouse-lib-query;
                    toggle(g) => { root.mouse-lib-toggle(g); }
                    find(t) => { root.mouse-lib-find(t); }
                    pick(id) => { root.mouse-row(id); }
                }
                // Lighting: the lights beside the boxes, as the profiles are listed
                if root.mouse-tab == 1: Rectangle {
                    x: pws-x + pro-w;
                    y: low-y;
                    width: mouse-list-w;
                    height: low-h;
                    border-radius: 12px;
                    background: Ink.box;
                    AnchorHead {
                        x: 16px;
                        y: 8px;
                        text: "LIGHTS";
                    }
                    VerticalLayout {
                        x: 8px;
                        y: 40px;
                        width: parent.width - 16px;
                        height: parent.height - 48px;
                        spacing: 2px;
                        alignment: start;
                        for r[i] in root.mouse-rows: AnchorRow {
                            chosen: r.chosen;
                            clicked => { root.mouse-row(i); }
                            Text {
                                x: 12px;
                                y: 7px;
                                width: parent.width - 24px - (r.swatched ? 24px : 0);
                                text: r.name;
                                font-family: "Geist";
                                font-size: 13.5px;
                                color: Ink.bright;
                                overflow: elide;
                            }
                            Text {
                                x: 12px;
                                y: 25px;
                                width: parent.width - 24px - (r.swatched ? 24px : 0);
                                text: r.job;
                                font-family: "Geist";
                                font-size: 12px;
                                color: r.rebound ? Ink.warn : r.chosen ? Ink.soft : Ink.quiet;
                                overflow: elide;
                            }
                            if r.swatched: Rectangle {
                                x: parent.width - 12px - 14px;
                                y: (parent.height - 14px) / 2;
                                width: 14px;
                                height: 14px;
                                border-radius: 4px;
                                background: r.swatch;
                                border-width: 1px;
                                border-color: #ffffff2e;
                            }
                        }
                    }
                }
                // Buttons, no button chosen: every button at once, where the
                // chosen one's box goes and in its shade
                if root.mouse-tab == 0 && !root.mouse-chosen: PageBox {
                    x: pws-x + pro-w + mouse-list-w + 12px;
                    y: low-y;
                    width: pws-w - pro-w - mouse-list-w - 12px;
                    height: low-h;
                    title: "All buttons";
                    Text {
                        x: 16px;
                        y: 46px;
                        width: parent.width - 32px - (root.mouse-any-rebound ? all-reset.width + 16px : 0);
                        text: root.mouse-all-note;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.quiet;
                        wrap: word-wrap;
                    }
                    all-reset := WordButton {
                        visible: root.mouse-any-rebound;
                        x: parent.width - self.width - 16px;
                        y: 40px;
                        text: "Back to factory";
                        fill: Ink.hover-box;
                        fill-hover: Ink.pick;
                        clicked => { root.mouse-reset-all(); }
                    }
                }
                // Buttons: the chosen button's job, as a key's on the keyboard's Keys tab
                if root.mouse-tab == 0 && root.mouse-chosen: KeyDetail {
                    x: pws-x + pro-w + mouse-list-w + 12px;
                    y: low-y;
                    width: pws-w - pro-w - mouse-list-w - 12px;
                    height: low-h;
                    title: root.mouse-title;
                    cap: root.mouse-cap;
                    factory: root.mouse-factory;
                    state: root.mouse-state;
                    rebound: root.mouse-rebound;
                    layer-rebound: false;
                    layer-title: "When pressed";
                    kinds: root.mouse-kinds;
                    kind-icons: root.mouse-kind-icons;
                    kind: root.mouse-kind;
                    job: root.mouse-job;
                    listening: false;
                    recordable: false;
                    closable: false;
                    menu-open: root.mouse-menu-open;
                    note: root.mouse-note;
                    reset => { root.mouse-reset(); }
                    kind-picked(i, x, y, h) => { root.mouse-kind-picked(i, x, y, h); }
                    job-clicked(x, y, h) => { root.mouse-job-clicked(x, y, h); }
                }
                // Lighting: the chosen light's effect, as the keyboard's
                if root.mouse-tab == 1: EffectGrid {
                    x: pws-x + pro-w + 240px + 12px;
                    y: low-y;
                    width: 300px;
                    height: low-h;
                    effects: root.mouse-effects;
                    moving: root.mouse-effect-moves;
                    chose(i) => { root.mouse-effect(i); }
                }
                // the boxes built as cells: the effect's settings, Performance, Settings
                if root.mouse-tab >= 1: Rectangle {
                    x: pws-x + pro-w + (root.mouse-tab == 1 ? 240px + 12px + 300px + 12px : 0);
                    y: low-y;
                    width: root.mouse-w - pro-w - (root.mouse-tab == 1 ? 564px : 0);
                    height: root.mouse-cells-h;
                    for c in root.cells: CellView {
                        c: c;
                        glyph: root.mouse-tile;
                        pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                        slide(id, v) => { root.cell-slide(id, v); }
                        typed(id, index, t) => { root.cell-typed(id, index, t); }
                    }
                }
            }
            // the mouse's own bar: its name, its tabs, and what went wrong
            Rectangle {
                y: 0;
                height: 56px;
                background: Ink.base;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 28px;
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 10px;
                        Rectangle {
                            width: 7px;
                            Rectangle {
                                y: (parent.height - 7px) / 2;
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.mouse-conn == 1 ? Ink.good : root.mouse-conn == 2 ? Ink.bad : #5c5c5c;
                            }
                        }
                        Text {
                            text: "SteelSeries Sensei 310";
                            font-family: "Geist";
                            font-size: 17px;
                            font-weight: 600;
                            letter-spacing: 0.17px;
                            color: Ink.ink;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 2px;
                        for name[i] in ["Buttons", "Lighting", "Performance", "Settings"]: Rectangle {
                            width: mt.width;
                            mt := Tab {
                                text: name;
                                selected: root.mouse-tab == i;
                                clicked => { root.mouse-tab-chosen(i); }
                            }
                            if root.mouse-tab == i: Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                background: Ink.ink;
                            }
                        }
                    }
                    // what went wrong, which stays, or what was last done to the
                    // profiles, for a moment, with Undo after a delete
                    Text {
                        horizontal-stretch: 1;
                        text: root.mouse-status != "" ? root.mouse-status : root.mouse-said;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: root.mouse-status != "" ? Ink.bad : Ink.quiet;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.mouse-status == "" && root.mouse-undo-shown: VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        BoxLink {
                            text: "Undo";
                            clicked => { root.mouse-undo(); }
                        }
                    }
                    // the Macro Editor, on Ectomatter's own macros, and the lab, on the
                    // mouse's lights, at the bar's end
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        BarButton {
                            commands: "M3.1 4h9.8a1.6 1.6 0 0 1 1.6 1.6v5.3a1.6 1.6 0 0 1-1.6 1.6H3.1a1.6 1.6 0 0 1-1.6-1.6V5.6a1.6 1.6 0 0 1 1.6-1.6zM4 7h1M7 7h1M10 7h2M4.5 9.8h7";
                            text: "Macro Editor";
                            clicked => { root.mouse-macro-editor(); }
                        }
                        BarButton {
                            // a flask drawn for this size, its lines on the pixel grid
                            commands: "M5.14 1.14h5.72M6.29 1.14v4.58L2.95 11.93a1.25 1.25 0 0 0 1.1 1.79h7.9a1.25 1.25 0 0 0 1.1-1.79L9.71 5.72V1.14M4.3 10.29h7.4";
                            round: true;
                            text: "";
                            clicked => { root.rail("lab"); }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Ink.line;
                }
            }
        }
        // the Library (games_page.rs): the games and apps on three tabs, each
        // game's or app's own page, and Every game's; its bar stays put over
        // what scrolls, as a device's does
        Rectangle {
            visible: root.place == "library";
            gl-flick := Flickable {
                y: 56px;
                height: parent.height - 56px;
                content-height: root.gl-page-h;
                mouse-drag-pan-enabled: false;
                Text {
                    x: pws-x;
                    y: 12px;
                    width: pws-w - (root.gl-view == 0 ? 240px + 20px + root.gl-store-w + root.gl-sort-w : 0);
                    height: 36px;
                    text: root.gl-hint;
                    font-family: "Geist";
                    font-size: 12.5px;
                    color: Ink.quiet;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // the find box, and on the games' tabs the store and the order
                if root.gl-view == 0: HorizontalLayout {
                    x: pws-x;
                    y: 14px;
                    width: pws-w;
                    height: 32px;
                    spacing: 10px;
                    alignment: end;
                    Rectangle {
                        width: 240px;
                        border-radius: 8px;
                        background: Ink.well;
                        Path {
                            x: 10px;
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: "M11.6 7a4.6 4.6 0 1 1-9.2 0 4.6 4.6 0 0 1 9.2 0ZM10.4 10.4 14 14";
                            fill: transparent;
                            stroke: Ink.quiet;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                        }
                        if gl-find-in.text == "": Text {
                            x: 32px;
                            height: parent.height;
                            text: root.gl-find-hint;
                            font-family: "Geist";
                            font-size: 13px;
                            color: #8a8a92;
                            vertical-alignment: center;
                        }
                        gl-find-in := TextInput {
                            x: 32px;
                            width: parent.width - 42px;
                            height: parent.height;
                            text <=> root.gl-query;
                            font-family: "Geist";
                            font-size: 13px;
                            color: Ink.ink;
                            vertical-alignment: center;
                            single-line: true;
                            changed has-focus => { Typing.on = self.has-focus; }
                            edited => { root.gl-find(self.text); }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    self.clear-focus();
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                    if root.gl-tab < 2: DropField {
                        width: root.gl-store-w;
                        height: 32px;
                        text: root.gl-store;
                        clicked(x, y, h) => { root.gl-store-menu(x, y, h); }
                    }
                    if root.gl-tab < 2: DropField {
                        width: root.gl-sort-w;
                        height: 32px;
                        text: root.gl-sort;
                        clicked(x, y, h) => { root.gl-sort-menu(x, y, h); }
                    }
                }
                for c[i] in root.gl-covers: LibCoverView {
                    c: c;
                    open => { root.gl-open(i); }
                    star => { root.gl-star(i); }
                }
                // the Apps tab: a row for each app, in a box of their own
                if root.gl-view == 0 && root.gl-apps.length > 0: Rectangle {
                    x: pws-x;
                    y: head-end + 6px;
                    width: pws-w;
                    height: root.gl-apps.length * 60px + 12px;
                    border-radius: 12px;
                    background: Ink.box;
                    for a[i] in root.gl-apps: Rectangle {
                        x: 6px;
                        y: 6px + i * 60px;
                        width: parent.width - 12px;
                        height: 60px;
                        border-radius: 8px;
                        background: row-ta.has-hover ? Ink.hover-box : transparent;
                        if a.has-icon: Image {
                            x: 12px;
                            y: 14px;
                            width: 32px;
                            height: 32px;
                            source: a.icon;
                        }
                        if !a.has-icon: Rectangle {
                            x: 12px;
                            y: 14px;
                            width: 32px;
                            height: 32px;
                            border-radius: 7px;
                            background: Ink.well;
                        }
                        Text {
                            x: 58px;
                            y: 11px;
                            width: parent.width - 58px - 220px;
                            height: 19px;
                            text: a.name;
                            font-family: "Geist";
                            font-size: 14px;
                            font-weight: 500;
                            color: Ink.ink;
                            overflow: elide;
                        }
                        Text {
                            x: 58px;
                            y: 31px;
                            width: parent.width - 58px - 220px;
                            height: 17px;
                            text: a.sub;
                            font-family: "Geist";
                            font-size: 12.5px;
                            color: Ink.quiet;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 40px - 200px;
                            width: 200px;
                            height: parent.height;
                            text: a.from;
                            font-family: "Geist";
                            font-size: 12.5px;
                            color: Ink.quiet;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Path {
                            x: parent.width - 26px;
                            y: (parent.height - 12px) / 2;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M4.5 2.5l3.5 3.5-3.5 3.5";
                            fill: transparent;
                            stroke: Ink.quiet;
                            stroke-width: 1.6px;
                            stroke-line-cap: round;
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.gl-open(i); }
                        }
                    }
                }
                // nothing to show: what's missing, and the way to it
                if root.gl-view == 0 && root.gl-empty != "": VerticalLayout {
                    x: pws-x;
                    y: head-end + 48px;
                    width: min(pws-w, 640px);
                    height: self.preferred-height;
                    spacing: 4px;
                    Text {
                        text: root.gl-empty;
                        font-family: "Geist";
                        font-size: 15px;
                        font-weight: 500;
                        color: Ink.dim;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.gl-empty-sub;
                        font-family: "Geist";
                        font-size: 14px;
                        color: Ink.quiet;
                        wrap: word-wrap;
                    }
                }
                // a page of its own: the game's picture, then its sections
                if root.gl-view == 1 && root.gl-has-hero: Rectangle {
                    x: pws-x;
                    y: head-end;
                    width: pws-w;
                    height: 240px;
                    border-radius: 12px;
                    background: Ink.box;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.gl-hero;
                    }
                    for f in root.gl-facts: Text {
                        x: parent.width - 24px - root.gl-facts-w + f.x;
                        y: parent.height - 22px - 17px;
                        height: 17px;
                        text: f.text;
                        font-family: "Geist";
                        font-size: 12.5px;
                        font-weight: f.strong ? 500 : 400;
                        color: f.strong ? Ink.ink : Ink.dim;
                        vertical-alignment: center;
                    }
                }
                // (a device's glyph at the rail's own size, drawn for it, not a larger one shrunk)
                for c in root.gl-cells: CellView {
                    c: c;
                    glyph: root.keyboard-glyph;
                    glyph2: root.mouse-glyph;
                    glyphs: root.package-glyphs;
                    glyph3: root.scene-glyph;
                    chips: root.scene-chips;
                    pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                    slide(id, v) => { root.cell-slide(id, v); }
                    typed(id, index, t) => { root.cell-typed(id, index, t); }
                }
            }
            // On this page: each section's name and what it changes for this game, beside the
            // sections; it scrolls with the page until it reaches the top, then stays in view
            if root.gl-view == 1 && root.gl-toc.length > 0: Rectangle {
                x: root.gl-toc-x;
                y: 56px + max(16px, root.gl-toc-top + gl-flick.viewport-y);
                width: root.gl-toc-w;
                height: toc-col.preferred-height;
                toc-col := VerticalLayout {
                    spacing: 0;
                    Text {
                        text: "ON THIS PAGE";
                        font-family: "Geist";
                        font-size: 12px;
                        font-weight: 500;
                        letter-spacing: 1.2px;
                        color: Ink.quiet;
                        x: 2px;
                    }
                    Rectangle { height: 10px; }
                    for t[i] in root.gl-toc: Rectangle {
                        height: toc-words.preferred-height;
                        border-radius: 8px;
                        background: toc-ta.has-hover ? Ink.box : transparent;
                        toc-words := VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 2px;
                            Text {
                                text: t.name;
                                font-family: "Geist";
                                font-size: 13.5px;
                                font-weight: 500;
                                color: Ink.dim;
                            }
                            Text {
                                text: t.sub;
                                font-family: "Geist";
                                font-size: 12.5px;
                                color: t.set ? Ink.soft : Ink.quiet;
                                wrap: word-wrap;
                            }
                        }
                        toc-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.gl-toc-jump(i); }
                        }
                    }
                    if root.gl-toc-foot != "": Rectangle { height: 14px; }
                    if root.gl-toc-foot != "": HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.gl-toc-foot;
                            font-family: "Geist";
                            font-size: 12.5px;
                            color: Ink.quiet;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            // the Library's bar: its name and tabs, or on a page of its own the way
            // back to the Library, the page's name, its star and Play
            Rectangle {
                y: 0;
                height: 56px;
                background: Ink.base;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 28px;
                    if root.gl-view == 0: Text {
                        horizontal-stretch: 0;
                        text: "Library";
                        font-family: "Geist";
                        font-size: 17px;
                        font-weight: 600;
                        letter-spacing: 0.17px;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                    if root.gl-view == 0: HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 2px;
                        for name[i] in ["Favorites", "Games", "Apps"]: Rectangle {
                            width: lt.width;
                            lt := Tab {
                                text: name;
                                selected: root.gl-tab == i;
                                clicked => { root.gl-tab-chosen(i); }
                            }
                            if root.gl-tab == i: Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                background: Ink.ink;
                            }
                        }
                    }
                    if root.gl-view == 1: HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 10px;
                        Rectangle {
                            width: up.preferred-width + 4px;
                            up := Text {
                                text: "Library";
                                font-family: "Geist";
                                font-size: 15px;
                                font-weight: 500;
                                color: up-ta.has-hover ? Ink.ink : Ink.quiet;
                                vertical-alignment: center;
                            }
                            up-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.gl-back(); }
                            }
                        }
                        Path {
                            y: (56px - 12px) / 2;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M4.5 2.5l3.5 3.5-3.5 3.5";
                            fill: transparent;
                            stroke: Ink.quiet;
                            stroke-width: 1.6px;
                            stroke-line-cap: round;
                        }
                        Text {
                            text: root.gl-name;
                            font-family: "Geist";
                            font-size: 17px;
                            font-weight: 600;
                            letter-spacing: 0.17px;
                            color: Ink.ink;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    // what was last done, or what went wrong, for a moment
                    Text {
                        horizontal-stretch: 1;
                        text: root.gl-said;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: root.gl-said-bad ? Ink.bad : Ink.quiet;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.gl-undo-shown: VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        BoxLink {
                            text: "Undo";
                            clicked => { root.gl-undo(); }
                        }
                    }
                    if root.gl-view == 0: HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        if root.gl-tab < 2: BarButton {
                            // two cards, one on another: every game at once
                            commands: "M2.5 5.5h7.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5h-7.5a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5zM4.5 3h8a1.5 1.5 0 0 1 1.5 1.5v7.5";
                            text: "Every game";
                            clicked => { root.gl-every-page(); }
                        }
                        BarButton {
                            commands: "M8 3v10M3 8h10";
                            round: true;
                            text: root.gl-tab < 2 ? "Add a game" : "Add an app";
                            clicked => { root.gl-add(); }
                        }
                    }
                    if root.gl-view == 1 && !root.gl-every: HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        alignment: center;
                        if root.gl-removable: VerticalLayout {
                            alignment: center;
                            BoxLink {
                                text: "Remove";
                                clicked => { root.gl-remove(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            StarButton {
                                on: root.gl-fav;
                                clicked => { root.gl-star-page(); }
                            }
                        }
                        if root.gl-playable: VerticalLayout {
                            alignment: center;
                            WordButton {
                                primary: true;
                                text: "Play";
                                icon: "M4 2.6v8.8c0 .5.5.8.9.5l7-4.4a.6.6 0 0 0 0-1L4.9 2.1c-.4-.3-.9 0-.9.5Z";
                                clicked => { root.gl-play(); }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Ink.line;
                }
            }
        }
        // Ectomatter's own settings, as the window lays them out
        set-flick := Flickable {
            visible: root.place == "settings";
            content-height: root.settings-h;
            mouse-drag-pan-enabled: false;
            for c in root.cells: CellView {
                c: c;
                glyph: root.keyboard-tile;
                glyph2: root.mouse-tile;
                glyphs: root.package-tiles;
                pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                slide(id, v) => { root.cell-slide(id, v); }
                typed(id, index, t) => { root.cell-typed(id, index, t); }
            }
        }

        Rectangle {
            visible: root.place == "z10";
            // the page scrolls under the device's bar, as the web page did
            flick := Flickable {
                y: 56px;
                height: parent.height - 56px;
                content-height: root.page-h;
                mouse-drag-pan-enabled: false;
                // over the keyboard: what to do on this tab, and Show rebindings
                Rectangle {
                    x: pws-x;
                    y: 12px;
                    width: pws-w;
                    height: head-h;
                    if root.boot != 0: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if root.boot == 1: Rectangle {
                            width: 16px;
                            Spinner {
                                y: (parent.height - 16px) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.boot-title;
                                font-family: "Geist";
                                font-size: 13.5px;
                                font-weight: 600;
                                color: root.boot == 2 ? Ink.bad : Ink.ink;
                            }
                            Text {
                                text: root.boot-text;
                                font-family: "Geist";
                                font-size: 12px;
                                color: Ink.quiet;
                            }
                        }
                    }
                    if root.boot == 0: HorizontalLayout {
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 10px;
                            if root.hint-chip-on: Rectangle {
                                width: 14px;
                                Image {
                                    y: (parent.height - 14px) / 2;
                                    width: 14px;
                                    height: 14px;
                                    source: root.hint-chip;
                                    image-fit: fill;
                                }
                            }
                            Text {
                                text: root.hint;
                                font-family: "Geist";
                                font-size: 12.5px;
                                color: root.hint-chip-on ? Ink.soft : Ink.quiet;
                                vertical-alignment: center;
                            }
                        }
                        if root.live: HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 6px;
                                Rectangle {
                                    y: (parent.height - 6px) / 2;
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Ink.good;
                                    opacity: 0.55 + 0.45 * cos(animation-tick() / 1600ms * 360deg);
                                }
                            }
                            Text {
                                text: "Showing on keyboard";
                                font-family: "Geist";
                                font-size: 12px;
                                color: Ink.good;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // whether rebound keys show their new actions on the keyboard
                        if root.tab < 2: Rectangle {
                            width: 28px + rebind-words.preferred-width;
                            Rectangle {
                                x: 0;
                                y: (parent.height - 18px) / 2;
                                width: 18px;
                                height: 18px;
                                border-radius: 5px;
                                background: root.show-rebindings-on ? Ink.dim : rebind-ta.has-hover ? Ink.hover-box : Ink.well;
                                border-width: root.show-rebindings-on ? 0 : 1px;
                                border-color: #4a4a52;
                                if root.show-rebindings-on: Path {
                                    width: 18px;
                                    height: 18px;
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                                    fill: transparent;
                                    stroke: Ink.base;
                                    stroke-width: 2px;
                                }
                            }
                            rebind-words := Text {
                                x: 28px;
                                text: "Show rebindings";
                                font-family: "Geist";
                                font-size: 13px;
                                color: Ink.dim;
                                vertical-alignment: center;
                            }
                            rebind-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-rebindings(); }
                            }
                        }
                        // on Screen, what it is doing now, a dot that breathes while
                        // Ectomatter plays it; then Pause, which holds the screen as it
                        // is, and Play, which carries on
                        if root.tab == 3 && root.screen-status != "": Text {
                            horizontal-stretch: 0;
                            text: root.screen-status;
                            font-family: "Geist";
                            font-size: 12.5px;
                            color: Ink.soft;
                            vertical-alignment: center;
                        }
                    }
                }

                // the anchoring column: the profiles, saving, and on Keys the layers
                anchor := AnchorColumn {
                    visible: root.boot == 0 && root.tab != 2;
                    x: pws-x;
                    y: root.tab == 3 ? head-end : under-top;
                    width: anchor-w;
                    profiles: root.profiles;
                    has-menu: true;
                    choose(n) => { root.choose-profile(n); }
                    rename(t) => { root.rename-profile(t); }
                    menu(x, y, h) => { root.kb-profile-menu(x, y, h); }
                }

                // Keys: the Key library, and beside it Game mode, or the chosen key or slider
                if root.tab == 0 && root.boot == 0: KeyLibrary {
                    x: under-x;
                    y: under-top;
                    layer: root.layer;
                    reveal-y: root.lib-reveal-y;
                    reveal-n: root.lib-reveal-n;
                    layer-chosen(i) => { root.layer-changed(i); }
                    width: lib-w;
                    height: lib-h;
                    groups: root.lib-groups;
                    query <=> root.lib-query;
                    toggle(g) => { root.lib-toggle(g); }
                    find(t) => { root.lib-find(t); }
                    pick(id) => { if (id >= 0) { root.key-clicked(id); } else { root.slider-chosen-at(-id); } }
                }
                key-tile := ScrollBox {
                    visible: root.tab == 0 && root.boot == 0;
                    // Game mode in the Profiles box's darker shade; a key or a slider in a box's
                    fill: !root.key-open && root.slider-chosen == 0 ? Ink.well : Ink.box;
                    x: under-x + (second-fits ? lib-w + 12px : 0);
                    y: under-top + (second-fits ? 0 : keys-h + 12px);
                    width: second-w;
                    height: second-h;
                    need: second-need;
                    if !root.key-open && root.slider-chosen == 0: GameBox {
                        width: parent.width;
                        height: max(second-need, second-h);
                        fill: transparent;
                        items: root.game-items;
                        toggled(i) => { root.game-toggled(i); }
                    }
                    if root.key-open: KeyDetail {
                        width: parent.width;
                        height: max(second-need, second-h);
                        fill: transparent;
                        title: root.key-name;
                        cap: root.key-cap;
                        factory: root.key-factory;
                        state: root.key-state;
                        rebound: root.key-rebound;
                        layer-title: root.layer == 1 ? "Function layer" : "Base layer";
                        layer-rebound: root.layer-rebound;
                        kind: root.key-kind;
                        job: root.key-job;
                        listening: root.key-listening;
                        menu-open: root.menu-open;
                        note: root.key-note;
                        done => { root.board-clicked(); }
                        reset => { root.reset-key(); }
                        kind-picked(i, x, y, h) => { root.kind-picked(i, x, y, h); }
                        job-clicked(x, y, h) => { root.action-menu(root.layer, x, y, h); }
                        record => { root.listen(root.layer); }
                    }
                    if root.slider-chosen != 0: SliderDetail {
                        width: parent.width;
                        height: max(second-need, second-h);
                        fill: transparent;
                        title: root.slider-chosen == 1 ? "Dimmer" : "Volume";
                        side: root.slider-chosen == 1 ? "left" : "right";
                        at: root.slider-at;
                        choices: root.slider-choices;
                        note: root.slider-note;
                        done => { root.slider-chosen-at(0); }
                        picked(i) => { root.slider-bind-at(i); }
                    }
                }
                // the Lighting page: the effects, the chosen one's settings, and where and when it plays
                if root.tab == 1 && root.boot == 0: ScrollBox {
                    x: under-x;
                    y: under-top;
                    width: 300px;
                    height: lrow0;
                    need: lfx-h;
                    EffectGrid {
                        width: parent.width;
                        height: max(lfx-h, lrow0);
                        fill: transparent;
                        effects: root.effects;
                        moving: root.effect-moves;
                        chose(i) => { root.effect(i); }
                    }
                }
                if root.tab == 1 && root.boot == 0: ScrollBox {
                    x: under-x + lx1;
                    y: under-top + (lr1 == 0 ? 0 : lrow0 + 12px);
                    width: 360px;
                    height: lr1 == 0 ? lrow0 : lrow1;
                    need: root.set-h;
                    PageBox {
                        width: parent.width;
                        height: max(root.set-h, lr1 == 0 ? lrow0 : lrow1);
                        fill: transparent;
                        title: root.light-title;
                        for c in root.cells: CellView {
                            c: c;
                            pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                            slide(id, v) => { root.cell-slide(id, v); }
                        }
                    }
                }
                if root.tab == 1 && root.boot == 0 && root.light-kind == 0: ScrollBox {
                    x: under-x + lx2;
                    y: under-top + (lr2 == 0 ? 0 : lr2 == 1 ? lrow0 + 12px : lrow0 + 12px + lrow1 + 12px);
                    width: 320px;
                    height: lr2 == 0 ? lrow0 : lr2 == 1 ? lrow1 : lrow2;
                    need: root.place-h;
                    PageBox {
                        width: parent.width;
                        height: max(root.place-h, lr2 == 0 ? lrow0 : lr2 == 1 ? lrow1 : lrow2);
                        fill: transparent;
                        title: root.place-title;
                        for c in root.place-cells: CellView {
                            c: c;
                            pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                            slide(id, v) => { root.cell-slide(id, v); }
                            hovered(i, on) => { root.area-hover(i, on); }
                        }
                    }
                }
                // Screen, the right column: the tabs of the screen's two states over its dark box,
                // the playlist's panel in the box under the screen, and the Library joined to the
                // box's foot. (All in one part of the window, so a screen carried from the Library
                // knows where the panel is.)
                if root.tab == 3: stage := Rectangle {
                    x: under-x;
                    y: head-end;
                    width: under-w;
                    height: tabs-h + box-h + (shelf-on ? shelf-h : 0);
                    // a screen carried to `wx`, `wy` in the window: where the pointer holds it
                    // here, and where that is along the strip (anywhere over the panel, it can land);
                    // on the second tab, whether it is over the screen, where it lands there; and
                    // on either, the place in the Library under it
                    function carry-to(wx: length, wy: length) {
                        root.carry-x = wx - self.absolute-position.x;
                        root.carry-y = wy - self.absolute-position.y;
                        if (root.screen-game) {
                            root.gl-carry-move(
                                wx < game-panel.absolute-position.x || wx > game-panel.absolute-position.x + game-panel.width ? -1
                                : wy >= game-panel.absolute-position.y + 6px && wy < game-panel.absolute-position.y + 48px ? 0
                                : wy >= game-panel.absolute-position.y + 48px && wy < game-panel.absolute-position.y + 92px ? 1 : -1,
                                self.shelf-at(root.carry-x, root.carry-y));
                        } else if (root.screen-closed) {
                            root.pl-carry-move(0,
                                wx > screen-bay.absolute-position.x && wx < screen-bay.absolute-position.x + screen-bay.width
                                && wy > screen-bay.absolute-position.y && wy < screen-bay.absolute-position.y + screen-bay.height,
                                self.shelf-at(root.carry-x, root.carry-y));
                        } else {
                            root.pl-carry-move(wx - strip.absolute-position.x,
                                wx > panel.absolute-position.x && wx < panel.absolute-position.x + panel.width
                                && wy > panel.absolute-position.y - 20px && wy < panel.absolute-position.y + panel.height + 40px,
                                self.shelf-at(root.carry-x, root.carry-y));
                        }
                    }
                    // the Library's place at `lx`, `ly` here, counted as its cards are laid (two to a
                    // row, or one), past its last card the last; -1 off the Library
                    function shelf-at(lx: length, ly: length) -> int {
                        if (!shelf-on || lx < 0 || lx > under-w || ly < tabs-h + box-h || ly > tabs-h + box-h + shelf-h) {
                            return -1;
                        }
                        return max(0, floor((ly - tabs-h - box-h - 48px + 4px) / 104px)) * (shelf-two ? 2 : 1) + (shelf-two && lx > under-w / 2 ? 1 : 0);
                    }
                    // let go: over the panel, the carried name settles into its room and then
                    // the screen takes its place; over the Library, into its card's place, where
                    // the card's own name sits; away from both, nothing changes
                    function drop-carry() {
                        if (root.pl-slot-w > 0) {
                            root.carry-settle = true;
                            root.carry-x = panel.x + strip.x + root.pl-slot-x + root.carry-gx;
                            root.carry-y = panel.y + strip.y + 30px + root.carry-gy;
                            settle.running = true;
                        } else if (root.lib-gap >= 0) {
                            root.carry-settle = true;
                            root.carry-x = 16px + (shelf-two ? mod(root.lib-gap, 2) * ((under-w - 40px) / 2 + 8px) : 0) + 288px + root.carry-gx;
                            root.carry-y = tabs-h + box-h + 48px + (shelf-two ? floor(root.lib-gap / 2) : root.lib-gap) * 104px + 16px + root.carry-gy;
                            settle.running = true;
                        } else {
                            root.carry-on = false;
                            root.pl-carry-drop();
                        }
                    }
                    settle := Timer {
                        interval: 160ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            root.carry-settle = false;
                            root.carry-on = false;
                            root.pl-carry-drop();
                        }
                    }
                    // the screen's two states, as folder tabs on the box's top
                    HorizontalLayout {
                        x: 0;
                        y: 0;
                        height: tabs-h;
                        spacing: 4px;
                        alignment: start;
                        StateTab {
                            text: "Playlist";
                            open: !root.screen-closed && !root.screen-game;
                            first: true;
                            clicked => {
                                root.screen-closed = false;
                                root.screen-game = false;
                                root.screen-state();
                            }
                        }
                        StateTab {
                            text: "Onboard layout";
                            open: root.screen-closed;
                            clicked => {
                                root.screen-closed = true;
                                root.screen-game = false;
                                root.screen-state();
                            }
                        }
                        StateTab {
                            text: "Game launch";
                            open: root.screen-game;
                            clicked => {
                                root.screen-closed = false;
                                root.screen-game = true;
                                root.screen-state();
                            }
                        }
                    }
                    // Layouts' gray behind the box's lower corners, where the two meet
                    Rectangle {
                        visible: shelf-on;
                        y: tabs-h + box-h - 12px;
                        height: 24px;
                        background: Ink.box;
                    }
                    // the screen's box (square at its top left under the first tab, open)
                    Rectangle {
                        y: tabs-h;
                        height: box-h;
                        border-radius: 12px;
                        border-top-left-radius: !root.screen-closed && !root.screen-game ? 0 : 12px;
                        background: Ink.well;
                        // the bay the screen is set into, between plain walls: the screen's own
                        // background color, its corners rounded inside the box's, its top edge
                        // shaded as a step down into it
                        screen-bay := Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: bay-pad;
                            width: lcd-w + 2 * kb-pad-y;
                            height: lcd-h + 2 * kb-pad-y;
                            border-radius: 10px;
                            background: root.lcd-field;
                            animate background { duration: 450ms; easing: ease; }
                            border-width: 1px;
                            border-color: #0000008c;
                            clip: true;
                            // (at the top: an element placed nowhere sits in the middle)
                            Rectangle {
                                y: 0;
                                height: 14px;
                                background: @linear-gradient(180deg, #00000073 0%, #00000000 100%);
                            }
                        }
                        // a layout carried over the screen on the second tab: ringed, as where it lands
                        if root.ob-over: Rectangle {
                            x: screen-bay.x - 3px;
                            y: screen-bay.y - 3px;
                            width: screen-bay.width + 6px;
                            height: screen-bay.height + 6px;
                            border-radius: 13px;
                            border-width: 2px;
                            border-color: Ink.soft;
                        }
                        Rectangle {
                            x: (parent.width - lcd-w) / 2;
                            y: bay-pad + kb-pad-y;
                            width: lcd-w;
                            height: lcd-h;
                            border-radius: 4px;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.lcd-big;
                            }
                        }
                    }

                    // ---------------------------------------------------- Game launch's rows
                    // in the box under the screen, as the playlist's panel is: a row for a game
                    // starting and one for a game quitting, each with its checkbox (unchecked, the
                    // row shows nothing), its words, the layout's bar (select it to see the layout
                    // on the screen above, again to let go; drag a layout from Layouts onto it to
                    // show that one) and until when
                    game-panel := Rectangle {
                        visible: root.screen-game;
                        y: band-y;
                        height: 96px;
                        for g[i] in root.gl-rows: Rectangle {
                            x: 24px;
                            y: 13px + i * 40px;
                            width: parent.width - 48px;
                            height: 30px;
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    CheckBox {
                                        width: 17px;
                                        on: g.on;
                                        clicked => { root.gl-row-on(i); }
                                    }
                                }
                                Text {
                                    text: g.words;
                                    font-family: "Geist";
                                    font-size: 13px;
                                    color: Ink.soft;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 230px;
                                        height: 24px;
                                        border-radius: 6px;
                                        opacity: g.on ? 1 : 0.45;
                                        background: g.chosen ? (bar-ta.has-hover ? #55555e : #4a4a52) : bar-ta.has-hover ? Ink.pick : Ink.hover-box;
                                        border-width: g.over ? 2px : 0;
                                        border-color: Ink.soft;
                                        clip: true;
                                        Rectangle {
                                            x: 0;
                                            width: 26px;
                                            background: #ffffff0a;
                                            Path {
                                                width: 12px;
                                                height: 12px;
                                                viewbox-width: 12;
                                                viewbox-height: 12;
                                                commands: "M2.7 2.5h6.6a1.2 1.2 0 0 1 1.2 1.2v4.6a1.2 1.2 0 0 1-1.2 1.2H2.7a1.2 1.2 0 0 1-1.2-1.2V3.7a1.2 1.2 0 0 1 1.2-1.2zM3.5 5h5M3.5 7h3";
                                                fill: transparent;
                                                stroke: Ink.soft;
                                                stroke-width: 1.2px;
                                            }
                                        }
                                        Text {
                                            x: 35px;
                                            width: parent.width - 44px;
                                            height: parent.height;
                                            text: g.layout;
                                            font-family: "Geist";
                                            font-size: 12.5px;
                                            font-weight: 500;
                                            color: Ink.ink;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        bar-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.gl-row-pick(i); }
                                        }
                                    }
                                }
                                Text {
                                    text: "until";
                                    font-family: "Geist";
                                    font-size: 13px;
                                    color: Ink.soft;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    DropField {
                                        width: 250px;
                                        height: 28px;
                                        opacity: g.on ? 1 : 0.45;
                                        text: g.until;
                                        clicked(x, y, h) => { root.gl-row-until(i, x, y, h); }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------- the playlist's panel
                    // attached under the screen's box, as wide as the box, in the boxes' gray (over
                    // the box's foot, so what opens from the panel rises over the box). One row:
                    // Pause, which playlist, then one round of it, left to right, each turn as long
                    // as its time, and the round starting again after it.
                    panel := Rectangle {
                        visible: !root.screen-closed && !root.screen-game;
                        y: band-y;
                        height: pl-panel-h;
                        // Pause, at the playlist's right end, after the round's start again
                        PlayButton {
                            x: parent.width - 16px - self.width;
                            y: 14px;
                            paused: root.lcd-state == 1;
                            clicked => { root.lcd-pause(); }
                        }
                        // which playlist the profile plays: select it to choose another, or to
                        // make, rename or delete one
                        if !root.pl-renaming: Rectangle {
                            x: 16px;
                            y: 14px;
                            width: root.pl-chooser-w;
                            height: 28px;
                            border-radius: 7px;
                            background: cho-ta.has-hover || root.pl-choosing ? Ink.hover-well : transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 33px;
                                height: parent.height;
                                text: root.pl-name;
                                font-family: "Geist";
                                font-size: 13px;
                                font-weight: 500;
                                color: Ink.bright;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Path {
                                x: parent.width - 18px;
                                y: 9px;
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                commands: "M2 3.5l3 3 3-3";
                                fill: transparent;
                                stroke: Ink.soft;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                            cho-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.pl-choose(self.absolute-position.x, self.absolute-position.y, self.height); }
                            }
                        }
                        // the playlist's name changed in place: Enter, the tick or a press away keeps
                        // it, Escape lets it go
                        if root.pl-renaming: Rectangle {
                            x: 16px;
                            y: 14px;
                            width: 195px;
                            height: 28px;
                            border-radius: 7px;
                            background: Ink.box;
                            border-width: 1px;
                            border-color: #4a4a52;
                            TouchArea {
                                mouse-cursor: text;
                                clicked => { ren-in.focus(); }
                            }
                            ren-in := TextInput {
                                x: 10px;
                                width: 160px;
                                height: parent.height;
                                text <=> root.pl-rename-text;
                                font-family: "Geist";
                                font-size: 13px;
                                font-weight: 500;
                                color: Ink.bright;
                                vertical-alignment: center;
                                single-line: true;
                                init => {
                                    self.focus();
                                    self.select-all();
                                }
                                changed has-focus => { Typing.on = self.has-focus; }
                                accepted => { root.pl-rename-done(true, self.text); }
                                key-pressed(e) => {
                                    if (e.text == Key.Escape) {
                                        root.pl-rename-done(false, self.text);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            Rectangle {
                                x: 170px;
                                y: 3px;
                                width: 22px;
                                height: 22px;
                                border-radius: 5px;
                                background: ok-ta.has-hover ? Ink.hover-well : transparent;
                                Path {
                                    x: 4.5px;
                                    y: 4.5px;
                                    width: 13px;
                                    height: 13px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: "M5 12.5l4.5 4.5L19 7.5";
                                    fill: transparent;
                                    stroke: ok-ta.has-hover ? Ink.bright : Ink.dim;
                                    stroke-width: 2px;
                                    stroke-line-cap: round;
                                    stroke-line-join: round;
                                }
                                ok-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pl-rename-done(true, ren-in.text); }
                                }
                            }
                        }
                        // the round starting again, after the strip (before Pause)
                        Path {
                            visible: !root.pl-single && !root.pl-empty && root.pl-sizing < 0;
                            x: parent.width - 16px - 28px - 8px - 20px;
                            y: 18px;
                            width: 20px;
                            height: 20px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M20 12a8 8 0 1 1-2.6-5.9M20 4v4.5h-4.5";
                            fill: transparent;
                            stroke: Ink.quiet;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                        // the strip: every turn one piece, its way bar then its screen's bar with the
                        // screen's name on it; then an empty bar to add to. (16 above the bars' row
                        // as well, for a turn's time and buttons, which rise over the screen's box.)
                        strip := Rectangle {
                            x: root.pl-track-x;
                            y: -16px;
                            width: root.pl-track-w;
                            height: 16px + pl-panel-h;
                            // where a carried layout will land: one empty bar in the box's shade (as the
                            // holding bar; the screen's charcoal wouldn't show on the box's), the turn's
                            // whole room, the others making room
                            if root.pl-slot-w > 0: Rectangle {
                                x: root.pl-slot-x - root.pl-pre;
                                y: 32px;
                                width: root.pl-pre + root.pl-slot-w;
                                height: 24px;
                                animate x, width { duration: 250ms; easing: ease; }
                                border-radius: 5px;
                                background: Ink.box;
                            }
                            // the empty holding bar, at the strip's end: a turn's room, a step lighter than
                            // the screen's charcoal it sits on, with a "+": select it for a menu of the
                            // layouts to add. The whole strip while the playlist is empty, saying how to fill it.
                            if root.pl-hold-w > 0: Rectangle {
                                x: root.pl-hold-x;
                                y: 32px;
                                width: root.pl-hold-w;
                                height: 24px;
                                animate x, width { duration: root.pl-live ? 0ms : 250ms; easing: ease; }
                                border-radius: 5px;
                                property <bool> lit: (hold-ta.has-hover || root.pl-adding) && !root.carry-on;
                                background: hold-ta.pressed ? Ink.pick : self.lit ? Ink.hover-box : Ink.box;
                                animate background { duration: 120ms; }
                                Path {
                                    x: root.pl-empty ? 10px : (parent.width - 12px) / 2;
                                    y: 6px;
                                    width: 12px;
                                    height: 12px;
                                    viewbox-width: 12;
                                    viewbox-height: 12;
                                    commands: "M6 2v8M2 6h8";
                                    fill: transparent;
                                    stroke: parent.lit ? Ink.bright : Ink.soft;
                                    stroke-width: 1.6px;
                                    stroke-line-cap: round;
                                }
                                if root.pl-empty: Text {
                                    x: 28px;
                                    width: parent.width - 38px;
                                    height: parent.height;
                                    text: "Add a screen layout, or drag one here from Layouts.";
                                    font-family: "Geist";
                                    font-size: 12.5px;
                                    color: parent.lit ? Ink.dim : Ink.quiet;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                hold-ta := TouchArea {
                                    enabled: !root.carry-on;
                                    mouse-cursor: pointer;
                                    clicked => { root.pl-hold-menu(self.absolute-position.x, self.absolute-position.y, self.height); }
                                }
                            }
                            for b[i] in root.pl-blocks: turn := Rectangle {
                                x: b.x - root.pl-pre;
                                width: root.pl-pre + b.w;
                                animate x, width { duration: root.pl-live ? 0ms : 250ms; easing: ease; }
                                opacity: b.away ? 0 : root.pl-dim ? 0.3 : 1;
                                animate opacity { duration: 120ms; }
                                // the pointer on the screen's part or on the way bar: each lights the
                                // other a step, so the two read as one; the way bar lit while its menu
                                // is open or the screen is coming in
                                property <bool> hov: sta.has-hover && !root.carry-on && root.pl-sizing < 0 && !root.pl-dim;
                                property <bool> way-hov: wta.has-hover && !root.carry-on && root.pl-sizing < 0 && !root.pl-dim;
                                property <bool> lit: root.pl-menu == i || (b.on && root.pl-head && root.pl-in);
                                // how the screen comes in: the turn's start (grayed while the turn is the
                                // only one, when nothing comes in after it, but still to be chosen)
                                Rectangle {
                                    x: 0;
                                    y: 32px;
                                    width: root.pl-way-w;
                                    height: 24px;
                                    opacity: root.pl-single && !(turn.way-hov || turn.hov || turn.lit) ? 0.45 : 1;
                                    animate opacity { duration: 120ms; }
                                    border-top-left-radius: 5px;
                                    border-bottom-left-radius: 5px;
                                    background: turn.lit ? Ink.pick-hover : turn.way-hov || turn.hov ? Ink.pick : Ink.hover-box;
                                    animate background { duration: 120ms; }
                                    WayGlyph {
                                        x: (parent.width - 12px) / 2;
                                        y: 6px;
                                        way: b.way;
                                        ink: turn.lit || turn.way-hov ? Ink.bright : turn.hov ? Ink.dim : Ink.soft;
                                    }
                                }
                                // the screen's bar, a hairline after its way in, the screen's name on it
                                // (none on a bar too short for a letter or two)
                                Rectangle {
                                    x: root.pl-pre;
                                    y: 32px;
                                    width: b.w;
                                    height: 24px;
                                    border-top-right-radius: 5px;
                                    border-bottom-right-radius: 5px;
                                    background: b.on ? (turn.hov || turn.way-hov ? #5c5c66 : #52525b) : (turn.hov || turn.way-hov ? Ink.pick-hover : Ink.pick);
                                    animate background { duration: 120ms; }
                                    // its name, then its time at its end, short of the end's handle: its
                                    // seconds, or the infinity mark for a turn that stays until the layouts
                                    // are switched (the time left off a bar too short to keep some of the
                                    // name beside it, and both off one too short for a letter or two)
                                    if b.w >= 28px: HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            text: b.name;
                                            font-family: "Geist";
                                            font-size: 12px;
                                            font-weight: b.on ? 600 : 400;
                                            color: b.on ? Ink.bright : turn.hov ? Ink.dim : Ink.soft;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if b.time != "" && b.w >= 64px: Text {
                                            text: b.time;
                                            font-family: "Geist";
                                            font-size: 11px;
                                            color: b.on ? Ink.dim : turn.hov ? Ink.soft : Ink.quiet;
                                            vertical-alignment: center;
                                        }
                                        if b.stays && !root.pl-single && b.w >= 34px: Rectangle {
                                            width: 17.6px;
                                            Path {
                                                y: (parent.height - 8px) / 2;
                                                width: 17.6px;
                                                height: 8px;
                                                viewbox-x: 1;
                                                viewbox-y: 7;
                                                viewbox-width: 22;
                                                viewbox-height: 10;
                                                commands: "M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z";
                                                fill: transparent;
                                                stroke: b.on ? Ink.dim : turn.hov ? Ink.soft : Ink.quiet;
                                                stroke-width: 1.5px;
                                            }
                                        }
                                    }
                                }
                                // the playhead: across the way bar while the screen comes in, then along
                                // the screen's bar (under the turn's time and buttons)
                                if b.on && root.pl-head && !b.away: Rectangle {
                                    x: (root.pl-in ? root.pl-pre * root.pl-p : root.pl-pre + b.w * root.pl-p) - 1px;
                                    y: 26px;
                                    width: 2px;
                                    height: 36px;
                                    border-radius: 1px;
                                    background: Ink.bright;
                                    opacity: root.carry-on ? 0.3 : 1;
                                    Rectangle {
                                        x: -4px;
                                        y: -4px;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: Ink.bright;
                                    }
                                }
                                // select the turn to show it now; drag it along the strip to move it
                                // (the turn carried keeps the press it was carried with, unseen, until
                                // it lands: switched off then, the drag would end under the hand)
                                sta := TouchArea {
                                    enabled: (!b.away || root.carry-on) && !root.pl-dim;
                                    // (the open hand at rest, as a turn is there to be carried; Grant, 2026-10-16)
                                    mouse-cursor: root.carry-on ? MouseCursor.grabbing : MouseCursor.grab;
                                    property <bool> far;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            self.far = false;
                                        }
                                        if (e.kind == PointerEventKind.up) {
                                            if (root.carry-on) {
                                                stage.drop-carry();
                                            } else if (!self.far) {
                                                root.page-show(i);
                                            }
                                        }
                                        if (e.kind == PointerEventKind.cancel && root.carry-on) {
                                            root.carry-on = false;
                                            root.pl-carry-cancel();
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            if (!root.carry-on && !self.far && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                                                self.far = true;
                                                root.carry-gx = 18px;
                                                root.carry-gy = 14px;
                                                root.carry-settle = false;
                                                root.carry-on = true;
                                                root.pl-carry-start(0, i);
                                            }
                                            if (root.carry-on) {
                                                stage.carry-to(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    // its time, then Edit and Remove, over its bar while the pointer is on
                                    // the turn or its time's menu is open; only the time while its end is
                                    // dragged. The time opens its menu of times while there are other turns.
                                    // (Inside the turn's TouchArea, so the turn keeps the pointer while it
                                    // is on them.)
                                    if (turn.hov || root.pl-sizing == i || root.pl-timing == i) && !b.away: tb := Rectangle {
                                        property <bool> buttons: root.pl-sizing != i;
                                        property <bool> times: self.buttons && !root.pl-single;
                                        x: root.pl-pre + (b.w - self.width) / 2;
                                        y: 0;
                                        width: 2px + time-button.width + (self.buttons ? 1px + 20px + 21px : 0) + 2px;
                                        height: 24px;
                                        border-radius: 7px;
                                        background: Ink.pop;
                                        drop-shadow-blur: 16px;
                                        drop-shadow-offset-y: 6px;
                                        drop-shadow-color: #00000059;
                                        time-button := Rectangle {
                                            x: 2px;
                                            y: 2px;
                                            width: 6px + secs-text.preferred-width + (tb.times ? 3px + 10px + 5px : 6px);
                                            height: 20px;
                                            border-radius: 5px;
                                            background: !tb.times ? transparent : time-ta.pressed || root.pl-timing == i ? Ink.pick : time-ta.has-hover ? Ink.hover-box : transparent;
                                            secs-text := Text {
                                                x: 6px;
                                                height: parent.height;
                                                text: b.secs;
                                                font-family: "Geist";
                                                font-size: 12px;
                                                color: Ink.bright;
                                                vertical-alignment: center;
                                            }
                                            if tb.times: Path {
                                                x: 6px + secs-text.preferred-width + 3px;
                                                y: 5px;
                                                width: 10px;
                                                height: 10px;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                commands: "M6 9l6 6 6-6";
                                                fill: transparent;
                                                stroke: time-ta.has-hover || root.pl-timing == i ? Ink.bright : Ink.soft;
                                                stroke-width: 2px;
                                            }
                                            time-ta := TouchArea {
                                                enabled: tb.times;
                                                mouse-cursor: tb.times ? MouseCursor.pointer : MouseCursor.default;
                                                clicked => { root.pl-time(i, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                                            }
                                        }
                                        if tb.buttons: StripIcon {
                                            x: 2px + time-button.width + 1px;
                                            y: 2px;
                                            commands: "M4 20h4L19 9l-4-4L4 16z";
                                            clicked => { root.screen-edit(i); }
                                        }
                                        if tb.buttons: StripIcon {
                                            x: 2px + time-button.width + 1px + 21px;
                                            y: 2px;
                                            commands: "M6 6l12 12M18 6L6 18";
                                            clicked => { root.page-remove(i); }
                                        }
                                    }
                                    // the bar's right end: drag it to make the turn longer or shorter
                                    if !root.pl-single && !b.away && !root.pl-dim: Rectangle {
                                        x: parent.width - 10px;
                                        y: 32px;
                                        width: 10px;
                                        height: 24px;
                                        Rectangle {
                                            x: 4px;
                                            y: 7px;
                                            width: 2px;
                                            height: 10px;
                                            border-radius: 1px;
                                            background: Ink.bright;
                                            opacity: turn.hov || root.pl-sizing == i ? 0.8 : 0;
                                            animate opacity { duration: 120ms; }
                                        }
                                        TouchArea {
                                            enabled: !root.carry-on;
                                            mouse-cursor: MouseCursor.ew-resize;
                                            // (measured in the window: the end moves with the drag)
                                            property <length> from;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    self.from = self.absolute-position.x + self.mouse-x;
                                                }
                                                if ((e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.pl-sizing == i) {
                                                    root.pl-sizing = -1;
                                                    root.pl-size-done();
                                                }
                                            }
                                            moved => {
                                                if (self.pressed) {
                                                    root.pl-sizing = i;
                                                    root.pl-size(i, self.absolute-position.x + self.mouse-x - self.from);
                                                }
                                            }
                                        }
                                    }
                                }
                                // the way bar: select it to choose how the screen comes in
                                wta := TouchArea {
                                    enabled: !b.away && !root.pl-dim && !root.carry-on;
                                    x: 0;
                                    y: 16px;
                                    width: root.pl-way-w;
                                    height: 40px;
                                    mouse-cursor: pointer;
                                    clicked => { root.pl-mark(i, self.absolute-position.x, self.absolute-position.y + 16px, 24px); }
                                }
                                // its name over it while the pointer is on it (not while its menu is open)
                                if turn.way-hov && root.pl-menu != i: Rectangle {
                                    x: (root.pl-way-w - self.width) / 2;
                                    y: 4px;
                                    width: wn-text.preferred-width + 14px;
                                    height: 20px;
                                    border-radius: 6px;
                                    background: Ink.pop;
                                    wn-text := Text {
                                        x: 7px;
                                        height: parent.height;
                                        text: b.way-name;
                                        font-family: "Geist";
                                        font-size: 12px;
                                        color: Ink.bright;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            // a script's screen on the keyboard: the strip waits, and says so
                            if root.pl-dim: Rectangle {
                                property <length> tw: pill-text.preferred-width;
                                property <length> bw: back-text.preferred-width + 20px;
                                x: (parent.width - self.width) / 2;
                                y: 26px;
                                width: 14px + self.tw + 12px + self.bw + 4px;
                                height: 36px;
                                border-radius: 9px;
                                background: Ink.pop;
                                drop-shadow-blur: 24px;
                                drop-shadow-offset-y: 8px;
                                drop-shadow-color: #00000059;
                                pill-text := Text {
                                    x: 14px;
                                    height: parent.height;
                                    text: root.pl-script;
                                    font-family: "Geist";
                                    font-size: 13px;
                                    color: Ink.bright;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: 14px + parent.tw + 12px;
                                    y: 4px;
                                    width: parent.bw;
                                    height: 28px;
                                    border-radius: 7px;
                                    background: back-ta.pressed ? Ink.pick : back-ta.has-hover ? Ink.pick-hover : Ink.hover-box;
                                    back-text := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Back to the playlist";
                                        font-family: "Geist";
                                        font-size: 13px;
                                        color: Ink.bright;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    back-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pl-back(); }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------- the onboard layout
                    // the second tab's row under the screen, where the first has the playlist: the
                    // chooser of the layout the profile keeps on the keyboard, and the line beside
                    // it; on a keyboard without build 5, what the keyboard needs instead
                    if root.screen-closed: Rectangle {
                        y: band-y;
                        height: pl-panel-h;
                        if root.ob-ready: Rectangle {
                            x: 16px;
                            y: 14px;
                            width: root.ob-chooser-w;
                            height: 28px;
                            border-radius: 7px;
                            background: ob-ta.has-hover || root.ob-choosing ? Ink.hover-well : transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 33px;
                                height: parent.height;
                                text: root.ob-name;
                                font-family: "Geist";
                                font-size: 13px;
                                font-weight: 500;
                                color: Ink.bright;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Path {
                                x: parent.width - 18px;
                                y: 9px;
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                commands: "M2 3.5l3 3 3-3";
                                fill: transparent;
                                stroke: Ink.soft;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                            ob-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.ob-choose(self.absolute-position.x, self.absolute-position.y, self.height); }
                            }
                        }
                        if root.ob-ready: Text {
                            x: 16px + root.ob-chooser-w + 24px;
                            y: 14px;
                            width: parent.width - self.x - 16px;
                            height: 28px;
                            text: root.ob-say;
                            font-family: "Geist";
                            font-size: 12.5px;
                            color: Ink.quiet;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.ob-ready: Rectangle {
                            x: 24px;
                            y: 14px;
                            width: parent.width - 48px;
                            height: 28px;
                            Path {
                                x: 0;
                                y: 7px;
                                width: 14px;
                                height: 14px;
                                viewbox-width: 14;
                                viewbox-height: 14;
                                commands: "M7 1.4a5.6 5.6 0 1 0 0 11.2a5.6 5.6 0 1 0 0-11.2zM7 6.2v3.6M7 4.3v0.1";
                                fill: transparent;
                                stroke: Ink.soft;
                                stroke-width: 1.3px;
                                stroke-line-cap: round;
                            }
                            Text {
                                x: 23px;
                                width: parent.width - self.x;
                                height: parent.height;
                                text: "Onboard layouts need Ectomatter’s firmware on the keyboard. Until then, the keyboard shows EVGA’s status screen when Ectomatter isn’t running.";
                                font-family: "Geist";
                                font-size: 12.5px;
                                color: Ink.soft;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // ---------------------------------------------------- the Library
                    // every screen there is, two to a row; drag one onto the playlist to play it,
                    // or put it on the playlist's end from its card; an empty block after them
                    // for a new one
                    if root.boot == 0: PageBox {
                        visible: shelf-on;
                        x: 0;
                        y: tabs-h + box-h;
                        width: under-w;
                        height: shelf-h;
                        border-top-left-radius: 0;
                        border-top-right-radius: 0;
                        title: "Layouts";
                        // how the Library is used, at the end of its title's line
                        Text {
                            x: 96px;
                            y: 14px;
                            width: parent.width - 16px - self.x;
                            height: 22px;
                            text: root.screen-game ? "Drag a screen layout onto a bar above to show that layout when a game starts or quits." : root.screen-closed ? "Drag a screen layout onto the screen to save the layout on the keyboard, or to another place in Layouts to move the layout." : "Drag a screen layout onto the playlist to add the layout to what the keyboard shows, or to another place in Layouts to move the layout.";
                            font-family: "Geist";
                            font-size: 12.5px;
                            color: Ink.quiet;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // each card in its place: while a layout is carried along the Library, the
                        // others make room where it will land, and it is left out of its own
                        for c[k] in root.lib-pages: Rectangle {
                            property <length> cw: shelf-two ? (parent.width - 32px - 8px) / 2 : parent.width - 32px;
                            x: 16px + (shelf-two ? mod(c.at, 2) * (self.cw + 8px) : 0);
                            y: 48px + (shelf-two ? floor(c.at / 2) : c.at) * 104px;
                            animate x, y { duration: root.carry-on ? 250ms : 0ms; easing: ease; }
                            opacity: c.carried ? 0 : 1;
                            width: self.cw;
                            height: 96px;
                            PlCard {
                                width: parent.width;
                                height: parent.height;
                                p: c;
                                hovered: cta.has-hover && !root.carry-on;
                            }
                            // the whole card a button: select it (or right-click it) for its menu, Edit
                            // first; press and drag it to carry it onto the playlist
                            cta := TouchArea {
                                mouse-cursor: root.carry-on ? MouseCursor.grabbing : MouseCursor.pointer;
                                property <bool> far;
                                // (pressed with the right button: its menu, never a carry)
                                property <bool> right;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        self.far = false;
                                        self.right = e.button == PointerEventButton.right;
                                    }
                                    if (e.kind == PointerEventKind.up && root.carry-on) {
                                        stage.drop-carry();
                                    } else if (e.kind == PointerEventKind.up && !self.far && (e.button == PointerEventButton.left || e.button == PointerEventButton.right)) {
                                        root.lib-menu(k, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                    if (e.kind == PointerEventKind.cancel && root.carry-on) {
                                        root.carry-on = false;
                                        root.pl-carry-cancel();
                                    }
                                }
                                moved => {
                                    if (self.pressed && !self.right) {
                                        if (!root.carry-on && !self.far && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                                            self.far = true;
                                            root.carry-gx = 18px;
                                            root.carry-gy = 14px;
                                            root.carry-settle = false;
                                            root.carry-on = true;
                                            root.pl-carry-start(1, k);
                                        }
                                        if (root.carry-on) {
                                            stage.carry-to(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                                // the menu's "···", at the middle of the card's right edge while the pointer
                                // is on it: what selecting the card opens
                                if self.has-hover && !root.carry-on: Text {
                                    x: parent.width - 30px - self.preferred-width / 2;
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "···";
                                    font-family: "Geist";
                                    font-size: 16px;
                                    letter-spacing: 1px;
                                    color: Ink.soft;
                                }
                            }
                        }
                        // a new screen: an empty block after the last, in the cards' own shade
                        Rectangle {
                            property <int> k: root.lib-pages.length;
                            property <length> cw: shelf-two ? (parent.width - 32px - 8px) / 2 : parent.width - 32px;
                            x: 16px + (shelf-two ? mod(self.k, 2) * (self.cw + 8px) : 0);
                            y: 48px + (shelf-two ? floor(self.k / 2) : self.k) * 104px;
                            width: self.cw;
                            height: 96px;
                            border-radius: 10px;
                            background: new-ta.pressed ? Ink.pick : new-ta.has-hover ? Ink.hover-well : Ink.well;
                            animate background { duration: 120ms; }
                            property <length> words-w: 12px + 7px + new-text.preferred-width;
                            Path {
                                x: (parent.width - parent.words-w) / 2;
                                y: (parent.height - 12px) / 2;
                                width: 12px;
                                height: 12px;
                                viewbox-width: 12;
                                viewbox-height: 12;
                                commands: "M6 2v8M2 6h8";
                                fill: transparent;
                                stroke: new-ta.has-hover ? Ink.bright : Ink.soft;
                                stroke-width: 1.6px;
                                stroke-line-cap: round;
                            }
                            new-text := Text {
                                x: (parent.width - parent.words-w) / 2 + 19px;
                                height: parent.height;
                                text: "New screen layout";
                                font-family: "Geist";
                                font-size: 13px;
                                font-weight: 500;
                                color: new-ta.has-hover ? Ink.bright : Ink.soft;
                                vertical-alignment: center;
                            }
                            new-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.lib-new(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                            }
                        }
                    }

                    // the pieces round the box, in the column's terms: the default backlight at the
                    // tabs' row's right end, and the line on a layout's own color before it
                    if root.boot == 0: Rectangle {
                        for c in root.cells: CellView {
                            c: c;
                            pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                            slide(id, v) => { root.cell-slide(id, v); }
                        }
                    }

                    // ---------------------------------------------------- the screen carried
                    // its name, under the pointer; let go over the panel, it settles into its room
                    if root.carry-on: Rectangle {
                        x: root.carry-x - root.carry-gx;
                        y: root.carry-y - root.carry-gy;
                        animate x, y { duration: root.carry-settle ? 150ms : 0ms; easing: ease; }
                        width: chip-text.preferred-width + 24px;
                        height: 28px;
                        border-radius: 8px;
                        background: Ink.hover-box;
                        opacity: root.carry-settle ? 0 : 1;
                        animate opacity { duration: 150ms; easing: ease; }
                        drop-shadow-blur: 30px;
                        drop-shadow-offset-y: 12px;
                        drop-shadow-color: #0000008c;
                        chip-text := Text {
                            x: 12px;
                            height: parent.height;
                            text: root.carry-name;
                            font-family: "Geist";
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Ink.bright;
                            vertical-alignment: center;
                        }
                    }
                }
                // Settings: its tiles, as the window lays them out
                // Settings: one column of cards in the middle of the page, under a rule
                if root.tab == 2: Rectangle {
                    x: 0;
                    y: 12px + head-h + 6px;
                    width: content-w;
                    height: 1px;
                    background: Ink.line;
                }
                if root.tab == 2: Rectangle {
                    x: pws-x + max(0, (pws-w - 820px) / 2);
                    y: 12px + head-h + 6px + 24px;
                    width: 820px;
                    height: root.tile-height;
                    for c in root.cells: CellView {
                        c: c;
                        pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                        slide(id, v) => { root.cell-slide(id, v); }
                        typed(id, index, t) => { root.cell-typed(id, index, t); }
                    }
                }

                // the keyboard's box, in the Profiles box's shade, which the keyboard
                // is drawn on: a frame round the hole, which the window fills
                if root.tab < 2: Rectangle {
                    x: pws-x;
                    y: board-top - kb-pad-y;
                    width: pws-w;
                    height: kb-pad-y;
                    border-top-left-radius: 12px;
                    border-top-right-radius: 12px;
                    background: Ink.well;
                }
                if root.tab < 2: Rectangle {
                    x: pws-x;
                    y: board-top + board-h;
                    width: pws-w;
                    height: kb-pad-y;
                    border-bottom-left-radius: 12px;
                    border-bottom-right-radius: 12px;
                    background: Ink.well;
                }
                if root.tab < 2: Rectangle {
                    x: pws-x;
                    y: board-top;
                    width: kb-pad-x;
                    height: board-h;
                    background: Ink.well;
                }
                if root.tab < 2: Rectangle {
                    x: pws-x + pws-w - kb-pad-x;
                    y: board-top;
                    width: kb-pad-x;
                    height: board-h;
                    background: Ink.well;
                }
                // the device's shadow on the box, kept inside the box's corners
                if root.tab < 2: Rectangle {
                    x: pws-x;
                    y: board-top - kb-pad-y;
                    width: pws-w;
                    height: board-h + 2 * kb-pad-y;
                    border-radius: 12px;
                    clip: true;
                    Image {
                        x: kb-pad-x - root.board-shadow-margin;
                        y: kb-pad-y - root.board-shadow-margin;
                        width: board-w + 2 * root.board-shadow-margin;
                        height: board-h + 2 * root.board-shadow-margin;
                        source: root.board-shadow;
                    }
                }
                // the keys, over the keyboard's hole: a click on the keyboard away
                // from every key lets the chosen one go; then what is drawn over it
                Rectangle {
                    visible: root.tab < 2;
                    x: pws-x + kb-pad-x;
                    y: board-top;
                    width: board-w;
                    height: board-h;
                    TouchArea {
                        clicked => { root.board-clicked(); }
                    }
                    for k in root.keys: KeyBox {
                        k: k;
                        unit: root.unit;
                        cqw: root.cqw;
                        clicked => { root.key-clicked(k.pos); }
                        hovered(on) => { root.key-hovered(k.pos, on); }
                    }
                    for o in root.overlays: Image {
                        visible: root.board-ready;
                        // Only a knob's place along its track glides, as long as the time
                        // between readings, so it is still moving when the next one comes
                        // and never steps; its track moves with the keyboard at once.
                        property <float> along: o.frac;
                        animate along { duration: root.knob-glide; easing: linear; }
                        x: o.x + self.along * o.travel;
                        y: o.y;
                        // (dimmed with the keyboard round an area the pointer is over)
                        opacity: o.opacity * (root.dimming ? 0.45 : 1);
                        width: o.w;
                        height: o.h;
                        source: o.image;
                        image-fit: fill;
                    }
                }
            }
            // the device's own bar: its name, its tabs, its Macro Editor, and how it is
            devbar := Rectangle {
                y: 0;
                height: 56px;
                background: Ink.base;
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 28px;
                    // the device's name, its connection's dot before it
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 10px;
                        Rectangle {
                            width: 7px;
                            Rectangle {
                                y: (parent.height - 7px) / 2;
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.conn-state == 1 ? Ink.good : root.conn-state == 2 ? Ink.bad : #5c5c5c;
                            }
                        }
                        Text {
                            text: "EVGA Z10 RGB";
                            font-family: "Geist";
                            font-size: 17px;
                            font-weight: 600;
                            letter-spacing: 0.17px;
                            color: Ink.ink;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 2px;
                        t-keys := Tab {
                            text: "Keys";
                            selected: root.tab == 0;
                            clicked => { root.view-changed(0); }
                        }
                        t-lighting := Tab {
                            text: "Lighting";
                            selected: root.tab == 1;
                            clicked => { root.view-changed(1); }
                        }
                        t-screen := Tab {
                            text: "Screen";
                            selected: root.tab == 3;
                            clicked => { root.view-changed(3); }
                        }
                        t-settings := Tab {
                            text: "Settings";
                            selected: root.tab == 2;
                            clicked => { root.view-changed(2); }
                        }
                    }
                    // what was last done ("Saved", which fades, or a problem, which
                    // stays), and for a moment after a change, Undo
                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: root.status-kind == 2 ? Ink.bad : Ink.quiet;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.undo-shown: VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        BoxLink {
                            text: "Undo";
                            clicked => { root.undo(false); }
                        }
                    }
                    // the Macro Editor, the Screen Editor and the lab, at the bar's end
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        BarButton {
                            commands: "M3.1 4h9.8a1.6 1.6 0 0 1 1.6 1.6v5.3a1.6 1.6 0 0 1-1.6 1.6H3.1a1.6 1.6 0 0 1-1.6-1.6V5.6a1.6 1.6 0 0 1 1.6-1.6zM4 7h1M7 7h1M10 7h2M4.5 9.8h7";
                            text: "Macro Editor";
                            clicked => { root.macro-editor(-1); }
                        }
                        // (the keyboard's screen: a wide frame with its rows of words)
                        BarButton {
                            commands: "M2.6 3.4h10.8a1.6 1.6 0 0 1 1.6 1.6v6a1.6 1.6 0 0 1-1.6 1.6H2.6A1.6 1.6 0 0 1 1 11V5a1.6 1.6 0 0 1 1.6-1.6zM4 6.2h8M4 8h6M4 9.8h7";
                            text: "Screen Editor";
                            clicked => { root.screen-editor(); }
                        }
                        BarButton {
                            // a flask drawn for this size, its lines on the pixel grid
                            commands: "M5.14 1.14h5.72M6.29 1.14v4.58L2.95 11.93a1.25 1.25 0 0 0 1.1 1.79h7.9a1.25 1.25 0 0 0 1.1-1.79L9.71 5.72V1.14M4.3 10.29h7.4";
                            round: true;
                            text: "";
                            clicked => { root.rail("lab"); }
                        }
                    }
                }
                // its edge, and the chosen tab's underline over it
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Ink.line;
                }
                Rectangle {
                    x: 28px + 17px + devbar-brand-w + 28px + (root.tab == 0 ? 0 : root.tab == 1 ? t-keys.width + 2px : root.tab == 3 ? t-keys.width + t-lighting.width + 4px : t-keys.width + t-lighting.width + t-screen.width + 6px);
                    y: parent.height - 2px;
                    width: root.tab == 0 ? t-keys.width : root.tab == 1 ? t-lighting.width : root.tab == 3 ? t-screen.width : t-settings.width;
                    height: 2px;
                    background: Ink.ink;
                }
            }

        }
    }

    // the brand's width, for the underline's place
    property <length> devbar-brand-w: brand-measure.preferred-width;
    brand-measure := Text {
        visible: false;
        text: "EVGA Z10 RGB";
        font-family: "Geist";
        font-size: 17px;
        font-weight: 600;
        letter-spacing: 0.17px;
    }

    // the title bar: the mark and the wordmark, then the window's own buttons;
    // dragging it moves the window
    Rectangle {
        y: 0;
        height: bar;
        background: Ink.title;
        border-top-left-radius: root.radius;
        border-top-right-radius: root.radius;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.drag();
                }
            }
            double-clicked => { root.maximize(); }
        }
        Image {
            x: 12px;
            y: (bar - 16px) / 2;
            width: 16px;
            height: 16px;
            source: root.mark;
        }
        Text {
            x: 12px + 16px + 7px;
            height: bar;
            text: "Ectomatter";
            font-family: "Geist";
            font-weight: 600;
            font-size: 13.5px;
            letter-spacing: -0.54px;
            color: #f5f5f5;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: parent.width - 120px;
            width: 120px;
            WinButton {
                commands: "M3 8h10";
                clicked => { root.minimize(); }
            }
            WinButton {
                size: 12px;
                commands: "M3.5 2.5h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z";
                clicked => { root.maximize(); }
            }
            WinButton {
                danger: true;
                corner: root.radius;
                commands: "M3.5 3.5l9 9M12.5 3.5l-9 9";
                clicked => { root.close-window(); }
            }
        }
    }

    // the rail: Home, the device, and Settings at its foot. Clicking the item
    // already chosen opens it into its blade, with the names, or closes it.
    // Drawn after the page, so a name beside a closed item shows over it.
    Rectangle {
        x: 0;
        y: bar;
        width: rail-w;
        height: root.height - bar;
        background: Ink.frame;
        border-bottom-left-radius: root.radius;
        clip: !root.rail-open ? false : true;
        r-home := RailItem {
            x: 10px;
            y: 10px;
            width: rail-w - 20px;
            glyph: root.home-glyph;
            name: "Home";
            on: root.place == "home";
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail("home"); }
        }
        // (the devices, as they sit on Home's desk, left to right)
        for d[i] in root.rail-devices: RailItem {
            x: 10px;
            y: 10px + 40px + 4px + 8px + 4px + i * (40px + 4px);
            width: rail-w - 20px;
            glyph: d.kind == "mouse" ? root.mouse-glyph : root.keyboard-glyph;
            name: d.name;
            on: root.place == d.place;
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail(d.place); }
        }
        r-library := RailItem {
            x: 10px;
            y: parent.height - 10px - 40px - 4px - 40px;
            width: rail-w - 20px;
            glyph: root.library-glyph;
            name: "Library";
            on: root.place == "library";
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail("library"); }
        }
        r-settings := RailItem {
            x: 10px;
            y: parent.height - 10px - 40px;
            width: rail-w - 20px;
            glyph: root.settings-glyph;
            name: "Settings";
            on: root.place == "settings";
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail("settings"); }
        }
    }

    // the color picker, hung from the swatch that opened it
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-top;
    in property <float> pk-hue;
    in property <float> pk-sat;
    in property <float> pk-val;
    in property <color> pk-now;
    in property <color> pk-pure;
    in property <image> pk-sv-img;
    in property <image> pk-hue-img;
    in-out property <string> pk-hex;
    in-out property <string> pk-r;
    in-out property <string> pk-g;
    in-out property <string> pk-b;
    in-out property <string> pk-h;
    in-out property <string> pk-s;
    in-out property <string> pk-v;
    in property <[color]> pk-presets;
    in property <[color]> pk-recent;
    out property <length> picker-height: 6px + 353.56px + (root.pk-recent.length > 0 ? 55.56px : 0);
    callback pk-sv(float, float);
    callback pk-hue-at(float);
    callback pk-field(int, string);
    callback pk-well(color);
    callback pk-enter();
    callback pk-dismiss();
    // closed, the picker's fields let go of the keyboard
    public function blur-picker() {
        sink.focus();
        sink.clear-focus();
    }
    sink := FocusScope {
        width: 0;
        height: 0;
    }

    // Each page's scrollbar runs beside what scrolls and nothing else: under
    // the title bar, under the device's bar on its page (which stays put), and
    // short of the window's rounded corner at the foot.
    if root.place == "z10": ScrollBar {
        x: root.width - 12px;
        y: bar + 56px + 2px;
        height: root.height - bar - 56px - 2px - root.bar-foot;
        view: flick.height;
        content: flick.content-height;
        offset: -flick.content-y;
        scroll-to(o) => { flick.content-y = -o; }
    }
    if root.place == "mouse": ScrollBar {
        x: root.width - 12px;
        y: bar + 56px + 2px;
        height: root.height - bar - 56px - 2px - root.bar-foot;
        view: mouse-flick.height;
        content: mouse-flick.content-height;
        offset: -mouse-flick.content-y;
        scroll-to(o) => { mouse-flick.content-y = -o; }
    }
    if root.place == "library": ScrollBar {
        x: root.width - 12px;
        y: bar + 56px + 2px;
        height: root.height - bar - 56px - 2px - root.bar-foot;
        view: gl-flick.height;
        content: gl-flick.content-height;
        offset: -gl-flick.content-y;
        scroll-to(o) => { gl-flick.content-y = -o; }
    }
    if root.place == "settings": ScrollBar {
        x: root.width - 12px;
        y: bar + 2px;
        height: root.height - bar - 2px - root.bar-foot;
        view: set-flick.height;
        content: set-flick.content-height;
        offset: -set-flick.content-y;
        scroll-to(o) => { set-flick.content-y = -o; }
    }

    // a form over the Library: Add a game (its program and its name) or Add an
    // app (one seen in front); the page dims under it, and a press on the dim,
    // Cancel or Escape closes it
    if root.gl-modal != 0: Rectangle {
        background: #00000099;
        border-radius: root.radius;
        TouchArea {
            clicked => { root.gl-modal-close(); }
        }
        FocusScope {
            width: 0;
            height: 0;
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.gl-modal-close();
                    return accept;
                }
                reject
            }
        }
        Rectangle {
            width: min(560px, parent.width - 32px);
            height: form.preferred-height + 44px;
            border-radius: 14px;
            background: Ink.box;
            border-width: 1px;
            border-color: #ffffff0d;
            drop-shadow-blur: 80px;
            drop-shadow-offset-y: 30px;
            drop-shadow-color: #000000cc;
            TouchArea { }
            form := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: self.preferred-height;
                spacing: 0;
                Text {
                    text: root.gl-modal == 1 ? "Add a game" : root.gl-modal == 3 ? root.gl-script-title : root.gl-modal == 4 ? root.gl-plugin-title : root.gl-modal == 5 ? root.gl-var-title : "Add an app";
                    font-family: "Geist";
                    font-size: 17px;
                    font-weight: 600;
                    color: Ink.ink;
                }
                Rectangle { height: 4px; }
                Text {
                    text: root.gl-modal == 1 ? "Choose the game’s program. The game joins Games, with a page of its own." : root.gl-modal == 3 ? root.gl-script-sub
                        : root.gl-modal == 4 ? root.gl-plugin-sub : root.gl-modal == 5 ? root.gl-var-sub
                        : "Choose an app you’ve had open while Ectomatter was running. The app joins Apps, with a page of its own.";
                    font-family: "Geist";
                    font-size: 13px;
                    color: Ink.soft;
                    wrap: word-wrap;
                }
                Rectangle { height: 18px; }
                if root.gl-modal == 1: VerticalLayout {
                    spacing: 0;
                    Text {
                        text: "Program";
                        font-family: "Geist";
                        font-size: 13px;
                        color: Ink.dim;
                    }
                    Rectangle { height: 7px; }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: Ink.well;
                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: root.gl-program != "" ? root.gl-program : "No program chosen";
                                font-family: "Geist";
                                font-size: 13px;
                                color: root.gl-program != "" ? Ink.ink : #8a8a92;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            WordButton {
                                text: "Choose…";
                                fill: Ink.hover-box;
                                fill-hover: Ink.pick;
                                clicked => { root.gl-choose-program(); }
                            }
                        }
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: "Ectomatter notices the game starting, from Play here or anywhere else.";
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.quiet;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 14px; }
                    Text {
                        text: "Name";
                        font-family: "Geist";
                        font-size: 13px;
                        color: Ink.dim;
                    }
                    Rectangle { height: 7px; }
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: Ink.well;
                        if name-in.text == "": Text {
                            x: 12px;
                            height: parent.height;
                            text: root.gl-name-hint;
                            font-family: "Geist";
                            font-size: 13px;
                            color: #8a8a92;
                            vertical-alignment: center;
                        }
                        name-in := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text <=> root.gl-name-typed;
                            font-family: "Geist";
                            font-size: 13px;
                            color: Ink.ink;
                            vertical-alignment: center;
                            single-line: true;
                            changed has-focus => { Typing.on = self.has-focus; }
                            accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.gl-modal-close();
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                }
                // a plugin: from its GitHub address or its file, and what it is once found
                if root.gl-modal == 4: VerticalLayout {
                    spacing: 0;
                    Text {
                        text: "GitHub address";
                        font-family: "Geist";
                        font-size: 13px;
                        color: Ink.dim;
                    }
                    Rectangle { height: 7px; }
                    FieldBox {
                        placeholder: "Its GitHub address, or its owner/name";
                        text <=> root.gl-plugin-address;
                        edited => { root.gl-plugin-typed(); }
                        accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                        escape => { root.gl-modal-close(); }
                    }
                    Rectangle { height: 14px; }
                    Text {
                        text: "Or a file";
                        font-family: "Geist";
                        font-size: 13px;
                        color: Ink.dim;
                    }
                    Rectangle { height: 7px; }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: Ink.well;
                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: root.gl-plugin-file != "" ? root.gl-plugin-file : "No file chosen";
                                font-family: "Geist";
                                font-size: 13px;
                                color: root.gl-plugin-file != "" ? Ink.ink : #8a8a92;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            WordButton {
                                text: "Choose…";
                                fill: Ink.hover-box;
                                fill-hover: Ink.pick;
                                clicked => { root.gl-plugin-choose-file(); }
                            }
                        }
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: "Its file ends in .ectocore.";
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.quiet;
                    }
                    if root.gl-plugin-found != "": Rectangle { height: 16px; }
                    if root.gl-plugin-found != "": Rectangle {
                        height: found-words.preferred-height;
                        border-radius: 10px;
                        background: Ink.well;
                        found-words := VerticalLayout {
                            padding: 14px;
                            spacing: 3px;
                            Text {
                                text: root.gl-plugin-found;
                                font-family: "Geist";
                                font-size: 14px;
                                font-weight: 500;
                                color: Ink.ink;
                            }
                            if root.gl-plugin-found-sub != "": Text {
                                text: root.gl-plugin-found-sub;
                                font-family: "Geist";
                                font-size: 12.5px;
                                color: Ink.soft;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.gl-plugin-can;
                                font-family: "Geist";
                                font-size: 12.5px;
                                color: Ink.quiet;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if root.gl-plugin-state != "": Rectangle { height: 10px; }
                    if root.gl-plugin-state != "": Text {
                        text: root.gl-plugin-state;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: root.gl-plugin-bad ? Ink.bad : Ink.quiet;
                        wrap: word-wrap;
                    }
                }
                // a variable: its name and its value side by side, as a launch line sets them
                if root.gl-modal == 5: VerticalLayout {
                    spacing: 0;
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 0;
                            Text {
                                text: "Name";
                                font-family: "Geist";
                                font-size: 13px;
                                color: Ink.dim;
                            }
                            Rectangle { height: 7px; }
                            FieldBox {
                                placeholder: "PROTON_ENABLE_NVAPI";
                                mono: true;
                                text <=> root.gl-var-name;
                                edited => { root.gl-var-typed(); }
                                accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                                escape => { root.gl-modal-close(); }
                            }
                        }
                        VerticalLayout {
                            spacing: 0;
                            Text {
                                text: "Value";
                                font-family: "Geist";
                                font-size: 13px;
                                color: Ink.dim;
                            }
                            Rectangle { height: 7px; }
                            FieldBox {
                                placeholder: "1";
                                mono: true;
                                text <=> root.gl-var-value;
                                edited => { root.gl-var-typed(); }
                                accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                                escape => { root.gl-modal-close(); }
                            }
                        }
                    }
                    if root.gl-var-warning != "": Rectangle { height: 8px; }
                    if root.gl-var-warning != "": Text {
                        text: root.gl-var-warning;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.bad;
                        wrap: word-wrap;
                    }
                }
                // a script: its name, its command and its undo side by side, how it runs, its time limit
                if root.gl-modal == 3: VerticalLayout {
                    spacing: 0;
                    Text {
                        text: "Name";
                        font-family: "Geist";
                        font-size: 13px;
                        color: Ink.dim;
                    }
                    Rectangle { height: 7px; }
                    FieldBox {
                        placeholder: "For example, Pause the local AI";
                        text <=> root.gl-script-name;
                        edited => { root.gl-script-typed(); }
                        accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                        escape => { root.gl-modal-close(); }
                    }
                    Rectangle { height: 14px; }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 0;
                            Text {
                                text: root.gl-script-start-label;
                                font-family: "Geist";
                                font-size: 13px;
                                color: Ink.dim;
                                overflow: elide;
                            }
                            Rectangle { height: 7px; }
                            FieldBox {
                                placeholder: "A command or a file";
                                mono: true;
                                text <=> root.gl-script-start;
                                edited => { root.gl-script-typed(); }
                                accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                                escape => { root.gl-modal-close(); }
                            }
                        }
                        VerticalLayout {
                            spacing: 0;
                            Text {
                                text: root.gl-script-quit-label;
                                font-family: "Geist";
                                font-size: 13px;
                                color: Ink.dim;
                                overflow: elide;
                            }
                            Rectangle { height: 7px; }
                            FieldBox {
                                placeholder: "Optional";
                                mono: true;
                                text <=> root.gl-script-quit;
                                edited => { root.gl-script-typed(); }
                                accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                                escape => { root.gl-modal-close(); }
                            }
                        }
                    }
                    if root.gl-script-warning != "": Rectangle { height: 8px; }
                    if root.gl-script-warning != "": Text {
                        text: root.gl-script-warning;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.bad;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 18px; }
                    CheckBox {
                        text: root.gl-script-wait-label;
                        on: root.gl-script-wait;
                        clicked => { root.gl-script-wait-toggle(); }
                    }
                    Rectangle { height: 6px; }
                    CheckBox {
                        text: root.gl-script-keep-label;
                        on: root.gl-script-keep;
                        clicked => { root.gl-script-keep-toggle(); }
                    }
                    Rectangle { height: 18px; }
                    Text {
                        text: "Time limit";
                        font-family: "Geist";
                        font-size: 13px;
                        color: Ink.dim;
                    }
                    Rectangle { height: 7px; }
                    HorizontalLayout {
                        alignment: start;
                        DropField {
                            width: 200px;
                            text: root.gl-script-limit;
                            open: root.menu-open;
                            clicked(x, y, h) => { root.gl-script-limit-menu(x, y, h); }
                        }
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: root.gl-script-limit-note;
                        font-family: "Geist";
                        font-size: 12.5px;
                        color: Ink.quiet;
                        wrap: word-wrap;
                    }
                }
                if root.gl-modal == 2 && root.gl-seen.length == 0: Text {
                    text: "Apps show here once they’ve been in front while Ectomatter is running.";
                    font-family: "Geist";
                    font-size: 13px;
                    color: Ink.quiet;
                    wrap: word-wrap;
                }
                if root.gl-modal == 2 && root.gl-seen.length > 0: Rectangle {
                    height: min(root.gl-seen.length * 44px + 8px, 320px);
                    border-radius: 10px;
                    background: Ink.well;
                    clip: true;
                    seen-flick := Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-height: root.gl-seen.length * 44px + 8px;
                        mouse-drag-pan-enabled: false;
                        for a[i] in root.gl-seen: Rectangle {
                            x: 4px;
                            y: 4px + i * 44px;
                            width: parent.width - 8px;
                            height: 44px;
                            border-radius: 7px;
                            background: root.gl-seen-chosen == i ? (seen-ta.has-hover ? Ink.pick-hover : Ink.pick) : seen-ta.has-hover ? Ink.hover-well : transparent;
                            if a.has-icon: Image {
                                x: 10px;
                                y: 10px;
                                width: 24px;
                                height: 24px;
                                source: a.icon;
                            }
                            Text {
                                x: 44px;
                                width: parent.width - 54px;
                                height: parent.height;
                                text: a.name;
                                font-family: "Geist";
                                font-size: 13.5px;
                                color: Ink.ink;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            seen-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.gl-seen-pick(i); }
                            }
                        }
                    }
                }
                Rectangle { height: 20px; }
                HorizontalLayout {
                    spacing: 8px;
                    if root.gl-modal == 3 && root.gl-script-editing: VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Remove";
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.gl-script-remove(); }
                        }
                    }
                    if root.gl-modal == 5 && root.gl-var-editing: VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Remove";
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.gl-var-remove(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        WordButton {
                            text: "Cancel";
                            fill: Ink.hover-box;
                            fill-hover: Ink.pick;
                            clicked => { root.gl-modal-close(); }
                        }
                    }
                    WordButton {
                        primary: true;
                        text: (root.gl-modal == 3 && root.gl-script-editing) || (root.gl-modal == 5 && root.gl-var-editing) ? "Save" : "Add";
                        enabled: root.gl-can-add;
                        clicked => { root.gl-add-done(); }
                    }
                }
            }
        }
    }

    // the scene form, over the window: New scene or Edit scene, the scene across the desk
    // as it's set (the devices show it too), its pieces, and Cancel and Create scene (or
    // Save, and Delete scene apart at the left); a press on the dim, Cancel or Escape closes it
    if root.scene-form: Rectangle {
        background: #00000099;
        border-radius: root.radius;
        TouchArea {
            clicked => { root.scene-form-close(); }
        }
        FocusScope {
            width: 0;
            height: 0;
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.scene-form-escape();
                    return accept;
                }
                reject
            }
        }
        sf := Rectangle {
            property <length> head-h: 22px + 4px + sf-sub.preferred-height + 18px;
            property <length> natural: 24px + self.head-h + 46px + 6px + root.scene-form-h + 24px + 36px + 20px;
            width: 600px;
            height: min(self.natural, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: max(16px, (parent.height - self.height) / 2);
            border-radius: 14px;
            background: Ink.box;
            border-width: 1px;
            border-color: #ffffff0d;
            drop-shadow-blur: 80px;
            drop-shadow-offset-y: 30px;
            drop-shadow-color: #000000cc;
            TouchArea { }
            Text {
                x: 24px;
                y: 24px;
                height: 22px;
                text: root.scene-form-title;
                font-family: "Geist";
                font-size: 17px;
                font-weight: 600;
                color: Ink.ink;
                vertical-alignment: center;
            }
            sf-sub := Text {
                x: 24px;
                y: 24px + 22px + 4px;
                width: parent.width - 48px;
                text: root.scene-form-sub;
                font-family: "Geist";
                font-size: 13px;
                color: Ink.soft;
                wrap: word-wrap;
            }
            Rectangle {
                x: 24px;
                y: 24px + sf.head-h;
                width: 552px;
                height: 46px;
                border-radius: 9px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.scene-strip;
                    image-fit: fill;
                }
            }
            sf-flick := Flickable {
                // (scrolled by the wheel; a drag is the slider's)
                mouse-drag-pan-enabled: false;
                x: 24px;
                y: 24px + sf.head-h + 46px + 6px;
                width: 552px;
                height: sf.height - self.y - 24px - 36px - 20px;
                viewport-height: root.scene-form-h;
                for c in root.scene-cells: CellView {
                    c: c;
                    glyph: root.keyboard-glyph;
                    glyph2: root.mouse-glyph;
                    glyphs: root.package-glyphs;
                    pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                    slide(id, v) => { root.cell-slide(id, v); }
                    typed(id, index, t) => { root.cell-typed(id, index, t); }
                }
                // the effects, as the Lighting page's tiles, each in the scene's colors
                if root.scene-tiles-on: Rectangle {
                    y: root.scene-tiles-y;
                    height: 76px;
                    for fx[i] in root.scene-tiles: Rectangle {
                        x: i * (84px + 8px);
                        width: 84px;
                        height: 76px;
                        border-radius: 10px;
                        background: fx.on ? (st-ta.has-hover ? Ink.pick-hover : Ink.pick) : st-ta.has-hover ? Ink.hover-box : Ink.well;
                        Rectangle {
                            x: 6px;
                            y: 6px;
                            width: parent.width - 12px;
                            height: 40px;
                            border-radius: 6px;
                            clip: true;
                            background: #0c0e10;
                            property <float> phase: fx.on && fx.motion != 0 ? animation-tick() / 1ms : 0;
                            Image {
                                // (a wave rolls along a picture twice as wide; a breath fades and comes back)
                                x: fx.on && fx.motion == 3 ? -mod(parent.phase / 3000, 1) * parent.width : 0;
                                width: fx.motion == 3 ? parent.width * 2 : parent.width;
                                height: parent.height;
                                source: fx.icon;
                                image-fit: fill;
                                opacity: fx.on && fx.motion == 1 ? 0.3 + 0.7 * (0.5 - 0.5 * cos(parent.phase / 3000 * 360deg)) : 1;
                            }
                        }
                        Text {
                            y: 53px;
                            height: 15px;
                            width: parent.width;
                            text: fx.name;
                            font-family: "Geist";
                            font-size: 12px;
                            font-weight: fx.on ? 500 : 400;
                            color: fx.on || st-ta.has-hover ? Ink.bright : Ink.soft;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        st-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.scene-tile(i); }
                        }
                    }
                }
            }
            HorizontalLayout {
                x: 24px;
                y: parent.height - 20px - 36px;
                width: parent.width - 48px;
                height: 36px;
                spacing: 8px;
                if root.scene-form-edit: VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: "Delete scene";
                        fill: Ink.hover-box;
                        fill-hover: Ink.pick;
                        clicked => { root.scene-form-delete(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: "Cancel";
                        fill: Ink.hover-box;
                        fill-hover: Ink.pick;
                        clicked => { root.scene-form-close(); }
                    }
                }
                WordButton {
                    primary: true;
                    text: root.scene-form-edit ? "Save" : "Create scene";
                    clicked => { root.scene-form-done(); }
                }
            }
        }
    }

    // the open menu, over everything
    menu := Menu {
        marks: root.menu-marks;
        visible: root.menu-open;
        x: max(8px, min(root.menu-ax, root.width - root.menu-w - 8px));
        width: root.menu-w;
        height: min(root.menu-natural, min(root.menu-max, root.height - root.menu-top - 8px));
        y: root.menu-top;
        rows: root.menu-rows;
        placeholder: root.menu-placeholder;
        back: root.menu-back;
        search: root.menu-search;
        query <=> root.menu-query;
        chose(i) => { root.menu-chose(i); }
        edit(i) => { root.menu-edit(i); }
        go-back => { root.menu-back-to(); }
        typed(t) => { root.menu-typed(t); }
        enter => { root.menu-enter(); }
        dismiss => { root.menu-dismiss(); }
        field-done(i, t) => { root.menu-field(i, t); }
    }
    picker := Picker {
        visible: root.picker-open;
        x: max(8px, min(root.picker-x, root.width - 264px - 8px));
        y: root.picker-top;
        height: root.picker-height;
        hue: root.pk-hue;
        sat: root.pk-sat;
        val: root.pk-val;
        now: root.pk-now;
        pure: root.pk-pure;
        sv-img: root.pk-sv-img;
        hue-img: root.pk-hue-img;
        t-hex <=> root.pk-hex;
        t-r <=> root.pk-r;
        t-g <=> root.pk-g;
        t-b <=> root.pk-b;
        t-h <=> root.pk-h;
        t-s <=> root.pk-s;
        t-v <=> root.pk-v;
        presets: root.pk-presets;
        recent: root.pk-recent;
        sv(x, y) => { root.pk-sv(x, y); }
        hue-at(x) => { root.pk-hue-at(x); }
        field(i, t) => { root.pk-field(i, t); }
        well(c) => { root.pk-well(c); }
        enter => { root.pk-enter(); }
        dismiss => { root.pk-dismiss(); }
    }
    // the menu's height as its rows lay out, which the window works out: Slint
    // lays a list's rows out only as it draws them
    in property <length> menu-natural;

    // are you sure: a scrim over the window, and the question on it, as in the Macro
    // Editor; Escape is Cancel
    if root.confirm-open: Rectangle {
        background: #0a0c0f9e;
        border-radius: root.radius;
        TouchArea {
            clicked => { root.confirm-no(); }
        }
        FocusScope {
            width: 0;
            height: 0;
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.confirm-no();
                    return accept;
                }
                reject
            }
        }
        Rectangle {
            width: min(440px, parent.width - 32px);
            height: dlg.preferred-height + 40px;
            border-radius: 12px;
            background: Ink.shade2;
            border-width: 1px;
            border-color: Ink.line;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 24px;
            drop-shadow-color: #000000cc;
            TouchArea { }
            dlg := VerticalLayout {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                height: self.preferred-height;
                spacing: 10px;
                Text { text: root.confirm-title; font-family: "Geist"; font-size: 16px; font-weight: 600; color: Ink.ink; wrap: word-wrap; }
                Text { text: root.confirm-body; font-family: "Geist"; font-size: 13.5px; color: Ink.dim; wrap: word-wrap; }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    alignment: end;
                    WordButton { text: root.confirm-keep; clicked => { root.confirm-no(); } }
                    Rectangle {
                        width: del.preferred-width + 28px;
                        height: 30px;
                        border-radius: 7px;
                        background: del-ta.has-hover ? #e25f5b : #d9534f;
                        del := Text { text: root.confirm-do; font-family: "Geist"; font-size: 13px; font-weight: 600; color: #ffffff; }
                        del-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.confirm-yes(); }
                        }
                    }
                }
            }
        }
    }


}

// ---------------------------------------------------------------- the Macro Editor
// Its own window, as the web app had it (macro.css at cd9ea82): the library
// in the rail's shade on the left, the chosen macro on the home's ground as a
// chain of steps on a tile, the tools under the chain, how it plays and its
// Revert and Save at the foot.

// a macro in the library
// a row of the Macro Editor's list: a macro (kind 0), or the heading of a
// section of them (kind 1): Ectomatter's own, then each device's that keeps
// macros in its own memory. Each knows its library (0 the keyboard's, 1
// Ectomatter's) and where it sits in the list; a heading, whether a new one
// can be made there.
export struct MacroItem {
    kind: int,
    lib: int,
    n: int,
    name: string,
    sub: string,
    timed: bool,
    current: bool,
    dirty: bool,
    can-new: bool,
    y: length,
    h: length,
}

// a small icon from the editor's set, drawn in its color
component MacroIcon inherits Path {
    in property <int> which;   // 0 keys, 1 clock, 2 gear, 3 pen
    viewbox-width: 16;
    viewbox-height: 16;
    fill: transparent;
    stroke-width: 1.4px * self.width / 16px;
    commands: root.which == 1 ? "M13.8 8.5a5.8 5.8 0 1 1-11.6 0a5.8 5.8 0 1 1 11.6 0zM8 5.3v3.2l2.2 1.4M6.5 1.5h3"
        : root.which == 2 ? "M10.3 8a2.3 2.3 0 1 1-4.6 0a2.3 2.3 0 1 1 4.6 0zM8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"
        : root.which == 3 ? "M10.5 2.5l3 3L6 13H3v-3z"
        : "M3.1 4h9.8a1.6 1.6 0 0 1 1.6 1.6v5.3a1.6 1.6 0 0 1-1.6 1.6H3.1a1.6 1.6 0 0 1-1.6-1.6V5.6a1.6 1.6 0 0 1 1.6-1.6zM4 7h1M7 7h1M10 7h2M4.5 9.8h7";
}

// a macro's row in the library
component MacroRow inherits Rectangle {
    in property <MacroItem> m;
    callback clicked;
    callback menu(length, length);
    height: 53px;
    border-radius: 10px;
    background: root.m.current ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover ? Ink.hover-box : transparent;
    MacroIcon {
        x: 11.5px;
        y: 19px;
        width: 15px;
        height: 15px;
        which: root.m.timed ? 1 : 0;
        stroke: root.m.current ? Ink.bright : Ink.soft;
    }
    HorizontalLayout {
        x: 40px;
        y: 8px;
        width: parent.width - 52px;
        height: 19px;
        spacing: 7px;
        alignment: start;
        Text {
            text: root.m.name;
            font-family: "Geist";
            font-size: 13.5px;
            font-weight: 500;
            color: (root.m.current || ta.has-hover) ? Ink.bright : Ink.dim;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.m.dirty: Rectangle {
            width: 6px;
            Rectangle {
                y: 8px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Ink.warn;
            }
        }
    }
    Text {
        x: 40px;
        y: 27px;
        width: parent.width - 52px;
        height: 17px;
        text: root.m.sub;
        font-family: "Geist";
        font-size: 12px;
        color: Ink.soft;
        overflow: elide;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.clicked(); }
    }
}

// a piece of the chain, placed by the window: a step, a wait, a joint, the
// insert point, the recording's caret
component ChainPiece inherits Rectangle {
    in property <Cell> c;
    in property <bool> blink;
    // a step being dragged is over this one: the web's bar at its left edge
    in property <bool> drop-to;
    callback clicked(int, int, length, length, length);
    callback dropped(int, length, length);
    // a step dragged: where the pointer is, and where on the step it was taken
    callback drag-at(int, length, length, length, length);
    callback wait-typed(int, string);
    // a step or wait just recorded pops in, once, as the web page's did
    property <bool> fresh: root.c.index >= 1000 && (root.c.kind == 15 || root.c.kind == 16);
    property <duration> born;
    init => { root.born = animation-tick(); }
    property <float> age: root.fresh ? max(0, min(1, (animation-tick() - root.born) / 400ms)) : 1;
    property <float> eased: 1 - (1 - root.age) * (1 - root.age);
    opacity: 0.3 + 0.7 * root.eased;
    transform-scale: 0.85 + 0.15 * root.eased;
    callback wait-done(int, string);
    callback wait-cancel();
    x: root.c.x;
    y: root.c.y;
    width: root.c.w;
    height: root.c.h;
    // a step: its key, and which way it goes; chosen, it turns ink
    if root.c.kind == 15: Rectangle {
        property <bool> dragging: ev.pressed && (abs(ev.mouse-x - ev.pressed-x) > 5px || abs(ev.mouse-y - ev.pressed-y) > 5px);
        border-radius: 8px;
        background: root.c.on ? Ink.ink : ev.has-hover ? #3d3d3d : #333333;
        opacity: dragging ? 0.6 : 1;
        HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 6px;
            // (a media key's note; a job's mark, on a device or the screen, or
            // another macro played; a key's step has none)
            if root.c.style == 1: Text {
                text: "♫";
                font-family: "Geist";
                font-size: 12px;
                color: root.c.on ? #171717 : #9fc2ea;
                vertical-alignment: center;
            }
            if root.c.style == 2: Text {
                text: "◆";
                font-family: "Geist";
                font-size: 12px;
                color: root.c.on ? #171717 : Ink.warn;
                vertical-alignment: center;
            }
            if root.c.style == 3: Text {
                text: "▶";
                font-family: "Geist";
                font-size: 12px;
                color: root.c.on ? #171717 : Ink.good;
                vertical-alignment: center;
            }
            Text {
                text: root.c.text;
                font-family: "Geist";
                font-size: 13px;
                font-weight: 500;
                color: root.c.on ? #171717 : Ink.ink;
                vertical-alignment: center;
            }
            // (which way a key goes; a job goes no way)
            if root.c.style < 2: Text {
                text: root.c.value > 0.5 ? "↓" : "↑";
                font-family: "Geist";
                font-size: 12.5px;
                font-weight: 500;
                color: root.c.value > 0.5 ? (root.c.on ? #171717 : Ink.ink) : (root.c.on ? #525252 : Ink.quiet);
                vertical-alignment: center;
            }
        }
        if root.drop-to: Rectangle {
            x: -4px;
            y: 1px;
            width: 3px;
            height: parent.height - 2px;
            background: #a3a3a3;
        }
        ev := TouchArea {
            mouse-cursor: pointer;
            moved => {
                if (self.pressed && root.c.id != 0 && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px)) {
                    root.drag-at(root.c.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, self.pressed-x, self.pressed-y);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    if (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px) {
                        root.dropped(root.c.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else {
                        root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height);
                    }
                }
            }
        }
    }
    // a wait: its milliseconds and a clock
    if root.c.kind == 16: Rectangle {
        border-radius: 8px;
        background: wt.has-hover ? Ink.shade2 : transparent;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            Text {
                text: root.c.text;
                font-family: "Geist";
                font-size: 12.5px;
                font-weight: 500;
                color: wt.has-hover ? Ink.bright : Ink.soft;
                vertical-alignment: center;
            }
            MacroIcon {
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                which: 1;
                stroke: wt.has-hover ? Ink.bright : Ink.soft;
                opacity: 0.7;
            }
        }
        wt := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a wait being typed
    if root.c.kind == 20: Rectangle {
        border-radius: 8px;
        background: #333333;
        MacroIcon {
            x: 8px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            which: 1;
            stroke: #ffffff;
        }
        input := TextInput {
            x: 24px;
            width: 44px;
            height: parent.height;
            text: root.c.text;
            font-family: "Geist";
            font-size: 12.5px;
            font-weight: 500;
            color: #ffffff;
            vertical-alignment: center;
            single-line: true;
            init => {
                self.focus();
                self.select-all();
            }
            accepted => { root.wait-done(root.c.index, self.text); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.wait-cancel();
                    return accept;
                }
                reject
            }
            changed has-focus => {
                Typing.on = self.has-focus;
                if (!self.has-focus) {
                    root.wait-done(root.c.index, self.text);
                }
            }
        }
        Text {
            x: 70px;
            height: parent.height;
            text: "ms";
            font-family: "Geist";
            font-size: 12.5px;
            font-weight: 500;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
    // a joint between two steps, where a step can be put
    if root.c.kind == 17: Rectangle {
        property <bool> lit: root.c.on || (root.c.style == 0 && cn.has-hover);
        Rectangle {
            x: 4px;
            y: 8px;
            width: 12px;
            height: 2px;
            border-radius: 1px;
            background: parent.lit ? Ink.soft : #4a4a4a;
        }
        Rectangle {
            x: 12px;
            y: 6px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #5c5c5c;
        }
        if root.c.on: Rectangle {
            x: 0;
            y: -1px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Ink.ink;
            Text {
                text: "+";
                font-family: "Geist";
                font-size: 14px;
                font-weight: 600;
                color: #171717;
            }
        }
        cn := TouchArea {
            enabled: root.c.style == 0;
            mouse-cursor: pointer;
            clicked => { root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // where new steps go
    if root.c.kind == 18: Rectangle {
        border-radius: 1px;
        background: #525252;
        opacity: root.c.on ? 1 : 0.25;
        TouchArea {
            x: -4px;
            width: parent.width + 8px;
            mouse-cursor: pointer;
            clicked => { root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // the recording's caret
    if root.c.kind == 19: Rectangle {
        background: #ff5b5b;
        opacity: root.blink ? 1 : 0.15;
    }
}

export component MacroWindow inherits Window {
    in property <bool> is-maximized;
    in property <image> mark;
    in property <[MacroItem]> items;
    in-out property <length> lib-scroll;
    // the device the open macro belongs to, if any, and the list's height
    in property <string> lib-title;
    in property <length> items-h;
    in property <string> macro-name;
    in property <bool> editing-name;
    in-out property <string> name-text;
    in property <bool> can-rename;
    in property <string> state-text;
    in property <int> state-kind;      // 0 quiet, 1 changed, 2 recording
    in property <[Cell]> chain;
    in property <length> chain-h;
    in property <int> chain-empty;     // 0 steps, 1 none yet, 2 recording with none yet
    in property <[string]> empty-lines;
    // a step being dragged: its chip under the pointer, and the step it would go before
    in property <bool> ghost-on;
    in property <Cell> ghost;
    in property <int> drop-index: -1;
    in property <bool> tools-off;
    in property <bool> can-clear;
    in property <bool> can-key;
    in property <bool> can-media;
    in property <bool> can-wait;
    // Ectomatter's own macros' actions and other macros: shown for its library alone
    in property <bool> jobs-shown;
    in property <bool> can-jobs;
    in property <bool> can-record;
    in property <string> meter-text;
    in property <bool> meter-warn;
    in property <bool> recording;
    in property <string> rec-clock;
    in property <string> plays-text;
    in property <bool> plays-on;
    in property <bool> count-shown;
    in-out property <string> count-text;
    in property <bool> locked;
    in property <string> status-text;
    in property <int> status-kind;
    in property <bool> can-revert;
    in property <bool> can-save;
    // the open menu
    in property <bool> menu-open;
    // whether the open menu keeps a column for ticks (not when nothing in it is ticked)
    in property <bool> menu-marks: true;
    in property <length> menu-ax;
    in property <length> menu-w: 220px;
    in property <[MenuRow]> menu-rows;
    in property <string> menu-placeholder;
    in property <bool> menu-back;
    in property <bool> menu-search;
    in-out property <string> menu-query;
    in property <length> menu-top;
    in property <length> menu-max;
    in property <length> menu-natural;
    out property <length> menu-x: menu.x;
    out property <length> menu-y: menu.y;
    out property <length> menu-width: menu.width;
    out property <length> menu-height: menu.height;
    out property <length> window-height: root.height;
    out property <length> window-width: root.width;
    // the chain's width, for the window to wrap it
    out property <length> chain-width: root.width - 290px - 36px - 36px;
    out property <length> chain-scroll: chain-flick.content-y;
    // are you sure: deleting a macro
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-body2;

    callback minimize();
    callback maximize();
    callback close-window();
    callback drag();
    // the library shown, and its drop-down at the list's top, which opens the
    // menu of every library: Ectomatter's own, then each device's that keeps macros
    in property <string> lib-name;
    callback libs(length, length, length);
    // a macro by its library and number, and a new one in a library
    callback choose(int, int);
    callback new-in(int);
    callback row-menu(int, int, length, length);
    callback rename();
    callback name-done(string);
    callback name-cancel();
    callback more(length, length, length);
    callback chain-click(int, int, length, length, length);
    callback chain-drop(int, length, length);
    callback chain-drag(int, length, length, length, length);
    callback wait-done(int, string);
    callback wait-cancel();
    callback tool(int, length, length, length);
    callback plays(length, length, length);
    callback count-done(string);
    callback revert();
    callback save();
    callback menu-chose(int);
    callback menu-typed(string);
    callback menu-enter();
    callback menu-dismiss();
    callback menu-back-to();
    callback menu-field(int, string);
    callback confirm-yes();
    callback confirm-no();

    background: transparent;
    default-font-family: "Geist";
    property <length> radius: root.is-maximized ? 0 : 10px;
    in property <bool> blink;

    public function focus-menu() {
        menu.focus-search();
    }
    public function blur-menu() {
        menu.blur-search();
    }

    // the title bar: the mark, the wordmark, and where this window is
    Rectangle {
        y: 0;
        height: 36px;
        background: Ink.title;
        border-top-left-radius: root.radius;
        border-top-right-radius: root.radius;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.drag();
                }
            }
            double-clicked => { root.maximize(); }
        }
        Image {
            x: 12px;
            y: 10px;
            width: 16px;
            height: 16px;
            source: root.mark;
        }
        Text {
            x: 35px;
            height: 36px;
            text: "Ectomatter";
            font-weight: 600;
            font-size: 13.5px;
            letter-spacing: -0.54px;
            color: Ink.bright;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 114px;
            y: 0;
            width: self.preferred-width;
            height: 36px;
            spacing: 6px;
            if root.lib-title != "": Text { text: root.lib-title; font-size: 13px; color: Ink.dim; vertical-alignment: center; }
            if root.lib-title != "": Text { text: "/"; font-size: 13px; color: #4a4a52; vertical-alignment: center; }
            Text { text: "Macro Editor"; font-size: 13px; color: Ink.dim; vertical-alignment: center; }
        }
        HorizontalLayout {
            x: parent.width - 120px;
            width: 120px;
            WinButton {
                commands: "M3 8h10";
                clicked => { root.minimize(); }
            }
            WinButton {
                size: 12px;
                commands: "M3.5 2.5h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z";
                clicked => { root.maximize(); }
            }
            WinButton {
                danger: true;
                corner: root.radius;
                commands: "M3.5 3.5l9 9M12.5 3.5l-9 9";
                clicked => { root.close-window(); }
            }
        }
    }

    // the macros: the library shown, chosen from a drop-down at the top
    // (Ectomatter's own, then each device's that keeps macros in its own
    // memory); under it, where its macros are kept and who plays them, a way
    // to make a new one there, and its macros
    Rectangle {
        x: 0;
        y: 36px;
        width: 290px;
        height: root.height - 36px;
        background: Ink.box;
        border-bottom-left-radius: root.radius;
        property <length> head-h: 10px + 34px + 10px;
        // (the drop-down as the Plays one is drawn)
        Rectangle {
            x: 10px;
            y: 10px + 1px;
            width: parent.width - 20px;
            height: 32px;
            border-radius: 8px;
            background: libs-ta.has-hover ? Ink.shade2 : Ink.shade1;
            Text {
                x: 14px;
                width: parent.width - 42px;
                text: root.lib-name;
                font-size: 13px;
                color: Ink.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            Path {
                x: parent.width - 23px;
                y: 13px;
                width: 9px;
                height: 6px;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M1 1l4 4 4-4";
                fill: transparent;
                stroke: Ink.quiet;
                stroke-width: 1.35px;
            }
            libs-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.libs(self.absolute-position.x, self.absolute-position.y, 32px); }
            }
        }
        Flickable {
            x: 10px;
            y: parent.head-h;
            width: parent.width - 20px;
            height: parent.height - parent.head-h - 10px;
            content-height: root.items-h;
            content-y <=> root.lib-scroll;
            mouse-drag-pan-enabled: false;
            for m[i] in root.items: Rectangle {
                y: m.y;
                width: parent.width;
                height: m.h;
                if m.kind == 0: MacroRow {
                    width: parent.width;
                    m: m;
                    clicked => { root.choose(m.lib, m.n); }
                    menu(x, y) => { root.row-menu(m.lib, m.n, x, y); }
                }
                // a section's heading: as the mouse's page heads its lists
                // (a heading with no name, where the tab above names the library:
                // its note beside the New button, from the top)
                if m.kind == 1: Rectangle {
                    if m.name != "": Text {
                        x: 12px;
                        y: 0;
                        height: 30px;
                        width: parent.width - 84px;
                        text: m.name;
                        font-family: "Geist";
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.9px;
                        color: Ink.quiet;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TextButton {
                        x: parent.width - self.width - 4px;
                        y: 1px;
                        text: "+ New";
                        opacity: m.can-new ? 1 : 0.35;
                        clicked => { if (m.can-new) { root.new-in(m.lib); } }
                    }
                    // (broken into lines where the page measured them, so the
                    // macros start below the last)
                    Text {
                        x: 12px;
                        y: m.name == "" ? 7px : 30px;
                        text: m.sub;
                        font-size: 12px;
                        color: Ink.quiet;
                        vertical-alignment: top;
                    }
                }
            }
        }
        ScrollBar {
            x: parent.width - 12px;
            y: parent.head-h;
            height: parent.height - parent.head-h - 10px;
            view: parent.height - parent.head-h - 10px;
            content: root.items-h;
            offset: -root.lib-scroll;
            framed: false;
            thumb-color: #4a4a52;
            scroll-to(o) => { root.lib-scroll = -o; }
        }
    }

    // the workspace
    Rectangle {
        x: 290px;
        y: 36px;
        width: root.width - 290px;
        height: root.height - 36px;
        background: Ink.base;
        border-bottom-right-radius: root.radius;
        // the name, whether it is saved, and the less common actions
        HorizontalLayout {
            x: 18px;
            y: 0;
            width: parent.width - 30px;
            height: 56px;
            spacing: 8px;
            // the name: a click into it edits it, as the rename button does
            if !root.editing-name: Text {
                text: root.macro-name;
                font-size: 14.5px;
                font-weight: 600;
                color: Ink.ink;
                vertical-alignment: center;
                overflow: elide;
                TouchArea {
                    enabled: root.can-rename;
                    mouse-cursor: text;
                    clicked => { root.rename(); }
                }
            }
            if root.editing-name: Rectangle {
                width: 320px;
                y: 13px;
                height: 30px;
                border-radius: 8px;
                background: Ink.shade1;
                name-in := TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text <=> root.name-text;
                    font-size: 14.5px;
                    font-weight: 600;
                    color: Ink.ink;
                    vertical-alignment: center;
                    single-line: true;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => { root.name-done(self.text); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.name-cancel();
                            return accept;
                        }
                        reject
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.name-done(self.text);
                        }
                    }
                }
            }
            if !root.editing-name: Rectangle {
                width: 17px;
                MacroIcon {
                    x: 2px;
                    y: 21.5px;
                    width: 13px;
                    height: 13px;
                    which: 3;
                    stroke: Ink.quiet;
                    opacity: root.can-rename ? 1 : 0.35;
                }
                TouchArea {
                    enabled: root.can-rename;
                    mouse-cursor: pointer;
                    clicked => { root.rename(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.state-kind == 2: Rectangle {
                width: 7px;
                Rectangle {
                    y: 24px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #ff5b5b;
                    opacity: root.blink ? 1 : 0.15;
                }
            }
            Text {
                text: root.state-text;
                font-size: 12px;
                font-weight: root.state-kind == 2 ? 600 : 400;
                color: root.state-kind == 2 ? #ff6b6b : root.state-kind == 1 ? Ink.warn : Ink.quiet;
                vertical-alignment: center;
            }
            Rectangle {
                width: 28px;
                more-b := Rectangle {
                    y: 15px;
                    height: 26px;
                    border-radius: 6px;
                    background: more-ta.has-hover && !root.recording ? Ink.shade2 : transparent;
                    Text { text: "⋯"; font-size: 15px; color: Ink.quiet; }
                    more-ta := TouchArea {
                        enabled: !root.recording;
                        mouse-cursor: pointer;
                        clicked => { root.more(self.absolute-position.x, self.absolute-position.y, 26px); }
                    }
                }
            }
        }
        // the recording area: the chain, then the tools under it
        // recording is a signal, so the canvas keeps a red edge while it runs
        if root.recording: Rectangle {
            x: 18px - 1px;
            y: 56px - 1px;
            width: parent.width - 36px + 2px;
            height: parent.height - 56px - 66px + 2px;
            border-radius: 15px;
            background: #ff5b5bb3;
        }
        canvas := Rectangle {
            x: 18px;
            y: 56px;
            width: parent.width - 36px;
            height: parent.height - 56px - 66px;
            border-radius: 14px;
            background: Ink.shade1;
            chain-flick := Flickable {
                y: 0;
                width: parent.width;
                height: parent.height - 48px;
                content-height: max(self.height, root.chain-h + 36px);
                mouse-drag-pan-enabled: false;
                for c in root.chain: ChainPiece {
                    c: c;
                    blink: root.blink;
                    drop-to: root.ghost-on && c.kind == 15 && c.id != 0 && c.index == root.drop-index;
                    drag-at(i, x, y, ox, oy) => { root.chain-drag(i, x, y, ox, oy); }
                    clicked(id, i, x, y, h) => { root.chain-click(id, i, x, y, h); }
                    dropped(i, x, y) => { root.chain-drop(i, x, y); }
                    wait-done(i, t) => { root.wait-done(i, t); }
                    wait-cancel => { root.wait-cancel(); }
                }
                // nothing in it yet: a dashed ring round the record dot, and what to do
                if root.chain-empty != 0: Rectangle {
                    x: (parent.width - 440px) / 2;
                    y: (parent.height - 118px) / 2;
                    width: 440px;
                    height: 118px;
                    Path {
                        x: (parent.width - 38px) / 2;
                        y: 0;
                        width: 38px;
                        height: 38px;
                        viewbox-width: 38;
                        viewbox-height: 38;
                        commands: "M19.00 0.50A18.5 18.5 0 0 1 22.04 0.75M25.01 1.50A18.5 18.5 0 0 1 27.81 2.73M30.36 4.40A18.5 18.5 0 0 1 32.61 6.47M34.49 8.88A18.5 18.5 0 0 1 35.94 11.57M36.93 14.46A18.5 18.5 0 0 1 37.44 17.47M37.44 20.53A18.5 18.5 0 0 1 36.93 23.54M35.94 26.43A18.5 18.5 0 0 1 34.49 29.12M32.61 31.53A18.5 18.5 0 0 1 30.36 33.60M27.81 35.27A18.5 18.5 0 0 1 25.01 36.50M22.04 37.25A18.5 18.5 0 0 1 19.00 37.50M15.96 37.25A18.5 18.5 0 0 1 12.99 36.50M10.19 35.27A18.5 18.5 0 0 1 7.64 33.60M5.39 31.53A18.5 18.5 0 0 1 3.51 29.12M2.06 26.43A18.5 18.5 0 0 1 1.07 23.54M0.56 20.53A18.5 18.5 0 0 1 0.56 17.47M1.07 14.46A18.5 18.5 0 0 1 2.06 11.57M3.51 8.88A18.5 18.5 0 0 1 5.39 6.47M7.64 4.40A18.5 18.5 0 0 1 10.19 2.73M12.99 1.50A18.5 18.5 0 0 1 15.96 0.75";
                        fill: transparent;
                        stroke: #525252;
                        stroke-width: 1px;
                    }
                    Rectangle {
                        x: (parent.width - 11px) / 2;
                        y: 13.5px;
                        width: 11px;
                        height: 11px;
                        border-radius: 5.5px;
                        background: #ff5b5b;
                    }
                    Text {
                        y: 52px;
                        width: parent.width;
                        height: 20px;
                        text: root.chain-empty == 2 ? "Recording" : "No keys yet";
                        font-size: 14px;
                        font-weight: 600;
                        color: Ink.ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    for line[i] in root.empty-lines: Text {
                        y: 78px + i * 20.15px;
                        width: parent.width;
                        height: 20.15px;
                        text: line;
                        font-size: 13px;
                        color: Ink.soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            ScrollBar {
                x: parent.width - 12px;
                y: 8px;
                height: parent.height - 48px - 8px - 2px;
                view: chain-flick.height;
                content: chain-flick.content-height;
                offset: -chain-flick.content-y;
                framed: false;
                thumb-color: #4a4a52;
                scroll-to(o) => { chain-flick.content-y = -o; }
            }
            // the tools
            HorizontalLayout {
                x: 10px;
                y: parent.height - 48px + 8px;
                width: parent.width - 20px;
                height: 30px;
                spacing: 2px;
                Rectangle {
                    width: 30px;
                    Rectangle {
                        y: 3px;
                        height: 24px;
                        border-radius: 6px;
                        background: gear.has-hover && !root.tools-off ? Ink.shade2 : transparent;
                        opacity: root.tools-off ? 0.35 : 1;
                        MacroIcon { width: 14px; height: 14px; which: 2; stroke: Ink.dim; }
                        gear := TouchArea {
                            enabled: !root.tools-off;
                            mouse-cursor: pointer;
                            clicked => { root.tool(0, self.absolute-position.x, self.absolute-position.y, 24px); }
                        }
                    }
                }
                TextButton { y: 1px; text: "Clear"; opacity: root.can-clear ? 1 : 0.35; clicked => { if (root.can-clear) { root.tool(1, self.absolute-position.x, self.absolute-position.y, self.height); } } }
                Rectangle {
                    width: 13px;
                    Rectangle { x: 6px; y: 7px; width: 1px; height: 16px; background: Ink.shade4; }
                }
                TextButton { y: 1px; text: "+ Key"; opacity: root.can-key ? 1 : 0.35; clicked => { if (root.can-key) { root.tool(2, self.absolute-position.x, self.absolute-position.y, self.height); } } }
                TextButton { y: 1px; text: "+ Media key"; opacity: root.can-media ? 1 : 0.35; clicked => { if (root.can-media) { root.tool(3, self.absolute-position.x, self.absolute-position.y, self.height); } } }
                TextButton { y: 1px; text: "+ Wait"; opacity: root.can-wait ? 1 : 0.35; clicked => { if (root.can-wait) { root.tool(4, self.absolute-position.x, self.absolute-position.y, self.height); } } }
                if root.jobs-shown: TextButton { y: 1px; text: "+ Action"; opacity: root.can-jobs ? 1 : 0.35; clicked => { if (root.can-jobs) { root.tool(6, self.absolute-position.x, self.absolute-position.y, self.height); } } }
                if root.jobs-shown: TextButton { y: 1px; text: "+ Macro"; opacity: root.can-jobs ? 1 : 0.35; clicked => { if (root.can-jobs) { root.tool(7, self.absolute-position.x, self.absolute-position.y, self.height); } } }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.meter-text;
                    font-size: 12px;
                    color: root.meter-warn ? Ink.warn : Ink.quiet;
                    vertical-alignment: center;
                }
                Rectangle { width: 4px; }
                if root.recording: Rectangle { width: 6px; }
                if root.recording: Text {
                    text: root.rec-clock;
                    font-size: 13px;
                    color: #ff9a9a;
                    vertical-alignment: center;
                }
                if root.recording: Rectangle { width: 4px; }
                Rectangle {
                    width: rec-row.preferred-width;
                    border-radius: 8px;
                    background: root.recording ? #e23b3b33 : rec-ta.has-hover && root.can-record ? Ink.pick-hover : Ink.pick;
                    opacity: root.recording || root.can-record ? 1 : 0.35;
                    rec-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 7px;
                        Rectangle {
                            width: root.recording ? 8px : 9px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: root.recording ? 8px : 9px;
                                height: self.width;
                                border-radius: root.recording ? 2px : 4.5px;
                                background: root.recording ? #ff8a8a : #ff5b5b;
                            }
                        }
                        Text {
                            text: root.recording ? "Stop" : "Record";
                            font-size: 13px;
                            font-weight: 500;
                            color: root.recording ? #ffc9c9 : Ink.bright;
                            vertical-alignment: center;
                        }
                    }
                    rec-ta := TouchArea {
                        enabled: root.recording || root.can-record;
                        mouse-cursor: pointer;
                        clicked => { root.tool(5, self.absolute-position.x, self.absolute-position.y, self.height); }
                    }
                }
            }
        }
        // the foot: how it plays, what was last done, Revert and Save
        HorizontalLayout {
            x: 18px;
            y: parent.height - 66px + 14px;
            width: parent.width - 36px;
            height: 34px;
            spacing: 10px;
            Text { text: "Plays"; font-size: 12px; color: Ink.quiet; vertical-alignment: center; }
            Rectangle {
                width: 170px;
                Rectangle {
                    y: 1px;
                    height: 32px;
                    border-radius: 8px;
                    background: plays-ta.has-hover && root.plays-on ? Ink.shade2 : Ink.shade1;
                    opacity: root.plays-on ? 1 : 0.35;
                    Text {
                        x: 14px;
                        width: parent.width - 42px;
                        text: root.plays-text;
                        font-size: 13px;
                        color: Ink.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Path {
                        x: parent.width - 23px;
                        y: 13px;
                        width: 9px;
                        height: 6px;
                        viewbox-width: 10;
                        viewbox-height: 6;
                        commands: "M1 1l4 4 4-4";
                        fill: transparent;
                        stroke: Ink.quiet;
                        stroke-width: 1.35px;
                    }
                    plays-ta := TouchArea {
                        enabled: root.plays-on;
                        mouse-cursor: pointer;
                        clicked => { root.plays(self.absolute-position.x, self.absolute-position.y, 32px); }
                    }
                }
            }
            if root.count-shown: Rectangle {
                width: 56px;
                Rectangle {
                    y: 1px;
                    height: 32px;
                    border-radius: 8px;
                    background: Ink.shade1;
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text <=> root.count-text;
                        font-size: 13px;
                        color: Ink.ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.count-done(self.text); }
                        changed has-focus => { if (!self.has-focus) { root.count-done(self.text); } }
                    }
                }
            }
            if root.count-shown: Text { text: "times"; font-size: 13px; color: Ink.dim; vertical-alignment: center; }
            if root.locked: Text {
                text: "This macro holds something the editor cannot rebuild exactly, so it is shown read only.";
                font-size: 12.5px;
                color: Ink.quiet;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                text: root.status-text;
                font-size: 12.5px;
                color: root.status-kind == 1 ? Ink.good : root.status-kind == 2 ? Ink.bad : Ink.quiet;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { width: 0; }
            WordButton {
                y: 1px;
                height: 32px;
                width: 68px;
                text: "Revert";
                enabled: root.can-revert;
                clicked => { root.revert(); }
            }
            WordButton {
                height: 34px;
                width: 103px;
                text: "Save macro";
                primary: true;
                enabled: root.can-save;
                clicked => { root.save(); }
            }
        }
    }

    // the step being dragged, following the pointer as the web page's drag image did
    if root.ghost-on: ChainPiece {
        c: root.ghost;
        opacity: 0.75;
    }

    // the open menu, over everything
    menu := Menu {
        marks: root.menu-marks;
        visible: root.menu-open;
        x: max(8px, min(root.menu-ax, root.width - root.menu-w - 8px));
        width: root.menu-w;
        height: min(root.menu-natural, min(root.menu-max, root.height - root.menu-top - 8px));
        y: root.menu-top;
        rows: root.menu-rows;
        placeholder: root.menu-placeholder;
        back: root.menu-back;
        search: root.menu-search;
        query <=> root.menu-query;
        chose(i) => { root.menu-chose(i); }
        go-back => { root.menu-back-to(); }
        typed(t) => { root.menu-typed(t); }
        enter => { root.menu-enter(); }
        dismiss => { root.menu-dismiss(); }
        field-done(i, t) => { root.menu-field(i, t); }
    }

    // are you sure: a scrim over the window, and the question on it
    if root.confirm-open: Rectangle {
        background: #0a0c0f9e;
        border-radius: root.radius;
        TouchArea {
            clicked => { root.confirm-no(); }
        }
        Rectangle {
            width: min(440px, parent.width - 32px);
            height: dlg.preferred-height + 40px;
            border-radius: 12px;
            background: Ink.shade2;
            border-width: 1px;
            border-color: Ink.line;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 24px;
            drop-shadow-color: #000000cc;
            TouchArea { }
            dlg := VerticalLayout {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                height: self.preferred-height;
                spacing: 10px;
                Text { text: root.confirm-title; font-size: 16px; font-weight: 600; color: Ink.ink; wrap: word-wrap; }
                Text { text: root.confirm-body; font-size: 13.5px; color: Ink.dim; wrap: word-wrap; }
                Text { text: root.confirm-body2; font-size: 13.5px; color: Ink.dim; wrap: word-wrap; }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    alignment: end;
                    WordButton { text: "Cancel"; clicked => { root.confirm-no(); } }
                    Rectangle {
                        width: del.preferred-width + 28px;
                        height: 30px;
                        border-radius: 7px;
                        background: del-ta.has-hover ? #e25f5b : #d9534f;
                        del := Text { text: "Delete macro"; font-size: 13px; font-weight: 600; color: #ffffff; }
                        del-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.confirm-yes(); }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ the screen layout editor
// A layout in the editor's list: its name, the line saying what it shows, whether open.
export struct LayoutRow {
    name: string,
    about: string,
    on: bool,
}

// A block on the editor's screen: its first cell and its size in cells, whether
// selected, whether an effect; whether its corner can change its rows; and for each
// height it can have from one row on, the nearest column its corner may pull it in to
// (as narrow as it can be there) and how far its corner can reach (the column after its
// last free cell), so the corner stops at its neighbors and the screen's edges.
// An effect's tile in the Effect box: its name, its picture on the screen, and whether
// it is the one chosen (lit, and its picture moving).
export struct FxTile {
    name: string,
    pic: image,
    on: bool,
}

export struct EdBlock {
    row: int,
    col: int,
    width: int,
    height: int,
    on: bool,
    fx: bool,
    tall: bool,
    lows: [int],
    ends: [int],
}

// A kind of block's glyph, 12 across: 0 Text, 1 Data, 2 Bar, 3 Effect.
component BlockGlyph inherits Rectangle {
    in property <int> which;
    in property <color> tint;
    width: 12px;
    height: 12px;
    if root.which == 0: Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M2 2.5h8M6 2.5V10";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
    }
    if root.which == 1: Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M1.6 9.2a4.4 4.4 0 1 1 8.8 0M6 9.2l2.3-3";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.35px;
        stroke-line-cap: round;
    }
    if root.which == 2: Rectangle {
        Path {
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M2.5 3.4h7a1.5 1.5 0 0 1 1.5 1.5v2.2a1.5 1.5 0 0 1-1.5 1.5h-7a1.5 1.5 0 0 1-1.5-1.5v-2.2a1.5 1.5 0 0 1 1.5-1.5z";
            fill: transparent;
            stroke: root.tint;
            stroke-width: 1.2px;
        }
        Rectangle {
            x: 2.5px;
            y: 4.9px;
            width: 4.2px;
            height: 2.2px;
            border-radius: 0.5px;
            background: root.tint;
        }
    }
    if root.which == 3: Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M6 1.2l1.15 3.65L10.8 6 7.15 7.15 6 10.8 4.85 7.15 1.2 6l3.65-1.15z";
        fill: root.tint;
    }
}

// A kind of block in the bar over the screen, as a layout's bar on the playlist:
// selected, it goes into the first free cells that fit it; pressed and dragged, it
// is carried to the screen (where it is in the window, as it moves and as it is let go).
component BlockChip inherits Rectangle {
    in property <string> text;
    in property <int> which;
    in property <bool> lit;
    callback add();
    callback carry(length, length);
    callback drop(length, length);
    callback cancel();
    width: 88px;
    height: 24px;
    border-radius: 5px;
    background: root.lit ? #52525b : ta.has-hover ? Ink.pick-hover : Ink.pick;
    property <bool> far;
    BlockGlyph {
        x: 9px;
        y: 6px;
        which: root.which;
        tint: root.lit || ta.has-hover ? Ink.bright : Ink.soft;
    }
    Text {
        x: 28px;
        height: parent.height;
        text: root.text;
        font-family: "Geist";
        font-size: 12px;
        color: root.lit || ta.has-hover ? Ink.bright : Ink.dim;
        vertical-alignment: center;
    }
    ta := TouchArea {
        // the finger, as on anything that can be selected; the closed hand once it is carried
        mouse-cursor: root.far ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.far = false;
            }
            if (e.kind == PointerEventKind.up) {
                if (root.far) {
                    root.far = false;
                    root.drop(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else if (e.button == PointerEventButton.left) {
                    root.add();
                }
            }
            if (e.kind == PointerEventKind.cancel && root.far) {
                root.far = false;
                root.cancel();
            }
        }
        moved => {
            if (self.pressed) {
                if (!root.far && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                    root.far = true;
                }
                if (root.far) {
                    root.carry(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// A layout in the editor's list, as a macro in the Macro Editor's: chosen, its
// row lit, with a bar at its left.
component LayoutListRow inherits Rectangle {
    in property <LayoutRow> r;
    callback clicked;
    height: 52px;
    border-radius: 8px;
    background: root.r.on ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover ? Ink.hover-box : transparent;
    if root.r.on: Rectangle {
        x: 0;
        y: 12px;
        width: 4px;
        height: 28px;
        border-radius: 2px;
        background: Ink.bright;
    }
    Text {
        x: 20px;
        y: 8px;
        width: parent.width - 32px;
        height: 18px;
        text: root.r.name;
        font-family: "Geist";
        font-size: 13px;
        font-weight: 500;
        color: root.r.on || ta.has-hover ? Ink.bright : Ink.dim;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: 20px;
        y: 26px;
        width: parent.width - 32px;
        height: 17px;
        text: root.r.about;
        font-family: "Geist";
        font-size: 11.5px;
        color: Ink.quiet;
        overflow: elide;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The screen layout editor, a window of its own as the Macro Editor is: the
// layouts down its left; the one open, its name and its menu; the bar of blocks
// joined to the top of the screen's box, with the layout's backlight and the grid
// at its end; the screen, its blocks outlined; under it, the box of the block
// selected. Changes save as they are made.
export component LayoutWindow inherits Window {
    in property <bool> is-maximized;
    in property <image> mark;
    in property <[LayoutRow]> rows;
    in-out property <length> list-scroll;
    // the layout open (none once every layout is deleted): its name, changed in place;
    // deleting it asks first, in the header's place
    in property <bool> has-layout: true;
    in property <string> name;
    in property <bool> editing-name;
    in-out property <string> name-text;
    in property <bool> confirm-open;
    in property <string> confirm-text;
    // the screen: its picture and the background round it, its blocks, its grid; a block
    // on its way in from the bar (the cells it would take), and its name under the pointer
    in property <image> picture;
    in property <color> field: #0a0908;
    in property <[EdBlock]> blocks;
    // the block selected (-1, none); its corner being dragged and how many cells wider and
    // rows taller so far; and whether it is being carried (its corner and × step aside)
    in property <int> sel-block: -1;
    in-out property <bool> corner-on;
    in-out property <int> corner-dw;
    in-out property <int> corner-dh;
    in-out property <bool> sel-moving;
    // the line in the bar after the blocks: how to add one, or that there's no room
    in property <string> bar-hint: "Drag a block onto the screen.";
    // counted up each time the layout has taken a block's move or new ends, so the
    // block dragged lets go of the drag even when nothing changed
    in property <int> settled;
    in property <bool> grid;
    in property <bool> ghost-on;
    in property <EdBlock> ghost;
    // an effect selected: the effects, as tiles in its box
    in property <[FxTile]> fx-tiles;
    callback fx-chose(int);
    in property <bool> carry-on;
    in property <string> carry-name;
    in property <int> carry-kind;
    in property <length> carry-x;
    in property <length> carry-y;
    in property <int> lit-chip: -1;
    // the layout's backlight: its own color, or the profile's default (whose color the
    // switch's dot shows); the color and its code; the picker open on it
    in property <bool> own-light;
    in property <color> default-light;
    in property <color> own-color;
    in property <string> own-hex;
    in property <bool> picking;
    // the box under the screen: 0 nothing selected, 1 text, 2 data, 3 bar; its title and
    // its cells; whether the layout has blocks yet
    in property <int> box-kind;
    in property <string> box-title;
    in property <[Cell]> box-cells;
    in property <length> box-h;
    in property <bool> has-blocks;
    // the open menu
    in property <bool> menu-open;
    // whether the open menu keeps a column for ticks (not when nothing in it is ticked)
    in property <bool> menu-marks: true;
    in property <length> menu-ax;
    in property <length> menu-w: 248px;
    in property <[MenuRow]> menu-rows;
    in property <length> menu-top;
    in property <length> menu-max;
    in property <length> menu-natural;
    out property <length> menu-x: menu.x;
    out property <length> menu-y: menu.y;
    out property <length> menu-width: menu.width;
    out property <length> menu-height: menu.height;
    out property <length> window-height: root.height;
    out property <length> window-width: root.width;
    // the color picker
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-top;
    in property <length> picker-height: 415px;
    in property <float> pk-hue;
    in property <float> pk-sat;
    in property <float> pk-val;
    in property <color> pk-now;
    in property <color> pk-pure;
    in property <image> pk-sv-img;
    in property <image> pk-hue-img;
    in-out property <string> pk-hex;
    in-out property <string> pk-r;
    in-out property <string> pk-g;
    in-out property <string> pk-b;
    in-out property <string> pk-h;
    in-out property <string> pk-s;
    in-out property <string> pk-v;
    in property <[color]> pk-presets;
    in property <[color]> pk-recent;
    // where the screen's cells are in the window, for a block carried from the bar
    out property <length> cells-x: lcd.absolute-position.x;
    out property <length> cells-y: lcd.absolute-position.y;
    out property <length> cell-w: lcd.width / 20;
    out property <length> cell-h: lcd.height / 4;

    callback minimize();
    callback maximize();
    callback close-window();
    callback drag();
    callback choose(int);
    // + New (or the empty window's New layout): its menu, hung from the button (where it is
    // and how wide)
    callback new-layout(length, length, length, length);
    callback rename();
    callback name-done(string);
    callback name-cancel();
    callback more(length, length, length);
    callback confirm-yes();
    callback confirm-no();
    callback block-chosen(int);
    callback block-moved(int, int, int);
    callback block-sized(int, int, int);
    callback block-remove();
    callback chip-add(int);
    callback chip-carry(int, length, length);
    callback chip-drop(int, length, length);
    callback chip-cancel();
    callback light-own(bool);
    callback light-color(length, length, length);
    callback grid-toggle();
    callback cell-pick(int, int, length, length, length);
    callback cell-slide(int, float);
    callback cell-typed(int, int, string);
    callback menu-chose(int);
    callback menu-dismiss();
    callback pk-sv(float, float);
    callback pk-hue-at(float);
    callback pk-field(int, string);
    callback pk-well(color);
    callback pk-enter();
    callback pk-dismiss();

    background: transparent;
    default-font-family: "Geist";
    property <length> radius: root.is-maximized ? 0 : 10px;
    property <length> main-w: root.width - 290px;
    property <length> rig-w: main-w - 36px;
    // the screen holds the keyboard when a block on it is pressed, so a field in the box
    // lets go of it (and the window no longer counts as typing)
    keys := FocusScope { width: 0; height: 0; }
    function take-keys() {
        keys.focus();
        Typing.on = false;
    }

    // the title bar: the mark, the wordmark, and where this window is
    Rectangle {
        y: 0;
        height: 36px;
        background: Ink.title;
        border-top-left-radius: root.radius;
        border-top-right-radius: root.radius;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.drag();
                }
            }
            double-clicked => { root.maximize(); }
        }
        Image {
            x: 12px;
            y: 10px;
            width: 16px;
            height: 16px;
            source: root.mark;
        }
        Text {
            x: 35px;
            height: 36px;
            text: "Ectomatter";
            font-weight: 600;
            font-size: 13.5px;
            letter-spacing: -0.54px;
            color: Ink.bright;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 114px;
            y: 0;
            width: self.preferred-width;
            height: 36px;
            spacing: 6px;
            Text { text: "EVGA Z10 RGB"; font-size: 13px; color: Ink.dim; vertical-alignment: center; }
            Text { text: "/"; font-size: 13px; color: #4a4a52; vertical-alignment: center; }
            Text { text: "Screen layouts"; font-size: 13px; color: Ink.dim; vertical-alignment: center; }
        }
        HorizontalLayout {
            x: parent.width - 120px;
            width: 120px;
            WinButton {
                commands: "M3 8h10";
                clicked => { root.minimize(); }
            }
            WinButton {
                size: 12px;
                commands: "M3.5 2.5h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z";
                clicked => { root.maximize(); }
            }
            WinButton {
                danger: true;
                corner: root.radius;
                commands: "M3.5 3.5l9 9M12.5 3.5l-9 9";
                clicked => { root.close-window(); }
            }
        }
    }

    // the layouts
    Rectangle {
        x: 0;
        y: 36px;
        width: 290px;
        height: root.height - 36px;
        background: Ink.box;
        border-bottom-left-radius: root.radius;
        Text {
            x: 18px;
            y: 14px;
            height: 28px;
            text: "All layouts";
            font-size: 13.5px;
            font-weight: 500;
            color: Ink.bright;
            vertical-alignment: center;
        }
        TextButton {
            x: parent.width - 12px - self.width;
            y: 14px;
            text: "+ New";
            clicked => { root.new-layout(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
        }
        Flickable {
            x: 8px;
            y: 52px;
            width: 274px;
            height: parent.height - 52px - 10px;
            content-height: root.rows.length * 54px;
            content-y <=> root.list-scroll;
            mouse-drag-pan-enabled: false;
            for r[i] in root.rows: LayoutListRow {
                y: i * 54px;
                width: parent.width;
                r: r;
                clicked => { root.choose(i); }
            }
        }
    }

    // the layout open
    Rectangle {
        x: 290px;
        y: 36px;
        width: main-w;
        height: root.height - 36px;
        background: Ink.base;
        border-bottom-right-radius: root.radius;
        // its name, a pencil to change it, and its menu; asking before it is deleted, in their place
        if !root.confirm-open: Rectangle {
            visible: root.has-layout;
            x: 18px;
            y: 0;
            width: parent.width - 36px;
            height: 56px;
            if !root.editing-name: name-t := Text {
                x: 0;
                height: parent.height;
                text: root.name;
                font-size: 14px;
                font-weight: 600;
                color: Ink.bright;
                vertical-alignment: center;
                overflow: elide;
                TouchArea {
                    mouse-cursor: text;
                    clicked => { root.rename(); }
                }
            }
            if !root.editing-name: Rectangle {
                x: min(name-w.preferred-width, parent.width - 80px) + 9px;
                width: 13px;
                Path {
                    y: 21.5px;
                    width: 13px;
                    height: 13px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M4 20h4L19 9l-4-4L4 16z";
                    fill: transparent;
                    stroke: pen-ta.has-hover ? Ink.soft : Ink.quiet;
                    stroke-width: 1.8px;
                    stroke-line-join: round;
                }
                pen-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.rename(); }
                }
            }
            // (the name's width, for the pencil after it)
            name-w := Text {
                visible: false;
                text: root.name;
                font-size: 14px;
                font-weight: 600;
            }
            if root.editing-name: Rectangle {
                x: 0;
                y: 13px;
                width: 320px;
                height: 30px;
                border-radius: 8px;
                background: Ink.shade1;
                TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text <=> root.name-text;
                    font-size: 14px;
                    font-weight: 600;
                    color: Ink.ink;
                    vertical-alignment: center;
                    single-line: true;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => { root.name-done(self.text); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.name-cancel();
                            return accept;
                        }
                        reject
                    }
                    changed has-focus => {
                        Typing.on = self.has-focus;
                        if (!self.has-focus) {
                            root.name-done(self.text);
                        }
                    }
                }
            }
            Rectangle {
                x: parent.width - 30px;
                y: 14px;
                width: 30px;
                height: 28px;
                border-radius: 7px;
                background: more-ta.has-hover ? Ink.hover-box : transparent;
                Text { text: "···"; font-size: 16px; letter-spacing: 1px; color: Ink.soft; }
                more-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.more(self.absolute-position.x, self.absolute-position.y, self.height); }
                }
            }
        }
        if root.confirm-open: HorizontalLayout {
            x: 18px;
            y: 0;
            width: parent.width - 36px;
            height: 56px;
            spacing: 10px;
            alignment: start;
            // (a long answer wraps, the buttons kept beside it)
            Text {
                text: root.confirm-text;
                font-size: 13px;
                color: Ink.dim;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            VerticalLayout {
                alignment: center;
                WordButton {
                    text: "Keep";
                    clicked => { root.confirm-no(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: del-t.preferred-width + 24px;
                    height: 28px;
                    border-radius: 7px;
                    background: del-ta.has-hover ? #74302a : #5c2420;
                    del-t := Text { text: "Delete"; font-size: 13px; color: #fecaca; }
                    del-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirm-yes(); }
                    }
                }
            }
        }

        // the bar of blocks, joined to the top of the screen's box, as the playlist's panel
        // is to its foot; the layout's backlight and the grid at its end
        Rectangle {
            visible: root.has-layout;
            x: 18px;
            y: 56px;
            width: rig-w;
            height: 56px;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            background: Ink.box;
            for name[k] in ["Text", "Data", "Bar", "Effect"]: BlockChip {
                x: 16px + k * 94px;
                y: 16px;
                text: name;
                which: k;
                lit: root.lit-chip == k;
                add => { root.chip-add(k); }
                carry(x, y) => { root.chip-carry(k, x, y); }
                drop(x, y) => { root.chip-drop(k, x, y); }
                cancel => { root.chip-cancel(); }
            }
            // (whole or not at all: in a narrow window it steps aside for the backlight)
            Text {
                x: 16px + 4 * 94px + 10px;
                y: 16px;
                width: light-row.x - self.x - 16px;
                height: 24px;
                visible: self.preferred-width <= self.width;
                text: root.bar-hint;
                font-size: 12.5px;
                color: Ink.quiet;
                vertical-alignment: center;
            }
            // the layout's backlight: Default (the profile's, whose color the dot shows), or a
            // color of the layout's own, as its dot and its code, which open the picker
            light-row := HorizontalLayout {
                x: parent.width - 108px - self.width;
                y: 14px;
                width: self.preferred-width;
                height: 28px;
                spacing: 0;
                Text {
                    text: "Backlight";
                    font-size: 12.5px;
                    color: Ink.soft;
                    vertical-alignment: center;
                }
                Rectangle { width: 10px; }
                Rectangle {
                    width: def-l.preferred-width + own-l.preferred-width + 22px + 22px + 9px + 7px + 6px;
                    border-radius: 7px;
                    background: Ink.well;
                    def-b := Rectangle {
                        x: 2px;
                        y: 2px;
                        width: def-l.preferred-width + 22px + 9px + 7px;
                        height: 24px;
                        border-radius: 5px;
                        background: !root.own-light ? Ink.pick : def-ta.has-hover ? Ink.hover-well : transparent;
                        Rectangle {
                            x: 11px;
                            y: 7.5px;
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: root.default-light;
                            border-width: 1px;
                            border-color: #0000001f;
                        }
                        def-l := Text {
                            x: 11px + 9px + 7px;
                            height: parent.height;
                            text: "Default";
                            font-size: 12.5px;
                            color: !root.own-light ? Ink.bright : Ink.soft;
                            vertical-alignment: center;
                        }
                        def-ta := TouchArea {
                            enabled: root.own-light;
                            mouse-cursor: root.own-light ? MouseCursor.pointer : MouseCursor.default;
                            clicked => { root.light-own(false); }
                        }
                    }
                    Rectangle {
                        x: def-b.x + def-b.width + 2px;
                        y: 2px;
                        width: own-l.preferred-width + 22px;
                        height: 24px;
                        border-radius: 5px;
                        background: root.own-light ? Ink.pick : own-ta.has-hover ? Ink.hover-well : transparent;
                        own-l := Text {
                            x: 11px;
                            height: parent.height;
                            text: "Own color";
                            font-size: 12.5px;
                            color: root.own-light ? Ink.bright : Ink.soft;
                            vertical-alignment: center;
                        }
                        own-ta := TouchArea {
                            enabled: !root.own-light;
                            mouse-cursor: !root.own-light ? MouseCursor.pointer : MouseCursor.default;
                            clicked => { root.light-own(true); }
                        }
                    }
                }
                if root.own-light: Rectangle { width: 10px; }
                if root.own-light: Rectangle {
                    width: hex-t.preferred-width + 4px + 20px + 8px + 9px;
                    border-radius: 7px;
                    background: col-ta.has-hover || root.picking ? Ink.hover-box : transparent;
                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: root.own-color;
                        border-width: 1px;
                        border-color: #ffffff2a;
                    }
                    hex-t := Text {
                        x: 32px;
                        height: parent.height;
                        text: root.own-hex;
                        font-size: 13px;
                        color: Ink.bright;
                        vertical-alignment: center;
                    }
                    col-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.light-color(self.absolute-position.x, self.absolute-position.y, self.height); }
                    }
                }
            }
            // a hairline, then Grid: only the editor's view
            Rectangle {
                x: parent.width - 92px;
                y: 18px;
                width: 1px;
                height: 20px;
                background: Ink.line;
            }
            Rectangle {
                x: parent.width - 16px - self.width;
                y: 14px;
                width: 28px + grid-t.preferred-width;
                height: 28px;
                Rectangle {
                    x: 0;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    border-radius: 5px;
                    background: root.grid ? (grid-ta.has-hover ? Ink.bright : Ink.dim) : grid-ta.has-hover ? Ink.hover-box : Ink.well;
                    border-width: root.grid ? 0 : 1px;
                    border-color: grid-ta.has-hover ? #6a6a74 : #4a4a52;
                    if root.grid: Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                        fill: transparent;
                        stroke: Ink.base;
                        stroke-width: 2px;
                    }
                }
                grid-t := Text {
                    x: 28px;
                    height: parent.height;
                    text: "Grid";
                    font-size: 13px;
                    color: grid-ta.has-hover ? Ink.bright : Ink.dim;
                    vertical-alignment: center;
                }
                grid-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.grid-toggle(); }
                }
            }
        }
        // the bar's gray behind the box's top corners, where the two meet
        Rectangle {
            visible: root.has-layout;
            x: 18px;
            y: 56px + 44px;
            width: rig-w;
            height: 24px;
            background: Ink.box;
        }
        // the screen's box, and the bay the screen is set into, as on the Screen tab
        Rectangle {
            visible: root.has-layout;
            x: 18px;
            y: 56px + 56px;
            width: rig-w;
            height: 236px;
            border-radius: 12px;
            background: Ink.well;
            bay := Rectangle {
                x: (parent.width - 828px) / 2;
                y: 16px;
                width: 828px;
                height: 204px;
                border-radius: 10px;
                background: root.field;
                border-width: 1px;
                border-color: #0000008c;
                Rectangle {
                    y: 0;
                    height: 14px;
                    background: @linear-gradient(180deg, #00000073 0%, #00000000 100%);
                }
                lcd := Rectangle {
                    x: 24px;
                    y: 24px;
                    width: 780px;
                    height: 156px;
                    Rectangle {
                        border-radius: 4px;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.picture;
                        }
                    }
                    // a press away from every block lets the selected one go (and takes the
                        // keyboard from any field in the box, so Delete is the screen's again)
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.take-keys();
                                root.block-chosen(-1);
                            }
                        }
                    }
                    // the screen's 20 by 4 cells
                    if root.grid: Rectangle {
                        for k in 19: Rectangle {
                            x: (k + 1) * parent.width / 20 - 0.5px;
                            width: 1px;
                            background: #ffffff1c;
                        }
                        for k in 3: Rectangle {
                            y: (k + 1) * parent.height / 4 - 0.5px;
                            height: 1px;
                            background: #ffffff1c;
                        }
                    }
                    // a block on its way in: the cells it would take
                    if root.ghost-on: Rectangle {
                        x: root.ghost.col * parent.width / 20 + 1px;
                        y: root.ghost.row * parent.height / 4 + 1px;
                        width: root.ghost.width * parent.width / 20 - 2px;
                        height: root.ghost.height * parent.height / 4 - 2px;
                        border-radius: 3px;
                        border-width: 1.5px;
                        border-color: #ffffffb0;
                        background: root.field.with-alpha(0.5);
                    }
                    // each block outlined; the one selected in amber (its corner glyph and × over
                    // every block, below). Dragged, a block follows the pointer cell by cell; its
                    // corner dragged takes the block wider or narrower (and words taller or
                    // shorter), as far as the free cells and the screen let it
                    for b[i] in root.blocks: blk := Rectangle {
                        property <length> cw: parent.width / 20;
                        property <length> ch: parent.height / 4;
                        // a move: how many cells across and down; the corner (the selected block's,
                        // dragged): how many cells wider and rows taller
                        property <int> dc: 0;
                        property <int> dr: 0;
                        property <int> dw: b.on ? root.corner-dw : 0;
                        property <int> dh: b.on ? root.corner-dh : 0;
                        property <bool> sizing: b.on && root.corner-on;
                        // carried by the pointer (past a few pixels from where it was pressed)
                        property <bool> moving: false;
                        property <int> at-col: max(0, min(20 - b.width, b.col + dc));
                        property <int> at-row: max(0, min(4 - b.height, b.row + dr));
                        // (the corner: as tall as asked within the rows the block can have, then
                        // as wide as that height's free cells let it, and no narrower than the
                        // block can be at that height)
                        property <int> s-h: max(1, min(b.ends.length, b.height + dh));
                        property <int> s-end: max(b.lows[s-h - 1], min(b.ends[s-h - 1], b.col + b.width + dw));
                        property <int> show-w: sizing ? s-end - b.col : b.width;
                        property <int> show-h: sizing ? s-h : b.height;
                        property <int> home: b.row * 10000 + b.col * 100 + b.width * 4 + b.height;
                        property <int> settled: root.settled;
                        changed home => { self.rest(); }
                        changed settled => { self.rest(); }
                        function rest() {
                            self.dc = 0;
                            self.dr = 0;
                            self.moving = false;
                            if (b.on) {
                                root.sel-moving = false;
                            }
                        }
                        // (sizing never moves the block's first cell)
                        x: at-col * cw;
                        y: at-row * ch;
                        width: show-w * cw;
                        height: show-h * ch;
                        // (an effect stays behind the other blocks, selected too, so the blocks on
                        // it can still be selected)
                        z: b.fx ? 0 : b.on ? 2 : 1;
                        // (the outline a pixel in from the block's cells, as the grid's lines are between them)
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-radius: 3px;
                            border-width: b.on || move-ta.pressed ? 2px : 1px;
                            border-color: b.on || move-ta.pressed ? Ink.warn : move-ta.has-hover ? #ffffff80 : #ffffff33;
                            background: b.on && !b.fx ? #f0b35a1a : move-ta.has-hover && !b.on ? #ffffff0d : transparent;
                        }
                        // the finger, as on anything that can be selected; the closed hand only
                        // once the block is carried, and the finger again as it is let go
                        move-ta := TouchArea {
                            mouse-cursor: parent.moving ? MouseCursor.grabbing : MouseCursor.pointer;
                            // the pointer measured from where it was pressed: the outline moves
                            // with the drag, so how far it has moved already is added back
                            moved => {
                                if (abs(self.mouse-x - self.pressed-x + (parent.at-col - b.col) * cw) > 3px
                                    || abs(self.mouse-y - self.pressed-y + (parent.at-row - b.row) * ch) > 3px) {
                                    parent.moving = true;
                                }
                                parent.dc = round((self.mouse-x - self.pressed-x + (parent.at-col - b.col) * cw) / cw);
                                parent.dr = round((self.mouse-y - self.pressed-y + (parent.at-row - b.row) * ch) / ch);
                                if (b.on) {
                                    root.sel-moving = parent.moving;
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    // (the keyboard is the screen's while a block is pressed: Delete
                                    // removes the block rather than a letter in the box's field)
                                    root.take-keys();
                                    parent.dc = 0;
                                    parent.dr = 0;
                                    parent.moving = false;
                                }
                                if (e.kind == PointerEventKind.up) {
                                    parent.moving = false;
                                    root.sel-moving = false;
                                    if (parent.at-col != b.col || parent.at-row != b.row) {
                                        root.block-moved(i, parent.at-row, parent.at-col);
                                    } else {
                                        parent.rest();
                                        root.block-chosen(i);
                                    }
                                }
                            }
                        }
                    }
                    // the selected block's outline, corner glyph and × over every block: an effect
                    // stays behind the blocks on it, selected too, so they can still be selected,
                    // and its corner and × are still there to use (they step aside while the block
                    // is carried, and the × while the corner is dragged)
                    if root.sel-block >= 0 && root.sel-block < root.blocks.length && !root.sel-moving: sel := Rectangle {
                        property <EdBlock> sb: root.blocks[root.sel-block];
                        property <length> cw: parent.width / 20;
                        property <length> ch: parent.height / 4;
                        property <int> s-h: max(1, min(sb.ends.length, sb.height + root.corner-dh));
                        property <int> s-end: max(sb.lows[s-h - 1], min(sb.ends[s-h - 1], sb.col + sb.width + root.corner-dw));
                        property <int> show-w: root.corner-on ? s-end - sb.col : sb.width;
                        property <int> show-h: root.corner-on ? s-h : sb.height;
                        property <int> home: sb.row * 10000 + sb.col * 100 + sb.width * 4 + sb.height;
                        property <int> settled: root.settled;
                        changed home => { self.rest(); }
                        changed settled => { self.rest(); }
                        function rest() {
                            root.corner-on = false;
                            root.corner-dw = 0;
                            root.corner-dh = 0;
                        }
                        // the corner let go: the block's new size, or, back where it started, as it was
                        function let-go() {
                            if (self.show-w != sb.width || self.show-h != sb.height) {
                                root.block-sized(root.sel-block, self.show-w, self.show-h);
                            } else {
                                self.rest();
                            }
                        }
                        x: sb.col * cw;
                        y: sb.row * ch;
                        width: show-w * cw;
                        height: show-h * ch;
                        z: 3;
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-radius: 3px;
                            border-width: 2px;
                            border-color: Ink.warn;
                        }
                        // the corner glyph: an L of twice the outline's weight on the outline's own
                        // line round the bottom right corner (the line's middle is 2 px in from the
                        // block's edge), drawn as two bars so it lands on the line's own pixels:
                        // square where they meet, rounded at their far ends. With room round it to
                        // press
                        Rectangle {
                            x: parent.width - 2px - 12px;
                            y: parent.height - 2px - 12px;
                            width: 24px;
                            height: 24px;
                            property <color> ink: corner-ta.has-hover || corner-ta.pressed ? #f7c47a : Ink.warn;
                            // (the corner's middle, at 12 in the box, on the line's middle)
                            Rectangle {
                                x: 12px - 14px;
                                y: 12px - 2px;
                                width: 16px;
                                height: 4px;
                                border-top-left-radius: 2px;
                                border-bottom-left-radius: 2px;
                                background: parent.ink;
                            }
                            Rectangle {
                                x: 12px - 2px;
                                y: 12px - 14px;
                                width: 4px;
                                height: 16px;
                                border-top-left-radius: 2px;
                                border-top-right-radius: 2px;
                                background: parent.ink;
                            }
                            // (the corner moves with the size, so how far it has moved already is
                            // added back, as for the block itself)
                            corner-ta := TouchArea {
                                mouse-cursor: sel.sb.tall ? MouseCursor.nwse-resize : MouseCursor.ew-resize;
                                moved => {
                                    root.corner-on = true;
                                    root.corner-dw = round((self.mouse-x - self.pressed-x + (sel.show-w - sel.sb.width) * sel.cw) / sel.cw);
                                    root.corner-dh = round((self.mouse-y - self.pressed-y + (sel.show-h - sel.sb.height) * sel.ch) / sel.ch);
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up && root.corner-on) {
                                        sel.let-go();
                                    }
                                }
                            }
                        }
                        // its ×: a ring of the outline's weight round the screen's dark, centered on
                        // the outline's top right corner and filled with amber under the pointer (it
                        // steps aside while the corner is dragged)
                        if !root.corner-on: Rectangle {
                            x: parent.width - 2px - 12px;
                            y: 2px - 12px;
                            width: 24px;
                            height: 24px;
                            Rectangle {
                                x: 4px;
                                y: 4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: x-ta.has-hover ? Ink.warn : root.field;
                                border-width: 2px;
                                border-color: Ink.warn;
                                Path {
                                    width: 7px;
                                    height: 7px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: "M1.5 1.5l7 7M8.5 1.5l-7 7";
                                    fill: transparent;
                                    stroke: x-ta.has-hover ? #18181b : Ink.warn;
                                    stroke-width: 1.6px;
                                    stroke-line-cap: round;
                                }
                            }
                            x-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.block-remove(); }
                            }
                        }
                    }
                }
            }
        }

        // the box under the screen: the block selected, named for its kind
        Rectangle {
            visible: root.has-layout;
            x: 18px;
            y: 56px + 56px + 236px + 18px;
            width: (rig-w - 12px) / 2;
            height: root.box-h;
            border-radius: 12px;
            background: Ink.box;
            Text {
                x: 16px;
                y: 14px;
                height: 22px;
                text: root.box-title;
                font-size: 13.5px;
                font-weight: 600;
                color: Ink.bright;
                vertical-alignment: center;
            }
            if root.box-kind != 0: TextButton {
                x: parent.width - 10px - self.width;
                y: 11px;
                text: "Remove";
                clicked => { root.block-remove(); }
            }
            // nothing selected: what each block is for
            if root.box-kind == 0: Rectangle {
                if root.has-blocks: Text {
                    x: 16px;
                    y: 46px;
                    height: 18px;
                    text: "Select a block on the screen to change the block.";
                    font-size: 12.5px;
                    color: Ink.quiet;
                }
                for g[k] in [
                    { name: "Text", says: "Words you type, like a label or a greeting." },
                    { name: "Data", says: "A reading, such as the time, the date or the CPU temperature." },
                    { name: "Bar", says: "A bar that fills as a reading rises." },
                ]: Rectangle {
                    x: 16px;
                    y: (root.has-blocks ? 78px : 50px) + k * 29px;
                    width: parent.width - 32px;
                    height: 18px;
                    BlockGlyph {
                        x: 0;
                        y: 3px;
                        which: k;
                        tint: Ink.soft;
                    }
                    Text {
                        x: 22px;
                        height: parent.height;
                        text: g.name;
                        font-size: 12.5px;
                        font-weight: 500;
                        color: Ink.dim;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 22px + 58px;
                        width: parent.width - self.x;
                        height: parent.height;
                        text: g.says;
                        font-size: 12.5px;
                        color: Ink.quiet;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            // an effect selected: the effects as tiles, four to a row, built as the Lighting
            // tab's Effect grid is: each a well with its picture under a film and its name, the
            // chosen one lit and only its picture moving
            if root.box-kind == 4: Rectangle {
                property <length> tw: (self.width - 32px - 24px) / 4;
                for t[k] in root.fx-tiles: Rectangle {
                    x: 16px + mod(k, 4) * (parent.tw + 8px);
                    y: 50px + floor(k / 4) * (76px + 8px);
                    width: parent.tw;
                    height: 76px;
                    border-radius: 10px;
                    background: t.on ? (tile-ta.has-hover ? Ink.pick-hover : Ink.pick) : tile-ta.has-hover ? Ink.hover-box : Ink.well;
                    Rectangle {
                        x: 6px;
                        y: 6px;
                        width: parent.width - 12px;
                        height: 40px;
                        border-radius: 6px;
                        clip: true;
                        background: #0c0e10;
                        // (the screen's own shape, across the tile and in its middle)
                        Image {
                            width: parent.width;
                            height: parent.width / 5;
                            source: t.pic;
                            image-fit: fill;
                        }
                        // the film every picture sits under
                        Rectangle {
                            background: Ink.pick.with-alpha(0.35);
                        }
                    }
                    Text {
                        y: 53px;
                        height: 15px;
                        width: parent.width;
                        text: t.name;
                        font-size: 12px;
                        font-weight: t.on ? 500 : 400;
                        color: t.on || tile-ta.has-hover ? Ink.bright : Ink.soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tile-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.fx-chose(k); }
                    }
                }
            }
            for c in root.box-cells: CellView {
                c: c;
                pick(id, index, x, y, h) => { root.cell-pick(id, index, x, y, h); }
                slide(id, v) => { root.cell-slide(id, v); }
                typed(id, index, t) => { root.cell-typed(id, index, t); }
            }
        }

        // no layout left to open: what the keyboard shows meanwhile, and a new one
        if !root.has-layout: VerticalLayout {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 40px;
            width: 420px;
            height: self.preferred-height;
            spacing: 8px;
            Text {
                text: "No screen layouts";
                font-size: 14px;
                font-weight: 600;
                color: Ink.bright;
                horizontal-alignment: center;
            }
            Text {
                text: "The keyboard’s screen stays blank until a playlist has a layout to show.";
                font-size: 13px;
                color: Ink.soft;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                alignment: center;
                WordButton {
                    primary: true;
                    text: "New layout";
                    clicked => { root.new-layout(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                }
            }
        }
    }

    // a block carried from the bar: its name, under the pointer
    if root.carry-on: Rectangle {
        x: root.carry-x + 16px;
        y: root.carry-y + 12px;
        width: carry-t.preferred-width + 12px + 10px + 12px + 7px;
        height: 28px;
        border-radius: 8px;
        background: Ink.hover-box;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #0000008c;
        BlockGlyph {
            x: 10px;
            y: 8px;
            which: root.carry-kind;
            tint: Ink.dim;
        }
        carry-t := Text {
            x: 10px + 12px + 7px;
            height: parent.height;
            text: root.carry-name;
            font-size: 12.5px;
            font-weight: 600;
            color: Ink.bright;
            vertical-alignment: center;
        }
    }

    // the open menu, over everything
    menu := Menu {
        marks: root.menu-marks;
        visible: root.menu-open;
        x: max(8px, min(root.menu-ax, root.width - root.menu-w - 8px));
        width: root.menu-w;
        height: min(root.menu-natural, min(root.menu-max, root.height - root.menu-top - 8px));
        y: root.menu-top;
        rows: root.menu-rows;
        search: false;
        chose(i) => { root.menu-chose(i); }
        dismiss => { root.menu-dismiss(); }
    }

    Picker {
        visible: root.picker-open;
        x: max(8px, min(root.picker-x, root.width - 264px - 8px));
        y: root.picker-top;
        height: root.picker-height;
        hue: root.pk-hue;
        sat: root.pk-sat;
        val: root.pk-val;
        now: root.pk-now;
        pure: root.pk-pure;
        sv-img: root.pk-sv-img;
        hue-img: root.pk-hue-img;
        t-hex <=> root.pk-hex;
        t-r <=> root.pk-r;
        t-g <=> root.pk-g;
        t-b <=> root.pk-b;
        t-h <=> root.pk-h;
        t-s <=> root.pk-s;
        t-v <=> root.pk-v;
        presets: root.pk-presets;
        recent: root.pk-recent;
        sv(x, y) => { root.pk-sv(x, y); }
        hue-at(x) => { root.pk-hue-at(x); }
        field(i, t) => { root.pk-field(i, t); }
        well(c) => { root.pk-well(c); }
        enter => { root.pk-enter(); }
        dismiss => { root.pk-dismiss(); }
    }
}

// The stage of the lab: a section's drawing of the key, with the
// line from each slider to its part, drawn in Rust at the window's own pixels;
// its words are cells over it.
export struct Sketch {
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
}

// One of the lab's sliders, where it stands beside the drawing: its
// name, its box and unit (a derived one, as a beam's angle, quieter), its
// knob along its track, where it was saved, if it has moved from there,
// whether its value is other than the saved one, which its reset puts back,
// and, for a share, what each end of its track stands for
export struct LabRow {
    x: length,
    y: length,
    w: length,
    id: int,
    name: string,
    hot: bool,
    number: string,
    unit: string,
    derived: bool,
    at: float,
    was: float,
    moved: bool,
    changed: bool,
    low: string,
    high: string,
}

// A slider of the lab: the whole row tells the page when the
// pointer is over it, so its line and its part light up whether the pointer
// is on its name, its box or its track.
component LabControl inherits Rectangle {
    in property <LabRow> r;
    callback slide(int, float);
    callback reset(int);
    callback entered(int, string);
    callback hovered(int, bool);
    callback focused(int, bool);
    x: root.r.x - 10px;
    y: root.r.y - 7px;
    width: root.r.w + 20px;
    height: root.r.low != "" ? 76px : 62px;
    border-radius: 10px;
    background: root.r.hot ? #ffffff0b : transparent;
    zone := TouchArea {
        changed has-hover => { root.hovered(root.r.id, self.has-hover); }
        Text {
            x: 10px;
            y: 7px;
            height: 26px;
            text: root.r.name;
            font-family: "Geist";
            font-size: 13.5px;
            color: root.r.hot ? Ink.bright : Ink.dim;
            vertical-alignment: center;
        }
        CellView {
            c: { kind: 15, x: root.r.w + 10px - 58px - 7px - 60px, y: 7px, w: 60px, h: 26px, text: root.r.number, id: root.r.id };
            entered(id, t) => { root.entered(id, t); }
            focused(id, on) => { root.focused(id, on); }
        }
        Text {
            x: root.r.w + 10px - 58px;
            y: 7px;
            width: 58px;
            height: 26px;
            text: root.r.unit;
            font-family: "Geist";
            font-size: 13px;
            color: root.r.derived ? Ink.quiet : Ink.soft;
            vertical-alignment: center;
        }
        // its track, short of the reset at its end
        CellView {
            c: { kind: 3, x: 10px, y: 39px, w: root.r.w - 26px, h: 16px, value: root.r.at, id: root.r.id };
            slide(id, v) => { root.slide(id, v); }
            reset(id) => { root.reset(id); }
        }
        // what each end of its track stands for, under its ends
        if root.r.low != "": Text {
            x: 10px;
            y: 55px;
            height: 14px;
            text: root.r.low;
            font-family: "Geist";
            font-size: 11.5px;
            color: root.r.hot ? Ink.dim : Ink.soft;
            vertical-alignment: center;
        }
        if root.r.high != "": Text {
            x: 10px;
            y: 55px;
            width: root.r.w - 26px;
            height: 14px;
            text: root.r.high;
            font-family: "Geist";
            font-size: 11.5px;
            color: root.r.hot ? Ink.dim : Ink.soft;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        // where it was saved, on its track
        if root.r.moved: Rectangle {
            x: 10px + 8px + root.r.was * (root.r.w - 26px - 16px) - 1px;
            y: 41px;
            width: 2px;
            height: 12px;
            border-radius: 1px;
            background: #8a8a94;
        }
        // its reset, at the end of its track: the arrow alone, as gray as the
        // track while the value is the saved one, brighter once it differs,
        // and brighter still under the pointer; a click puts the value back
        Path {
            x: 10px + root.r.w - 18px;
            y: 40px;
            width: 14px;
            height: 14px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5";
            fill: transparent;
            stroke: !root.r.changed ? Ink.track : back.has-hover ? Ink.bright : Ink.soft;
            stroke-width: 1.4px;
        }
        back := TouchArea {
            x: 10px + root.r.w - 22px;
            y: 36px;
            width: 22px;
            height: 22px;
            // (nothing to put back at the saved value)
            enabled: root.r.changed;
            mouse-cursor: pointer;
            changed has-hover => { root.hovered(root.r.id + 1000, self.has-hover); }
            clicked => { root.reset(root.r.id); }
        }
    }
}

// The lab: a developer's window for tuning how the Z10's keys are
// lit, beside the main window so the keyboard stays in view as it changes.
// Landscape, one section at a time: its drawing in the middle, its sliders
// round it, the line under it saying what the slider under the pointer does,
// and what is on the keyboard now read out by Save.
export component LabWindow inherits Window {
    in property <bool> is-maximized;
    // the device the lab tunes, for its title bar
    in property <string> device-name: "EVGA Z10 RGB";
    // the lab's name for the device: its kind's (Keyboard lab, Mouse lab)
    in property <string> lab-name: "Keyboard lab";
    in property <image> mark;
    in property <[Cell]> cells;
    in property <[Sketch]> sketches;
    in property <[Cell]> over;
    in property <[LabRow]> rows;
    in property <[Cell]> foot;
    in property <string> status-text;
    in property <int> status-kind;
    // the most room what was last done takes, its words wrapping past it
    in property <length> status-room: 400px;
    in property <bool> can-save;
    in property <bool> can-revert;
    // Save's words, and its width: where it saves, the core or the light setup in use
    in property <string> save-text: "Save to the core";
    in property <length> save-w: 176px;
    // the button that puts the section on screen back as Default has it: its words, and whether there is anything to put back
    in property <string> default-text: "Reset";
    in property <bool> can-default;
    // whether there is one: a setup of the person's own is tuned, not Default itself
    in property <bool> has-default;
    // what is over everything on the page: the light setups' menu, open
    in property <[Cell]> top;
    // the chosen key's text boxes, a list of their own
    in property <[Cell]> boxes;
    out property <length> window-width: root.width;
    out property <length> window-height: root.height;

    callback minimize();
    callback maximize();
    callback close-window();
    callback drag();
    callback slide(int, float);
    callback entered(int, string);
    callback revert();
    callback save();
    // a section chosen; a slider or a reading under the pointer; a slider's box typed in;
    // Hold to compare held or let go; a slider put back
    callback pick(int, int);
    callback compare(bool);
    callback reset(int);
    callback pad(int, float, float);
    callback hovered(int, bool);
    callback focused(int, bool);
    // the typefaces' list's place on the page (none while it is shut), and the wheel turning it
    in property <length> list-x;
    in property <length> list-y;
    in property <length> list-w;
    in property <length> list-h;
    callback list-scroll(float);
    // the color picker, as the main window's, hung from the cap color's button that opened it
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-top;
    in property <float> pk-hue;
    in property <float> pk-sat;
    in property <float> pk-val;
    in property <color> pk-now;
    in property <color> pk-pure;
    in property <image> pk-sv-img;
    in property <image> pk-hue-img;
    in-out property <string> pk-hex;
    in-out property <string> pk-r;
    in-out property <string> pk-g;
    in-out property <string> pk-b;
    in-out property <string> pk-h;
    in-out property <string> pk-s;
    in-out property <string> pk-v;
    in property <[color]> pk-presets;
    in property <[color]> pk-recent;
    out property <length> picker-height: 6px + 353.56px + (root.pk-recent.length > 0 ? 55.56px : 0);
    callback pk-sv(float, float);
    callback pk-hue-at(float);
    callback pk-field(int, string);
    callback pk-well(color);
    callback pk-enter();
    callback pk-dismiss();

    background: transparent;
    default-font-family: "Geist";
    property <length> radius: root.is-maximized ? 0 : 10px;

    // the title bar: the mark, the wordmark, and where this window is
    Rectangle {
        y: 0;
        height: 36px;
        background: Ink.title;
        border-top-left-radius: root.radius;
        border-top-right-radius: root.radius;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.drag();
                }
            }
            double-clicked => { root.maximize(); }
        }
        Image {
            x: 12px;
            y: 10px;
            width: 16px;
            height: 16px;
            source: root.mark;
        }
        Text {
            x: 35px;
            height: 36px;
            text: "Ectomatter";
            font-weight: 600;
            font-size: 13.5px;
            letter-spacing: -0.54px;
            color: Ink.bright;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 114px;
            y: 0;
            width: self.preferred-width;
            height: 36px;
            spacing: 6px;
            Text { text: root.device-name; font-size: 13px; color: Ink.dim; vertical-alignment: center; }
            Text { text: "/"; font-size: 13px; color: #4a4a52; vertical-alignment: center; }
            Text { text: root.lab-name; font-size: 13px; color: Ink.dim; vertical-alignment: center; }
        }
        HorizontalLayout {
            x: parent.width - 120px;
            width: 120px;
            WinButton {
                commands: "M3 8h10";
                clicked => { root.minimize(); }
            }
            WinButton {
                size: 12px;
                commands: "M3.5 2.5h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z";
                clicked => { root.maximize(); }
            }
            WinButton {
                danger: true;
                corner: root.radius;
                commands: "M3.5 3.5l9 9M12.5 3.5l-9 9";
                clicked => { root.close-window(); }
            }
        }
    }

    // the page: its head and sections, the stage, the line under it
    Rectangle {
        y: 36px;
        height: root.height - 36px - 64px;
        background: Ink.base;
        for c in root.cells: CellView {
            c: c;
            pick(id, i, x, y, h) => { root.pick(id, i); }
            hovered(id, on) => { root.hovered(id, on); }
        }
        for s in root.sketches: Image {
            x: s.x;
            y: s.y;
            width: s.w;
            height: s.h;
            source: s.image;
        }
        // the typefaces' list, open: turned by the wheel anywhere on it
        TouchArea {
            x: root.list-x;
            y: root.list-y;
            width: root.list-w;
            height: root.list-h;
            scroll-event(e) => {
                root.list-scroll(e.delta-y / 1px);
                accept
            }
        }
        // the words on the stage, and the section's choices over it
        for c in root.over: CellView {
            c: c;
            pick(id, i, x, y, h) => { root.pick(id, i); }
            hovered(id, on) => { root.hovered(id, on); }
            pad(id, x, y) => { root.pad(id, x, y); }
            typed(id, t) => { root.entered(id, t); }
        }
        for c in root.boxes: CellView {
            c: c;
            pick(id, i, x, y, h) => { root.pick(id, i); }
            typed(id, t) => { root.entered(id, t); }
            focused(id, on) => { root.focused(id, on); }
        }
        for r in root.rows: LabControl {
            r: r;
            slide(id, v) => { root.slide(id, v); }
            reset(id) => { root.reset(id); }
            entered(id, t) => { root.entered(id, t); }
            hovered(id, on) => { root.hovered(id, on); }
            focused(id, on) => { root.focused(id, on); }
        }
        for c in root.top: CellView {
            c: c;
            pick(id, i, x, y, h) => { root.pick(id, i); }
            hovered(id, on) => { root.hovered(id, on); }
            typed(id, t) => { root.entered(id, t); }
        }
        Picker {
            visible: root.picker-open;
            x: max(8px, min(root.picker-x, root.width - 264px - 8px));
            y: root.picker-top;
            height: root.picker-height;
            hue: root.pk-hue;
            sat: root.pk-sat;
            val: root.pk-val;
            now: root.pk-now;
            pure: root.pk-pure;
            sv-img: root.pk-sv-img;
            hue-img: root.pk-hue-img;
            t-hex <=> root.pk-hex;
            t-r <=> root.pk-r;
            t-g <=> root.pk-g;
            t-b <=> root.pk-b;
            t-h <=> root.pk-h;
            t-s <=> root.pk-s;
            t-v <=> root.pk-v;
            presets: root.pk-presets;
            recent: root.pk-recent;
            sv(x, y) => { root.pk-sv(x, y); }
            hue-at(x) => { root.pk-hue-at(x); }
            field(i, t) => { root.pk-field(i, t); }
            well(c) => { root.pk-well(c); }
            enter => { root.pk-enter(); }
            dismiss => { root.pk-dismiss(); }
        }
    }

    // the foot: what is on the keyboard now, what was last done, Revert and Save
    Rectangle {
        y: root.height - 64px;
        height: 64px;
        background: Ink.base;
        border-bottom-left-radius: root.radius;
        border-bottom-right-radius: root.radius;
        Rectangle {
            x: 24px;
            y: 0;
            width: parent.width - 48px;
            height: 1px;
            background: Ink.line;
        }
        for c in root.foot: CellView {
            c: c;
            hovered(id, on) => { root.hovered(id, on); }
        }
        HorizontalLayout {
            x: 24px;
            y: 15px;
            width: parent.width - 48px;
            height: 34px;
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: root.status-text;
                font-size: 12.5px;
                color: root.status-kind == 1 ? Ink.good : root.status-kind == 2 ? Ink.bad : Ink.quiet;
                vertical-alignment: center;
                horizontal-alignment: right;
                max-width: max(0px, root.status-room);
                wrap: word-wrap;
            }
            WordButton {
                y: 1px;
                height: 32px;
                width: 132px;
                text: "Hold to compare";
                enabled: root.can-revert;
                changed down => { root.compare(self.down); }
            }
            if root.has-default: WordButton {
                y: 1px;
                height: 32px;
                text: root.default-text;
                enabled: root.can-default;
                clicked => { root.pick(1610, 0); }
                changed hover => { root.hovered(1610, self.hover); }
            }
            WordButton {
                y: 1px;
                height: 32px;
                width: 68px;
                text: "Revert";
                enabled: root.can-revert;
                clicked => { root.revert(); }
            }
            WordButton {
                height: 34px;
                width: root.save-w;
                text: root.save-text;
                primary: true;
                enabled: root.can-save;
                clicked => { root.save(); }
            }
        }
    }
}
