    in property <[Cell]> cells;
    in property <length> tile-height;
    in property <length> settings-h;
    out property <length> settings-scroll: set-flick.content-y;
    // Settings scrolled to a place on its page (its Sensor Feed box), as far as it scrolls
    in property <length> settings-goto: -1px;
    changed settings-goto => {
        if (root.settings-goto >= 0) {
            set-flick.content-y = -min(root.settings-goto, max(0px, root.settings-h - set-flick.height));
        }
    }
    // the keyboard is showing the page's preview
    in property <bool> live;
