    // same whether one is chosen or not so the row stays put; the Key library scrolls
    // inside its box)
    property <length> mouse-pro-w: root.mouse-profiles-shown && root.mouse-tab < 3 ? Size.column + Space.gap : 0;
    property <length> mouse-band-min: mouse-pro-w > 0 ? mouse-pro.preferred-height : 0;
    property <length> mouse-band-max: max(mouse-band-min, mouse-flick.height - mouse-low-y - Space.margin);
    // (the second box, a button's or All buttons, as tall as it says it needs; All buttons
    // keeps a button's room, so the row doesn't move as a button is chosen and the Key
    // library beside it keeps its height)
    property <length> mouse-key-need: 270px; // art: the Key detail box's height until it's first shown, so the row starts that tall
    property <length> mouse-all-need: 120px; // art: All buttons' height until it says
    property <length> mouse-second-need: root.mouse-chosen ? root.mouse-key-need : max(root.mouse-key-need, root.mouse-all-need);
    // the effects' box on Lighting: its tiles, three to a line
    property <length> mouse-fx-h: Size.box-head + ceil(root.mouse-effects.length / 3) * (Size.tile + Space.inline) - Space.inline + Space.pad;
    out property <length> mouse-wx: rail-w + pws-x;
    out property <length> mouse-wy: bar + Size.bar + mouse-flick.content-y;
    out property <length> mouse-stage-y: head-end;
    out property <length> mouse-stage-height: mouse-stage-h;
    out property <length> mouse-low-top: mouse-low-y;
    out property <length> mouse-low-height: root.mouse-tab < 3 ? mouse-row.height : root.mouse-cells-h;
    // the row of boxes, right of the Profiles box, in the window
    out property <length> mouse-row-wx: mouse-wx + mouse-pro-w;
    out property <length> mouse-row-width: pws-w - mouse-pro-w;
    callback mouse-tab-chosen(int);
    callback mouse-row(int);
    callback mouse-kind-picked(int, length, length, length);
    callback mouse-job-clicked(length, length, length, length);
    callback mouse-reset();
    callback mouse-effect(int);
    callback view-changed(int);
    callback choose-profile(int);
    callback key-clicked(int);
    callback key-hovered(int, bool);
    callback board-clicked();
    // whether a rebound key's new action is printed on it, and turning it on or off
    in property <bool> show-rebindings-on: true;
    callback show-rebindings();
    // the line over the keyboard, saying what to do on this tab
    in property <string> hint;
    // the layer the Keys tab edits (0 Base, 1 Function)
    in property <int> layer;
    callback layer-changed(int);
    callback rename-profile(string);
    // the Key library
    in property <[LibGroup]> lib-groups;
    in-out property <string> lib-query;
    callback lib-toggle(string);
    callback lib-find(string);
    // Game mode's keys
    in property <[CheckItem]> game-items;
    callback game-toggled(int);
    // the chosen key, on the layer shown
    in property <string> key-cap;
    in property <string> key-state;
    in property <bool> key-rebound;
    in property <bool> layer-rebound;
    in property <int> key-kind;
    in property <string> key-job;
    in property <bool> key-listening;
    in property <string> key-note;
    callback kind-picked(int, length, length, length);
    // a slider chosen in the library: 0 none, 1 the dimmer, 2 the volume slider
    in property <int> slider-chosen;
    in property <float> slider-at;
    in property <[CheckItem]> slider-choices;
    callback slider-chosen-at(int);
    callback slider-bind-at(int);
    callback action-menu(int, length, length, length, length);
    callback listen(int);
    callback reset-key();
    callback macro-editor(int);  // the layer whose macro to open, or -1
    callback mouse-macro-editor();
    callback screen-editor();
    callback menu-chose(int);
    callback menu-typed(string);
    callback menu-enter();
    callback menu-dismiss();
    callback menu-back-to();
    // a field in the open menu typed in and set, by its row
    callback menu-field(int, string);
    callback effect(int);
    callback cell-pick(int, int, length, length, length, length);
    callback cell-left(int, int, bool);
    callback cell-slide(int, float);
    callback cell-typed(int, int, string);

    background: transparent;
    default-font-family: "Barlow";
    default-font-size: Font.lead;

    property <length> radius: root.is-maximized ? 0 : Radius.window;
    property <length> bar: Size.title-bar;
    // the rail, opened into its blade, widens and the page narrows to make room
    property <length> rail-w: root.rail-open ? Size.rail-open : Size.rail-shut;
    animate rail-w { duration: 220ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> reveal: root.rail-open ? 1 : 0;
    animate reveal { duration: 160ms; delay: 60ms; easing: ease; }
    property <length> content-w: root.width - rail-w;
    // (the room a page has across, for the pages laid out in Rust)
    out property <length> content-width: content-w;
    // where the pages' scrollbars run
    property <length> page-scroll-y: bar + Size.bar + Space.inline;
    property <length> page-scroll-h: root.height - root.page-scroll-y - Space.inline;
    // the page runs the window's width, its margin either side
    property <length> pws-x: Space.margin;
    property <length> pws-w: content-w - 2 * Space.margin;
    // the keyboard fills the page's width, at the drawing's proportions, under the head
    // over the keyboard, one line: what to do here, and Show rebindings
    property <length> head-h: Size.hint;
    property <length> head-end: Size.head;
    // the keyboard sits in a box of its own, a gutter round it
    property <length> kb-pad-x: Space.stage;
    property <length> kb-pad-y: Space.margin;
    property <length> board-top: head-end + kb-pad-y;
    // under the keyboard: the anchoring column (the profiles, what goes with
    // them), and beside it the tab's boxes
    // the Screen tab, in two columns: Profiles alone in the left one; in the right one
    // the screen's two states as folder tabs on a row over the screen's box, the default
    // backlight at the row's right end (it lights both); the box holding the screen and,
    // under it, the playlist on the first tab, or on the second the chooser of the layout
    // the keyboard keeps, with Layouts joined to the box's foot. The box is as tall as
    // Profiles. (`stage-h` is the screen's part of the box.)
    // (the playlist's row: a bar's height, its controls at its middle)
    property <length> pl-panel-h: Size.bar;
    property <length> stage-h: anchor.preferred-height - pl-panel-h;
    property <length> tabs-h: Size.tab;
    // the box: as tall as Profiles, less whatever a narrow window takes off the screen's
    // height, so the row under the screen keeps its margin
    property <length> lcd-short: stage-h - 2 * bay-pad - 2 * kb-pad-y - lcd-h;
    // (Game launch's two rows take more than the playlist's one)
    property <length> game-panel-h: 2 * Size.button + Space.inline + 2 * Space.row;
    property <length> box-h: anchor.preferred-height - lcd-short + (root.screen-game ? game-panel-h - pl-panel-h : 0);
    // Layouts, joined to the box's foot: on the second tab only once the keyboard can keep a layout
    property <bool> shelf-on: !root.screen-closed || root.ob-ready;
    // the row under the screen in the box: the bay 16 in from the box's top, its gutter round the screen
    property <length> band-y: tabs-h + bay-pad + lcd-h + 2 * kb-pad-y;
    // the bay the screen sits in (the screen and its gutter), and the box's gray round the
    // bay, above and below it as at its sides
    property <length> bay-pad: Space.pad;
    // the screen as large as its box leaves it, the gutter and the padding kept, in whole
    // pixels (the page draws its picture at this size)
    out property <length> lcd-h: floor(min(stage-h - 2 * bay-pad - 2 * kb-pad-y, (under-w - 2 * bay-pad - 2 * kb-pad-y) / 5) / 1px) * 1px;
    out property <length> lcd-w: lcd-h * 5;
    // under the panel: the Library, its cards two to a row while each has room for its
    // picture and its words, otherwise one; after them, an empty block for a new screen
    // (Layouts' cards two to a row where each still has its least, Space.pad in from the
    // shelf and Space.inline apart)
    out property <bool> shelf-two: (under-w - 2 * Space.pad - Space.inline) / 2 >= Size.layout-card;
    property <int> shelf-rows: shelf-two ? ceil((root.lib-pages.length + 1) / 2) : root.lib-pages.length + 1;
    property <length> shelf-h: Size.box-head + shelf-rows * (Size.layout-card-h + Space.inline) - Space.inline + Space.pad;
    // the screen's own background, which its bay is
    in property <color> lcd-field: #0a0908;  // art: the screen's own ground, until its core says
    // (on the Screen tab, what is under the screen's box and its panel: the Library)
    // (the gap under the stage, as under every device's)
    property <length> under-top: root.tab == 3 ? head-end + tabs-h + box-h : head-end + board-h + 2 * kb-pad-y + Space.gap;
    // the playlist's name changed in place: where its field is in the window, so a press
    // away from it keeps the name
    out property <length> pl-rename-wx: rail-w + under-x + Space.pad;
    out property <length> pl-rename-wy: bar + Size.bar + flick.content-y + head-end + band-y + (pl-panel-h - Size.compact) / 2;
    property <length> anchor-w: Size.column;
    property <length> under-x: pws-x + anchor-w + Space.gap;
    out property <length> under-w: pws-w - anchor-w - Space.gap;
    property <length> board-w: pws-w - 2 * kb-pad-x;
    property <length> board-h: board-w * root.units-high / root.units;
    property <length> unit: board-w / root.units;
    property <length> cqw: board-w / 100;
    // the page's height under the device's bar: its head, the keyboard, what is under it, and the page's foot
    // Keys: the library and its neighbor, in the row of boxes (BoxRow), which wraps the
    // neighbor under the library where the page is narrow
    // Every block in a row is as tall as the others: at least the Profiles box,
    // at most the room under the keyboard in the window (so it never runs off
    // its foot), between those as tall as the tallest holds. What holds more
    // than that scrolls inside its block.
    property <length> band-min: anchor.preferred-height;
    property <length> room: flick.height - under-top - Space.margin;
    property <length> band-max: max(band-min, room);
    // (each of the second box's three, as tall as it says it needs)
    property <length> key-need: 270px; // art: the box's height until it says
    property <length> slider-need: 330px; // art: the box's height until it says
    property <length> game-need: 230px; // art: the box's height until it says
    property <length> second-need: root.slider-chosen != 0 ? root.slider-need : root.key-open ? root.key-need : root.game-need;
    property <length> second-w: root.key-open ? Size.detail : root.slider-chosen != 0 ? Size.settings : Size.game;
    // Lighting: the effects, the effect's settings and where and when, in the row of boxes
    property <length> lfx-h: Size.box-head + 3 * Size.tile + 2 * Space.inline + Space.pad;
    property <length> tab-h: root.tab == 0 ? kb-keys.height : root.tab == 1 ? kb-light.height
        : root.tab == 3 ? (shelf-on ? shelf-h : 0) : root.tile-height;
    property <length> under-board: Space.gap + max(anchor.preferred-height, tab-h);
    property <length> page-h: root.tab == 2 ? head-end + root.tile-height
        : root.tab == 3 ? max(head-end + anchor.preferred-height, under-top + tab-h) + Space.margin
        : board-top + board-h + kb-pad-y + under-board + Space.margin;
    // the page's scrollbar, as WebKit drew it: over the whole window, when the page is longer than it
    property <length> doc-h: bar + Size.bar + page-h;

    public function focus-menu() {
        menu.focus-search();
    }
    public function blur-menu() {
        menu.blur-search();
    }

    // the content: the home, Ectomatter's settings, or the device's page, on the
    // app's ground. The window lays the ground under the page itself, so that
    // nothing the page draws lies under the keyboard's hole.
    Rectangle {
        x: rail-w;
        y: bar;
        width: content-w;
        height: root.height - bar;

        // Home: the devices on a desk, each as its page draws it, to scale, its
        // name under it. Day to day the desk fits the window and a device opens
        // its page; Arrange shows the dots, the desk zooms and pans, and the
        // devices move onto the dots. (The window lays the dots and the
        // highlight under a device on the ground, and draws the keyboard.)
        if root.place == "home": Rectangle {
            desk-ta := TouchArea {
                // (in edit mode a drag on the empty desk moves round it; with
                // Draw your own on, it draws a pad)
                mouse-cursor: root.desk-panning ? MouseCursor.grabbing : root.desk-drawing ? MouseCursor.crosshair : MouseCursor.default;
                // (in edit mode a drag with the middle button moves around the desk)
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        root.desk-press(-1, self.mouse-x, self.mouse-y);
                    }
                    if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
                        root.desk-pan(self.mouse-x, self.mouse-y);
                    }
                    if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
                        root.desk-release();
                    }
                }
                moved => { root.desk-move(self.mouse-x, self.mouse-y); }
                scroll-event(e) => {
                    if (root.desk-editing) {
                        root.desk-wheel(self.mouse-x, self.mouse-y, e.delta-y);
                        return accept;
                    }
                    return reject;
                }
                // the pads, under the devices (the window draws them on the ground):
                // in edit mode, a ring round the one chosen or being drawn, and a
                // fainter one round the one the pointer is over; a drag on one
                // carries it, and the chosen one's edges and corners size it
                for p[j] in root.desk-pads: Rectangle {
                    x: p.x;
                    y: p.y;
                    width: p.w;
                    height: p.h;
                    if root.desk-editing && (p.chosen || (p.hover && !root.desk-carrying)): Rectangle {
                        border-radius: p.r;
                        border-width: p.chosen ? Stroke.chosen : Stroke.line;
                        border-color: p.chosen ? Ink.white.with-alpha(0.878) : Ink.white.with-alpha(0.251);
                    }
                    if root.desk-editing && !p.drawing: TouchArea {
                        mouse-cursor: root.desk-drawing ? MouseCursor.crosshair : root.desk-carrying ? MouseCursor.grabbing : MouseCursor.grab;
                        changed has-hover => { root.desk-pad-hover(j, self.has-hover); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.desk-press(-1, p.x + self.mouse-x, p.y + self.mouse-y);
                            }
                            if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
                                root.desk-pan(p.x + self.mouse-x, p.y + self.mouse-y);
                            }
                            if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
                                root.desk-release();
                            }
                        }
                        moved => { root.desk-move(p.x + self.mouse-x, p.y + self.mouse-y); }
                    }
                    // (each its own element, placed as the pad's size has it: not
                    // a list made from its size, which a drag would make anew, and
                    // the grip held with it)
                    if root.desk-editing && p.chosen && !p.drawing: Rectangle {
                        PadGrip {
                            x: -5px;
                            y: 7px; // art: the grips that size a device in edit mode
                            width: 10px; // art: the grips that size a device in edit mode
                            height: p.h - 14px; // art: the grips that size a device in edit mode
                            edges: 1;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: p.w - 5px; // art: the grips that size a device in edit mode
                            y: 7px; // art: the grips that size a device in edit mode
                            width: 10px; // art: the grips that size a device in edit mode
                            height: p.h - 14px; // art: the grips that size a device in edit mode
                            edges: 4;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: 7px; // art: the grips that size a device in edit mode
                            y: -5px;
                            width: p.w - 14px; // art: the grips that size a device in edit mode
                            height: 10px; // art: the grips that size a device in edit mode
                            edges: 2;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: 7px; // art: the grips that size a device in edit mode
                            y: p.h - 5px; // art: the grips that size a device in edit mode
                            width: p.w - 14px; // art: the grips that size a device in edit mode
                            height: 10px; // art: the grips that size a device in edit mode
                            edges: 8;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: -7px;
                            y: -7px;
                            width: 14px; // art: the grips that size a device in edit mode
                            height: 14px; // art: the grips that size a device in edit mode
                            edges: 3;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: p.w - 7px; // art: the grips that size a device in edit mode
                            y: -7px;
                            width: 14px; // art: the grips that size a device in edit mode
                            height: 14px; // art: the grips that size a device in edit mode
                            edges: 6;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: p.w - 7px; // art: the grips that size a device in edit mode
                            y: p.h - 7px; // art: the grips that size a device in edit mode
                            width: 14px; // art: the grips that size a device in edit mode
                            height: 14px; // art: the grips that size a device in edit mode
                            edges: 12;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                        PadGrip {
                            x: -7px;
                            y: p.h - 7px; // art: the grips that size a device in edit mode
                            width: 14px; // art: the grips that size a device in edit mode
                            height: 14px; // art: the grips that size a device in edit mode
                            edges: 9;
                            ox: p.x;
                            oy: p.y;
                            grip(e, x, y) => { root.desk-pad-edges(e, x, y); }
                            pan(x, y) => { root.desk-pan(x, y); }
                            drag(x, y) => { root.desk-move(x, y); }
                            let-go => { root.desk-release(); }
                        }
                    }
                }
                for d[i] in root.desk-items: Rectangle {
                    x: d.x;
                    y: d.y;
                    width: d.w;
                    height: d.h;
                    // the keyboard: its shadow round its place, its knobs and the display's glass over it
                    if d.kind == 0: Image {
                        x: -root.desk-kb-shadow-m * root.desk-kb-k;
                        y: -root.desk-kb-shadow-m * root.desk-kb-k;
                        width: parent.width + 2 * root.desk-kb-shadow-m * root.desk-kb-k;
                        height: parent.height + 2 * root.desk-kb-shadow-m * root.desk-kb-k;
                        source: root.desk-kb-shadow;
                    }
                    if d.kind == 0: Rectangle {
                        // the keys held down on the keyboard, shaded as its page shades them
                        for k in root.keys: Rectangle {
                            visible: k.pressed;
                            x: k.x * d.w / root.units;
                            y: k.y * d.w / root.units;
                            width: k.w * d.w / root.units;
                            height: k.h * d.w / root.units;
                            border-radius: (k.molded ? 0.13 : 0.24) * d.w / 100;
                            background: #00000052;  // art: a key held down, as the keyboard's own picture has it
                        }
                        for o in root.overlays: Image {
                            visible: root.board-ready;
                            property <float> along: o.frac;
                            animate along { duration: root.knob-glide; easing: linear; }
                            x: (o.x + self.along * o.travel) * root.desk-kb-k;
                            y: o.y * root.desk-kb-k;
                            opacity: o.opacity * (d.off ? 0.5 : 1);
                            width: o.w * root.desk-kb-k;
                            height: o.h * root.desk-kb-k;
                            source: o.image;
                            image-fit: fill;
                        }
                    }
                    // the mouse: the window draws it here in HDR, under the page; these
                    // layers only place it
                    if d.kind == 1: MouseLayers {
                        x: -root.desk-mouse-m * root.desk-mouse-k;
                        y: -root.desk-mouse-m * root.desk-mouse-k;
                        width: parent.width + 2 * root.desk-mouse-m * root.desk-mouse-k;
                        height: parent.height + 2 * root.desk-mouse-m * root.desk-mouse-k;
                        drawn: false;
                        k: root.desk-mouse-k;
                        opacity: d.off ? 0.5 : 1;
                        lit: !d.off;
                        base: root.desk-mouse-picture;
                        logo-under: root.desk-mouse-logo-under;
                        wheel-under: root.desk-mouse-wheel-under;
                        logo: root.desk-mouse-logo;
                        wheel: root.desk-mouse-wheel;
                        logo-tint: root.mouse-logo-tint;
                        wheel-tint: root.mouse-wheel-tint;
                    }
                    // in edit mode, a thin ring round the device the pointer is over
                    if root.desk-editing && d.hover && !root.desk-carrying: Rectangle {
                        x: -16px;
                        y: -16px;
                        width: parent.width + 2 * Space.pad;
                        height: parent.height + 16px + 58px; // art: the ring round the device and its name
                        border-radius: Radius.box;
                        border-width: Stroke.line;
                        border-color: Ink.white.with-alpha(0.11);
                    }
                    // over a pad it could be lost on, its name on a backing of the
                    // app's own ground
                    if d.backed: Rectangle {
                        x: (parent.width - name-col.preferred-width) / 2 - 10px; // art: the name's backing
                        y: parent.height + 16px - 5px; // art: the name's backing
                        width: name-col.preferred-width + 20px; // art: the name's backing
                        height: name-col.preferred-height + 10px; // art: the name's backing
                        border-radius: Radius.control;
                        background: Ink.base.with-alpha(0.851);
                    }
                    // its name under it, and under that whether it is plugged in
                    name-col := VerticalLayout {
                        x: (parent.width - self.preferred-width) / 2;
                        y: parent.height + Space.pad;
                        width: self.preferred-width;
                        spacing: Space.list;
                        HorizontalLayout {
                            alignment: center;
                            spacing: Space.inline;
                            VerticalLayout {
                                alignment: center;
                                Dot { state: d.off ? 2 : 1; }
                            }
                            Text {
                                text: d.name;
                                font-family: Font.ui;
                                font-size: Font.text;
                                font-weight: Font.medium;
                                color: d.hover ? Ink.bright : Ink.dim;
                                height: Line.text;
                                vertical-alignment: center;
                            }
                        }
                        if d.sub != "": Text {
                            text: d.sub;
                            font-family: Font.ui;
                            font-size: Font.caption;
                            color: Ink.quiet;
                            horizontal-alignment: center;
                        }
                    }
                    // a press: outside edit mode, a click opens its page; in edit mode it carries it
                    TouchArea {
                        y: 0;
                        height: parent.height + 16px + 40px; // art: the device and its name, pressed as one
                        mouse-cursor: root.desk-editing ? (root.desk-carrying ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.pointer;
                        changed has-hover => { root.desk-hover(i, self.has-hover); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.desk-press(i, d.x + self.mouse-x, d.y + self.mouse-y);
                            }
                            // (the middle button's drag moves around the desk, over a device too)
                            if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.down) {
                                root.desk-pan(d.x + self.mouse-x, d.y + self.mouse-y);
                            }
                            if ((e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && e.kind == PointerEventKind.up) {
                                root.desk-release();
                            }
                        }
                        moved => { root.desk-move(d.x + self.mouse-x, d.y + self.mouse-y); }
                    }
                }
            }
            // day to day: the tab's words at the top left, Arrange at the top right
            // day to day: what to do here, and at the right Scenes (the scene on, by its
            // name and its chip; Scenes, with the light's glyph, while none is on) and Arrange
            if !root.desk-editing && root.desk-empty == "": HintRow {
                x: Space.margin;
                width: parent.width - 2 * Space.margin;
                text: "Select a device to change it.";
                Rectangle {
                    horizontal-stretch: 1;
                }
                HorizontalLayout {
                    spacing: Space.inline;
                    cross-axis-alignment: center;
                    LinkButton {
                        text: root.scene-name == "" ? "Scenes" : "Scene: " + root.scene-name;
                        chip: root.scene-chip;
                        chip-on: root.scene-name != "";
                        lit: root.scene-name != "";
                        // (a bulb's light: a ring, and its rays)
                        icon: "M7 4.6a2.4 2.4 0 1 0 0 4.8a2.4 2.4 0 1 0 0-4.8zM7 0.9v1.5M7 11.6v1.5M0.9 7h1.5M11.6 7h1.5M2.7 2.7l1.06 1.06M10.24 10.24l1.06 1.06M2.7 11.3l1.06-1.06M10.24 3.76l1.06-1.06";
                        clicked => { root.scene-menu(self.absolute-position.x, self.absolute-position.y, self.height); }
                    }
                    LinkButton {
                        text: "Arrange";
                        icon: "M7 1.5v11M1.5 7h11M7 1.5 5.4 3.1M7 1.5l1.6 1.6M7 12.5l-1.6-1.6M7 12.5l1.6-1.6M1.5 7l1.6-1.6M1.5 7l1.6 1.6M12.5 7l-1.6-1.6M12.5 7l-1.6 1.6";
                        clicked => { root.desk-arrange(); }
                    }
                }
            }
            // edit mode: what to do and Done, on a bar of its own over the dots
            if root.desk-editing: FloatBar {
                x: (parent.width - self.width) / 2;
                y: Space.row;
                // nothing chosen: what to do, Space.row in from the bar's edge
                if root.desk-pad-chosen < 0: HorizontalLayout {
                    padding-left: Space.row - Space.tight;
                    padding-right: Space.tight;
                    Text {
                        text: root.desk-drawing ? "Drag across the desk to draw your pad." : "Drag a device to where it sits on your desk.";
                        font-family: Font.ui;
                        font-size: Font.note;
                        color: Ink.soft;
                        vertical-alignment: center;
                    }
                }
                // nothing chosen: a pad to add, at its maker's size or drawn
                if root.desk-pad-chosen < 0 && !root.desk-drawing: WordButton {
                    text: "Add pad";
                    compact: true;
                    on-box: true;
                    clicked => { root.desk-add-pad(self.absolute-position.x, self.absolute-position.y, self.height); }
                }
                // drawing: put away unused
                if root.desk-pad-chosen < 0 && root.desk-drawing: WordButton {
                    text: "Cancel";
                    compact: true;
                    on-box: true;
                    clicked => { root.desk-draw-cancel(); }
                }
                // a pad chosen: its size, its color, its picture, and taking it off the desk
                if root.desk-pad-chosen >= 0: WordButton {
                    text: root.desk-pad-size;
                    compact: true;
                    on-box: true;
                    menu: true;
                    clicked => { root.desk-pad-size-menu(self.absolute-position.x, self.absolute-position.y, self.height); }
                }
                if root.desk-pad-chosen >= 0: WordButton {
                    text: "Color";
                    compact: true;
                    on-box: true;
                    swatched: true;
                    swatch: root.desk-pad-rgb;
                    clicked => { root.desk-pad-color(self.absolute-position.x, self.absolute-position.y, self.height); }
                }
                if root.desk-pad-chosen >= 0: WordButton {
                    text: "Choose a picture…";
                    compact: true;
                    on-box: true;
                    clicked => { root.desk-pad-picture(); }
                }
                if root.desk-pad-chosen >= 0 && root.desk-pad-pictured: WordButton {
                    text: "Remove picture";
                    compact: true;
                    on-box: true;
                    clicked => { root.desk-pad-no-picture(); }
                }
                if root.desk-pad-chosen >= 0: WordButton {
                    text: "Delete pad";
                    compact: true;
                    danger: true;
                    clicked => { root.desk-pad-delete(); }
                }
                if root.desk-pad-chosen >= 0 && root.desk-pad-note != "": Text {
                    text: root.desk-pad-note;
                    font-family: Font.ui;
                    font-size: Font.note;
                    color: Ink.bad;
                    vertical-alignment: center;
                }
                // (Done apart from the rest, Space.inline more)
                if root.desk-pad-chosen >= 0: Rectangle { width: Space.inline; }
                WordButton {
                    text: "Done";
                    compact: true;
                    on-box: true;
                    clicked => { root.desk-done(); }
                }
            }
            // edit mode: zoom, at the bottom right, Space.margin in
            if root.desk-editing: FloatBar {
                x: parent.width - self.width - Space.margin;
                y: parent.height - self.height - Space.margin;
                IconButton {
                    width: Size.compact;
                    height: Size.compact;
                    icon: "M2 6h8";
                    units: 12;
                    clicked => { root.desk-zoom-step(-1); }
                }
                // (as wide at every zoom as at its widest, so the bar never moves)
                TextButton {
                    width: max(self.preferred-width, zoom-most.preferred-width + 2 * Part.quiet-pad);
                    text: root.desk-zoom;
                    clicked => { root.desk-zoom-step(0); }
                }
                IconButton {
                    width: Size.compact;
                    height: Size.compact;
                    icon: "M2 6h8M6 2v8";
                    units: 12;
                    clicked => { root.desk-zoom-step(1); }
                }
                TextButton {
                    text: "Fit";
                    clicked => { root.desk-zoom-step(2); }
                }
            }
            zoom-most := Text {
                visible: false;
                text: "400%";
                font-family: Font.ui;
                font-size: Font.control;
                font-weight: Font.medium;
            }
            // before anything is plugged in: which devices Ectomatter works with
            if root.desk-empty != "": EmptyState {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(Size.empty, parent.width - 2 * Space.margin);
                text: root.desk-empty;
            }
        }

        // the mouse's page, from the keyboard page's own parts: its bar, then
        // the tab's words, the mouse's picture (on Buttons with each button's
        // job beside it), and the tab's boxes
        Rectangle {
            visible: root.place == "mouse";
            property <length> stage-h: mouse-stage-h;
            property <length> low-y: mouse-low-y;

            mouse-flick := Flickable {
                y: Size.bar;
                height: parent.height - Size.bar;
                // (Settings' form brings its own margin under it)
                content-height: low-y + (root.mouse-tab < 3 ? max(mouse-pro.visible ? mouse-pro.height : 0, mouse-row.height) + Space.margin : root.mouse-cells-h);
                mouse-drag-pan-enabled: false;
                HintRow {
                    x: pws-x;
                    width: pws-w;
                    text: root.mouse-hint;
                    chip: root.mouse-hint-chip;
                    chip-on: root.mouse-hint-chip-on;
                }
                // the mouse's stage, every device's: its shade round the hole the window
                // draws the mouse in, in HDR (filled till the mouse is drawn there)
                if root.mouse-tab < 2: Rectangle {
                    x: pws-x;
                    y: head-end;
                    width: pws-w;
                    height: stage-h;
                    border-radius: Radius.box;
                    clip: true;
                    property <length> hx: max(0, self.width / 2 - 600px + 480px - root.mouse-pic-m); // art: the mouse's picture, from its mock's canvas
                    property <length> hy: max(0, 30px - root.mouse-pic-m); // art: the mouse's picture, from its mock's canvas
                    property <length> hx2: min(self.width, self.width / 2 - 600px + 720px + root.mouse-pic-m); // art: the mouse's picture, from its mock's canvas
                    property <length> hy2: min(self.height, 440px + root.mouse-pic-m); // art: the mouse's picture, from its mock's canvas
                    Stage {
                        width: parent.width;
                        height: parent.height;
                        hole-x: hx;
                        hole-y: hy;
                        hole-w: hx2 - hx;
                        hole-h: hy2 - hy;
                        filled: !root.mouse-hdr-ready;
                    }
                    // the mock's own canvas, the mouse's middle at 600 of its 1092
                    Rectangle {
                        x: parent.width / 2 - 600px; // art: the mouse's picture, from its mock's canvas
                        width: 1092px; // art: the mouse's picture, from its mock's canvas
                        height: parent.height;
                        pic := MouseLayers {
                            x: 480px - root.mouse-pic-m; // art: the mouse's picture, from its mock's canvas
                            y: 30px - root.mouse-pic-m; // art: the mouse's picture, from its mock's canvas
                            width: 240px + 2 * root.mouse-pic-m; // art: the mouse's picture, from its mock's canvas
                            height: 410px + 2 * root.mouse-pic-m; // art: the mouse's picture, from its mock's canvas
                            drawn: false;
                            base: root.mouse-picture;
                            picked: root.mouse-picked;
                            picked-shown: root.mouse-picked-shown;
                            over: root.mouse-over;
                            over-shown: root.mouse-over-shown;
                            logo-under: root.mouse-logo-under;
                            wheel-under: root.mouse-wheel-under;
                            logo: root.mouse-logo;
                            wheel: root.mouse-wheel;
                            logo-tint: root.mouse-logo-tint;
                            wheel-tint: root.mouse-wheel-tint;
                            // a click on a button (or, on Lighting, a light) chooses it
                            pic-ta := TouchArea {
                                mouse-cursor: root.mouse-pic-hand ? pointer : default;
                                changed mouse-x => { root.mouse-pic-moved(self.mouse-x, self.mouse-y, self.has-hover); }
                                changed mouse-y => { root.mouse-pic-moved(self.mouse-x, self.mouse-y, self.has-hover); }
                                changed has-hover => { root.mouse-pic-moved(self.mouse-x, self.mouse-y, self.has-hover); }
                                clicked => { root.mouse-pic-clicked(self.mouse-x, self.mouse-y); }
                            }
                        }
                        if root.mouse-tab == 0: Rectangle {
                            Path {
                                width: 1092px; // art: the mouse's picture, from its mock's canvas
                                height: 470px; // art: the mouse's picture, from its mock's canvas
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-lines;
                                stroke: Ink.edge;
                                stroke-width: 1px; // art: the mouse's picture, from its mock's canvas
                                fill: transparent;
                            }
                            Path {
                                width: 1092px; // art: the mouse's picture, from its mock's canvas
                                height: 470px; // art: the mouse's picture, from its mock's canvas
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-dots;
                                fill: Ink.edge;
                            }
                            Path {
                                width: 1092px; // art: the mouse's picture, from its mock's canvas
                                height: 470px; // art: the mouse's picture, from its mock's canvas
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-line-on;
                                stroke: Ink.dim;
                                stroke-width: 1px; // art: the mouse's picture, from its mock's canvas
                                fill: transparent;
                            }
                            Path {
                                width: 1092px; // art: the mouse's picture, from its mock's canvas
                                height: 470px; // art: the mouse's picture, from its mock's canvas
                                viewbox-width: 1092;
                                viewbox-height: 470;
                                commands: root.mouse-dot-on;
                                fill: Ink.dim;
                            }
                            for c[i] in root.mouse-calls: Rectangle {
                                x: c.left ? 220px : 780px; // art: a button's callout on the mouse's picture
                                y: c.top;
                                width: 200px; // art: a button's callout on the mouse's picture
                                height: 40px; // art: a button's callout on the mouse's picture
                                Text {
                                    y: 0;
                                    width: parent.width;
                                    height: 16px; // art: a button's callout on the mouse's picture
                                    text: c.name;
                                    font-family: Font.ui;
                                    font-size: Font.small;
                                    letter-spacing: 0.2px; // art: a button's callout on the mouse's picture
                                    color: Ink.quiet;
                                    horizontal-alignment: c.left ? right : left;
                                }
                                Rectangle {
                                    x: c.left ? parent.width - self.width : 0;
                                    y: 17px; // art: a button's callout on the mouse's picture
                                    width: job-t.preferred-width + (c.chosen ? 16px : 0); // art: a button's callout on the mouse's picture
                                    height: 22px; // art: a button's callout on the mouse's picture
                                    border-radius: Radius.small;
                                    background: c.chosen ? Ink.pick : transparent;
                                    border-width: c.chosen ? 1px : 0; // art: a button's callout on the mouse's picture
                                    border-color: Ink.white.with-alpha(0.251);
                                    job-t := Text {
                                        x: c.chosen ? 8px : 0; // art: a button's callout on the mouse's picture
                                        height: parent.height;
                                        text: c.job;
                                        font-family: Font.ui;
                                        font-size: Font.note;
                                        color: c.rebound ? Ink.warn : c.chosen ? Ink.bright : Ink.dim;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    changed has-hover => { root.mouse-call-hover(i, self.has-hover); }
                                    clicked => { root.mouse-row(i); }
                                }
                            }
                        }
                    }
                }
                // the profiles, first in the row, as every device page has them; the well
                // reaching the foot of the boxes beside it
                mouse-pro := AnchorColumn {
                    visible: mouse-pro-w > 0;
                    x: pws-x;
                    y: low-y;
                    width: Size.column;
                    height: max(self.preferred-height, mouse-row.height);
                    profiles: root.mouse-profiles;
                    kept: true;
                    renaming <=> root.mouse-renaming;
                    choose(n) => { root.mouse-profile-choose(n); }
                    rename(t) => { root.mouse-profile-rename(t); }
                    add() => { root.mouse-profile-new(); }
                    menu(x, y, h) => { root.mouse-profile-menu(x, y, h); }
                }
                // the tab's boxes, in the row of boxes every device page has: on Buttons the Key
                // library and every button or the chosen one's job; on Lighting the lights, the
                // effects and the chosen effect's settings; on Performance a box for each of the
                // mouse's sections (the boxes laid out in Rust say how wide the row made them)
                mouse-row := BoxRow {
                    visible: root.mouse-tab < 3;
                    x: pws-x + mouse-pro-w;
                    y: low-y;
                    width: pws-w - mouse-pro-w;
                    height: max(self.preferred-height, mouse-band-min);
                    if root.mouse-tab == 0: KeyLibrary {
                        min-width: Size.library;
                        preferred-width: Size.library;
                        max-height: mouse-band-max;
                        preferred-height: mouse-band-min;
                        layer: 0;
                        layers: root.mouse-layers;
                        placeholder: "Find a button or what it does";
                        reveal-y: root.mouse-lib-reveal-y;
                        reveal-n: root.mouse-lib-reveal-n;
                        groups: root.mouse-lib-groups;
                        query <=> root.mouse-lib-query;
                        toggle(g) => { root.mouse-lib-toggle(g); }
                        find(t) => { root.mouse-lib-find(t); }
                        pick(id) => { root.mouse-row(id); }
                    }
                    if root.mouse-tab == 0 && !root.mouse-chosen: PageBox {
                        min-width: Size.detail;
                        preferred-width: Size.detail;
                        max-height: mouse-band-max;
                        preferred-height: mouse-second-need;
                        title: "All buttons";
                        // its note, and Back to factory Space.pad after it, at the middle of its first line
                        property <length> need: Size.box-head + all-note.preferred-height + Space.pad;
                        init => { root.mouse-all-need = self.need; }
                        changed need => { root.mouse-all-need = self.need; }
                        all-note := Text {
                            x: Space.pad;
                            y: Size.box-head;
                            width: parent.width - 2 * Space.pad - (root.mouse-any-rebound ? all-reset.width + Space.pad : 0);
                            text: root.mouse-all-note;
                            font-family: Font.ui;
                            font-size: Font.note;
                            color: Ink.quiet;
                            wrap: word-wrap;
                        }
                        all-reset := WordButton {
                            visible: root.mouse-any-rebound;
                            x: parent.width - self.width - Space.pad;
                            y: Size.box-head + (Line.note - self.height) / 2;
                            text: "Back to factory";
                            on-box: true;
                            clicked => { root.mouse-reset-all(); }
                        }
                    }
                    if root.mouse-tab == 0 && root.mouse-chosen: KeyDetail {
                        min-width: Size.detail;
                        preferred-width: Size.detail;
                        max-height: mouse-band-max;
                        preferred-height: mouse-second-need;
                        init => { root.mouse-key-need = self.need; }
                        changed need => { root.mouse-key-need = self.need; }
                        title: root.mouse-title;
                        cap: root.mouse-cap;
                        factory: root.mouse-factory;
                        state: root.mouse-state;
                        rebound: root.mouse-rebound;
                        layer-rebound: false;
                        layer-title: "When pressed";
                        kinds: root.mouse-kinds;
                        kind-icons: root.mouse-kind-icons;
                        kind: root.mouse-kind;
                        job: root.mouse-job;
                        listening: false;
                        recordable: false;
                        closable: false;
                        menu-open: root.mouse-menu-open;
                        note: root.mouse-note;
                        reset => { root.mouse-reset(); }
                        kind-picked(i, x, y, h) => { root.mouse-kind-picked(i, x, y, h); }
                        job-clicked(x, y, h, w) => { root.mouse-job-clicked(x, y, h, w); }
                    }
                    if root.mouse-tab == 1: ListBox {
                        heading: "LIGHTS";
                        min-width: Size.column;
                        preferred-width: Size.column;
                        max-height: mouse-band-max;
                for r[i] in root.mouse-rows: ListRow {
                    name: r.name;
                    // (a job not the factory's in amber)
                    sub: r.rebound ? "" : r.job;
                    warn: r.rebound ? r.job : "";
                    chosen: r.chosen;
                    // (its color at its right end, Space.row in, the row's words kept clear of it)
                    end: r.swatched ? Space.row + Part.glyph + Space.row : Space.row;
                    clicked => { root.mouse-row(i); }
                    if r.swatched: ColorSquare {
                        x: parent.width - Space.row - self.width;
                        y: (parent.height - self.height) / 2;
                        swatch: r.swatch;
                    }
                }
                    }
                    if root.mouse-tab == 1: ScrollBox {
                        min-width: Size.effects;
                        preferred-width: Size.effects;
                        max-height: mouse-band-max;
                        preferred-height: mouse-fx-h;
                        need: mouse-fx-h;
                        EffectGrid {
                            width: parent.width;
                            height: max(mouse-fx-h, parent.height);
                            fill: transparent;
                            init => { root.mouse-fx-w = self.pic-w; root.boxes-resized(); }
                            changed pic-w => { root.mouse-fx-w = self.pic-w; root.boxes-resized(); }
                            effects: root.mouse-effects;
                            moving: root.mouse-effect-moves;
                            chose(i) => { root.mouse-effect(i); }
                        }
                    }
                    for b[i] in root.mouse-tab == 1 || root.mouse-tab == 2 ? root.mouse-boxes : []: CellBox {
                        b: b;
                        max-height: mouse-band-max;
                        resized(w) => { root.mouse-box-resized(i, w); }
                        pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                        field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                        slide(id, v) => { root.cell-slide(id, v); }
                        typed(id, index, t) => { root.cell-typed(id, index, t); }
                    }
                }
                // Settings: the mouse's own facts, laid out in Rust as a form
                if root.mouse-tab == 3: Rectangle {
                    x: pws-x;
                    y: low-y;
                    width: root.mouse-w;
                    height: root.mouse-cells-h;
                    for c in root.cells: CellView {
                        c: c;
                        glyph: root.mouse-tile;
                        pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                        field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                        slide(id, v) => { root.cell-slide(id, v); }
                        typed(id, index, t) => { root.cell-typed(id, index, t); }
                    }
                }
            }
            // the mouse's own bar, every page's: its name, its tabs, and what went wrong
            PageBar {
                y: 0;
                title: root.mouse-name;
                dot: root.mouse-conn;
                tabs: ["Buttons", "Lighting", "Performance", "Settings"];
                tab: root.mouse-tab;
                tab-chosen(i) => { root.mouse-tab-chosen(i); }
                status: root.mouse-status != "" ? root.mouse-status : root.mouse-said;
                status-bad: root.mouse-status != "";
                undo-shown: root.mouse-status == "" && root.mouse-undo-shown;
                undo => { root.mouse-undo(); }
                // the Macro Editor, on Ectomatter's own macros, and the lab, on the
                // mouse's lights
                BarButton {
                    commands: "M3.1 4h9.8a1.6 1.6 0 0 1 1.6 1.6v5.3a1.6 1.6 0 0 1-1.6 1.6H3.1a1.6 1.6 0 0 1-1.6-1.6V5.6a1.6 1.6 0 0 1 1.6-1.6zM4 7h1M7 7h1M10 7h2M4.5 9.8h7";
                    text: "Macro Editor";
                    clicked => { root.mouse-macro-editor(); }
                }
                BarButton {
                    // a flask drawn for this size, its lines on the pixel grid
                    commands: "M5.14 1.14h5.72M6.29 1.14v4.58L2.95 11.93a1.25 1.25 0 0 0 1.1 1.79h7.9a1.25 1.25 0 0 0 1.1-1.79L9.71 5.72V1.14M4.3 10.29h7.4";
                    round: true;
                    text: "";
                    clicked => { root.rail("lab"); }
                }
            }
        }
        // the Library (games_page.rs): the games and apps on three tabs, each
        // game's or app's own page, and Every game's; its bar stays put over
        // what scrolls, as a device's does
        Rectangle {
            visible: root.place == "library";
            gl-flick := Flickable {
                y: Size.bar;
                height: parent.height - Size.bar;
                content-height: root.gl-page-h;
                mouse-drag-pan-enabled: false;
                // what to do here, and beside it the find box and, on the games' tabs, the
                // store and the order
                HintRow {
                    x: pws-x;
                    width: pws-w;
                    text: root.gl-hint;
                    shorten: true;
                    // the find box, and on the games' tabs the store and the order, on the
                    // hint line at a button's height
                    if root.gl-view == 0: HorizontalLayout {
                        cross-axis-self-alignment: center;
                        height: Size.button;
                        spacing: Space.inline;
                        FieldBox {
                            width: Size.find;
                            height: Size.button;
                            glyph: Glyph.find;
                            placeholder: root.gl-find-hint;
                            text <=> root.gl-query;
                            edited => { root.gl-find(self.text); }
                            escape => { self.stop-typing(); }
                        }
                        if root.gl-tab < 2: DropField {
                            width: root.gl-store-w;
                            height: Size.button;
                            text: root.gl-store;
                            clicked(x, y, h) => { root.gl-store-menu(x, y, h, self.width); }
                        }
                        if root.gl-tab < 2: DropField {
                            width: root.gl-sort-w;
                            height: Size.button;
                            text: root.gl-sort;
                            clicked(x, y, h) => { root.gl-sort-menu(x, y, h, self.width); }
                        }
                    }
                }
                for c[i] in root.gl-covers: LibCoverView {
                    c: c;
                    open => { root.gl-open(i); }
                    star => { root.gl-star(i); }
                }
                // the Apps tab: a row for each app, in a box of their own, Space.inline in from it
                // as a list's rows in a box are: its icon, its name and what changes for it, where
                // it's from, and the way on to its page
                if root.gl-view == 0 && root.gl-apps.length > 0: PageBox {
                    x: pws-x;
                    y: head-end;
                    width: pws-w;
                    height: root.gl-apps.length * Size.app + 2 * Space.inline;
                    for a[i] in root.gl-apps: Rectangle {
                        x: Space.inline;
                        y: Space.inline + i * Size.app;
                        width: parent.width - 2 * Space.inline;
                        height: Size.app;
                        border-radius: Radius.control;
                        background: row-ta.has-hover ? Ink.hover-box : transparent;
                        property <length> words-x: Space.row + Size.app-icon + Space.row;
                        property <length> onward-x: self.width - Part.field-pad - Part.chevron;
                        if a.has-icon: Image {
                            x: Space.row;
                            y: (parent.height - self.height) / 2;
                            width: Size.app-icon;
                            height: Size.app-icon;
                            source: a.icon;
                        }
                        if !a.has-icon: Rectangle {
                            x: Space.row;
                            y: (parent.height - self.height) / 2;
                            width: Size.app-icon;
                            height: Size.app-icon;
                            border-radius: Radius.control;
                            background: Ink.well;
                        }
                        VerticalLayout {
                            x: parent.words-x;
                            width: parent.width - parent.words-x - from-t.width - Space.row - (parent.width - parent.onward-x);
                            alignment: center;
                            spacing: Space.list;
                            Text {
                                text: a.name;
                                font-family: Font.ui;
                                font-size: Font.name;
                                font-weight: Font.medium;
                                color: Ink.ink;
                                overflow: elide;
                            }
                            Text {
                                text: a.sub;
                                font-family: Font.ui;
                                font-size: Font.note;
                                color: Ink.quiet;
                                overflow: elide;
                            }
                        }
                        from-t := Text {
                            x: parent.onward-x - Space.row - self.width;
                            width: min(self.preferred-width, parent.width / 3);
                            height: parent.height;
                            text: a.from;
                            font-family: Font.ui;
                            font-size: Font.note;
                            color: Ink.quiet;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Path {
                            x: parent.onward-x;
                            y: (parent.height - self.height) / 2;
                            width: Part.chevron;
                            height: Part.chevron;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: Glyph.onward;
                            fill: transparent;
                            stroke: Ink.quiet;
                            stroke-width: 1.6px; // art: the chevron's stroke
                            stroke-line-cap: round;
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.gl-open(i); }
                        }
                    }
                }
                // nothing to show: what's missing, and the way to it, in the page's middle
                if root.gl-view == 0 && root.gl-empty != "": EmptyState {
                    x: (parent.width - self.width) / 2;
                    y: max(head-end + Space.section, (gl-flick.height - self.preferred-height) / 2);
                    width: min(Size.empty, pws-w);
                    height: self.preferred-height;
                    title: root.gl-empty;
                    text: root.gl-empty-sub;
                }
                // a page of its own: the game's picture, then its sections
                if root.gl-view == 1 && root.gl-has-hero: Rectangle {
                    x: pws-x;
                    y: head-end;
                    width: pws-w;
                    height: Size.hero;
                    border-radius: Radius.box;
                    background: Ink.box;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.gl-hero;
                    }
                    for f in root.gl-facts: Text {
                        x: parent.width - Space.margin - root.gl-facts-w + f.x;
                        y: parent.height - Space.margin - Line.note;
                        height: Line.note;
                        text: f.text;
                        font-family: Font.ui;
                        font-size: Font.note;
                        font-weight: f.strong ? Font.medium : Font.regular;
                        color: f.strong ? Ink.ink : Ink.dim;
                        vertical-alignment: center;
                    }
                }
                // (a device's glyph at the rail's own size, drawn for it, not a larger one shrunk)
                for c in root.gl-cells: CellView {
                    c: c;
                    glyph: root.keyboard-glyph;
                    glyph2: root.mouse-glyph;
                    glyphs: root.package-glyphs;
                    glyph3: root.scene-glyph;
                    chips: root.scene-chips;
                    pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                    field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                    slide(id, v) => { root.cell-slide(id, v); }
                    typed(id, index, t) => { root.cell-typed(id, index, t); }
                }
            }
            // On this page: each section's name and what it changes for this game, beside the
            // sections; it scrolls with the page until it reaches the top, then stays in view
            if root.gl-view == 1 && root.gl-toc.length > 0: Rectangle {
                x: root.gl-toc-x;
                y: Size.bar + max(Space.pad, root.gl-toc-top + gl-flick.content-y);
                width: root.gl-toc-w;
                height: toc-col.preferred-height;
                // its heading in capitals, as a list's, its words level with the entries'
                toc-col := VerticalLayout {
                    spacing: 0;
                    HorizontalLayout {
                        padding-left: Space.row;
                        AnchorHead { text: "ON THIS PAGE"; }
                    }
                    for t[i] in root.gl-toc: Rectangle {
                        height: toc-words.preferred-height;
                        border-radius: Radius.control;
                        background: toc-ta.has-hover ? Ink.box : transparent;
                        toc-words := VerticalLayout {
                            padding-left: Space.row;
                            padding-right: Space.row;
                            padding-top: Space.inline;
                            padding-bottom: Space.inline;
                            spacing: Space.list;
                            Text {
                                text: t.name;
                                font-family: Font.ui;
                                font-size: Font.text;
                                font-weight: Font.medium;
                                color: Ink.dim;
                            }
                            Text {
                                text: t.sub;
                                font-family: Font.ui;
                                font-size: Font.note;
                                color: t.set ? Ink.soft : Ink.quiet;
                                wrap: word-wrap;
                            }
                        }
                        toc-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.gl-toc-jump(i); }
                        }
                    }
                    if root.gl-toc-foot != "": Rectangle { height: Space.row; }
                    if root.gl-toc-foot != "": HorizontalLayout {
                        padding-left: Space.row;
                        padding-right: Space.row;
                        Text {
                            text: root.gl-toc-foot;
                            font-family: Font.ui;
                            font-size: Font.note;
                            color: Ink.quiet;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            // the Library's bar, every page's: its name and tabs, or on a page of its own
            // the way back to the Library, the page's name, its star and Play
            PageBar {
                y: 0;
                title: root.gl-view == 0 ? "Library" : root.gl-name;
                back: root.gl-view == 1 ? "Library" : "";
                back-clicked => { root.gl-back(); }
                tabs: root.gl-view == 0 ? ["Favorites", "Games", "Apps"] : [];
                tab: root.gl-tab;
                tab-chosen(i) => { root.gl-tab-chosen(i); }
                status: root.gl-said;
                status-bad: root.gl-said-bad;
                undo-shown: root.gl-undo-shown;
                undo => { root.gl-undo(); }
                if root.gl-view == 0: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Space.inline;
                    if root.gl-tab < 2: BarButton {
                        // two cards, one on another: every game at once
                        commands: "M2.5 5.5h7.5a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5h-7.5a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5zM4.5 3h8a1.5 1.5 0 0 1 1.5 1.5v7.5";
                        text: "Every game";
                        clicked => { root.gl-every-page(); }
                    }
                    BarButton {
                        commands: "M8 3v10M3 8h10";
                        round: true;
                        text: root.gl-tab < 2 ? "Add a game" : "Add an app";
                        clicked => { root.gl-add(); }
                    }
                }
                if root.gl-view == 1 && !root.gl-every: HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Space.inline;
                    alignment: center;
                    if root.gl-removable: VerticalLayout {
                        alignment: center;
                        LinkButton {
                            text: "Remove";
                            clicked => { root.gl-remove(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        StarButton {
                            on: root.gl-fav;
                            clicked => { root.gl-star-page(); }
                        }
                    }
                    if root.gl-playable: VerticalLayout {
                        alignment: center;
                        WordButton {
                            primary: true;
                            text: "Play";
                            icon: "M4 2.6v8.8c0 .5.5.8.9.5l7-4.4a.6.6 0 0 0 0-1L4.9 2.1c-.4-.3-.9 0-.9.5Z";
                            clicked => { root.gl-play(); }
                        }
                    }
                }
            }
        }
        // Ectomatter's own settings: its bar, every page's, and under it the form
        // (src/ecto_settings.rs), which scrolls
        Rectangle {
            visible: root.place == "settings";
        set-flick := Flickable {
            y: Size.bar;
            height: parent.height - Size.bar;
            content-height: root.settings-h;
            mouse-drag-pan-enabled: false;
            for c in root.cells: CellView {
                c: c;
                glyph: root.keyboard-tile;
                glyph2: root.mouse-tile;
                glyphs: root.package-tiles;
                pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                slide(id, v) => { root.cell-slide(id, v); }
                typed(id, index, t) => { root.cell-typed(id, index, t); }
            }
        }
            PageBar {
                y: 0;
                title: "Settings";
            }
        }

        Rectangle {
            visible: root.place == "z10";
            // the page scrolls under the device's bar, as the web page did
            flick := Flickable {
                y: Size.bar;
                height: parent.height - Size.bar;
                content-height: root.page-h;
                mouse-drag-pan-enabled: false;
                // over the keyboard: what to do on this tab, and Show rebindings
                Rectangle {
                    x: pws-x;
                    y: Space.row;
                    width: pws-w;
                    height: head-h;
                    if root.boot != 0: HorizontalLayout {
                        spacing: Space.inline;
                        alignment: start;
                        if root.boot == 1: Rectangle {
                            width: Size.spinner;
                            Spinner {
                                y: (parent.height - Size.spinner) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.boot-title;
                                font-family: Font.ui;
                                font-size: Font.text;
                                font-weight: Font.strong;
                                color: root.boot == 2 ? Ink.bad : Ink.ink;
                            }
                            Text {
                                text: root.boot-text;
                                font-family: Font.ui;
                                font-size: Font.caption;
                                color: Ink.quiet;
                            }
                        }
                    }
                    if root.boot == 0: HintRow {
                        y: 0;
                        width: parent.width;
                        text: root.hint;
                        chip: root.hint-chip;
                        chip-on: root.hint-chip-on;
                        // (a status: its dot, breathing while it plays, and its words)
                        if root.live: HorizontalLayout {
                            spacing: Space.inline;
                            VerticalLayout {
                                alignment: center;
                                Dot {
                                    state: 1;
                                    opacity: 0.55 + 0.45 * cos(animation-tick() / 1600ms * 360deg);
                                }
                            }
                            Text {
                                text: "Showing on keyboard";
                                font-family: Font.ui;
                                font-size: Font.caption;
                                color: Ink.good;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // whether rebound keys show their new actions on the keyboard
                        if root.tab < 2: CheckBox {
                            width: self.preferred-width;
                            text: "Show rebindings";
                            on: root.show-rebindings-on;
                            clicked => { root.show-rebindings(); }
                        }
                        // on Screen, what it is doing now, a dot that breathes while
                        // Ectomatter plays it; then Pause, which holds the screen as it
                        // is, and Play, which carries on
                        if root.tab == 3 && root.screen-status != "": Text {
                            horizontal-stretch: 0;
                            text: root.screen-status;
                            font-family: Font.ui;
                            font-size: Font.note;
                            color: Ink.soft;
                            vertical-alignment: center;
                        }
                    }
                }

                // the anchoring column: the profiles, saving, and on Keys the layers
                anchor := AnchorColumn {
                    visible: root.boot == 0 && root.tab != 2;
                    x: pws-x;
                    y: root.tab == 3 ? head-end : under-top;
                    width: Size.column;
                    // (its well reaching the foot of the boxes beside it)
                    height: max(self.preferred-height, root.tab == 0 ? kb-keys.height : root.tab == 1 ? kb-light.height : 0);
                    profiles: root.profiles;
                    has-menu: true;
                    choose(n) => { root.choose-profile(n); }
                    rename(t) => { root.rename-profile(t); }
                    menu(x, y, h) => { root.kb-profile-menu(x, y, h); }
                }

                // Keys: the Key library, and beside it Game mode, or the chosen key or slider,
                // in the row of boxes every device page has
                kb-keys := BoxRow {
                    visible: root.tab == 0 && root.boot == 0;
                    x: under-x;
                    y: under-top;
                    width: under-w;
                    // (at least as tall as the Profiles column beside it, its one line then as tall)
                    height: max(self.preferred-height, band-min);
                    if root.tab == 0 && root.boot == 0: KeyLibrary {
                        min-width: Size.library;
                        preferred-width: Size.library;
                        max-height: band-max;
                        preferred-height: band-min;
                        layer: root.layer;
                        reveal-y: root.lib-reveal-y;
                        reveal-n: root.lib-reveal-n;
                        layer-chosen(i) => { root.layer-changed(i); }
                        groups: root.lib-groups;
                        query <=> root.lib-query;
                        toggle(g) => { root.lib-toggle(g); }
                        find(t) => { root.lib-find(t); }
                        pick(id) => { if (id >= 0) { root.key-clicked(id); } else { root.slider-chosen-at(-id); } }
                    }
                    key-tile := ScrollBox {
                        // Game mode in the Profiles box's darker shade; a key or a slider in a box's
                        fill: !root.key-open && root.slider-chosen == 0 ? Ink.well : Ink.box;
                        min-width: second-w;
                        preferred-width: second-w;
                        max-height: band-max;
                        preferred-height: second-need;
                        need: second-need;
                        if !root.key-open && root.slider-chosen == 0: GameBox {
                            width: parent.width;
                            height: max(second-need, parent.height);
                            fill: transparent;
                            items: root.game-items;
                            toggled(i) => { root.game-toggled(i); }
                            init => { root.game-need = self.need; }
                            changed need => { root.game-need = self.need; }
                        }
                        if root.key-open: KeyDetail {
                            width: parent.width;
                            height: max(second-need, parent.height);
                            fill: transparent;
                            init => { root.key-need = self.need; }
                            changed need => { root.key-need = self.need; }
                            title: root.key-name;
                            cap: root.key-cap;
                            factory: root.key-factory;
                            state: root.key-state;
                            rebound: root.key-rebound;
                            layer-title: root.layer == 1 ? "Function layer" : "Base layer";
                            layer-rebound: root.layer-rebound;
                            kind: root.key-kind;
                            job: root.key-job;
                            listening: root.key-listening;
                            menu-open: root.menu-open;
                            note: root.key-note;
                            done => { root.board-clicked(); }
                            reset => { root.reset-key(); }
                            kind-picked(i, x, y, h) => { root.kind-picked(i, x, y, h); }
                            job-clicked(x, y, h, w) => { root.action-menu(root.layer, x, y, h, w); }
                            record => { root.listen(root.layer); }
                        }
                        if root.slider-chosen != 0: SliderDetail {
                            width: parent.width;
                            height: max(second-need, parent.height);
                            fill: transparent;
                            init => { root.slider-need = self.need; }
                            changed need => { root.slider-need = self.need; }
                            title: root.slider-chosen == 1 ? "Dimmer" : "Volume";
                            side: root.slider-chosen == 1 ? "left" : "right";
                            at: root.slider-at;
                            choices: root.slider-choices;
                            note: root.slider-note;
                            done => { root.slider-chosen-at(0); }
                            picked(i) => { root.slider-bind-at(i); }
                        }
                    }
                }
                // the Lighting page: the effects, the chosen one's settings, and where and when it
                // plays, in the row of boxes every device page has (the effects no wider than
                // their tiles' pictures can grow; the boxes laid out in Rust say how wide they are)
                kb-light := BoxRow {
                    visible: root.tab == 1 && root.boot == 0;
                    x: under-x;
                    y: under-top;
                    width: under-w;
                    height: max(self.preferred-height, band-min);
                    if root.tab == 1 && root.boot == 0: ScrollBox {
                        min-width: Size.effects;
                        preferred-width: Size.effects;
                        max-height: band-max;
                        preferred-height: lfx-h;
                        need: lfx-h;
                        EffectGrid {
                            width: parent.width;
                            height: max(lfx-h, parent.height);
                            fill: transparent;
                            effects: root.effects;
                            moving: root.effect-moves;
                            chose(i) => { root.effect(i); }
                            init => { root.light-fx-w = self.pic-w; root.boxes-resized(); }
                            changed pic-w => { root.light-fx-w = self.pic-w; root.boxes-resized(); }
                        }
                    }
                    // the chosen effect's boxes, laid out in Rust (its settings, and where and when)
                    for b[i] in root.tab == 1 && root.boot == 0 ? root.light-boxes : []: CellBox {
                        b: b;
                        max-height: band-max;
                        resized(w) => { root.light-box-resized(i, w); }
                        pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                        field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                        slide(id, v) => { root.cell-slide(id, v); }
                        hovered(k, on) => { root.area-hover(k, on); }
                    }
                }
                // Screen, the right column: the tabs of the screen's two states over its dark box,
                // the playlist's panel in the box under the screen, and the Library joined to the
                // box's foot. (All in one part of the window, so a screen carried from the Library
                // knows where the panel is.)
                if root.tab == 3: stage := Rectangle {
                    x: under-x;
                    y: head-end;
                    width: under-w;
                    height: tabs-h + box-h + (shelf-on ? shelf-h : 0);
                    // a screen carried to `wx`, `wy` in the window: where the pointer holds it
                    // here, and where that is along the strip (anywhere over the panel, it can land);
                    // on the second tab, whether it is over the screen, where it lands there; and
                    // on either, the place in the Library under it
                    function carry-to(wx: length, wy: length) {
                        root.carry-x = wx - self.absolute-position.x;
                        root.carry-y = wy - self.absolute-position.y;
                        if (root.screen-game) {
                            root.gl-carry-move(
                                wx < game-panel.absolute-position.x || wx > game-panel.absolute-position.x + game-panel.width ? -1
                                : wy >= game-panel.absolute-position.y + 6px && wy < game-panel.absolute-position.y + 48px ? 0 // art: where a carried layout lands on Game launch's rows
                                : wy >= game-panel.absolute-position.y + 48px && wy < game-panel.absolute-position.y + 92px ? 1 : -1, // art: where a carried layout lands on Game launch's rows
                                self.shelf-at(root.carry-x, root.carry-y));
                        } else if (root.screen-closed) {
                            root.pl-carry-move(0,
                                wx > screen-bay.absolute-position.x && wx < screen-bay.absolute-position.x + screen-bay.width
                                && wy > screen-bay.absolute-position.y && wy < screen-bay.absolute-position.y + screen-bay.height,
                                self.shelf-at(root.carry-x, root.carry-y));
                        } else {
                            root.pl-carry-move(wx - strip.absolute-position.x,
                                wx > panel.absolute-position.x && wx < panel.absolute-position.x + panel.width
                                && wy > panel.absolute-position.y - 20px && wy < panel.absolute-position.y + panel.height + 40px, // art: the reach of a drop on the panel
                                self.shelf-at(root.carry-x, root.carry-y));
                        }
                    }
                    // the Library's place at `lx`, `ly` here, counted as its cards are laid (two to a
                    // row, or one), past its last card the last; -1 off the Library
                    function shelf-at(lx: length, ly: length) -> int {
                        if (!shelf-on || lx < 0 || lx > under-w || ly < tabs-h + box-h || ly > tabs-h + box-h + shelf-h) {
                            return -1;
                        }
                        return max(0, floor((ly - tabs-h - box-h - Size.box-head + Space.tight) / (Size.layout-card-h + Space.inline))) * (shelf-two ? 2 : 1) + (shelf-two && lx > under-w / 2 ? 1 : 0);
                    }
                    // let go: over the panel, the carried name settles into its room and then
                    // the screen takes its place; over the Library, into its card's place, where
                    // the card's own name sits; away from both, nothing changes
                    function drop-carry() {
                        if (root.pl-slot-w > 0) {
                            root.carry-settle = true;
                            root.carry-x = panel.x + strip.x + root.pl-slot-x + root.carry-gx;
                            root.carry-y = panel.y + strip.y + 30px + root.carry-gy; // art: a carried card's place on the shelf
                            settle.running = true;
                        } else if (root.lib-gap >= 0) {
                            root.carry-settle = true;
                            root.carry-x = 16px + (shelf-two ? mod(root.lib-gap, 2) * ((under-w - 40px) / 2 + 8px) : 0) + 288px + root.carry-gx; // art: a carried card's place on the shelf
                            root.carry-y = tabs-h + box-h + 48px + (shelf-two ? floor(root.lib-gap / 2) : root.lib-gap) * 104px + 16px + root.carry-gy; // art: a carried card's place on the shelf
                            settle.running = true;
                        } else {
                            root.carry-on = false;
                            root.pl-carry-drop();
                        }
                    }
                    settle := Timer {
                        interval: 160ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            root.carry-settle = false;
                            root.carry-on = false;
                            root.pl-carry-drop();
                        }
                    }
                    // the screen's two states, as folder tabs on the box's top
                    HorizontalLayout {
                        x: 0;
                        y: 0;
                        height: tabs-h;
                        spacing: Space.tight;
                        alignment: start;
                        FolderTab {
                            fill: Ink.well;
                            text: "Playlist";
                            open: !root.screen-closed && !root.screen-game;
                            first: true;
                            clicked => {
                                root.screen-closed = false;
                                root.screen-game = false;
                                root.screen-state();
                            }
                        }
                        FolderTab {
                            fill: Ink.well;
                            text: "Onboard layout";
                            open: root.screen-closed;
                            clicked => {
                                root.screen-closed = true;
                                root.screen-game = false;
                                root.screen-state();
                            }
                        }
                        FolderTab {
                            fill: Ink.well;
                            text: "Game launch";
                            open: root.screen-game;
                            clicked => {
                                root.screen-closed = false;
                                root.screen-game = true;
                                root.screen-state();
                            }
                        }
                    }
                    // Layouts' gray behind the box's lower corners, where the two meet
                    Rectangle {
                        visible: shelf-on;
                        y: tabs-h + box-h - Radius.box;
                        height: 2 * Radius.box;
                        background: Ink.box;
                    }
                    // the screen's box (square at its top left under the first tab, open)
                    Rectangle {
                        y: tabs-h;
                        height: box-h;
                        border-radius: Radius.box;
                        border-top-left-radius: !root.screen-closed && !root.screen-game ? 0 : Radius.box;
                        background: Ink.well;
                        // the bay the screen is set into, Space.pad down the box
                        screen-bay := ScreenBay {
                            x: (parent.width - self.width) / 2;
                            y: bay-pad;
                            screen-w: lcd-w;
                            screen-h: lcd-h;
                            field: root.lcd-field;
                        }
                        // a layout carried over the screen on the second tab: ringed, as where it lands
                        if root.ob-over: Rectangle {
                            x: screen-bay.x - Part.ring-out;
                            y: screen-bay.y - Part.ring-out;
                            width: screen-bay.width + 2 * Part.ring-out;
                            height: screen-bay.height + 2 * Part.ring-out;
                            border-radius: Radius.panel + Part.ring-out;
                            border-width: Stroke.ring;
                            border-color: Ink.soft;
                        }
                        Rectangle {
                            x: (parent.width - lcd-w) / 2;
                            y: bay-pad + kb-pad-y;
                            width: lcd-w;
                            height: lcd-h;
                            border-radius: Radius.tiny;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.lcd-big;
                            }
                        }
                    }

                    // ---------------------------------------------------- Game launch's rows
                    // in the box under the screen, as the playlist's panel is: a row for a game
                    // starting and one for a game quitting, each with its checkbox (unchecked, the
                    // row shows nothing), its words, the layout's bar (select it to see the layout
                    // on the screen above, again to let go; drag a layout from Layouts onto it to
                    // show that one) and until when
                    game-panel := Rectangle {
                        visible: root.screen-game;
                        y: band-y;
                        height: game-panel-h;
                        // (its rows a button's height, Space.inline apart, Space.row in from the
                        // panel's top and foot, Space.pad from its sides as the playlist's row is)
                        for g[i] in root.gl-rows: Rectangle {
                            x: Space.pad;
                            y: Space.row + i * (Size.button + Space.inline);
                            width: parent.width - 2 * Space.pad;
                            height: Size.button;
                            HorizontalLayout {
                                spacing: Space.inline;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    CheckBox {
                                        width: Size.check;
                                        on: g.on;
                                        clicked => { root.gl-row-on(i); }
                                    }
                                }
                                Text {
                                    text: g.words;
                                    font-family: Font.ui;
                                    font-size: Font.control;
                                    color: Ink.soft;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 230px; // art: a Game launch row: its layout's bar, its check, its words
                                        height: 24px; // art: a Game launch row: its layout's bar, its check, its words
                                        border-radius: Radius.small;
                                        opacity: g.on ? 1 : 0.45;
                                        background: g.chosen ? (bar-ta.has-hover ? Ink.edge-hover : Ink.edge) : bar-ta.has-hover ? Ink.pick : Ink.hover-box;
                                        border-width: g.over ? Stroke.ring : 0;
                                        border-color: Ink.soft;
                                        clip: true;
                                        Rectangle {
                                            x: 0;
                                            width: 26px; // art: a Game launch row: its layout's bar, its check, its words
                                            background: Ink.white.with-alpha(0.039);
                                            Path {
                                                width: 12px; // art: a Game launch row: its layout's bar, its check, its words
                                                height: 12px; // art: a Game launch row: its layout's bar, its check, its words
                                                viewbox-width: 12;
                                                viewbox-height: 12;
                                                commands: "M2.7 2.5h6.6a1.2 1.2 0 0 1 1.2 1.2v4.6a1.2 1.2 0 0 1-1.2 1.2H2.7a1.2 1.2 0 0 1-1.2-1.2V3.7a1.2 1.2 0 0 1 1.2-1.2zM3.5 5h5M3.5 7h3";
                                                fill: transparent;
                                                stroke: Ink.soft;
                                                stroke-width: 1.2px; // art: a Game launch row: its layout's bar, its check, its words
                                            }
                                        }
                                        Text {
                                            x: 35px; // art: a Game launch row: its layout's bar, its check, its words
                                            width: parent.width - 44px; // art: a Game launch row: its layout's bar, its check, its words
                                            height: parent.height;
                                            text: g.layout;
                                            font-family: Font.ui;
                                            font-size: Font.note;
                                            font-weight: Font.medium;
                                            color: Ink.ink;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        bar-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.gl-row-pick(i); }
                                        }
                                    }
                                }
                                Text {
                                    text: "until";
                                    font-family: Font.ui;
                                    font-size: Font.control;
                                    color: Ink.soft;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    DropField {
                                        width: 250px; // art: the until chooser, as wide as its longest choice
                                        height: Size.compact;
                                        opacity: g.on ? 1 : 0.45;
                                        text: g.until;
                                        clicked(x, y, h) => { root.gl-row-until(i, x, y, h, self.width); }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------- the playlist's panel
                    // attached under the screen's box, as wide as the box, in the boxes' gray (over
                    // the box's foot, so what opens from the panel rises over the box). One row:
                    // Pause, which playlist, then one round of it, left to right, each turn as long
                    // as its time, and the round starting again after it.
                    panel := Rectangle {
                        visible: !root.screen-closed && !root.screen-game;
                        y: band-y;
                        height: pl-panel-h;
                        // Pause, at the playlist's right end, after the round's start again
                        PlayButton {
                            x: parent.width - Space.pad - self.width;
                            y: (pl-panel-h - self.height) / 2;
                            paused: root.lcd-state == 1;
                            clicked => { root.lcd-pause(); }
                        }
                        // which playlist the profile plays: select it to choose another, or to
                        // make, rename or delete one
                        if !root.pl-renaming: DropField {
                            x: Space.pad;
                            y: (pl-panel-h - self.height) / 2;
                            width: root.pl-chooser-w;
                            height: Size.compact;
                            subtle: true;
                            text: root.pl-name;
                            open: root.pl-choosing;
                            clicked(x, y, h) => { root.pl-choose(x, y, h); }
                        }
                        // the playlist's name changed in place: Enter, the tick or a press away keeps
                        // it, Escape lets it go
                        if root.pl-renaming: RenameField {
                            x: Space.pad;
                            y: (pl-panel-h - self.height) / 2;
                            width: root.pl-chooser-most;
                            height: Size.compact;
                            text <=> root.pl-rename-text;
                            done(kept, t) => { root.pl-rename-done(kept, t); }
                        }
                        // the round starting again, after the strip (before Pause)
                        Path {
                            visible: !root.pl-single && !root.pl-empty && root.pl-sizing < 0;
                            x: parent.width - Space.pad - Size.compact - Space.inline - Size.round;
                            y: (pl-panel-h - self.height) / 2;
                            width: Size.round;
                            height: Size.round;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M20 12a8 8 0 1 1-2.6-5.9M20 4v4.5h-4.5";
                            fill: transparent;
                            stroke: Ink.quiet;
                            stroke-width: 1.8px; // art: the playlist's strip
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                        // the strip: every turn one piece, its way bar then its screen's bar with the
                        // screen's name on it; then an empty bar to add to. (16 above the bars' row
                        // as well, for a turn's time and buttons, which rise over the screen's box.)
                        strip := Rectangle {
                            x: root.pl-track-x;
                            y: -16px;
                            width: root.pl-track-w;
                            height: 16px + pl-panel-h; // art: the playlist's strip
                            // where a carried layout will land: one empty bar in the box's shade (as the
                            // holding bar; the screen's charcoal wouldn't show on the box's), the turn's
                            // whole room, the others making room
                            if root.pl-slot-w > 0: Rectangle {
                                x: root.pl-slot-x - root.pl-pre;
                                y: 32px; // art: the playlist's strip
                                width: root.pl-pre + root.pl-slot-w;
                                height: 24px; // art: the playlist's strip
                                animate x, width { duration: 250ms; easing: ease; }
                                border-radius: Radius.small;
                                background: Ink.box;
                            }
                            // the empty holding bar, at the strip's end: a turn's room, a step lighter than
                            // the screen's charcoal it sits on, with a "+": select it for a menu of the
                            // layouts to add. The whole strip while the playlist is empty, saying how to fill it.
                            if root.pl-hold-w > 0: Rectangle {
                                x: root.pl-hold-x;
                                y: 32px; // art: the playlist's strip
                                width: root.pl-hold-w;
                                height: 24px; // art: the playlist's strip
                                animate x, width { duration: root.pl-live ? 0ms : 250ms; easing: ease; }
                                border-radius: Radius.small;
                                property <bool> lit: (hold-ta.has-hover || root.pl-adding) && !root.carry-on;
                                background: hold-ta.pressed ? Ink.pick : self.lit ? Ink.hover-box : Ink.box;
                                animate background { duration: 120ms; }
                                Path {
                                    x: root.pl-empty ? 10px : (parent.width - 12px) / 2; // art: the playlist's strip
                                    y: 6px; // art: the playlist's strip
                                    width: 12px; // art: the playlist's strip
                                    height: 12px; // art: the playlist's strip
                                    viewbox-width: 12;
                                    viewbox-height: 12;
                                    commands: "M6 2v8M2 6h8";
                                    fill: transparent;
                                    stroke: parent.lit ? Ink.bright : Ink.soft;
                                    stroke-width: 1.6px; // art: the playlist's strip
                                    stroke-line-cap: round;
                                }
                                if root.pl-empty: Text {
                                    x: 28px; // art: the playlist's strip
                                    width: parent.width - 38px; // art: the playlist's strip
                                    height: parent.height;
                                    text: "Add a screen layout, or drag one here from Layouts.";
                                    font-family: Font.ui;
                                    font-size: Font.note;
                                    color: parent.lit ? Ink.dim : Ink.quiet;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                hold-ta := TouchArea {
                                    enabled: !root.carry-on;
                                    mouse-cursor: pointer;
                                    clicked => { root.pl-hold-menu(self.absolute-position.x, self.absolute-position.y, self.height); }
                                }
                            }
                            for b[i] in root.pl-blocks: turn := Rectangle {
                                x: b.x - root.pl-pre;
                                width: root.pl-pre + b.w;
                                animate x, width { duration: root.pl-live ? 0ms : 250ms; easing: ease; }
                                opacity: b.away ? 0 : root.pl-dim ? 0.3 : 1;
                                animate opacity { duration: 120ms; }
                                // the pointer on the screen's part or on the way bar: each lights the
                                // other a step, so the two read as one; the way bar lit while its menu
                                // is open or the screen is coming in
                                property <bool> hov: sta.has-hover && !root.carry-on && root.pl-sizing < 0 && !root.pl-dim;
                                property <bool> way-hov: wta.has-hover && !root.carry-on && root.pl-sizing < 0 && !root.pl-dim;
                                property <bool> lit: root.pl-menu == i || (b.on && root.pl-head && root.pl-in);
                                // how the screen comes in: the turn's start (grayed while the turn is the
                                // only one, when nothing comes in after it, but still to be chosen)
                                Rectangle {
                                    x: 0;
                                    y: 32px; // art: the playlist's strip
                                    width: root.pl-way-w;
                                    height: 24px; // art: the playlist's strip
                                    opacity: root.pl-single && !(turn.way-hov || turn.hov || turn.lit) ? 0.45 : 1;
                                    animate opacity { duration: 120ms; }
                                    border-top-left-radius: Radius.small;
                                    border-bottom-left-radius: Radius.small;
                                    background: turn.lit ? Ink.pick-hover : turn.way-hov || turn.hov ? Ink.pick : Ink.hover-box;
                                    animate background { duration: 120ms; }
                                    WayGlyph {
                                        x: (parent.width - 12px) / 2; // art: the playlist's strip
                                        y: 6px; // art: the playlist's strip
                                        way: b.way;
                                        ink: turn.lit || turn.way-hov ? Ink.bright : turn.hov ? Ink.dim : Ink.soft;
                                    }
                                }
                                // the screen's bar, a hairline after its way in, the screen's name on it
                                // (none on a bar too short for a letter or two)
                                Rectangle {
                                    x: root.pl-pre;
                                    y: 32px; // art: the playlist's strip
                                    width: b.w;
                                    height: 24px; // art: the playlist's strip
                                    border-top-right-radius: Radius.small;
                                    border-bottom-right-radius: Radius.small;
                                    background: b.on ? (turn.hov || turn.way-hov ? Ink.off : Ink.edge) : (turn.hov || turn.way-hov ? Ink.pick-hover : Ink.pick);
                                    animate background { duration: 120ms; }
                                    // its name, then its time at its end, short of the end's handle: its
                                    // seconds, or the infinity mark for a turn that stays until the layouts
                                    // are switched (the time left off a bar too short to keep some of the
                                    // name beside it, and both off one too short for a letter or two)
                                    if b.w >= 28px: HorizontalLayout { // art: the playlist's strip
                                        padding-left: 8px;  // art: a turn on the strip
                                        padding-right: 10px;  // art: a turn on the strip
                                        spacing: 8px;  // art: a turn on the strip
                                        Text {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            text: b.name;
                                            font-family: Font.ui;
                                            font-size: Font.caption;
                                            font-weight: b.on ? Font.strong : Font.regular;
                                            color: b.on ? Ink.bright : turn.hov ? Ink.dim : Ink.soft;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if b.time != "" && b.w >= 64px: Text { // art: the playlist's strip
                                            text: b.time;
                                            font-family: Font.ui;
                                            font-size: Font.small;
                                            color: b.on ? Ink.dim : turn.hov ? Ink.soft : Ink.quiet;
                                            vertical-alignment: center;
                                        }
                                        if b.stays && !root.pl-single && b.w >= 34px: Rectangle { // art: the playlist's strip
                                            width: 17.6px; // art: the playlist's strip
                                            Path {
                                                y: (parent.height - 8px) / 2; // art: the playlist's strip
                                                width: 17.6px; // art: the playlist's strip
                                                height: 8px; // art: the playlist's strip
                                                viewbox-x: 1;
                                                viewbox-y: 7;
                                                viewbox-width: 22;
                                                viewbox-height: 10;
                                                commands: "M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z";
                                                fill: transparent;
                                                stroke: b.on ? Ink.dim : turn.hov ? Ink.soft : Ink.quiet;
                                                stroke-width: 1.5px; // art: the playlist's strip
                                            }
                                        }
                                    }
                                }
                                // the playhead: across the way bar while the screen comes in, then along
                                // the screen's bar (under the turn's time and buttons)
                                if b.on && root.pl-head && !b.away: Rectangle {
                                    x: (root.pl-in ? root.pl-pre * root.pl-p : root.pl-pre + b.w * root.pl-p) - 1px; // art: the playlist's strip
                                    y: 26px; // art: the playlist's strip
                                    width: 2px; // art: the playlist's strip
                                    height: 36px; // art: the playlist's strip
                                    border-radius: self.width / 2;
                                    background: Ink.bright;
                                    opacity: root.carry-on ? 0.3 : 1;
                                    Rectangle {
                                        x: -4px;
                                        y: -4px;
                                        width: 10px; // art: the playlist's strip
                                        height: 10px; // art: the playlist's strip
                                        border-radius: self.width / 2;
                                        background: Ink.bright;
                                    }
                                }
                                // select the turn to show it now; drag it along the strip to move it
                                // (the turn carried keeps the press it was carried with, unseen, until
                                // it lands: switched off then, the drag would end under the hand)
                                sta := TouchArea {
                                    enabled: (!b.away || root.carry-on) && !root.pl-dim;
                                    // (the open hand at rest, as a turn is there to be carried; Grant, 2026-10-16)
                                    mouse-cursor: root.carry-on ? MouseCursor.grabbing : MouseCursor.grab;
                                    property <bool> far;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            self.far = false;
                                        }
                                        if (e.kind == PointerEventKind.up) {
                                            if (root.carry-on) {
                                                stage.drop-carry();
                                            } else if (!self.far) {
                                                root.page-show(i);
                                            }
                                        }
                                        if (e.kind == PointerEventKind.cancel && root.carry-on) {
                                            root.carry-on = false;
                                            root.pl-carry-cancel();
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            if (!root.carry-on && !self.far && (abs(self.mouse-x - self.pressed-x) > Part.drag || abs(self.mouse-y - self.pressed-y) > Part.drag)) {
                                                self.far = true;
                                                root.carry-gx = 18px; // art: the playlist's strip
                                                root.carry-gy = 14px; // art: the playlist's strip
                                                root.carry-settle = false;
                                                root.carry-on = true;
                                                root.pl-carry-start(0, i);
                                            }
                                            if (root.carry-on) {
                                                stage.carry-to(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    // its time, then Edit and Remove, over its bar while the pointer is on
                                    // the turn or its time's menu is open; only the time while its end is
                                    // dragged. The time opens its menu of times while there are other turns.
                                    // (Inside the turn's TouchArea, so the turn keeps the pointer while it
                                    // is on them.)
                                    if (turn.hov || root.pl-sizing == i || root.pl-timing == i) && !b.away: tb := Rectangle {
                                        property <bool> buttons: root.pl-sizing != i;
                                        property <bool> times: self.buttons && !root.pl-single;
                                        x: root.pl-pre + (b.w - self.width) / 2;
                                        y: 0;
                                        width: 2px + time-button.width + (self.buttons ? 1px + 20px + 21px : 0) + 2px; // art: the playlist's strip
                                        height: 24px; // art: the playlist's strip
                                        border-radius: Radius.control;
                                        background: Ink.pop;
                                        drop-shadow-blur: Shadow.float.blur;
                                        drop-shadow-offset-y: Shadow.float.y;
                                        drop-shadow-color: Shadow.float.color;
                                        time-button := Rectangle {
                                            x: 2px; // art: the playlist's strip
                                            y: 2px; // art: the playlist's strip
                                            width: 6px + secs-text.preferred-width + (tb.times ? 3px + 10px + 5px : 6px); // art: the playlist's strip
                                            height: 20px; // art: the playlist's strip
                                            border-radius: Radius.control - 2px; // art: the playlist's strip
                                            background: !tb.times ? transparent : time-ta.pressed || root.pl-timing == i ? Ink.pick : time-ta.has-hover ? Ink.hover-box : transparent;
                                            secs-text := Text {
                                                x: 6px; // art: the playlist's strip
                                                height: parent.height;
                                                text: b.secs;
                                                font-family: Font.ui;
                                                font-size: Font.caption;
                                                color: Ink.bright;
                                                vertical-alignment: center;
                                            }
                                            if tb.times: Path {
                                                x: 6px + secs-text.preferred-width + 3px; // art: the playlist's strip
                                                y: 5px; // art: the playlist's strip
                                                width: 10px; // art: the playlist's strip
                                                height: 10px; // art: the playlist's strip
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                commands: "M6 9l6 6 6-6";  // art: the turn's own tools, over the strip
                                                fill: transparent;
                                                stroke: time-ta.has-hover || root.pl-timing == i ? Ink.bright : Ink.soft;
                                                stroke-width: 2px; // art: the playlist's strip
                                            }
                                            time-ta := TouchArea {
                                                enabled: tb.times;
                                                mouse-cursor: tb.times ? MouseCursor.pointer : MouseCursor.default;
                                                clicked => { root.pl-time(i, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                                            }
                                        }
                                        if tb.buttons: StripIcon {
                                            x: 2px + time-button.width + 1px; // art: the playlist's strip
                                            y: 2px; // art: the playlist's strip
                                            commands: "M4 20h4L19 9l-4-4L4 16z";
                                            clicked => { root.screen-edit(i); }
                                        }
                                        if tb.buttons: StripIcon {
                                            x: 2px + time-button.width + 1px + 21px; // art: the playlist's strip
                                            y: 2px; // art: the playlist's strip
                                            commands: "M6 6l12 12M18 6L6 18";
                                            clicked => { root.page-remove(i); }
                                        }
                                    }
                                    // the bar's right end: drag it to make the turn longer or shorter
                                    if !root.pl-single && !b.away && !root.pl-dim: Rectangle {
                                        x: parent.width - 10px; // art: the playlist's strip
                                        y: 32px; // art: the playlist's strip
                                        width: 10px; // art: the playlist's strip
                                        height: 24px; // art: the playlist's strip
                                        Rectangle {
                                            x: 4px; // art: the playlist's strip
                                            y: 7px; // art: the playlist's strip
                                            width: 2px; // art: the playlist's strip
                                            height: 10px; // art: the playlist's strip
                                            border-radius: self.width / 2;
                                            background: Ink.bright;
                                            opacity: turn.hov || root.pl-sizing == i ? 0.8 : 0;
                                            animate opacity { duration: 120ms; }
                                        }
                                        TouchArea {
                                            enabled: !root.carry-on;
                                            mouse-cursor: MouseCursor.ew-resize;
                                            // (measured in the window: the end moves with the drag)
                                            property <length> from;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    self.from = self.absolute-position.x + self.mouse-x;
                                                }
                                                if ((e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.pl-sizing == i) {
                                                    root.pl-sizing = -1;
                                                    root.pl-size-done();
                                                }
                                            }
                                            moved => {
                                                if (self.pressed) {
                                                    root.pl-sizing = i;
                                                    root.pl-size(i, self.absolute-position.x + self.mouse-x - self.from);
                                                }
                                            }
                                        }
                                    }
                                }
                                // the way bar: select it to choose how the screen comes in
                                wta := TouchArea {
                                    enabled: !b.away && !root.pl-dim && !root.carry-on;
                                    x: 0;
                                    y: 16px; // art: the playlist's strip
                                    width: root.pl-way-w;
                                    height: 40px; // art: the playlist's strip
                                    mouse-cursor: pointer;
                                    clicked => { root.pl-mark(i, self.absolute-position.x, self.absolute-position.y + 16px, 24px); } // art: the playlist's strip
                                }
                                // its name over it while the pointer is on it (not while its menu is open)
                                if turn.way-hov && root.pl-menu != i: Tip {
                                    x: (root.pl-way-w - self.width) / 2;
                                    y: 32px - self.height - Space.tight; // art: the playlist's strip
                                    width: self.preferred-width;
                                    height: self.preferred-height;
                                    text: b.way-name;
                                }
                            }
                            // a script's screen on the keyboard: the strip waits, and says so
                            if root.pl-dim: Rectangle {
                                property <length> tw: pill-text.preferred-width;
                                property <length> bw: back-text.preferred-width + 20px; // art: the playlist's strip
                                x: (parent.width - self.width) / 2;
                                y: 26px; // art: the playlist's strip
                                width: 14px + self.tw + 12px + self.bw + 4px; // art: the playlist's strip
                                height: 36px; // art: the playlist's strip
                                border-radius: Radius.panel;
                                background: Ink.pop;
                                drop-shadow-blur: Shadow.float.blur;
                                drop-shadow-offset-y: Shadow.float.y;
                                drop-shadow-color: Shadow.float.color;
                                pill-text := Text {
                                    x: 14px; // art: the playlist's strip
                                    height: parent.height;
                                    text: root.pl-script;
                                    font-family: Font.ui;
                                    font-size: Font.control;
                                    color: Ink.bright;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: 14px + parent.tw + 12px; // art: the playlist's strip
                                    y: 4px; // art: the playlist's strip
                                    width: parent.bw;
                                    height: 28px; // art: the playlist's strip
                                    border-radius: Radius.panel - 4px; // art: the playlist's strip
                                    background: back-ta.pressed ? Ink.pick : back-ta.has-hover ? Ink.pick-hover : Ink.hover-box;
                                    back-text := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Back to the playlist";
                                        font-family: Font.ui;
                                        font-size: Font.control;
                                        color: Ink.bright;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    back-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pl-back(); }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------- the onboard layout
                    // the second tab's row under the screen, where the first has the playlist: the
                    // chooser of the layout the profile keeps on the keyboard, and the line beside
                    // it; on a keyboard without build 5, what the keyboard needs instead
                    if root.screen-closed: Rectangle {
                        y: band-y;
                        height: pl-panel-h;
                        if root.ob-ready: DropField {
                            x: Space.pad;
                            y: (pl-panel-h - self.height) / 2;
                            width: root.ob-chooser-w;
                            height: Size.compact;
                            subtle: true;
                            text: root.ob-name;
                            open: root.ob-choosing;
                            clicked(x, y, h) => { root.ob-choose(x, y, h); }
                        }
                        if root.ob-ready: Text {
                            x: Space.pad + root.ob-chooser-w + Space.margin;
                            y: (Size.bar - Size.compact) / 2;
                            width: parent.width - self.x - Space.pad;
                            height: Size.compact;
                            text: root.ob-say;
                            font-family: Font.ui;
                            font-size: Font.note;
                            color: Ink.quiet;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.ob-ready: Rectangle {
                            x: Space.margin;
                            y: (Size.bar - Size.compact) / 2;
                            width: parent.width - 2 * Space.margin;
                            height: Size.compact;
                            Path {
                                x: 0;
                                y: (parent.height - Part.glyph) / 2;
                                width: Part.glyph;
                                height: Part.glyph;
                                viewbox-width: 14;
                                viewbox-height: 14;
                                commands: "M7 1.4a5.6 5.6 0 1 0 0 11.2a5.6 5.6 0 1 0 0-11.2zM7 6.2v3.6M7 4.3v0.1";
                                fill: transparent;
                                stroke: Ink.soft;
                                stroke-width: 1.3px; // art: the glyph's stroke
                                stroke-line-cap: round;
                            }
                            Text {
                                x: Part.glyph + Part.glyph-gap;
                                width: parent.width - self.x;
                                height: parent.height;
                                text: "Onboard layouts need Ectomatter’s firmware on the keyboard. Until then, the keyboard shows EVGA’s status screen when Ectomatter isn’t running.";
                                font-family: Font.ui;
                                font-size: Font.note;
                                color: Ink.soft;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // ---------------------------------------------------- the Library
                    // every screen there is, two to a row; drag one onto the playlist to play it,
                    // or put it on the playlist's end from its card; an empty block after them
                    // for a new one
                    if root.boot == 0: PageBox {
                        visible: shelf-on;
                        x: 0;
                        y: tabs-h + box-h;
                        width: under-w;
                        height: shelf-h;
                        border-top-left-radius: 0;
                        border-top-right-radius: 0;
                        title: "Layouts";
                        // how the Library is used, at the end of its title's line
                        Text {
                            x: 96px; // art: after the title's word
                            y: Part.title-top;
                            width: parent.width - Space.pad - self.x;
                            height: Line.title;
                            text: root.screen-game ? "Drag a screen layout onto a bar above to show that layout when a game starts or quits." : root.screen-closed ? "Drag a screen layout onto the screen to save the layout on the keyboard, or to another place in Layouts to move the layout." : "Drag a screen layout onto the playlist to add the layout to what the keyboard shows, or to another place in Layouts to move the layout.";
                            font-family: Font.ui;
                            font-size: Font.note;
                            color: Ink.quiet;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // each card in its place: while a layout is carried along the Library, the
                        // others make room where it will land, and it is left out of its own
                        for c[k] in root.lib-pages: Rectangle {
                            property <length> cw: shelf-two ? (parent.width - 2 * Space.pad - Space.inline) / 2 : parent.width - 2 * Space.pad;
                            x: Space.pad + (shelf-two ? mod(c.at, 2) * (self.cw + Space.inline) : 0);
                            y: Size.box-head + (shelf-two ? floor(c.at / 2) : c.at) * (Size.layout-card-h + Space.inline);
                            animate x, y { duration: root.carry-on ? 250ms : 0ms; easing: ease; }
                            opacity: c.carried ? 0 : 1;
                            width: self.cw;
                            height: Size.layout-card-h;
                            PlCard {
                                width: parent.width;
                                height: parent.height;
                                p: c;
                                hovered: cta.has-hover && !root.carry-on;
                            }
                            // the whole card a button: select it (or right-click it) for its menu, Edit
                            // first; press and drag it to carry it onto the playlist
                            cta := TouchArea {
                                mouse-cursor: root.carry-on ? MouseCursor.grabbing : MouseCursor.pointer;
                                property <bool> far;
                                // (pressed with the right button: its menu, never a carry)
                                property <bool> right;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        self.far = false;
                                        self.right = e.button == PointerEventButton.right;
                                    }
                                    if (e.kind == PointerEventKind.up && root.carry-on) {
                                        stage.drop-carry();
                                    } else if (e.kind == PointerEventKind.up && !self.far && (e.button == PointerEventButton.left || e.button == PointerEventButton.right)) {
                                        root.lib-menu(k, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                    if (e.kind == PointerEventKind.cancel && root.carry-on) {
                                        root.carry-on = false;
                                        root.pl-carry-cancel();
                                    }
                                }
                                moved => {
                                    if (self.pressed && !self.right) {
                                        if (!root.carry-on && !self.far && (abs(self.mouse-x - self.pressed-x) > Part.drag || abs(self.mouse-y - self.pressed-y) > Part.drag)) {
                                            self.far = true;
                                            root.carry-gx = 18px; // art: where the chip is held
                                            root.carry-gy = 14px; // art: where the chip is held
                                            root.carry-settle = false;
                                            root.carry-on = true;
                                            root.pl-carry-start(1, k);
                                        }
                                        if (root.carry-on) {
                                            stage.carry-to(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                                // the menu's "···", at the middle of the card's right edge while the pointer
                                // is on it: what selecting the card opens
                                if self.has-hover && !root.carry-on: Text {
                                    x: parent.width - 30px - self.preferred-width / 2; // art: what selecting the card opens, at its end
                                    y: (parent.height - self.preferred-height) / 2;
                                    text: "···";
                                    font-family: Font.ui;
                                    font-size: Font.title;
                                    letter-spacing: 1px; // art: what selecting the card opens, at its end
                                    color: Ink.soft;
                                }
                            }
                        }
                        // a new screen: an empty block after the last, in the cards' own shade
                        Rectangle {
                            property <int> k: root.lib-pages.length;
                            property <length> cw: shelf-two ? (parent.width - 2 * Space.pad - Space.inline) / 2 : parent.width - 2 * Space.pad;
                            x: Space.pad + (shelf-two ? mod(self.k, 2) * (self.cw + Space.inline) : 0);
                            y: Size.box-head + (shelf-two ? floor(self.k / 2) : self.k) * (Size.layout-card-h + Space.inline);
                            width: self.cw;
                            height: Size.layout-card-h;
                            border-radius: Radius.panel;
                            background: new-ta.pressed ? Ink.pick : new-ta.has-hover ? Ink.hover-well : Ink.well;
                            animate background { duration: 120ms; }
                            property <length> words-w: Part.chevron + Part.glyph-gap + new-text.preferred-width;
                            Path {
                                x: (parent.width - parent.words-w) / 2;
                                y: (parent.height - Part.chevron) / 2;
                                width: Part.chevron;
                                height: Part.chevron;
                                viewbox-width: 12;
                                viewbox-height: 12;
                                commands: "M6 2v8M2 6h8";
                                fill: transparent;
                                stroke: new-ta.has-hover ? Ink.bright : Ink.soft;
                                stroke-width: 1.6px; // art: the plus's stroke
                                stroke-line-cap: round;
                            }
                            new-text := Text {
                                x: (parent.width - parent.words-w) / 2 + Part.chevron + Part.glyph-gap;
                                height: parent.height;
                                text: "New screen layout";
                                font-family: Font.ui;
                                font-size: Font.control;
                                font-weight: Font.medium;
                                color: new-ta.has-hover ? Ink.bright : Ink.soft;
                                vertical-alignment: center;
                            }
                            new-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.lib-new(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                            }
                        }
                    }

                    // the pieces round the box, in the column's terms: the default backlight at the
                    // tabs' row's right end, and the line on a layout's own color before it
                    if root.boot == 0: Rectangle {
                        for c in root.cells: CellView {
                            c: c;
                            pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                            field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                            slide(id, v) => { root.cell-slide(id, v); }
                        }
                    }

                    // ---------------------------------------------------- the screen carried
                    // its name, under the pointer; let go over the panel, it settles into its room
                    if root.carry-on: CarryChip {
                        x: root.carry-x - root.carry-gx;
                        y: root.carry-y - root.carry-gy;
                        animate x, y { duration: root.carry-settle ? 150ms : 0ms; easing: ease; }
                        text: root.carry-name;
                        opacity: root.carry-settle ? 0 : 1;
                        animate opacity { duration: 150ms; easing: ease; }
                    }
                }
                // Settings: the keyboard's facts, a form (src/form.rs) laid out in Rust
                if root.tab == 2: Rectangle {
                    x: pws-x;
                    y: head-end;
                    width: pws-w;
                    height: root.tile-height;
                    for c in root.cells: CellView {
                        c: c;
                        pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                        field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                        slide(id, v) => { root.cell-slide(id, v); }
                        typed(id, index, t) => { root.cell-typed(id, index, t); }
                    }
                }

                // the keyboard's stage, every device's: its shade round the hole the
                // window draws the keyboard in
                if root.tab < 2: Stage {
                    x: pws-x;
                    y: board-top - kb-pad-y;
                    width: pws-w;
                    height: board-h + 2 * kb-pad-y;
                    hole-x: kb-pad-x;
                    hole-y: kb-pad-y;
                    hole-w: board-w;
                    hole-h: board-h;
                }
                // the device's shadow on the box, kept inside the box's corners
                if root.tab < 2: Rectangle {
                    x: pws-x;
                    y: board-top - kb-pad-y;
                    width: pws-w;
                    height: board-h + 2 * kb-pad-y;
                    border-radius: Radius.box;
                    clip: true;
                    Image {
                        x: kb-pad-x - root.board-shadow-margin;
                        y: kb-pad-y - root.board-shadow-margin;
                        width: board-w + 2 * root.board-shadow-margin;
                        height: board-h + 2 * root.board-shadow-margin;
                        source: root.board-shadow;
                    }
                }
                // the keys, over the keyboard's hole: a click on the keyboard away
                // from every key lets the chosen one go; then what is drawn over it
                Rectangle {
                    visible: root.tab < 2;
                    x: pws-x + kb-pad-x;
                    y: board-top;
                    width: board-w;
                    height: board-h;
                    TouchArea {
                        clicked => { root.board-clicked(); }
                    }
                    for k in root.keys: KeyBox {
                        k: k;
                        unit: root.unit;
                        cqw: root.cqw;
                        clicked => { root.key-clicked(k.pos); }
                        hovered(on) => { root.key-hovered(k.pos, on); }
                    }
                    for o in root.overlays: Image {
                        visible: root.board-ready;
                        // Only a knob's place along its track glides, as long as the time
                        // between readings, so it is still moving when the next one comes
                        // and never steps; its track moves with the keyboard at once.
                        property <float> along: o.frac;
                        animate along { duration: root.knob-glide; easing: linear; }
                        x: o.x + self.along * o.travel;
                        y: o.y;
                        // (dimmed with the keyboard round an area the pointer is over)
                        opacity: o.opacity * (root.dimming ? 0.45 : 1);
                        width: o.w;
                        height: o.h;
                        source: o.image;
                        image-fit: fill;
                    }
                }
            }
            // the device's own bar, every page's: its name, its tabs, its editors, and how it is
            devbar := PageBar {
                y: 0;
                title: root.kb-name;
                dot: root.conn-state;
                tabs: ["Keys", "Lighting", "Screen", "Settings"];
                // (the tabs in the bar's order: the page's numbers have Settings 2, Screen 3)
                tab: root.tab == 3 ? 2 : root.tab == 2 ? 3 : root.tab;
                tab-chosen(i) => { root.view-changed(i == 2 ? 3 : i == 3 ? 2 : i); }
                status: root.status-text;
                status-bad: root.status-kind == 2;
                undo-shown: root.undo-shown;
                undo => { root.undo(false); }
                // the Macro Editor, the Screen Editor and the lab
                BarButton {
                    commands: "M3.1 4h9.8a1.6 1.6 0 0 1 1.6 1.6v5.3a1.6 1.6 0 0 1-1.6 1.6H3.1a1.6 1.6 0 0 1-1.6-1.6V5.6a1.6 1.6 0 0 1 1.6-1.6zM4 7h1M7 7h1M10 7h2M4.5 9.8h7";
                    text: "Macro Editor";
                    clicked => { root.macro-editor(-1); }
                }
                // (the keyboard's screen: a wide frame with its rows of words)
                BarButton {
                    commands: "M2.6 3.4h10.8a1.6 1.6 0 0 1 1.6 1.6v6a1.6 1.6 0 0 1-1.6 1.6H2.6A1.6 1.6 0 0 1 1 11V5a1.6 1.6 0 0 1 1.6-1.6zM4 6.2h8M4 8h6M4 9.8h7";
                    text: "Screen Editor";
                    clicked => { root.screen-editor(); }
                }
                BarButton {
                    // a flask drawn for this size, its lines on the pixel grid
                    commands: "M5.14 1.14h5.72M6.29 1.14v4.58L2.95 11.93a1.25 1.25 0 0 0 1.1 1.79h7.9a1.25 1.25 0 0 0 1.1-1.79L9.71 5.72V1.14M4.3 10.29h7.4";
                    round: true;
                    text: "";
                    clicked => { root.rail("lab"); }
                }
            }

        }
    }


    // the title bar, every window's
    TitleBar {
        y: 0;
        mark: root.mark;
        corner: root.radius;
        drag => { root.drag(); }
        maximize => { root.maximize(); }
        minimize => { root.minimize(); }
        close => { root.close-window(); }
    }

    // the rail: Home, the device, and Settings at its foot. Clicking the item
    // already chosen opens it into its blade, with the names, or closes it.
    // Drawn after the page, so a name beside a closed item shows over it.
    Rectangle {
        x: 0;
        y: bar;
        width: rail-w;
        height: root.height - bar;
        background: Ink.frame;
        border-bottom-left-radius: root.radius;
        clip: !root.rail-open ? false : true;
        // (its items in from its edges as far as the shut rail has them, open or shut, so
        // opened its items widen for their names and stay where they were; Space.tight apart;
        // the devices Space.pad under Home; Library and Settings at its foot)
        property <length> rail-in: (Size.rail-shut - Size.rail) / 2;
        property <length> pitch: Size.rail + Space.tight;
        r-home := RailItem {
            x: parent.rail-in;
            y: parent.rail-in;
            width: rail-w - 2 * parent.rail-in;
            glyph: root.home-glyph;
            name: "Home";
            on: root.place == "home";
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail("home"); }
        }
        // (the devices, as they sit on Home's desk, left to right)
        for d[i] in root.rail-devices: RailItem {
            x: parent.rail-in;
            y: parent.rail-in + Size.rail + Space.pad + i * parent.pitch;
            width: rail-w - 2 * parent.rail-in;
            glyph: d.kind == "mouse" ? root.mouse-glyph : root.keyboard-glyph;
            name: d.name;
            on: root.place == d.place;
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail(d.place); }
        }
        r-library := RailItem {
            x: parent.rail-in;
            y: parent.height - parent.rail-in - parent.pitch - Size.rail;
            width: rail-w - 2 * parent.rail-in;
            glyph: root.library-glyph;
            name: "Library";
            on: root.place == "library";
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail("library"); }
        }
        r-settings := RailItem {
            x: parent.rail-in;
            y: parent.height - parent.rail-in - Size.rail;
            width: rail-w - 2 * parent.rail-in;
            glyph: root.settings-glyph;
            name: "Settings";
            on: root.place == "settings";
            open: root.rail-open;
            reveal: root.reveal;
            clicked => { root.rail("settings"); }
        }
    }

    // the color picker, hung from the swatch that opened it
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-top;
    in property <float> pk-hue;
    in property <float> pk-sat;
    in property <float> pk-val;
    in property <color> pk-now;
    in property <color> pk-pure;
    in property <image> pk-sv-img;
    in property <image> pk-hue-img;
    in-out property <string> pk-hex;
    in-out property <string> pk-r;
    in-out property <string> pk-g;
    in-out property <string> pk-b;
    in-out property <string> pk-h;
    in-out property <string> pk-s;
    in-out property <string> pk-v;
    in property <[color]> pk-presets;
    in property <[color]> pk-recent;
    out property <length> picker-height: picker.natural;
    callback pk-sv(float, float);
    callback pk-hue-at(float);
    callback pk-field(int, string);
    callback pk-well(color);
    callback pk-enter();
    callback pk-dismiss();
    // closed, the picker's fields let go of the keyboard
    public function blur-picker() {
        sink.focus();
        sink.clear-focus();
    }
    sink := FocusScope {
        width: 0;
        height: 0;
    }

    // Each page's scrollbar runs beside what scrolls and nothing else: under
    // the title bar, under the device's bar on its page (which stays put), and
    // Space.inline short of either end, as every scrollbar is (ScrollBox's).
    if root.place == "z10": ScrollBar {
        x: root.width - Part.scroll-in;
        y: root.page-scroll-y;
        height: root.page-scroll-h;
        view: flick.height;
        content: flick.content-height;
        offset: -flick.content-y;
        scroll-to(o) => { flick.content-y = -o; }
    }
    if root.place == "mouse": ScrollBar {
        x: root.width - Part.scroll-in;
        y: root.page-scroll-y;
        height: root.page-scroll-h;
        view: mouse-flick.height;
        content: mouse-flick.content-height;
        offset: -mouse-flick.content-y;
        scroll-to(o) => { mouse-flick.content-y = -o; }
    }
    if root.place == "library": ScrollBar {
        x: root.width - Part.scroll-in;
        y: root.page-scroll-y;
        height: root.page-scroll-h;
        view: gl-flick.height;
        content: gl-flick.content-height;
        offset: -gl-flick.content-y;
        scroll-to(o) => { gl-flick.content-y = -o; }
    }
    if root.place == "settings": ScrollBar {
        x: root.width - Part.scroll-in;
        y: root.page-scroll-y;
        height: root.page-scroll-h;
        view: set-flick.height;
        content: set-flick.content-height;
        offset: -set-flick.content-y;
        scroll-to(o) => { set-flick.content-y = -o; }
    }

    // a form over the Library: Add a game (its program and its name) or Add an
    // app (one seen in front); the page dims under it, and a press on the dim,
    // Cancel or Escape closes it
    if root.gl-modal != 0: FormDialog {
        corner: root.radius;
        cancel => { root.gl-modal-close(); }
        title: root.gl-modal == 1 ? "Add a game" : root.gl-modal == 3 ? root.gl-script-title : root.gl-modal == 4 ? root.gl-plugin-title : root.gl-modal == 5 ? root.gl-var-title : "Add an app";
        text: root.gl-modal == 1 ? "Choose the game’s program. The game joins Games, with a page of its own." : root.gl-modal == 3 ? root.gl-script-sub
            : root.gl-modal == 4 ? root.gl-plugin-sub : root.gl-modal == 5 ? root.gl-var-sub
            : "Choose an app you’ve had open while Ectomatter was running. The app joins Apps, with a page of its own.";
        go: (root.gl-modal == 3 && root.gl-script-editing) || (root.gl-modal == 5 && root.gl-var-editing) ? "Save" : "Add";
        go-enabled: root.gl-can-add;
        go-pressed => { root.gl-add-done(); }
        // (Remove, where the form changes a script or a value already there)
        aside: (root.gl-modal == 3 && root.gl-script-editing) || (root.gl-modal == 5 && root.gl-var-editing) ? "Remove" : "";
        aside-pressed => {
            if (root.gl-modal == 3) {
                root.gl-script-remove();
            } else {
                root.gl-var-remove();
            }
        }
        if root.gl-modal == 1: VerticalLayout {
            spacing: 0;
            FormLabel {
                text: "Program";
            }
            Rectangle { height: Space.label; }
            HorizontalLayout {
                spacing: Space.inline;
                FieldBox {
                    horizontal-stretch: 1;
                    read-only: true;
                    text: root.gl-program;
                    placeholder: "No program chosen";
                }
                VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: "Choose…";
                        on-box: true;
                        clicked => { root.gl-choose-program(); }
                    }
                }
            }
            Rectangle { height: Space.tight; }
            FormNote {
                text: "Ectomatter notices the game starting, from Play here or anywhere else.";
            }
            Rectangle { height: Space.pad; }
            FormLabel {
                text: "Name";
            }
            Rectangle { height: Space.label; }
            FieldBox {
                placeholder: root.gl-name-hint;
                text <=> root.gl-name-typed;
                accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                escape => { root.gl-modal-close(); }
            }
        }
        // a plugin: from its GitHub address or its file, and what it is once found
        if root.gl-modal == 4: VerticalLayout {
            spacing: 0;
            FormLabel {
                text: "GitHub address";
            }
            Rectangle { height: Space.label; }
            FieldBox {
                placeholder: "Its GitHub address, or its owner/name";
                text <=> root.gl-plugin-address;
                edited => { root.gl-plugin-typed(); }
                accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                escape => { root.gl-modal-close(); }
            }
            Rectangle { height: Space.pad; }
            FormLabel {
                text: "Or a file";
            }
            Rectangle { height: Space.label; }
            HorizontalLayout {
                spacing: Space.inline;
                FieldBox {
                    horizontal-stretch: 1;
                    read-only: true;
                    text: root.gl-plugin-file;
                    placeholder: "No file chosen";
                }
                VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: "Choose…";
                        on-box: true;
                        clicked => { root.gl-plugin-choose-file(); }
                    }
                }
            }
            Rectangle { height: Space.tight; }
            FormNote {
                text: "Its file ends in .ectocore.";
            }
            if root.gl-plugin-found != "": Rectangle { height: Space.pad; }
            if root.gl-plugin-found != "": Rectangle {
                height: found-words.preferred-height;
                border-radius: Radius.panel;
                background: Ink.well;
                found-words := VerticalLayout {
                    padding: Space.row;
                    spacing: Space.list;
                    Text {
                        text: root.gl-plugin-found;
                        font-family: Font.ui;
                        font-size: Font.name;
                        font-weight: Font.medium;
                        color: Ink.ink;
                    }
                    if root.gl-plugin-found-sub != "": Text {
                        text: root.gl-plugin-found-sub;
                        font-family: Font.ui;
                        font-size: Font.note;
                        color: Ink.soft;
                        wrap: word-wrap;
                    }
                    FormNote {
                        text: root.gl-plugin-can;
                    }
                }
            }
            if root.gl-plugin-state != "": Rectangle { height: Space.inline; }
            if root.gl-plugin-state != "": Text {
                text: root.gl-plugin-state;
                font-family: Font.ui;
                font-size: Font.note;
                color: root.gl-plugin-bad ? Ink.bad : Ink.quiet;
                wrap: word-wrap;
            }
        }
        // a variable: its name and its value side by side, as a launch line sets them
        if root.gl-modal == 5: VerticalLayout {
            spacing: 0;
            HorizontalLayout {
                spacing: Space.pad;
                VerticalLayout {
                    spacing: 0;
                    FormLabel {
                        text: "Name";
                    }
                    Rectangle { height: Space.label; }
                    FieldBox {
                        placeholder: "PROTON_ENABLE_NVAPI";
                        mono: true;
                        text <=> root.gl-var-name;
                        edited => { root.gl-var-typed(); }
                        accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                        escape => { root.gl-modal-close(); }
                    }
                }
                VerticalLayout {
                    spacing: 0;
                    FormLabel {
                        text: "Value";
                    }
                    Rectangle { height: Space.label; }
                    FieldBox {
                        placeholder: "1";
                        mono: true;
                        text <=> root.gl-var-value;
                        edited => { root.gl-var-typed(); }
                        accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                        escape => { root.gl-modal-close(); }
                    }
                }
            }
            if root.gl-var-warning != "": Rectangle { height: Space.tight; }
            if root.gl-var-warning != "": FormWarning { text: root.gl-var-warning; }
        }
        // a script: its name, its command and its undo side by side, how it runs, its time limit
        if root.gl-modal == 3: VerticalLayout {
            spacing: 0;
            FormLabel {
                text: "Name";
            }
            Rectangle { height: Space.label; }
            FieldBox {
                placeholder: "For example, Pause the local AI";
                text <=> root.gl-script-name;
                edited => { root.gl-script-typed(); }
                accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                escape => { root.gl-modal-close(); }
            }
            Rectangle { height: Space.pad; }
            HorizontalLayout {
                spacing: Space.pad;
                VerticalLayout {
                    spacing: 0;
                    FormLabel {
                        text: root.gl-script-start-label;
                    }
                    Rectangle { height: Space.label; }
                    FieldBox {
                        placeholder: "A command or a file";
                        mono: true;
                        text <=> root.gl-script-start;
                        edited => { root.gl-script-typed(); }
                        accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                        escape => { root.gl-modal-close(); }
                    }
                }
                VerticalLayout {
                    spacing: 0;
                    FormLabel {
                        text: root.gl-script-quit-label;
                    }
                    Rectangle { height: Space.label; }
                    FieldBox {
                        placeholder: "Optional";
                        mono: true;
                        text <=> root.gl-script-quit;
                        edited => { root.gl-script-typed(); }
                        accepted => { if (root.gl-can-add) { root.gl-add-done(); } }
                        escape => { root.gl-modal-close(); }
                    }
                }
            }
            if root.gl-script-warning != "": Rectangle { height: Space.tight; }
            if root.gl-script-warning != "": FormWarning { text: root.gl-script-warning; }
            Rectangle { height: Space.pad; }
            CheckBox {
                text: root.gl-script-wait-label;
                on: root.gl-script-wait;
                clicked => { root.gl-script-wait-toggle(); }
            }
            Rectangle { height: Space.tight; }
            CheckBox {
                text: root.gl-script-keep-label;
                on: root.gl-script-keep;
                clicked => { root.gl-script-keep-toggle(); }
            }
            Rectangle { height: Space.pad; }
            FormLabel {
                text: "Time limit";
            }
            Rectangle { height: Space.label; }
            HorizontalLayout {
                alignment: start;
                DropField {
                    width: Size.chooser;
                    text: root.gl-script-limit;
                    open: root.menu-open;
                    clicked(x, y, h) => { root.gl-script-limit-menu(x, y, h, self.width); }
                }
            }
            Rectangle { height: Space.tight; }
            FormNote {
                text: root.gl-script-limit-note;
            }
        }
        if root.gl-modal == 2 && root.gl-seen.length == 0: Text {
            text: "Apps show here once they’ve been in front while Ectomatter is running.";
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.quiet;
            wrap: word-wrap;
        }
        if root.gl-modal == 2 && root.gl-seen.length > 0: Rectangle {
            height: min(root.gl-seen.length * Size.pick-row + 2 * Space.tight, 320px); // art: the list at most, before it scrolls
            border-radius: Radius.panel;
            background: Ink.well;
            clip: true;
            seen-flick := Flickable {
                width: parent.width;
                height: parent.height;
                content-height: root.gl-seen.length * Size.pick-row + 2 * Space.tight;
                mouse-drag-pan-enabled: false;
                for a[i] in root.gl-seen: Rectangle {
                    x: Space.tight;
                    y: Space.tight + i * Size.pick-row;
                    width: parent.width - 2 * Space.tight;
                    height: Size.pick-row;
                    border-radius: Radius.control;
                    background: root.gl-seen-chosen == i ? (seen-ta.has-hover ? Ink.pick-hover : Ink.pick) : seen-ta.has-hover ? Ink.hover-well : transparent;
                    if a.has-icon: Image {
                        x: Space.row;
                        y: (parent.height - self.height) / 2;
                        width: Size.pick-icon;
                        height: Size.pick-icon;
                        source: a.icon;
                    }
                    Text {
                        x: Space.row + Size.pick-icon + Space.row;
                        width: parent.width - self.x - Space.row;
                        height: parent.height;
                        text: a.name;
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    seen-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.gl-seen-pick(i); }
                    }
                }
            }
        }
    }

    // the scene form, over the window: New scene or Edit scene, the scene across the desk
    // as it's set (the devices show it too), its pieces, and Cancel and Create scene (or
    // Save, and Delete scene apart at the left); a press on the dim, Cancel or Escape closes it
    if root.scene-form: Scrim {
        corner: root.radius;
        cancel => { root.scene-form-close(); }
        escape => { root.scene-form-escape(); }
        sf := DialogBox {
            property <length> head-h: sf-head.preferred-height + Space.pad;
            property <length> natural: Space.margin + self.head-h + Size.preview + Space.tight + root.scene-form-h + Space.margin + Size.button + Part.primary + Space.margin;
            width: Size.dialog;
            height: min(self.natural, parent.height - 2 * Space.pad);
            x: (parent.width - self.width) / 2;
            y: max(Space.pad, (parent.height - self.height) / 2);
            sf-head := DialogHead {
                x: Space.margin;
                y: Space.margin;
                width: parent.width - 2 * Space.margin;
                title: root.scene-form-title;
                text: root.scene-form-sub;
            }
            Rectangle {
                x: Space.margin;
                y: Space.margin + sf.head-h;
                width: parent.width - 2 * Space.margin;
                height: Size.preview;
                border-radius: Radius.control;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.scene-strip;
                    image-fit: fill;
                }
            }
            sf-flick := Flickable {
                // (scrolled by the wheel; a drag is the slider's)
                mouse-drag-pan-enabled: false;
                x: Space.margin;
                y: Space.margin + sf.head-h + Size.preview + Space.tight;
                width: parent.width - 2 * Space.margin;
                height: sf.height - self.y - Space.margin - Size.button - Part.primary - Space.margin;
                content-height: root.scene-form-h;
                for c in root.scene-cells: CellView {
                    c: c;
                    glyph: root.keyboard-glyph;
                    glyph2: root.mouse-glyph;
                    glyphs: root.package-glyphs;
                    pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                    field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                    slide(id, v) => { root.cell-slide(id, v); }
                    typed(id, index, t) => { root.cell-typed(id, index, t); }
                }
                // the effects, as the Lighting page's tiles, each in the scene's colors
                if root.scene-tiles-on: Rectangle {
                    y: root.scene-tiles-y;
                    height: Size.tile;
                    for fx[i] in root.scene-tiles: EffectTile {
                        x: i * (Size.scene-tile + Space.inline);
                        width: Size.scene-tile;
                        name: fx.name;
                        icon: fx.icon;
                        on: fx.on;
                        motion: fx.motion;
                        t: fx.on && fx.motion != 0 ? animation-tick() : 0ms;
                        clicked => { root.scene-tile(i); }
                    }
                }
            }
            // its buttons, at its foot (as tall as the primary one, two more than the rest)
            HorizontalLayout {
                x: Space.margin;
                y: parent.height - Space.margin - self.height;
                width: parent.width - 2 * Space.margin;
                height: Size.button + Part.primary;
                spacing: Space.inline;
                if root.scene-form-edit: VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: "Delete scene";
                        on-box: true;
                        clicked => { root.scene-form-delete(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: "Cancel";
                        on-box: true;
                        clicked => { root.scene-form-close(); }
                    }
                }
                WordButton {
                    primary: true;
                    text: root.scene-form-edit ? "Save" : "Create scene";
                    clicked => { root.scene-form-done(); }
                }
            }
        }
    }

    // the open menu, over everything
    // the open menu turned `y` down as it opens (src/menu_size.rs's reveal)
    public function scroll-menu(y: length) {
        menu.scroll-to(y);
    }
    menu := Menu {
        marks: root.menu-marks;
        visible: root.menu-open;
        x: max(Space.inline, min(root.menu-ax, root.width - root.menu-w - Space.inline));
        width: root.menu-w;
        height: min(root.menu-natural, min(root.menu-max, root.height - root.menu-top - Space.inline));
        y: root.menu-top;
        rows: root.menu-rows;
        placeholder: root.menu-placeholder;
        back: root.menu-back;
        search: root.menu-search;
        query <=> root.menu-query;
        chose(i) => { root.menu-chose(i); }
        edit(i) => { root.menu-edit(i); }
        go-back => { root.menu-back-to(); }
        typed(t) => { root.menu-typed(t); }
        enter => { root.menu-enter(); }
        dismiss => { root.menu-dismiss(); }
        field-done(i, t) => { root.menu-field(i, t); }
    }
    picker := Picker {
        visible: root.picker-open;
        x: max(Space.inline, min(root.picker-x, root.width - Size.picker - Space.inline));
        y: root.picker-top;
        height: root.picker-height;
        hue: root.pk-hue;
        sat: root.pk-sat;
        val: root.pk-val;
        now: root.pk-now;
        pure: root.pk-pure;
        sv-img: root.pk-sv-img;
        hue-img: root.pk-hue-img;
        t-hex <=> root.pk-hex;
        t-r <=> root.pk-r;
        t-g <=> root.pk-g;
        t-b <=> root.pk-b;
        t-h <=> root.pk-h;
        t-s <=> root.pk-s;
        t-v <=> root.pk-v;
        presets: root.pk-presets;
        recent: root.pk-recent;
        sv(x, y) => { root.pk-sv(x, y); }
        hue-at(x) => { root.pk-hue-at(x); }
        field(i, t) => { root.pk-field(i, t); }
        well(c) => { root.pk-well(c); }
        enter => { root.pk-enter(); }
        dismiss => { root.pk-dismiss(); }
    }
    // the menu's height as its rows lay out, which the window works out: Slint
    // lays a list's rows out only as it draws them
    in property <length> menu-natural;

    // are you sure: a scrim over the window, and the question on it, as in the Macro
    // Editor; Escape is Cancel
    // are you sure: the question in a dialog, every window's; Escape is Cancel
    if root.confirm-open: Confirm {
        corner: root.radius;
        title: root.confirm-title;
        body: root.confirm-body;
        keep: root.confirm-keep;
        do: root.confirm-do;
        cancel => { root.confirm-no(); }
        yes => { root.confirm-yes(); }
    }

}

// ---------------------------------------------------------------- the Macro Editor
// Its own window, as the web app had it (macro.css at cd9ea82): the library
// in the rail's shade on the left, the chosen macro on the home's ground as a
// chain of steps on a tile, the tools under the chain, how it plays and its
// Revert and Save at the foot.

// a macro in the library
// a row of the Macro Editor's list: a macro (kind 0), or the heading of a
// section of them (kind 1): Ectomatter's own, then each device's that keeps
// macros in its own memory. Each knows its library (0 the keyboard's, 1
// Ectomatter's) and where it sits in the list; a heading, whether a new one
// can be made there.
export struct MacroItem {
    kind: int,
    lib: int,
    n: int,
    name: string,
    sub: string,
    // (a section's note, a line each, as Rust broke it)
    lines: [string],
    timed: bool,
    current: bool,
    dirty: bool,
    can-new: bool,
    y: length,
    h: length,
}

// a small icon from the editor's set, drawn in its color
component MacroIcon inherits Path {
    in property <int> which;   // 0 keys, 1 clock, 2 gear, 3 pen
    viewbox-width: 16;
    viewbox-height: 16;
    fill: transparent;
    stroke-width: 1.4px * self.width / 16px;
    commands: root.which == 1 ? "M13.8 8.5a5.8 5.8 0 1 1-11.6 0a5.8 5.8 0 1 1 11.6 0zM8 5.3v3.2l2.2 1.4M6.5 1.5h3"
        : root.which == 2 ? "M10.3 8a2.3 2.3 0 1 1-4.6 0a2.3 2.3 0 1 1 4.6 0zM8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"
        : root.which == 3 ? "M10.5 2.5l3 3L6 13H3v-3z"
        : "M3.1 4h9.8a1.6 1.6 0 0 1 1.6 1.6v5.3a1.6 1.6 0 0 1-1.6 1.6H3.1a1.6 1.6 0 0 1-1.6-1.6V5.6a1.6 1.6 0 0 1 1.6-1.6zM4 7h1M7 7h1M10 7h2M4.5 9.8h7";
}

// a macro's row in the library, a list's row with its glyph: a macro that waits, or one that doesn't
component MacroRow inherits ListRow {
    in property <MacroItem> m;
    callback menu(length, length);
    name: root.m.name;
    sub: root.m.sub;
    chosen: root.m.current;
    dirty: root.m.dirty;
    inset: 40px; // art: the macro's glyph, in its row
    right-clicked(x, y) => { root.menu(x, y); }
    MacroIcon {
        x: 11.5px; // art: the macro's glyph, in its row
        y: (parent.height - self.height) / 2;
        width: 15px; // art: the macro's glyph, in its row
        height: 15px; // art: the macro's glyph, in its row
        which: root.m.timed ? 1 : 0;
        stroke: root.m.current ? Ink.bright : Ink.soft;
    }
}

// a piece of the chain, placed by the window: a step, a wait, a joint, the
// insert point, the recording's caret
component ChainPiece inherits Rectangle {
    in property <Cell> c;
    in property <bool> blink;
    // a step being dragged is over this one: the web's bar at its left edge
    in property <bool> drop-to;
    callback clicked(int, int, length, length, length);
    callback dropped(int, length, length);
    // a step dragged: where the pointer is, and where on the step it was taken
    callback drag-at(int, length, length, length, length);
    callback wait-typed(int, string);
    // a step or wait just recorded pops in, once, as the web page's did
    property <bool> fresh: root.c.index >= 1000 && (root.c.kind == 15 || root.c.kind == 16);
    property <duration> born;
    init => { root.born = animation-tick(); }
    property <float> age: root.fresh ? max(0, min(1, (animation-tick() - root.born) / 400ms)) : 1;
    property <float> eased: 1 - (1 - root.age) * (1 - root.age);
    opacity: 0.3 + 0.7 * root.eased;
    transform-scale: 0.85 + 0.15 * root.eased;
    callback wait-done(int, string);
    callback wait-cancel();
    x: root.c.x;
    y: root.c.y;
    width: root.c.w;
    height: root.c.h;
    // a step: its key, and which way it goes; chosen, it turns ink
    if root.c.kind == 15: Rectangle {
        property <bool> dragging: ev.pressed && (abs(ev.mouse-x - ev.pressed-x) > Part.drag || abs(ev.mouse-y - ev.pressed-y) > Part.drag);
        border-radius: Radius.control;
        background: root.c.on ? Ink.ink : ev.has-hover ? Ink.pick-hover : Ink.pick;
        opacity: dragging ? 0.6 : 1;
        HorizontalLayout {
            padding-left: 11px;  // art: a step in the chain (macros.rs measures it so)
            padding-right: 11px;  // art: a step in the chain
            spacing: 6px;  // art: a step in the chain
            // (a media key's note; a job's mark, on a device or the screen, or
            // another macro played; a key's step has none)
            if root.c.style == 1: Text {
                text: "♫";
                font-family: Font.ui;
                font-size: Font.caption;
                color: root.c.on ? Ink.base : Ink.media;
                vertical-alignment: center;
            }
            if root.c.style == 2: Text {
                text: "◆";
                font-family: Font.ui;
                font-size: Font.caption;
                color: root.c.on ? Ink.base : Ink.warn;
                vertical-alignment: center;
            }
            if root.c.style == 3: Text {
                text: "▶";
                font-family: Font.ui;
                font-size: Font.caption;
                color: root.c.on ? Ink.base : Ink.good;
                vertical-alignment: center;
            }
            Text {
                text: root.c.text;
                font-family: Font.ui;
                font-size: Font.control;
                font-weight: Font.medium;
                color: root.c.on ? Ink.base : Ink.ink;
                vertical-alignment: center;
            }
            // (which way a key goes; a job goes no way)
            if root.c.style < 2: Text {
                text: root.c.value > 0.5 ? "↓" : "↑";
                font-family: Font.ui;
                font-size: Font.note;
                font-weight: Font.medium;
                color: root.c.value > 0.5 ? (root.c.on ? Ink.base : Ink.ink) : (root.c.on ? Ink.edge : Ink.quiet);
                vertical-alignment: center;
            }
        }
        if root.drop-to: Rectangle {
            x: -4px;
            y: 1px; // art: a step in the chain, drawn
            width: 3px; // art: a step in the chain, drawn
            height: parent.height - 2px; // art: a step in the chain, drawn
            background: Ink.soft;
        }
        ev := TouchArea {
            mouse-cursor: pointer;
            moved => {
                if (self.pressed && root.c.id != 0 && (abs(self.mouse-x - self.pressed-x) > Part.drag || abs(self.mouse-y - self.pressed-y) > Part.drag)) {
                    root.drag-at(root.c.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, self.pressed-x, self.pressed-y);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    if (abs(self.mouse-x - self.pressed-x) > Part.drag || abs(self.mouse-y - self.pressed-y) > Part.drag) {
                        root.dropped(root.c.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else {
                        root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height);
                    }
                }
            }
        }
    }
    // a wait: its milliseconds and a clock
    if root.c.kind == 16: Rectangle {
        border-radius: Radius.control;
        background: wt.has-hover ? Ink.shade2 : transparent;
        HorizontalLayout {
            padding-left: 8px;  // art: a wait in the chain (macros.rs measures it so)
            padding-right: 8px;  // art: a wait in the chain
            spacing: 4px;  // art: a wait in the chain
            Text {
                text: root.c.text;
                font-family: Font.ui;
                font-size: Font.note;
                font-weight: Font.medium;
                color: wt.has-hover ? Ink.bright : Ink.soft;
                vertical-alignment: center;
            }
            MacroIcon {
                y: (parent.height - 12px) / 2; // art: a step in the chain, drawn
                width: 12px; // art: a step in the chain, drawn
                height: 12px; // art: a step in the chain, drawn
                which: 1;
                stroke: wt.has-hover ? Ink.bright : Ink.soft;
                opacity: 0.7;
            }
        }
        wt := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a wait being typed
    if root.c.kind == 20: Rectangle {
        border-radius: Radius.control;
        background: Ink.pick;
        MacroIcon {
            x: 8px; // art: a step in the chain, drawn
            y: (parent.height - 12px) / 2; // art: a step in the chain, drawn
            width: 12px; // art: a step in the chain, drawn
            height: 12px; // art: a step in the chain, drawn
            which: 1;
            stroke: Ink.white;
        }
        input := TextInput {  // art: a wait typed in place, in the chain
            x: 24px; // art: a step in the chain, drawn
            width: 44px; // art: a step in the chain, drawn
            height: parent.height;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.note;
            font-weight: Font.medium;
            color: Ink.white;
            vertical-alignment: center;
            single-line: true;
            init => {
                self.focus();
                self.select-all();
            }
            accepted => { root.wait-done(root.c.index, self.text); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.wait-cancel();
                    return accept;
                }
                reject
            }
            changed has-focus => {
                Typing.on = self.has-focus;
                if (!self.has-focus) {
                    root.wait-done(root.c.index, self.text);
                }
            }
        }
        Text {
            x: 70px; // art: a step in the chain, drawn
            height: parent.height;
            text: "ms";
            font-family: Font.ui;
            font-size: Font.note;
            font-weight: Font.medium;
            color: Ink.white;
            vertical-alignment: center;
        }
    }
    // a joint between two steps, where a step can be put
    if root.c.kind == 17: Rectangle {
        property <bool> lit: root.c.on || (root.c.style == 0 && cn.has-hover);
        Rectangle {
            x: 4px; // art: a step in the chain, drawn
            y: 8px; // art: a step in the chain, drawn
            width: 12px; // art: a step in the chain, drawn
            height: 2px; // art: a step in the chain, drawn
            border-radius: self.height / 2;
            background: parent.lit ? Ink.soft : Ink.edge;
        }
        Rectangle {
            x: 12px; // art: a step in the chain, drawn
            y: 6px; // art: a step in the chain, drawn
            width: 6px; // art: a step in the chain, drawn
            height: 6px; // art: a step in the chain, drawn
            border-radius: self.width / 2;
            background: Ink.off;
        }
        if root.c.on: Rectangle {
            x: 0;
            y: -1px;
            width: 20px; // art: a step in the chain, drawn
            height: 20px; // art: a step in the chain, drawn
            border-radius: self.width / 2;
            background: Ink.ink;
            Text {
                text: "+";
                font-family: Font.ui;
                font-size: Font.name;
                font-weight: Font.strong;
                color: Ink.base;
            }
        }
        cn := TouchArea {
            enabled: root.c.style == 0;
            mouse-cursor: pointer;
            clicked => { root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // where new steps go
    if root.c.kind == 18: Rectangle {
        border-radius: 1px; // art: a step in the chain, drawn
        background: Ink.edge;
        opacity: root.c.on ? 1 : 0.25;
        TouchArea {
            x: -4px;
            width: parent.width + 8px; // art: a step in the chain, drawn
            mouse-cursor: pointer;
            clicked => { root.clicked(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // the recording's caret
    if root.c.kind == 19: Rectangle {
        background: Ink.record;
        opacity: root.blink ? 1 : 0.15;
    }
}

export component MacroWindow inherits Window {
    in property <bool> is-maximized;
    in property <image> mark;
    in property <[MacroItem]> items;
    in-out property <length> lib-scroll;
    // the device the open macro belongs to, if any, and the list's height
    in property <string> lib-title;
    in property <length> items-h;
    in property <string> macro-name;
    in property <bool> editing-name;
    in-out property <string> name-text;
    in property <bool> can-rename;
    in property <string> state-text;
    in property <int> state-kind;      // 0 quiet, 1 changed, 2 recording
    in property <[Cell]> chain;
    in property <length> chain-h;
    in property <int> chain-empty;     // 0 steps, 1 none yet, 2 recording with none yet
    in property <[string]> empty-lines;
    // a step being dragged: its chip under the pointer, and the step it would go before
    in property <bool> ghost-on;
    in property <Cell> ghost;
    in property <int> drop-index: -1;
    in property <bool> tools-off;
    in property <bool> can-clear;
    in property <bool> can-key;
    in property <bool> can-media;
    in property <bool> can-wait;
    // Ectomatter's own macros' actions and other macros: shown for its library alone
    in property <bool> jobs-shown;
    in property <bool> can-jobs;
    in property <bool> can-record;
    in property <string> meter-text;
    in property <bool> meter-warn;
    in property <bool> recording;
    in property <string> rec-clock;
    in property <string> plays-text;
    in property <bool> plays-on;
    in property <bool> count-shown;
    in-out property <string> count-text;
    in property <bool> locked;
    in property <string> status-text;
    in property <int> status-kind;
    in property <bool> can-revert;
    in property <bool> can-save;
    // the open menu
    in property <bool> menu-open;
    // whether the open menu keeps a column for ticks (not when nothing in it is ticked)
    in property <bool> menu-marks: true;
    in property <length> menu-ax;
    in property <length> menu-w: Size.menu;
    in property <[MenuRow]> menu-rows;
    in property <string> menu-placeholder;
    in property <bool> menu-back;
    in property <bool> menu-search;
    in-out property <string> menu-query;
    in property <length> menu-top;
    in property <length> menu-max;
    in property <length> menu-natural;
    out property <length> menu-x: menu.x;
    out property <length> menu-y: menu.y;
    out property <length> menu-width: menu.width;
    out property <length> menu-height: menu.height;
    out property <length> window-height: root.height;
    out property <length> window-width: root.width;
    // the chain's width, for the window to wrap it
    // (the chain's room: the canvas, less the chain's inset either side)
    out property <length> chain-width: root.width - Size.sidebar - 2 * Space.margin - 2 * Part.chain-in;
    out property <length> chain-scroll: chain-flick.content-y;
    // are you sure: deleting a macro
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-body2;

    callback minimize();
    callback maximize();
    callback close-window();
    callback drag();
    // the library shown, and its drop-down at the list's top, which opens the
    // menu of every library: Ectomatter's own, then each device's that keeps macros
    in property <string> lib-name;
    callback libs(length, length, length, length);
    // a macro by its library and number, and a new one in a library
    callback choose(int, int);
    callback new-in(int);
    callback row-menu(int, int, length, length);
    callback rename();
    callback name-done(string);
    callback name-cancel();
    callback more(length, length, length);
    callback chain-click(int, int, length, length, length);
    callback chain-drop(int, length, length);
    callback chain-drag(int, length, length, length, length);
    callback wait-done(int, string);
    callback wait-cancel();
    callback tool(int, length, length, length, length);
    callback plays(length, length, length, length);
    callback count-done(string);
    callback revert();
    callback save();
    callback menu-chose(int);
    callback menu-typed(string);
    callback menu-enter();
    callback menu-dismiss();
    callback menu-back-to();
    callback menu-field(int, string);
    callback confirm-yes();
    callback confirm-no();

    background: transparent;
    default-font-family: Font.ui;
    property <length> radius: root.is-maximized ? 0 : Radius.window;
    in property <bool> blink;

    public function focus-menu() {
        menu.focus-search();
    }
    public function blur-menu() {
        menu.blur-search();
    }

    // the title bar, every window's: where this window is
    TitleBar {
        y: 0;
        mark: root.mark;
        crumbs: root.lib-title != "" ? [root.lib-title, "Macro Editor"] : ["Macro Editor"];
        corner: root.radius;
        drag => { root.drag(); }
        maximize => { root.maximize(); }
        minimize => { root.minimize(); }
        close => { root.close-window(); }
    }

    // the macros: the library shown, chosen from a drop-down at the top
    // (Ectomatter's own, then each device's that keeps macros in its own
    // memory); under it, where its macros are kept and who plays them, a way
    // to make a new one there, and its macros
    Rectangle {
        x: 0;
        y: Size.title-bar;
        width: Size.sidebar;
        height: root.height - Size.title-bar;
        background: Ink.box;
        border-bottom-left-radius: root.radius;
        // (its head: the libraries' drop-down, Space.inline in; macro_page.rs's LIST_TOP)
        property <length> head-h: Space.inline + Size.button + Space.inline;
        DropField {
            x: Space.inline;
            y: Space.inline;
            width: parent.width - 2 * Space.inline;
            height: Size.button;
            subtle: true;
            on-box: true;
            text: root.lib-name;
            clicked(x, y, h) => { root.libs(x, y, h, self.width); }
        }
        // the list, Space.inline in from the column's sides, as a list's in a box is
        Flickable {
            x: Space.inline;
            y: parent.head-h;
            width: parent.width - 2 * Space.inline;
            height: parent.height - parent.head-h - Space.inline;
            content-height: root.items-h;
            content-y <=> root.lib-scroll;
            mouse-drag-pan-enabled: false;
            for m[i] in root.items: Rectangle {
                y: m.y;
                width: parent.width;
                height: m.h;
                if m.kind == 0: MacroRow {
                    width: parent.width;
                    m: m;
                    clicked => { root.choose(m.lib, m.n); }
                    menu(x, y) => { root.row-menu(m.lib, m.n, x, y); }
                }
                // a section's heading: as the mouse's page heads its lists
                // (a heading with no name, where the tab above names the library:
                // its note beside the New button, from the top, its first line at
                // the button's middle)
                if m.kind == 1: Rectangle {
                    if m.name != "": AnchorHead {
                        x: Space.row;
                        y: 0;
                        height: Size.list-head;
                        width: parent.width - Space.row - new-b.width - Space.tight;
                        text: m.name;
                        overflow: elide;
                    }
                    new-b := TextButton {
                        x: parent.width - self.width - Space.tight;
                        y: 0;
                        text: "+ New";
                        enabled: m.can-new;
                        clicked => { root.new-in(m.lib); }
                    }
                    // (broken into lines where the page measured them, so the
                    // macros start below the last)
                    for l[k] in m.lines: Text {
                        x: Space.row;
                        y: (m.name == "" ? (Size.compact - Line.note) / 2 : Size.list-head) + k * Line.note;
                        height: Line.note;
                        text: l;
                        font-family: Font.ui;
                        font-size: Font.note;
                        color: Ink.quiet;
                        vertical-alignment: center;
                    }
                }
            }
        }
        ScrollBar {
            x: parent.width - Part.scroll-in;
            y: parent.head-h;
            height: parent.height - parent.head-h - Space.inline;
            view: parent.height - parent.head-h - Space.inline;
            content: root.items-h;
            offset: -root.lib-scroll;
            framed: false;
            thumb-color: Ink.edge;
            scroll-to(o) => { root.lib-scroll = -o; }
        }
    }

    // the workspace: the canvas a margin in from its edges, the foot a gap under it
    property <length> foot-h: Space.gap + Size.button + Space.margin;
    // the tools' row at the canvas's foot, Space.inline in from it
    property <length> tools-h: Size.button + 2 * Space.inline;
    Rectangle {
        x: Size.sidebar;
        y: Size.title-bar;
        width: root.width - Size.sidebar;
        height: root.height - Size.title-bar;
        background: Ink.base;
        border-bottom-right-radius: root.radius;
        // the name, whether it is saved, and the less common actions: its header, every editor's
        EditorHeader {
            y: 0;
            width: parent.width;
            name: root.macro-name;
            can-rename: root.can-rename;
            renaming: root.editing-name;
            typed <=> root.name-text;
            state: root.state-text;
            state-kind: root.state-kind;
            blink: root.blink;
            more-enabled: !root.recording;
            rename => { root.rename(); }
            rename-done(t) => { root.name-done(t); }
            rename-cancel => { root.name-cancel(); }
            more(x, y, h) => { root.more(x, y, h); }
        }
        // the recording area: the chain, then the tools under it
        // recording is a signal, so the canvas keeps a red edge while it runs
        if root.recording: Rectangle {
            x: Space.margin - 1px; // art: the canvas's red edge while it records
            y: Size.bar - 1px; // art: the canvas's red edge while it records
            width: parent.width - 2 * Space.margin + 2px; // art: the canvas's red edge while it records
            height: parent.height - Size.bar - foot-h + 2px; // art: the canvas's red edge while it records
            border-radius: Radius.box + 1px; // art: the canvas's red edge while it records
            background: Ink.record.with-alpha(0.702);
        }
        canvas := Rectangle {
            x: Space.margin;
            y: Size.bar;
            width: parent.width - 2 * Space.margin;
            height: parent.height - Size.bar - foot-h;
            border-radius: Radius.box;
            background: Ink.shade1;
            chain-flick := Flickable {
                y: 0;
                width: parent.width;
                height: parent.height - tools-h;
                // (the chain Part.chain-in in from the canvas, at its foot too)
                content-height: max(self.height, root.chain-h + 2 * Part.chain-in);
                mouse-drag-pan-enabled: false;
                for c in root.chain: ChainPiece {
                    c: c;
                    blink: root.blink;
                    drop-to: root.ghost-on && c.kind == 15 && c.id != 0 && c.index == root.drop-index;
                    drag-at(i, x, y, ox, oy) => { root.chain-drag(i, x, y, ox, oy); }
                    clicked(id, i, x, y, h) => { root.chain-click(id, i, x, y, h); }
                    dropped(i, x, y) => { root.chain-drop(i, x, y); }
                    wait-done(i, t) => { root.wait-done(i, t); }
                    wait-cancel => { root.wait-cancel(); }
                }
                // nothing in it yet: a dashed ring round the record dot, and what to do
                if root.chain-empty != 0: Rectangle {
                    x: (parent.width - Size.empty) / 2;
                    y: (parent.height - 118px) / 2; // art: the record dot's dashed ring, while it's empty
                    width: Size.empty;
                    height: 118px; // art: the record dot's dashed ring, while it's empty
                    Path {
                        x: (parent.width - 38px) / 2; // art: the record dot's dashed ring, while it's empty
                        y: 0;
                        width: 38px; // art: the record dot's dashed ring, while it's empty
                        height: 38px; // art: the record dot's dashed ring, while it's empty
                        viewbox-width: 38;
                        viewbox-height: 38;
                        commands: "M19.00 0.50A18.5 18.5 0 0 1 22.04 0.75M25.01 1.50A18.5 18.5 0 0 1 27.81 2.73M30.36 4.40A18.5 18.5 0 0 1 32.61 6.47M34.49 8.88A18.5 18.5 0 0 1 35.94 11.57M36.93 14.46A18.5 18.5 0 0 1 37.44 17.47M37.44 20.53A18.5 18.5 0 0 1 36.93 23.54M35.94 26.43A18.5 18.5 0 0 1 34.49 29.12M32.61 31.53A18.5 18.5 0 0 1 30.36 33.60M27.81 35.27A18.5 18.5 0 0 1 25.01 36.50M22.04 37.25A18.5 18.5 0 0 1 19.00 37.50M15.96 37.25A18.5 18.5 0 0 1 12.99 36.50M10.19 35.27A18.5 18.5 0 0 1 7.64 33.60M5.39 31.53A18.5 18.5 0 0 1 3.51 29.12M2.06 26.43A18.5 18.5 0 0 1 1.07 23.54M0.56 20.53A18.5 18.5 0 0 1 0.56 17.47M1.07 14.46A18.5 18.5 0 0 1 2.06 11.57M3.51 8.88A18.5 18.5 0 0 1 5.39 6.47M7.64 4.40A18.5 18.5 0 0 1 10.19 2.73M12.99 1.50A18.5 18.5 0 0 1 15.96 0.75";
                        fill: transparent;
                        stroke: Ink.edge;
                        stroke-width: 1px; // art: the record dot's dashed ring, while it's empty
                    }
                    Rectangle {
                        x: (parent.width - 11px) / 2; // art: the record dot's dashed ring, while it's empty
                        y: 13.5px; // art: the record dot's dashed ring, while it's empty
                        width: 11px; // art: the record dot's dashed ring, while it's empty
                        height: 11px; // art: the record dot's dashed ring, while it's empty
                        border-radius: self.width / 2;
                        background: Ink.record;
                    }
                    EmptyState {
                        y: 52px; // art: the record dot's dashed ring, while it's empty
                        width: parent.width;
                        title: root.chain-empty == 2 ? "Recording" : "No keys yet";
                        lines: root.empty-lines;
                    }
                }
            }
            ScrollBar {
                x: parent.width - Part.scroll-in;
                y: Space.inline;
                height: chain-flick.height - Space.inline;
                view: chain-flick.height;
                content: chain-flick.content-height;
                offset: -chain-flick.content-y;
                framed: false;
                thumb-color: Ink.edge;
                scroll-to(o) => { chain-flick.content-y = -o; }
            }
            // the tools, a toolbar's quiet buttons at the canvas's foot: the settings, Clear,
            // then what to add; how full it is, and Record
            HorizontalLayout {
                x: Space.inline;
                y: parent.height - tools-h + Space.inline;
                width: parent.width - 2 * Space.inline;
                height: Size.button;
                spacing: Space.list;
                cross-axis-alignment: center;
                IconButton {
                    width: Size.compact;
                    height: Size.compact;
                    icon: "M10.3 8a2.3 2.3 0 1 1-4.6 0a2.3 2.3 0 1 1 4.6 0zM8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4";
                    units: 16;
                    enabled: !root.tools-off;
                    clicked(x, y, h) => { root.tool(0, x, y, h, self.width); }
                }
                TextButton { text: "Clear"; enabled: root.can-clear; clicked => { root.tool(1, self.absolute-position.x, self.absolute-position.y, self.height, self.width); } }
                // (a rule between clearing and adding, Space.tight either side of it)
                Rectangle {
                    width: 2 * Space.tight + Stroke.line;
                    Rectangle { x: Space.tight; y: (parent.height - self.height) / 2; width: Stroke.line; height: Line.small; background: Ink.line; }
                }
                TextButton { text: "+ Key"; enabled: root.can-key; clicked => { root.tool(2, self.absolute-position.x, self.absolute-position.y, self.height, self.width); } }
                TextButton { text: "+ Media key"; enabled: root.can-media; clicked => { root.tool(3, self.absolute-position.x, self.absolute-position.y, self.height, self.width); } }
                TextButton { text: "+ Wait"; enabled: root.can-wait; clicked => { root.tool(4, self.absolute-position.x, self.absolute-position.y, self.height, self.width); } }
                if root.jobs-shown: TextButton { text: "+ Action"; enabled: root.can-jobs; clicked => { root.tool(6, self.absolute-position.x, self.absolute-position.y, self.height, self.width); } }
                if root.jobs-shown: TextButton { text: "+ Macro"; enabled: root.can-jobs; clicked => { root.tool(7, self.absolute-position.x, self.absolute-position.y, self.height, self.width); } }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.meter-text;
                    font-family: Font.ui;
                    font-size: Font.caption;
                    color: root.meter-warn ? Ink.warn : Ink.quiet;
                    vertical-alignment: center;
                }
                // (while it records, how long, in red, Space.inline either side)
                if root.recording: Rectangle { width: Space.inline; }
                if root.recording: Text {
                    text: root.rec-clock;
                    font-family: Font.ui;
                    font-size: Font.control;
                    color: Ink.bad;
                    vertical-alignment: center;
                }
                Rectangle { width: Space.inline; }
                RecordButton {
                    on: root.recording;
                    enabled: root.can-record;
                    clicked(x, y, h) => { root.tool(5, x, y, h, self.width); }
                }
            }
        }

        // the foot: how it plays, what was last done, Revert and Save, a gap under the canvas;
        // a line of controls at a button's height
        HorizontalLayout {
            x: Space.margin;
            y: parent.height - Space.margin - Size.button;
            width: parent.width - 2 * Space.margin;
            height: Size.button;
            spacing: Space.inline;
            cross-axis-alignment: center;
            Text { text: "Plays"; font-family: Font.ui; font-size: Font.caption; color: Ink.quiet; vertical-alignment: center; }
            DropField {
                width: 170px; // art: the Plays chooser, as wide as its longest choice
                height: Size.button;
                text: root.plays-text;
                enabled: root.plays-on;
                clicked(x, y, h) => { root.plays(x, y, h, self.width); }
            }
            if root.count-shown: FieldBox {
                width: 56px; // art: the count, as wide as its digits
                height: Size.button;
                centered: true;
                text <=> root.count-text;
                accepted => { root.count-done(self.text); }
                left => { root.count-done(self.text); }
            }
            if root.count-shown: Text { text: "times"; font-family: Font.ui; font-size: Font.control; color: Ink.dim; vertical-alignment: center; }
            if root.locked: Text {
                text: "This macro holds something the editor cannot rebuild exactly, so it is shown read only.";
                font-family: Font.ui;
                font-size: Font.note;
                color: Ink.quiet;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                text: root.status-text;
                font-family: Font.ui;
                font-size: Font.note;
                color: root.status-kind == 1 ? Ink.good : root.status-kind == 2 ? Ink.bad : Ink.quiet;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            WordButton {
                text: "Revert";
                enabled: root.can-revert;
                clicked => { root.revert(); }
            }
            WordButton {
                text: "Save macro";
                primary: true;
                enabled: root.can-save;
                clicked => { root.save(); }
            }
        }
    }

    // the step being dragged, following the pointer as the web page's drag image did
    if root.ghost-on: ChainPiece {
        c: root.ghost;
        opacity: 0.75;
    }

    // the open menu, over everything
    // the open menu turned `y` down as it opens (src/menu_size.rs's reveal)
    public function scroll-menu(y: length) {
        menu.scroll-to(y);
    }
    menu := Menu {
        marks: root.menu-marks;
        visible: root.menu-open;
        x: max(Space.inline, min(root.menu-ax, root.width - root.menu-w - Space.inline));
        width: root.menu-w;
        height: min(root.menu-natural, min(root.menu-max, root.height - root.menu-top - Space.inline));
        y: root.menu-top;
        rows: root.menu-rows;
        placeholder: root.menu-placeholder;
        back: root.menu-back;
        search: root.menu-search;
        query <=> root.menu-query;
        chose(i) => { root.menu-chose(i); }
        go-back => { root.menu-back-to(); }
        typed(t) => { root.menu-typed(t); }
        enter => { root.menu-enter(); }
        dismiss => { root.menu-dismiss(); }
        field-done(i, t) => { root.menu-field(i, t); }
    }

    // are you sure: a scrim over the window, and the question on it
    // are you sure: the question in a dialog, every window's; Escape is Cancel
    if root.confirm-open: Confirm {
        corner: root.radius;
        title: root.confirm-title;
        body: root.confirm-body;
        body2: root.confirm-body2;
        do: "Delete macro";
        cancel => { root.confirm-no(); }
        yes => { root.confirm-yes(); }
    }
}

// ------------------------------------------------------------------ the screen layout editor
// A layout in the editor's list: its name, the line saying what it shows, whether open.
export struct LayoutRow {
    name: string,
    about: string,
    on: bool,
}

// A block on the editor's screen: its first cell and its size in cells, whether
// selected, whether an effect; whether its corner can change its rows; and for each
// height it can have from one row on, the nearest column its corner may pull it in to
// (as narrow as it can be there) and how far its corner can reach (the column after its
// last free cell), so the corner stops at its neighbors and the screen's edges.
// An effect's tile in the Effect box: its name, its picture on the screen, and whether
// it is the one chosen (lit, and its picture moving).
export struct FxTile {
    name: string,
    pic: image,
    on: bool,
}

export struct EdBlock {
    row: int,
    col: int,
    width: int,
    height: int,
    on: bool,
    fx: bool,
    tall: bool,
    lows: [int],
    ends: [int],
}

// A kind of block's glyph, 12 across: 0 Text, 1 Data, 2 Bar, 3 Effect.
component BlockGlyph inherits Rectangle {
    in property <int> which;
    in property <color> tint;
    width: 12px;
    height: 12px;
    if root.which == 0: Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M2 2.5h8M6 2.5V10";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
    }
    if root.which == 1: Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M1.6 9.2a4.4 4.4 0 1 1 8.8 0M6 9.2l2.3-3";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.35px;
        stroke-line-cap: round;
    }
    if root.which == 2: Rectangle {
        Path {
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M2.5 3.4h7a1.5 1.5 0 0 1 1.5 1.5v2.2a1.5 1.5 0 0 1-1.5 1.5h-7a1.5 1.5 0 0 1-1.5-1.5v-2.2a1.5 1.5 0 0 1 1.5-1.5z";
            fill: transparent;
            stroke: root.tint;
            stroke-width: 1.2px;
        }
        Rectangle {
            x: 2.5px;
            y: 4.9px;
            width: 4.2px;
            height: 2.2px;
            border-radius: 0.5px;
            background: root.tint;
        }
    }
    if root.which == 3: Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M6 1.2l1.15 3.65L10.8 6 7.15 7.15 6 10.8 4.85 7.15 1.2 6l3.65-1.15z";
        fill: root.tint;
    }
}

// A kind of block in the bar over the screen, as a layout's bar on the playlist:
// selected, it goes into the first free cells that fit it; pressed and dragged, it
// is carried to the screen (where it is in the window, as it moves and as it is let go).
component BlockChip inherits Rectangle {
    in property <string> text;
    in property <int> which;
    in property <bool> lit;
    callback add();
    callback carry(length, length);
    callback drop(length, length);
    callback cancel();
    width: Size.block-chip;
    height: 24px; // art: a block's chip: its glyph and its name
    border-radius: Radius.small;
    background: root.lit ? Ink.edge : ta.has-hover ? Ink.pick-hover : Ink.pick;
    property <bool> far;
    BlockGlyph {
        x: 9px; // art: a block's chip: its glyph and its name
        y: 6px; // art: a block's chip: its glyph and its name
        which: root.which;
        tint: root.lit || ta.has-hover ? Ink.bright : Ink.soft;
    }
    Text {
        x: 28px; // art: a block's chip: its glyph and its name
        height: parent.height;
        text: root.text;
        font-family: Font.ui;
        font-size: Font.caption;
        color: root.lit || ta.has-hover ? Ink.bright : Ink.dim;
        vertical-alignment: center;
    }
    ta := TouchArea {
        // the finger, as on anything that can be selected; the closed hand once it is carried
        mouse-cursor: root.far ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.far = false;
            }
            if (e.kind == PointerEventKind.up) {
                if (root.far) {
                    root.far = false;
                    root.drop(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else if (e.button == PointerEventButton.left) {
                    root.add();
                }
            }
            if (e.kind == PointerEventKind.cancel && root.far) {
                root.far = false;
                root.cancel();
            }
        }
        moved => {
            if (self.pressed) {
                if (!root.far && (abs(self.mouse-x - self.pressed-x) > Part.drag || abs(self.mouse-y - self.pressed-y) > Part.drag)) {
                    root.far = true;
                }
                if (root.far) {
                    root.carry(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// A layout in the editor's list, a list's row: the one open lit, with the bar at its left.
component LayoutListRow inherits ListRow {
    in property <LayoutRow> r;
    name: root.r.name;
    sub: root.r.about;
    chosen: root.r.on;
    active: root.r.on;
}

// The screen layout editor, a window of its own as the Macro Editor is: the
// layouts down its left; the one open, its name and its menu; the bar of blocks
// joined to the top of the screen's box, with the layout's backlight and the grid
// at its end; the screen, its blocks outlined; under it, the box of the block
// selected. Changes save as they are made.
export component LayoutWindow inherits Window {
    // the keyboard whose screen this is, as its core names it
    in property <string> device-name: "EVGA Z10 RGB";
    in property <bool> is-maximized;
    in property <image> mark;
    in property <[LayoutRow]> rows;
    in-out property <length> list-scroll;
    // the layout open (none once every layout is deleted): its name, changed in place;
    // deleting it asks first, in the header's place
    in property <bool> has-layout: true;
    in property <string> name;
    in property <bool> editing-name;
    in-out property <string> name-text;
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-body;
    // the screen: its picture and the background round it, its blocks, its grid; a block
    // on its way in from the bar (the cells it would take), and its name under the pointer
    in property <image> picture;
    in property <color> field: #0a0908;  // art: the screen's own ground, until its core says
    in property <[EdBlock]> blocks;
    // the block selected (-1, none); its corner being dragged and how many cells wider and
    // rows taller so far; and whether it is being carried (its corner and × step aside)
    in property <int> sel-block: -1;
    in-out property <bool> corner-on;
    in-out property <int> corner-dw;
    in-out property <int> corner-dh;
    in-out property <bool> sel-moving;
    // the line in the bar after the blocks: how to add one, or that there's no room
    in property <string> bar-hint: "Drag a block onto the screen.";
    // counted up each time the layout has taken a block's move or new ends, so the
    // block dragged lets go of the drag even when nothing changed
    in property <int> settled;
    in property <bool> grid;
    in property <bool> ghost-on;
    in property <EdBlock> ghost;
    // an effect selected: the effects, as tiles in its box
    in property <[FxTile]> fx-tiles;
    callback fx-chose(int);
    in property <bool> carry-on;
    in property <string> carry-name;
    in property <int> carry-kind;
    in property <length> carry-x;
    in property <length> carry-y;
    in property <int> lit-chip: -1;
    // the layout's backlight: its own color, or the profile's default (whose color the
    // switch's dot shows); the color and its code; the picker open on it
    in property <bool> own-light;
    in property <color> default-light;
    in property <color> own-color;
    in property <string> own-hex;
    in property <bool> picking;
    // the box under the screen: 0 nothing selected, 1 text, 2 data, 3 bar; its title and
    // its cells; whether the layout has blocks yet
    in property <int> box-kind;
    in property <string> box-title;
    in property <[Cell]> box-cells;
    in property <length> box-h;
    in property <bool> has-blocks;
    // the open menu
    in property <bool> menu-open;
    // whether the open menu keeps a column for ticks (not when nothing in it is ticked)
    in property <bool> menu-marks: true;
    in property <length> menu-ax;
    in property <length> menu-w: Size.menu;
    in property <[MenuRow]> menu-rows;
    in property <length> menu-top;
    in property <length> menu-max;
    in property <length> menu-natural;
    out property <length> menu-x: menu.x;
    out property <length> menu-y: menu.y;
    out property <length> menu-width: menu.width;
    out property <length> menu-height: menu.height;
    out property <length> window-height: root.height;
    out property <length> window-width: root.width;
    // the color picker
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-top;
    out property <length> picker-height: picker.natural;
    in property <float> pk-hue;
    in property <float> pk-sat;
    in property <float> pk-val;
    in property <color> pk-now;
    in property <color> pk-pure;
    in property <image> pk-sv-img;
    in property <image> pk-hue-img;
    in-out property <string> pk-hex;
    in-out property <string> pk-r;
    in-out property <string> pk-g;
    in-out property <string> pk-b;
    in-out property <string> pk-h;
    in-out property <string> pk-s;
    in-out property <string> pk-v;
    in property <[color]> pk-presets;
    in property <[color]> pk-recent;
    // where the screen's cells are in the window, for a block carried from the bar
    out property <length> cells-x: lcd.absolute-position.x;
    out property <length> cells-y: lcd.absolute-position.y;
    out property <length> cell-w: lcd.width / 20;
    out property <length> cell-h: lcd.height / 4;

    callback minimize();
    callback maximize();
    callback close-window();
    callback drag();
    callback choose(int);
    // + New (or the empty window's New layout): its menu, hung from the button (where it is
    // and how wide)
    callback new-layout(length, length, length, length);
    callback rename();
    callback name-done(string);
    callback name-cancel();
    callback more(length, length, length);
    callback confirm-yes();
    callback confirm-no();
    callback block-chosen(int);
    callback block-moved(int, int, int);
    callback block-sized(int, int, int);
    callback block-remove();
    callback chip-add(int);
    callback chip-carry(int, length, length);
    callback chip-drop(int, length, length);
    callback chip-cancel();
    callback light-own(bool);
    callback light-color(length, length, length);
    callback grid-toggle();
    callback cell-pick(int, int, length, length, length, length);
    callback cell-left(int, int, bool);
    callback cell-slide(int, float);
    callback cell-typed(int, int, string);
    callback menu-chose(int);
    callback menu-dismiss();
    callback pk-sv(float, float);
    callback pk-hue-at(float);
    callback pk-field(int, string);
    callback pk-well(color);
    callback pk-enter();
    callback pk-dismiss();

    background: transparent;
    default-font-family: Font.ui;
    property <length> radius: root.is-maximized ? 0 : Radius.window;
    property <length> main-w: root.width - Size.sidebar;
    property <length> rig-w: main-w - 2 * Space.margin;
    // the screen holds the keyboard when a block on it is pressed, so a field in the box
    // lets go of it (and the window no longer counts as typing)
    keys := FocusScope { width: 0; height: 0; }
    function take-keys() {
        keys.focus();
        Typing.on = false;
    }

    // the title bar, every window's: where this window is
    TitleBar {
        y: 0;
        mark: root.mark;
        crumbs: [root.device-name, "Screen layouts"];
        corner: root.radius;
        drag => { root.drag(); }
        maximize => { root.maximize(); }
        minimize => { root.minimize(); }
        close => { root.close-window(); }
    }

    // the layouts
    Rectangle {
        x: 0;
        y: Size.title-bar;
        width: Size.sidebar;
        height: root.height - Size.title-bar;
        background: Ink.box;
        border-bottom-left-radius: root.radius;
        Text {
            x: Space.inline + Part.field-pad;
            y: (Size.bar - Size.compact) / 2;
            height: Size.compact;
            text: "All layouts";
            font-size: Font.text;
            font-weight: Font.medium;
            color: Ink.bright;
            vertical-alignment: center;
        }
        TextButton {
            x: parent.width - Space.row - self.width;
            y: (Size.bar - Size.compact) / 2;
            text: "+ New";
            clicked => { root.new-layout(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
        }
        Flickable {
            x: Space.inline;
            y: Size.bar - Space.tight;
            width: parent.width - 2 * Space.inline;
            height: parent.height - self.y - Space.inline;
            content-height: root.rows.length * (Size.row + Space.list);
            content-y <=> root.list-scroll;
            mouse-drag-pan-enabled: false;
            for r[i] in root.rows: LayoutListRow {
                y: i * (Size.row + Space.list);
                width: parent.width;
                r: r;
                clicked => { root.choose(i); }
            }
        }
    }

    // the layout open
    Rectangle {
        x: Size.sidebar;
        y: Size.title-bar;
        width: main-w;
        height: root.height - Size.title-bar;
        background: Ink.base;
        border-bottom-right-radius: root.radius;
        // its name, a pencil to change it, and its menu: its header, every editor's
        EditorHeader {
            visible: root.has-layout;
            y: 0;
            width: parent.width;
            name: root.name;
            renaming: root.editing-name;
            typed <=> root.name-text;
            rename => { root.rename(); }
            rename-done(t) => { root.name-done(t); }
            rename-cancel => { root.name-cancel(); }
            more(x, y, h) => { root.more(x, y, h); }
        }

        // the bar of blocks, joined to the top of the screen's box, as the playlist's panel
        // is to its foot; the layout's backlight and the grid at its end
        Rectangle {
            visible: root.has-layout;
            x: Space.margin;
            y: Size.bar;
            width: rig-w;
            height: Size.bar;
            border-top-left-radius: Radius.box;
            border-top-right-radius: Radius.box;
            background: Ink.box;
            for name[k] in ["Text", "Data", "Bar", "Effect"]: BlockChip {
                x: Space.pad + k * (Size.block-chip + Space.inline);
                y: (parent.height - self.height) / 2;
                text: name;
                which: k;
                lit: root.lit-chip == k;
                add => { root.chip-add(k); }
                carry(x, y) => { root.chip-carry(k, x, y); }
                drop(x, y) => { root.chip-drop(k, x, y); }
                cancel => { root.chip-cancel(); }
            }
            // (whole or not at all: in a narrow window it steps aside for the backlight)
            Text {
                x: Space.pad + 4 * (Size.block-chip + Space.inline) - Space.inline + Space.row;
                y: (parent.height - self.height) / 2;
                width: light-row.x - self.x - Space.pad;
                height: Line.text;
                visible: self.preferred-width <= self.width;
                text: root.bar-hint;
                font-family: Font.ui;
                font-size: Font.note;
                color: Ink.quiet;
                vertical-alignment: center;
            }
            // at the bar's right, compact and at its middle: the layout's backlight, Default
            // (the profile's, whose color the dot shows) or a color of the layout's own, as its
            // dot and its code, which open the picker; a hairline, then Grid, only the editor's
            // view
            light-row := HorizontalLayout {
                x: parent.width - Space.pad - self.width;
                y: (parent.height - self.height) / 2;
                width: self.preferred-width;
                height: Size.compact;
                spacing: Space.inline;
                Text {
                    text: "Backlight";
                    font-family: Font.ui;
                    font-size: Font.note;
                    color: Ink.soft;
                    vertical-alignment: center;
                }
                // (a switch, its choices as wide as their words)
                SegGround {
                    width: def-c.need + own-c.need + Part.seg-gap + 2 * Part.inset;
                    def-c := SegChoice {
                        x: Part.inset;
                        y: Part.inset;
                        width: self.need;
                        height: parent.height - 2 * Part.inset;
                        text: "Default";
                        swatched: true;
                        swatch: root.default-light;
                        on: !root.own-light;
                        clicked => { if (root.own-light) { root.light-own(false); } }
                    }
                    own-c := SegChoice {
                        x: def-c.x + def-c.width + Part.seg-gap;
                        y: Part.inset;
                        width: self.need;
                        height: parent.height - 2 * Part.inset;
                        text: "Own color";
                        on: root.own-light;
                        clicked => { if (!root.own-light) { root.light-own(true); } }
                    }
                }
                if root.own-light: ColorButton {
                    swatch: root.own-color;
                    code: root.own-hex;
                    open: root.picking;
                    clicked(x, y, h) => { root.light-color(x, y, h); }
                }
                Rectangle {
                    width: Stroke.line;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: Stroke.line;
                        height: Line.text;
                        background: Ink.line;
                    }
                }
                CheckBox {
                    width: self.preferred-width;
                    text: "Grid";
                    on: root.grid;
                    clicked => { root.grid-toggle(); }
                }
            }
        }
        // the bar's gray behind the box's top corners, where the two meet
        Rectangle {
            visible: root.has-layout;
            x: Space.margin;
            y: 2 * Size.bar - Radius.box;
            width: rig-w;
            height: 2 * Radius.box;
            background: Ink.box;
        }
        // the screen's box, and the bay the screen is set into, as on the Screen tab (the
        // screen's 20 by 4 cells square)
        screen-box := Rectangle {
            visible: root.has-layout;
            x: Space.margin;
            y: 2 * Size.bar;
            width: rig-w;
            height: bay.height + 2 * Space.pad;
            border-radius: Radius.box;
            background: Ink.well;
            bay := ScreenBay {
                x: (parent.width - self.width) / 2;
                y: Space.pad;
                screen-w: Size.edit-screen;
                screen-h: Size.edit-screen * 4 / 20;
                field: root.field;
                lcd := Rectangle {
                    x: bay.screen-x;
                    y: bay.screen-y;
                    width: bay.screen-w;
                    height: bay.screen-h;
                    Rectangle {
                        border-radius: Radius.tiny;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.picture;
                        }
                    }
                    // a press away from every block lets the selected one go (and takes the
                        // keyboard from any field in the box, so Delete is the screen's again)
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.take-keys();
                                root.block-chosen(-1);
                            }
                        }
                    }
                    // the screen's 20 by 4 cells
                    if root.grid: Rectangle {
                        for k in 19: Rectangle {
                            x: (k + 1) * parent.width / 20 - 0.5px; // art: the screen's cells' lines
                            width: 1px; // art: the screen's cells' lines
                            background: Ink.white.with-alpha(0.11);
                        }
                        for k in 3: Rectangle {
                            y: (k + 1) * parent.height / 4 - 0.5px; // art: the screen's cells' lines
                            height: 1px; // art: the screen's cells' lines
                            background: Ink.white.with-alpha(0.11);
                        }
                    }
                    // a block on its way in: the cells it would take
                    if root.ghost-on: Rectangle {
                        x: root.ghost.col * parent.width / 20 + 1px; // art: the cells a block on its way in would take
                        y: root.ghost.row * parent.height / 4 + 1px; // art: the cells a block on its way in would take
                        width: root.ghost.width * parent.width / 20 - 2px; // art: the cells a block on its way in would take
                        height: root.ghost.height * parent.height / 4 - 2px; // art: the cells a block on its way in would take
                        border-radius: 3px; // art: the cells a block on its way in would take
                        border-width: 1.5px; // art: the cells a block on its way in would take
                        border-color: Ink.white.with-alpha(0.69);
                        background: root.field.with-alpha(0.5);
                    }
                    // each block outlined; the one selected in amber (its corner glyph and × over
                    // every block, below). Dragged, a block follows the pointer cell by cell; its
                    // corner dragged takes the block wider or narrower (and words taller or
                    // shorter), as far as the free cells and the screen let it
                    for b[i] in root.blocks: blk := Rectangle {
                        property <length> cw: parent.width / 20;
                        property <length> ch: parent.height / 4;
                        // a move: how many cells across and down; the corner (the selected block's,
                        // dragged): how many cells wider and rows taller
                        property <int> dc: 0;
                        property <int> dr: 0;
                        property <int> dw: b.on ? root.corner-dw : 0;
                        property <int> dh: b.on ? root.corner-dh : 0;
                        property <bool> sizing: b.on && root.corner-on;
                        // carried by the pointer (past a few pixels from where it was pressed)
                        property <bool> moving: false;
                        property <int> at-col: max(0, min(20 - b.width, b.col + dc));
                        property <int> at-row: max(0, min(4 - b.height, b.row + dr));
                        // (the corner: as tall as asked within the rows the block can have, then
                        // as wide as that height's free cells let it, and no narrower than the
                        // block can be at that height)
                        property <int> s-h: max(1, min(b.ends.length, b.height + dh));
                        property <int> s-end: max(b.lows[s-h - 1], min(b.ends[s-h - 1], b.col + b.width + dw));
                        property <int> show-w: sizing ? s-end - b.col : b.width;
                        property <int> show-h: sizing ? s-h : b.height;
                        property <int> home: b.row * 10000 + b.col * 100 + b.width * 4 + b.height;
                        property <int> settled: root.settled;
                        changed home => { self.rest(); }
                        changed settled => { self.rest(); }
                        function rest() {
                            self.dc = 0;
                            self.dr = 0;
                            self.moving = false;
                            if (b.on) {
                                root.sel-moving = false;
                            }
                        }
                        // (sizing never moves the block's first cell)
                        x: at-col * cw;
                        y: at-row * ch;
                        width: show-w * cw;
                        height: show-h * ch;
                        // (an effect stays behind the other blocks, selected too, so the blocks on
                        // it can still be selected)
                        z: b.fx ? 0 : b.on ? 2 : 1;
                        // (the outline a pixel in from the block's cells, as the grid's lines are between them)
                        Rectangle {
                            x: 1px; // art: a block's outline, a pixel in
                            y: 1px; // art: a block's outline, a pixel in
                            width: parent.width - 2px; // art: a block's outline, a pixel in
                            height: parent.height - 2px; // art: a block's outline, a pixel in
                            border-radius: 3px; // art: a block's outline, a pixel in
                            border-width: b.on || move-ta.pressed ? 2px : 1px; // art: a block's outline, a pixel in
                            border-color: b.on || move-ta.pressed ? Ink.warn : move-ta.has-hover ? Ink.white.with-alpha(0.502) : Ink.white.with-alpha(0.2);
                            background: b.on && !b.fx ? Ink.warn.with-alpha(0.102) : move-ta.has-hover && !b.on ? Ink.glass : transparent;
                        }
                        // the finger, as on anything that can be selected; the closed hand only
                        // once the block is carried, and the finger again as it is let go
                        move-ta := TouchArea {
                            mouse-cursor: parent.moving ? MouseCursor.grabbing : MouseCursor.pointer;
                            // the pointer measured from where it was pressed: the outline moves
                            // with the drag, so how far it has moved already is added back
                            moved => {
                                if (abs(self.mouse-x - self.pressed-x + (parent.at-col - b.col) * cw) > Part.drag
                                    || abs(self.mouse-y - self.pressed-y + (parent.at-row - b.row) * ch) > Part.drag) {
                                    parent.moving = true;
                                }
                                parent.dc = round((self.mouse-x - self.pressed-x + (parent.at-col - b.col) * cw) / cw);
                                parent.dr = round((self.mouse-y - self.pressed-y + (parent.at-row - b.row) * ch) / ch);
                                if (b.on) {
                                    root.sel-moving = parent.moving;
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    // (the keyboard is the screen's while a block is pressed: Delete
                                    // removes the block rather than a letter in the box's field)
                                    root.take-keys();
                                    parent.dc = 0;
                                    parent.dr = 0;
                                    parent.moving = false;
                                }
                                if (e.kind == PointerEventKind.up) {
                                    parent.moving = false;
                                    root.sel-moving = false;
                                    if (parent.at-col != b.col || parent.at-row != b.row) {
                                        root.block-moved(i, parent.at-row, parent.at-col);
                                    } else {
                                        parent.rest();
                                        root.block-chosen(i);
                                    }
                                }
                            }
                        }
                    }
                    // the selected block's outline, corner glyph and × over every block: an effect
                    // stays behind the blocks on it, selected too, so they can still be selected,
                    // and its corner and × are still there to use (they step aside while the block
                    // is carried, and the × while the corner is dragged)
                    if root.sel-block >= 0 && root.sel-block < root.blocks.length && !root.sel-moving: sel := Rectangle {
                        property <EdBlock> sb: root.blocks[root.sel-block];
                        property <length> cw: parent.width / 20;
                        property <length> ch: parent.height / 4;
                        property <int> s-h: max(1, min(sb.ends.length, sb.height + root.corner-dh));
                        property <int> s-end: max(sb.lows[s-h - 1], min(sb.ends[s-h - 1], sb.col + sb.width + root.corner-dw));
                        property <int> show-w: root.corner-on ? s-end - sb.col : sb.width;
                        property <int> show-h: root.corner-on ? s-h : sb.height;
                        property <int> home: sb.row * 10000 + sb.col * 100 + sb.width * 4 + sb.height;
                        property <int> settled: root.settled;
                        changed home => { self.rest(); }
                        changed settled => { self.rest(); }
                        function rest() {
                            root.corner-on = false;
                            root.corner-dw = 0;
                            root.corner-dh = 0;
                        }
                        // the corner let go: the block's new size, or, back where it started, as it was
                        function let-go() {
                            if (self.show-w != sb.width || self.show-h != sb.height) {
                                root.block-sized(root.sel-block, self.show-w, self.show-h);
                            } else {
                                self.rest();
                            }
                        }
                        x: sb.col * cw;
                        y: sb.row * ch;
                        width: show-w * cw;
                        height: show-h * ch;
                        z: 3;
                        Rectangle {
                            x: 1px; // art: the selected block's corner and its ×
                            y: 1px; // art: the selected block's corner and its ×
                            width: parent.width - 2px; // art: the selected block's corner and its ×
                            height: parent.height - 2px; // art: the selected block's corner and its ×
                            border-radius: 3px; // art: the selected block's corner and its ×
                            border-width: 2px; // art: the selected block's corner and its ×
                            border-color: Ink.warn;
                        }
                        // the corner glyph: an L of twice the outline's weight on the outline's own
                        // line round the bottom right corner (the line's middle is 2 px in from the
                        // block's edge), drawn as two bars so it lands on the line's own pixels:
                        // square where they meet, rounded at their far ends. With room round it to
                        // press
                        Rectangle {
                            x: parent.width - 2px - 12px; // art: the selected block's corner and its ×
                            y: parent.height - 2px - 12px; // art: the selected block's corner and its ×
                            width: 24px; // art: the selected block's corner and its ×
                            height: 24px; // art: the selected block's corner and its ×
                            property <color> ink: corner-ta.has-hover || corner-ta.pressed ? Ink.warn.mix(Ink.white, 0.8) : Ink.warn;
                            // (the corner's middle, at 12 in the box, on the line's middle)
                            Rectangle {
                                x: 12px - 14px; // art: the selected block's corner and its ×
                                y: 12px - 2px; // art: the selected block's corner and its ×
                                width: 16px; // art: the selected block's corner and its ×
                                height: 4px; // art: the selected block's corner and its ×
                                border-top-left-radius: self.height / 2;
                                border-bottom-left-radius: self.height / 2;
                                background: parent.ink;
                            }
                            Rectangle {
                                x: 12px - 2px; // art: the selected block's corner and its ×
                                y: 12px - 14px; // art: the selected block's corner and its ×
                                width: 4px; // art: the selected block's corner and its ×
                                height: 16px; // art: the selected block's corner and its ×
                                border-top-left-radius: self.width / 2;
                                border-top-right-radius: self.width / 2;
                                background: parent.ink;
                            }
                            // (the corner moves with the size, so how far it has moved already is
                            // added back, as for the block itself)
                            corner-ta := TouchArea {
                                mouse-cursor: sel.sb.tall ? MouseCursor.nwse-resize : MouseCursor.ew-resize;
                                moved => {
                                    root.corner-on = true;
                                    root.corner-dw = round((self.mouse-x - self.pressed-x + (sel.show-w - sel.sb.width) * sel.cw) / sel.cw);
                                    root.corner-dh = round((self.mouse-y - self.pressed-y + (sel.show-h - sel.sb.height) * sel.ch) / sel.ch);
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up && root.corner-on) {
                                        sel.let-go();
                                    }
                                }
                            }
                        }
                        // its ×: a ring of the outline's weight round the screen's dark, centered on
                        // the outline's top right corner and filled with amber under the pointer (it
                        // steps aside while the corner is dragged)
                        if !root.corner-on: Rectangle {
                            x: parent.width - 2px - 12px; // art: the selected block's corner and its ×
                            y: 2px - 12px; // art: the selected block's corner and its ×
                            width: 24px; // art: the selected block's corner and its ×
                            height: 24px; // art: the selected block's corner and its ×
                            Rectangle {
                                x: 4px; // art: the selected block's corner and its ×
                                y: 4px; // art: the selected block's corner and its ×
                                width: 16px; // art: the selected block's corner and its ×
                                height: 16px; // art: the selected block's corner and its ×
                                border-radius: self.width / 2;
                                background: x-ta.has-hover ? Ink.warn : root.field;
                                border-width: 2px; // art: the selected block's corner and its ×
                                border-color: Ink.warn;
                                Path {
                                    width: 7px; // art: the selected block's corner and its ×
                                    height: 7px; // art: the selected block's corner and its ×
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: "M1.5 1.5l7 7M8.5 1.5l-7 7";
                                    fill: transparent;
                                    stroke: x-ta.has-hover ? Ink.base : Ink.warn;
                                    stroke-width: 1.6px; // art: the selected block's corner and its ×
                                    stroke-line-cap: round;
                                }
                            }
                            x-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.block-remove(); }
                            }
                        }
                    }
                }
            }
        }

        // the box under the screen: the block selected, named for its kind; Remove at its
        // title's line, its words ending at the box's padding
        PageBox {
            visible: root.has-layout;
            x: Space.margin;
            y: 2 * Size.bar + screen-box.height + Space.gap;
            width: (rig-w - Space.gap) / 2;
            height: root.box-h;
            title: root.box-title;
            if root.box-kind != 0: LinkButton {
                x: parent.width - Space.pad + Part.quiet-pad - self.width;
                y: Part.title-top + (Line.title - self.height) / 2;
                text: "Remove";
                clicked => { root.block-remove(); }
            }
            // nothing selected: what each block is for (screen_edit.rs reckons the box's
            // height from the same lines)
            if root.box-kind == 0: Rectangle {
                if root.has-blocks: Text {
                    x: Space.pad;
                    y: Size.box-head;
                    height: Line.note;
                    text: "Select a block on the screen to change the block.";
                    font-size: Font.note;
                    color: Ink.quiet;
                }
                for g[k] in [
                    { name: "Text", says: "Words you type, like a label or a greeting." },
                    { name: "Data", says: "A reading, such as the time, the date or the CPU temperature." },
                    { name: "Bar", says: "A bar that fills as a reading rises." },
                ]: Rectangle {
                    x: Space.pad;
                    y: Size.box-head + (root.has-blocks ? Line.note + Space.row : 0) + k * (Line.note + Space.row);
                    width: parent.width - 2 * Space.pad;
                    height: Line.note;
                    BlockGlyph {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        which: k;
                        tint: Ink.soft;
                    }
                    Text {
                        x: 22px; // art: a block kind's glyph, name and what it says
                        height: parent.height;
                        text: g.name;
                        font-size: Font.note;
                        font-weight: Font.medium;
                        color: Ink.dim;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 22px + 58px; // art: a block kind's glyph, name and what it says
                        width: parent.width - self.x;
                        height: parent.height;
                        text: g.says;
                        font-size: Font.note;
                        color: Ink.quiet;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            // an effect selected: the effects as tiles, four to a row, built as the Lighting
            // tab's Effect grid is: each a well with its picture under a film and its name, the
            // chosen one lit and only its picture moving
            if root.box-kind == 4: Rectangle {
                property <length> tw: (self.width - 2 * Space.pad - 3 * Space.inline) / 4;
                for t[k] in root.fx-tiles: EffectTile {
                    x: Space.pad + mod(k, 4) * (parent.tw + Space.inline);
                    y: Size.box-head + floor(k / 4) * (Size.tile + Space.inline);
                    width: parent.tw;
                    name: t.name;
                    icon: t.pic;
                    on: t.on;
                    screen: true;
                    clicked => { root.fx-chose(k); }
                }
            }
            for c in root.box-cells: CellView {
                c: c;
                pick(id, index, x, y, h, w) => { root.cell-pick(id, index, x, y, h, w); }
                field-left(id, index, kept) => { root.cell-left(id, index, kept); }
                slide(id, v) => { root.cell-slide(id, v); }
                typed(id, index, t) => { root.cell-typed(id, index, t); }
            }
        }

        // no layout left to open: what the keyboard shows meanwhile, and a new one
        if !root.has-layout: EmptyState {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 40px; // art: a little above the middle
            height: self.preferred-height;
            title: "No screen layouts";
            text: "The keyboard’s screen stays blank until a playlist has a layout to show.";
            HorizontalLayout {
                padding-top: Space.label;
                alignment: center;
                WordButton {
                    primary: true;
                    text: "New layout";
                    clicked => { root.new-layout(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                }
            }
        }
    }

    // a block carried from the bar: its name and its glyph, under the pointer and clear of it
    if root.carry-on: CarryChip {
        x: root.carry-x + Space.pad;
        y: root.carry-y + Space.row;
        text: root.carry-name;
        VerticalLayout {
            alignment: center;
            BlockGlyph {
                which: root.carry-kind;
                tint: Ink.dim;
            }
        }
    }

    // the open menu, over everything
    // the open menu turned `y` down as it opens (src/menu_size.rs's reveal)
    public function scroll-menu(y: length) {
        menu.scroll-to(y);
    }
    menu := Menu {
        marks: root.menu-marks;
        visible: root.menu-open;
        x: max(Space.inline, min(root.menu-ax, root.width - root.menu-w - Space.inline));
        width: root.menu-w;
        height: min(root.menu-natural, min(root.menu-max, root.height - root.menu-top - Space.inline));
        y: root.menu-top;
        rows: root.menu-rows;
        search: false;
        chose(i) => { root.menu-chose(i); }
        dismiss => { root.menu-dismiss(); }
    }

    picker := Picker {
        visible: root.picker-open;
        x: max(Space.inline, min(root.picker-x, root.width - Size.picker - Space.inline));
        y: root.picker-top;
        height: root.picker-height;
        hue: root.pk-hue;
        sat: root.pk-sat;
        val: root.pk-val;
        now: root.pk-now;
        pure: root.pk-pure;
        sv-img: root.pk-sv-img;
        hue-img: root.pk-hue-img;
        t-hex <=> root.pk-hex;
        t-r <=> root.pk-r;
        t-g <=> root.pk-g;
        t-b <=> root.pk-b;
        t-h <=> root.pk-h;
        t-s <=> root.pk-s;
        t-v <=> root.pk-v;
        presets: root.pk-presets;
        recent: root.pk-recent;
        sv(x, y) => { root.pk-sv(x, y); }
        hue-at(x) => { root.pk-hue-at(x); }
        field(i, t) => { root.pk-field(i, t); }
        well(c) => { root.pk-well(c); }
        enter => { root.pk-enter(); }
        dismiss => { root.pk-dismiss(); }
    }

    // are you sure: the question in a dialog, every window's; Escape is Cancel
    if root.confirm-open: Confirm {
        corner: root.radius;
        title: root.confirm-title;
        body: root.confirm-body;
        do: "Delete layout";
        cancel => { root.confirm-no(); }
        yes => { root.confirm-yes(); }
    }
}

// The stage of the lab: a section's drawing of the key, with the
// line from each slider to its part, drawn in Rust at the window's own pixels;
// its words are cells over it.
export struct Sketch {
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
}

// One of the lab's sliders, where it stands beside the drawing: its
// name, its box and unit (a derived one, as a beam's angle, quieter), its
// knob along its track, where it was saved, if it has moved from there,
// whether its value is other than the saved one, which its reset puts back,
// and, for a share, what each end of its track stands for
export struct LabRow {
    x: length,
    y: length,
    w: length,
    id: int,
    name: string,
    hot: bool,
    number: string,
    unit: string,
    derived: bool,
    at: float,
    was: float,
    moved: bool,
    changed: bool,
    low: string,
    high: string,
}

// A slider of the lab: the whole row tells the page when the
// pointer is over it, so its line and its part light up whether the pointer
// is on its name, its box or its track.
component LabControl inherits Rectangle {
    in property <LabRow> r;
    callback slide(int, float);
    callback reset(int);
    callback entered(int, string);
    callback hovered(int, bool);
    callback focused(int, bool);
    x: root.r.x - 10px; // art: a lab slider's row
    y: root.r.y - 7px; // art: a lab slider's row
    width: root.r.w + 20px; // art: a lab slider's row
    height: root.r.low != "" ? 76px : 62px; // art: a lab slider's row
    border-radius: Radius.panel;
    background: root.r.hot ? Ink.white.with-alpha(0.043) : transparent;
    zone := TouchArea {
        changed has-hover => { root.hovered(root.r.id, self.has-hover); }
        Text {
            x: 10px; // art: a lab slider's row
            y: 7px; // art: a lab slider's row
            height: 26px; // art: a lab slider's row
            text: root.r.name;
            font-family: Font.ui;
            font-size: Font.text;
            color: root.r.hot ? Ink.bright : Ink.dim;
            vertical-alignment: center;
        }
        CellView {
            c: { kind: 15, x: root.r.w + 10px - 58px - 7px - 60px, y: 7px, w: 60px, h: 26px, text: root.r.number, id: root.r.id }; // art: a lab slider's row
            entered(id, t) => { root.entered(id, t); }
            focused(id, on) => { root.focused(id, on); }
        }
        Text {
            x: root.r.w + 10px - 58px; // art: a lab slider's row
            y: 7px; // art: a lab slider's row
            width: 58px; // art: a lab slider's row
            height: 26px; // art: a lab slider's row
            text: root.r.unit;
            font-family: Font.ui;
            font-size: Font.control;
            color: root.r.derived ? Ink.quiet : Ink.soft;
            vertical-alignment: center;
        }
        // its track, short of the reset at its end
        CellView {
            c: { kind: 3, x: 10px, y: 39px, w: root.r.w - 26px, h: 16px, value: root.r.at, id: root.r.id }; // art: a lab slider's row
            slide(id, v) => { root.slide(id, v); }
            reset(id) => { root.reset(id); }
        }
        // what each end of its track stands for, under its ends
        if root.r.low != "": Text {
            x: 10px; // art: a lab slider's row
            y: 55px; // art: a lab slider's row
            height: 14px; // art: a lab slider's row
            text: root.r.low;
            font-family: Font.ui;
            font-size: Font.caption;
            color: root.r.hot ? Ink.dim : Ink.soft;
            vertical-alignment: center;
        }
        if root.r.high != "": Text {
            x: 10px; // art: a lab slider's row
            y: 55px; // art: a lab slider's row
            width: root.r.w - 26px; // art: a lab slider's row
            height: 14px; // art: a lab slider's row
            text: root.r.high;
            font-family: Font.ui;
            font-size: Font.caption;
            color: root.r.hot ? Ink.dim : Ink.soft;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        // where it was saved, on its track
        if root.r.moved: Rectangle {
            x: 10px + 8px + root.r.was * (root.r.w - 26px - 16px) - 1px; // art: a lab slider's row
            y: 41px; // art: a lab slider's row
            width: 2px; // art: a lab slider's row
            height: 12px; // art: a lab slider's row
            border-radius: self.width / 2;
            background: Ink.placeholder;
        }
        // its reset, at the end of its track: the arrow alone, as gray as the
        // track while the value is the saved one, brighter once it differs,
        // and brighter still under the pointer; a click puts the value back
        Path {
            x: 10px + root.r.w - 18px; // art: a lab slider's row
            y: 40px; // art: a lab slider's row
            width: 14px; // art: a lab slider's row
            height: 14px; // art: a lab slider's row
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5";
            fill: transparent;
            stroke: !root.r.changed ? Ink.track : back.has-hover ? Ink.bright : Ink.soft;
            stroke-width: 1.4px; // art: a lab slider's row
        }
        back := TouchArea {
            x: 10px + root.r.w - 22px; // art: a lab slider's row
            y: 36px; // art: a lab slider's row
            width: 22px; // art: a lab slider's row
            height: 22px; // art: a lab slider's row
            // (nothing to put back at the saved value)
            enabled: root.r.changed;
            mouse-cursor: pointer;
            changed has-hover => { root.hovered(root.r.id + 1000, self.has-hover); }
            clicked => { root.reset(root.r.id); }
        }
    }
}

// The lab: a developer's window for tuning how the Z10's keys are
// lit, beside the main window so the keyboard stays in view as it changes.
// Landscape, one section at a time: its drawing in the middle, its sliders
// round it, the line under it saying what the slider under the pointer does,
// and what is on the keyboard now read out by Save.
export component LabWindow inherits Window {
    in property <bool> is-maximized;
    // the device the lab tunes, for its title bar
    in property <string> device-name: "EVGA Z10 RGB";
    // the lab's name for the device: its kind's (Keyboard lab, Mouse lab)
    in property <string> lab-name: "Keyboard lab";
    in property <image> mark;
    in property <[Cell]> cells;
    in property <[Sketch]> sketches;
    in property <[Cell]> over;
    in property <[LabRow]> rows;
    in property <[Cell]> foot;
    in property <string> status-text;
    in property <int> status-kind;
    // the most room what was last done takes, its words wrapping past it
    in property <length> status-room;
    in property <bool> can-save;
    in property <bool> can-revert;
    // Save's words, and its width: where it saves, the core or the light setup in use
    in property <string> save-text: "Save to the core";
    in property <length> save-w;
    // the button that puts the section on screen back as Default has it: its words, and whether there is anything to put back
    in property <string> default-text: "Reset";
    in property <bool> can-default;
    // whether there is one: a setup of the person's own is tuned, not Default itself
    in property <bool> has-default;
    // what is over everything on the page: the light setups' menu, open
    in property <[Cell]> top;
    // the chosen key's text boxes, a list of their own
    in property <[Cell]> boxes;
    out property <length> window-width: root.width;
    out property <length> window-height: root.height;

    callback minimize();
    callback maximize();
    callback close-window();
    callback drag();
    callback slide(int, float);
    callback entered(int, string);
    callback revert();
    callback save();
    // a section chosen; a slider or a reading under the pointer; a slider's box typed in;
    // Hold to compare held or let go; a slider put back
    callback pick(int, int);
    callback compare(bool);
    callback reset(int);
    callback pad(int, float, float);
    callback hovered(int, bool);
    callback focused(int, bool);
    // the typefaces' list's place on the page (none while it is shut), and the wheel turning it
    in property <length> list-x;
    in property <length> list-y;
    in property <length> list-w;
    in property <length> list-h;
    callback list-scroll(float);
    // the color picker, as the main window's, hung from the cap color's button that opened it
    in property <bool> picker-open;
    in property <length> picker-x;
    in property <length> picker-top;
    in property <float> pk-hue;
    in property <float> pk-sat;
    in property <float> pk-val;
    in property <color> pk-now;
    in property <color> pk-pure;
    in property <image> pk-sv-img;
    in property <image> pk-hue-img;
    in-out property <string> pk-hex;
    in-out property <string> pk-r;
    in-out property <string> pk-g;
    in-out property <string> pk-b;
    in-out property <string> pk-h;
    in-out property <string> pk-s;
    in-out property <string> pk-v;
    in property <[color]> pk-presets;
    in property <[color]> pk-recent;
    out property <length> picker-height: picker.natural;
    callback pk-sv(float, float);
    callback pk-hue-at(float);
    callback pk-field(int, string);
    callback pk-well(color);
    callback pk-enter();
    callback pk-dismiss();

    // the open menu: the setups', or the lights' list
    in property <bool> menu-open;
    in property <bool> menu-marks: true;
    in property <length> menu-ax;
    in property <length> menu-w: Size.menu;
    in property <[MenuRow]> menu-rows;
    in property <length> menu-top;
    in property <length> menu-max;
    in property <length> menu-natural;
    out property <length> menu-x: menu.x;
    out property <length> menu-y: menu.y;
    out property <length> menu-width: menu.width;
    out property <length> menu-height: menu.height;
    callback menu-chose(int);
    callback menu-dismiss();
    // a setup's name being given (1: Save as a new setup, Rename) or a delete asked about (2)
    in property <int> ask;
    in property <string> ask-title;
    in property <string> ask-text;
    in property <string> ask-go;
    in-out property <string> ask-name;
    // what's wrong with the name typed (none yet, or one already used)
    in property <string> ask-warn;
    callback ask-typed(string);
    callback ask-done(bool);

    background: transparent;
    default-font-family: Font.ui;
    property <length> radius: root.is-maximized ? 0 : Radius.window;

    // the title bar, every window's: where this window is
    TitleBar {
        y: 0;
        mark: root.mark;
        crumbs: [root.device-name, root.lab-name];
        corner: root.radius;
        drag => { root.drag(); }
        maximize => { root.maximize(); }
        minimize => { root.minimize(); }
        close => { root.close-window(); }
    }

    // the page: its head and sections, the stage, the line under it
    Rectangle {
        y: Size.title-bar;
        height: root.height - Size.title-bar - Size.foot;
        background: Ink.base;
        for c in root.cells: CellView {
            c: c;
            pick(id, i, x, y, h, w) => { root.pick(id, i); }
            hovered(id, on) => { root.hovered(id, on); }
        }
        for s in root.sketches: Image {
            x: s.x;
            y: s.y;
            width: s.w;
            height: s.h;
            source: s.image;
        }
        // the typefaces' list, open: turned by the wheel anywhere on it
        TouchArea {
            x: root.list-x;
            y: root.list-y;
            width: root.list-w;
            height: root.list-h;
            scroll-event(e) => {
                root.list-scroll(e.delta-y / 1px);
                accept
            }
        }
        // the words on the stage, and the section's choices over it
        for c in root.over: CellView {
            c: c;
            pick(id, i, x, y, h, w) => { root.pick(id, i); }
            hovered(id, on) => { root.hovered(id, on); }
            pad(id, x, y) => { root.pad(id, x, y); }
            typed(id, t) => { root.entered(id, t); }
        }
        for c in root.boxes: CellView {
            c: c;
            pick(id, i, x, y, h, w) => { root.pick(id, i); }
            typed(id, t) => { root.entered(id, t); }
            focused(id, on) => { root.focused(id, on); }
        }
        for r in root.rows: LabControl {
            r: r;
            slide(id, v) => { root.slide(id, v); }
            reset(id) => { root.reset(id); }
            entered(id, t) => { root.entered(id, t); }
            hovered(id, on) => { root.hovered(id, on); }
            focused(id, on) => { root.focused(id, on); }
        }
        for c in root.top: CellView {
            c: c;
            pick(id, i, x, y, h, w) => { root.pick(id, i); }
            hovered(id, on) => { root.hovered(id, on); }
            typed(id, t) => { root.entered(id, t); }
        }
        picker := Picker {
            visible: root.picker-open;
            x: max(Space.inline, min(root.picker-x, root.width - Size.picker - Space.inline));
            y: root.picker-top;
            height: root.picker-height;
            hue: root.pk-hue;
            sat: root.pk-sat;
            val: root.pk-val;
            now: root.pk-now;
            pure: root.pk-pure;
            sv-img: root.pk-sv-img;
            hue-img: root.pk-hue-img;
            t-hex <=> root.pk-hex;
            t-r <=> root.pk-r;
            t-g <=> root.pk-g;
            t-b <=> root.pk-b;
            t-h <=> root.pk-h;
            t-s <=> root.pk-s;
            t-v <=> root.pk-v;
            presets: root.pk-presets;
            recent: root.pk-recent;
            sv(x, y) => { root.pk-sv(x, y); }
            hue-at(x) => { root.pk-hue-at(x); }
            field(i, t) => { root.pk-field(i, t); }
            well(c) => { root.pk-well(c); }
            enter => { root.pk-enter(); }
            dismiss => { root.pk-dismiss(); }
        }
    }

    // the foot: what is on the keyboard now, what was last done, Revert and Save
    Rectangle {
        y: root.height - Size.foot;
        height: Size.foot;
        background: Ink.base;
        border-bottom-left-radius: root.radius;
        border-bottom-right-radius: root.radius;
        Rectangle {
            x: Space.margin;
            y: 0;
            width: parent.width - 2 * Space.margin;
            height: Stroke.line;
            background: Ink.line;
        }
        for c in root.foot: CellView {
            c: c;
            hovered(id, on) => { root.hovered(id, on); }
        }
        // (a line of buttons at the foot's middle, the page's margin in)
        HorizontalLayout {
            x: Space.margin;
            y: (parent.height - self.height) / 2;
            width: parent.width - 2 * Space.margin;
            height: self.preferred-height;
            spacing: Space.inline;
            cross-axis-alignment: center;
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: root.status-text;
                font-size: Font.note;
                color: root.status-kind == 1 ? Ink.good : root.status-kind == 2 ? Ink.bad : Ink.quiet;
                vertical-alignment: center;
                horizontal-alignment: right;
                max-width: max(0px, root.status-room);
                wrap: word-wrap;
            }
            WordButton {
                text: "Hold to compare";
                enabled: root.can-revert;
                changed down => { root.compare(self.down); }
            }
            if root.has-default: WordButton {
                text: root.default-text;
                enabled: root.can-default;
                clicked => { root.pick(1610, 0); }
                changed hover => { root.hovered(1610, self.hover); }
            }
            WordButton {
                text: "Revert";
                enabled: root.can-revert;
                clicked => { root.revert(); }
            }
            WordButton {
                wide: root.save-w;
                text: root.save-text;
                primary: true;
                enabled: root.can-save;
                clicked => { root.save(); }
            }
        }
    }

    // the open menu, over everything
    // the open menu turned `y` down as it opens (src/menu_size.rs's reveal)
    public function scroll-menu(y: length) {
        menu.scroll-to(y);
    }
    menu := Menu {
        marks: root.menu-marks;
        visible: root.menu-open;
        x: max(Space.inline, min(root.menu-ax, root.width - root.menu-w - Space.inline));
        width: root.menu-w;
        height: min(root.menu-natural, min(root.menu-max, root.height - root.menu-top - Space.inline));
        y: root.menu-top;
        rows: root.menu-rows;
        search: false;
        chose(i) => { root.menu-chose(i); }
        dismiss => { root.menu-dismiss(); }
    }

    // a setup's name: Save as a new setup, or Rename, in a dialog
    if root.ask == 1: FormDialog {
        corner: root.radius;
        cancel => { root.ask-done(false); }
        across: Size.ask;
        title: root.ask-title;
        go: root.ask-go;
        go-pressed => { root.ask-done(true); }
        VerticalLayout {
            spacing: Space.tight;
            FieldBox {
                text <=> root.ask-name;
                edited => { root.ask-typed(self.text); }
                accepted => { root.ask-done(true); }
                escape => { root.ask-done(false); }
                init => { self.start-typing(); }
            }
            if root.ask-warn != "": FormWarning { text: root.ask-warn; }
            if root.ask-text != "": FormNote { text: root.ask-text; }
        }
    }

    // a setup to delete: asked first, as everything that deletes is
    if root.ask == 2: Confirm {
        corner: root.radius;
        title: root.ask-title;
        body: root.ask-text;
        do: root.ask-go;
        cancel => { root.ask-done(false); }
        yes => { root.ask-done(true); }
    }

}
