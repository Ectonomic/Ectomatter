    in property <int> lib-reveal-n;
    // Undo offered beside "Saved", for a moment after a change
    in property <bool> undo-shown;
    callback undo(bool);
    in property <[EffectItem]> effects;
    // the chosen effect's picture moves
    in property <bool> effect-moves;
    // the pointer over an area on the Lighting page: the keyboard dims around it
