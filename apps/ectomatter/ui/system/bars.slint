// The bars across the top of every window and page, and the line under a page's
// bar. Each is drawn here once, from the tokens, so every window and every page
// opens the same way.

import { Space, Radius, Font, Line, Size, Part, Shadow, Ink } from "tokens.slint";
import { WinButton, Tab, LinkButton, PencilButton, MoreButton, RenameField } from "controls.slint";
import { Typing } from "state.slint";

// a dot that says how something is: 0 not known or not there, 1 good, 2 a
// problem, 3 a warning
export component Dot inherits Rectangle {
    in property <int> state;
    width: Size.dot;
    height: Size.dot;
    border-radius: self.height / 2;
    background: root.state == 1 ? Ink.good : root.state == 2 ? Ink.bad : root.state == 3 ? Ink.warn : Ink.off;
}

// A window's title bar, the same on every window: the mark and the wordmark,
// where the window is (its crumbs, each after a slash), then the window's own
// buttons. Dragging it moves the window; a double click maximizes it.
export component TitleBar inherits Rectangle {
    in property <image> mark;
    in property <[string]> crumbs;
    // the window's corners (none while it's maximized), which the bar's top follows
    in property <length> corner;
    callback drag();
    callback maximize();
    callback minimize();
    callback close();
    height: Size.title-bar;
    background: Ink.title;
    border-top-left-radius: root.corner;
    border-top-right-radius: root.corner;
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag();
            }
        }
        double-clicked => { root.maximize(); }
    }
    // the mark, Space.row in, and the wordmark Part.glyph-gap after it
    mark-i := Image {
        x: Space.row;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.mark;
    }
    wordmark := Text {
        x: mark-i.x + mark-i.width + Part.glyph-gap;
        height: root.height;
        text: "Ectomatter";
        font-family: Font.ui;
        font-weight: Font.strong;
        font-size: Font.text;
        letter-spacing: -0.54px;
        color: Ink.bright;
        vertical-alignment: center;
    }
    // where the window is, Space.pad after the wordmark, each crumb after a slash
    if root.crumbs.length > 0: HorizontalLayout {
        x: wordmark.x + wordmark.preferred-width + Space.pad;
        width: self.preferred-width;
        height: root.height;
        spacing: Part.glyph-gap;
        for c[i] in root.crumbs: HorizontalLayout {
            spacing: Part.glyph-gap;
            if i > 0: Text {
                text: "/";
                font-family: Font.ui;
                font-size: Font.control;
                color: Ink.edge;
                vertical-alignment: center;
            }
            Text {
                text: c;
                font-family: Font.ui;
                font-size: Font.control;
                color: Ink.dim;
                vertical-alignment: center;
            }
        }
    }
    win-row := HorizontalLayout {
        x: parent.width - self.width;
        width: self.preferred-width;
        WinButton {
            commands: "M3 8h10";
            clicked => { root.minimize(); }
        }
        WinButton {
            size: 12px;
            commands: "M3.5 2.5h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z";
            clicked => { root.maximize(); }
        }
        WinButton {
            danger: true;
            corner: root.corner;
            commands: "M3.5 3.5l9 9M12.5 3.5l-9 9";
            clicked => { root.close(); }
        }
    }
}

// A page's bar, the same on every page: its name (a device's after its
// connection's dot, a page's after the way back to where it opened from), its
// tabs with the chosen one underlined, what was last done or what went wrong,
// Undo for a moment after a change, and the page's own buttons at its end (its
// children). Its sides are the page's margin, so its name starts where the
// page's hint, stage and boxes do.
export component PageBar inherits Rectangle {
    in property <string> title;
    // the connection's dot before the name: -1 none, else as a Dot's state
    in property <int> dot: -1;
    // the way back before the name (the Library, from a game's page)
    in property <string> back;
    callback back-clicked();
    in property <[string]> tabs;
    // the chosen tab, by its place in `tabs`
    in property <int> tab;
    callback tab-chosen(int);
    in property <string> status;
    in property <bool> status-bad;
    in property <bool> undo-shown;
    callback undo();
    height: Size.bar;
    background: Ink.base;
    HorizontalLayout {
        padding-left: Space.margin;
        padding-right: Space.margin;
        spacing: Space.margin;
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.inline;
            if root.dot >= 0: Rectangle {
                width: Size.dot;
                Dot {
                    y: (parent.height - self.height) / 2;
                    state: root.dot;
                }
            }
            if root.back != "": Rectangle {
                width: up.preferred-width + Space.tight;
                up := Text {
                    text: root.back;
                    font-family: Font.ui;
                    font-size: Font.lead;
                    font-weight: Font.medium;
                    color: up-ta.has-hover ? Ink.bright : Ink.quiet;
                    vertical-alignment: center;
                }
                up-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.back-clicked(); }
                }
            }
            if root.back != "": Path {
                y: (root.height - self.height) / 2;
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M4.5 2.5l3.5 3.5-3.5 3.5";
                fill: transparent;
                stroke: Ink.quiet;
                stroke-width: 1.6px;
                stroke-line-cap: round;
            }
            Text {
                text: root.title;
                font-family: Font.ui;
                font-size: Font.title;
                font-weight: Font.strong;
                letter-spacing: Font.title-tracking;
                color: Ink.bright;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.tabs.length > 0: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.list;
            for name[i] in root.tabs: Rectangle {
                width: t.width;
                t := Tab {
                    text: name;
                    selected: root.tab == i;
                    clicked => { root.tab-chosen(i); }
                }
                if root.tab == i: Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    background: Ink.bright;
                }
            }
        }
        // what was last done, which fades, or what went wrong, which stays
        Text {
            horizontal-stretch: 1;
            text: root.status;
            font-family: Font.ui;
            font-size: Font.note;
            color: root.status-bad ? Ink.bad : Ink.quiet;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.undo-shown: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            LinkButton {
                text: "Undo";
                clicked => { root.undo(); }
            }
        }
        // the page's own buttons
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.inline;
            @children
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Ink.line;
    }
}

// The line under a page's bar, the same on every page: what to do here, a chip
// before it where the words name one, and whatever the page keeps beside it
// (its children: a checkbox, a status, a button), in the band the page's head
// is (Size.head: Space.row down, Size.hint tall).
export component HintRow inherits Rectangle {
    in property <string> text;
    in property <image> chip;
    in property <bool> chip-on;
    // shortened to the room it has, where something sits beside it
    in property <bool> shorten;
    y: Space.row;
    height: Size.hint;
    HorizontalLayout {
        spacing: Space.pad;
        HorizontalLayout {
            horizontal-stretch: root.shorten ? 1 : 0;
            spacing: Space.inline;
            if root.chip-on: Rectangle {
                width: Part.glyph;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: Part.glyph;
                    height: Part.glyph;
                    source: root.chip;
                    image-fit: fill;
                }
            }
            Text {
                text: root.text;
                font-family: Font.ui;
                font-size: Font.note;
                color: root.chip-on ? Ink.soft : Ink.quiet;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        @children
    }
}

// An editor window's header, its page bar: the open thing's name in the bar's
// type (a click on it, or on its pencil, renames it in place), how it stands
// (`state`, and `state-kind`: 0 as it is, 1 changed, 2 recording, its dot
// blinking), and its less common actions behind its three dots; the page's
// margin at either side, as every bar has.
export component EditorHeader inherits Rectangle {
    in property <string> name;
    in property <bool> can-rename: true;
    in property <bool> renaming;
    in-out property <string> typed;
    in property <string> state;
    in property <int> state-kind;
    in property <bool> blink;
    in property <bool> more-enabled: true;
    callback rename();
    callback rename-done(string);
    callback rename-cancel();
    callback more(length, length, length);
    height: Size.bar;
    HorizontalLayout {
        padding-left: Space.margin;
        padding-right: Space.margin;
        spacing: Space.inline;
        if !root.renaming: Text {
            text: root.name;
            font-family: Font.ui;
            font-size: Font.title;
            font-weight: Font.strong;
            letter-spacing: Font.title-tracking;
            color: Ink.bright;
            vertical-alignment: center;
            overflow: elide;
            TouchArea {
                enabled: root.can-rename;
                mouse-cursor: text;
                clicked => { root.rename(); }
            }
        }
        // (renamed in place: a field in the bar's type, at the bar's middle; leaving it keeps
        // the name as Enter does)
        if root.renaming: VerticalLayout {
            alignment: center;
            RenameField {
                width: Size.rename;
                big: true;
                tick: false;
                keep-on-leave: true;
                text <=> root.typed;
                done(kept, t) => {
                    if (kept) {
                        root.rename-done(t);
                    } else {
                        root.rename-cancel();
                    }
                }
            }
        }
        if !root.renaming: VerticalLayout {
            alignment: center;
            PencilButton {
                enabled: root.can-rename;
                clicked => { root.rename(); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if root.state-kind == 2: Rectangle {
            width: Size.dot;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: Size.dot;
                height: Size.dot;
                border-radius: self.width / 2;
                background: Ink.record;
                opacity: root.blink ? 1 : 0.15;
            }
        }
        if root.state != "": Text {
            text: root.state;
            font-family: Font.ui;
            font-size: Font.caption;
            font-weight: root.state-kind == 2 ? Font.strong : Font.regular;
            color: root.state-kind == 2 ? Ink.record : root.state-kind == 1 ? Ink.warn : Ink.quiet;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            MoreButton {
                enabled: root.more-enabled;
                clicked(x, y, h) => { root.more(x, y, h); }
            }
        }
    }
}
