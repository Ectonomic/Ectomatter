// Ectomatter's design system: the parts every page is built from, each drawn
// once from the design tokens (design/ectomatter.tokens.json). docs/design-system.md
// says what each is for and how a new design uses them.

export { Typing } from "state.slint";
export { ColorSquare, WinButton, Tab, WordButton, TextButton, Spinner, ScrollBar, PickField, Well, LinkButton, SmallCap, FieldBox, CheckBox, Star, StarButton, StripIcon, PlayButton, SegSwitch, DropField, BarButton, Glyph, IconButton, MoreButton, PencilButton, SegGround, SegChoice, Slider, ColorButton, FolderTab, Fold, RecordButton, Tag, RadioRow, RenameField } from "controls.slint";
export { Stage, PageBox, ScrollBox, Scrim, DialogBox, Confirm, EmptyState, TipBox, Tip, FloatBar, DialogHead, FormLabel, FormNote } from "surfaces.slint";
export { MenuRow, Menu, Picker } from "menu.slint";
export { Cell, CellView, LaidBox, CellBox } from "cells.slint";
export { ProfileItem, RailItem, AnchorRow, AnchorHead, ListBox, AnchorColumn, ListRow } from "lists.slint";
export { Dot, TitleBar, PageBar, HintRow, EditorHeader } from "bars.slint";
export { BoxRow } from "layout.slint";
export { EffectTile } from "tiles.slint";
