// The pieces the pages laid out in Rust are drawn with (the Settings page, a
// game's page, the Lighting page's boxes, a plugin's settings): Rust says where
// each goes and what it is, and each kind is drawn here once, from the tokens.

import { Space, Radius, Font, Size, Part, Shadow, Ink } from "tokens.slint";
import { Typing } from "state.slint";
import { CheckBox, LinkButton, TextButton } from "controls.slint";
import { ScrollBox, PageBox } from "surfaces.slint";

// a piece of the Lighting page's tile, placed by the window: text, a color
// swatch, a checkbox, a slider, a switch and its buttons, an area chip, a
// button, the reset at the foot
export struct Cell {
    kind: int,
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    // an icon drawn in place of its words, on a 24-unit square: its filled
    // shapes and its lines (2 units wide), as SVG path data (a sensor's cell,
    // kind 51, carries its driver's name and its reading in them)
    fill: string,
    lines: string,
    color: color,
    on: bool,
    value: float,
    id: int,
    index: int,
    style: int,
}

// one piece of the Lighting page's tile, drawn where the window placed it
export component CellView inherits Rectangle {
    in property <Cell> c;
    callback pick(int, int, length, length, length);
    callback slide(int, float);
    // typed into a box: its id, its index (which of the boxes with that id) and what it holds now
    callback typed(int, int, string);
    // a number typed into its box and set, by Enter or by leaving the box
    callback entered(int, string);
    // the pointer over a zone, or no longer; a box typed in, or no longer
    callback hovered(int, bool);
    callback focused(int, bool);
    // a slider double-clicked, to put it back as it was
    callback reset(int);
    // a pad pressed or dragged on: where, as a share of it across and down
    callback pad(int, float, float);
    in property <image> glyph;
    in property <image> glyph2;
    // each package's own glyph (a device's tile with style 2 on: the package that many past 2)
    in property <[image]> glyphs;
    // the scenes' glyph (a device glyph's style -1), and the chips a dropdown can show
    // before its words (its value, one more than the chip's place)
    in property <image> glyph3;
    in property <[image]> chips;
    x: root.c.x;
    y: root.c.y;
    width: root.c.w;
    height: root.c.h;
    // the Lighting page's words: a group's heading in small capitals (33), a color's hex
    // code (34), a setting's name (35), the words at a slider's ends (36 left, 37 right)
    // a command, as it was typed (41), cut off with an ellipsis where it runs long
    if root.c.kind == 0 && root.c.style == 41: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: Font.mono;
        font-size: Font.caption;
        color: Ink.dim;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.c.kind == 0 && root.c.style >= 33 && root.c.style != 41: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: Font.ui;
        // (39: the device a Sensors tab shows, on its first line; 42: a heading inside a
        // plugin's section, in capitals; 43: what a status says, beside its dot; 44: a
        // row's value that's only to read, quieter)
        font-size: root.c.style == 33 ? Font.small : root.c.style == 34 || root.c.style == 42 ? Font.caption : root.c.style == 35 ? Font.note : root.c.style == 38 || root.c.style == 39 ? Font.text : root.c.style == 43 || root.c.style == 44 ? Font.name : Font.small;
        font-weight: root.c.style == 33 || root.c.style == 38 ? Font.strong : root.c.style == 34 || root.c.style == 39 || root.c.style == 42 ? Font.medium : Font.regular;
        letter-spacing: root.c.style == 33 ? 0.95px : root.c.style == 42 ? 1.2px : 0;
        color: root.c.style == 38 || root.c.style == 39 || root.c.style == 43 ? Ink.bright : root.c.style == 35 || root.c.style == 34 ? Ink.dim : root.c.style == 44 ? Ink.soft : Ink.quiet;
        horizontal-alignment: root.c.style == 37 ? right : left;
        vertical-alignment: center;
    }
    // text: a row's name, a column's heading, a note, the empty tile's words, a slider's value
    if root.c.kind == 0 && root.c.style < 33: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: Font.ui;
        // 0 a row's name, 1 a heading, 2 a note, 3 an empty tile's words, 4 a slider's value, 5 a value,
        // 6 a list's item, 7 the page's title, 8 a device's name, 9 its state, 10 the temperature,
        // 11 the weather's words, 12 a fact, 13 its value, 14 the credit, 19 a note in its own color,
        // 20 a menu's words in their own color, 21 a small word in its own color, 22 a stronger word in its own color
        font-size: root.c.style == 1 ? Font.control : root.c.style == 2 || root.c.style == 19 ? Font.note : root.c.style == 3 ? Font.name : root.c.style == 4 ? Font.control
            : root.c.style == 7 ? 20px : root.c.style == 8 ? 14.5px : root.c.style == 9 || root.c.style == 22 ? 12.5px : root.c.style == 10 ? 22px
            : root.c.style == 12 || root.c.style == 13 ? 13px : root.c.style == 14 ? 12px : root.c.style == 21 ? 11.5px : 13.5px;
        font-weight: root.c.style == 1 || root.c.style == 8 || root.c.style == 10 || root.c.style == 13 || root.c.style == 22 ? Font.medium : root.c.style == 7 ? Font.strong : Font.regular;
        letter-spacing: root.c.style == 7 ? -0.4px : root.c.style == 10 ? -0.44px : 0;
        color: root.c.style >= 19 && root.c.style <= 22 ? root.c.color
            : root.c.style == 1 || root.c.style == 9 || root.c.style == 12 ? Ink.soft : root.c.style == 2 || root.c.style == 3 || root.c.style == 14 ? Ink.quiet
            : root.c.style == 5 || root.c.style == 8 ? Ink.bright : root.c.style == 7 || root.c.style == 10 ? Ink.ink : Ink.dim;
        horizontal-alignment: root.c.style == 4 ? right : left;
        vertical-alignment: center;
    }
    // a color: a swatch that opens the color picker
    if root.c.kind == 1: Rectangle {
        border-radius: Radius.control;
        background: root.c.color;
        Rectangle {
            border-radius: Radius.control;
            border-width: 1px;
            border-color: sw.has-hover ? #ffffff66 : #ffffff2e;
        }
        sw := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a checkbox and its words
    if root.c.kind == 2: CheckBox {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        on: root.c.on;
        // which box, and the state it is turned to
        clicked => { root.pick(root.c.id, root.c.index * 2 + (root.c.on ? 0 : 1), 0, 0, 0); }
    }
    // a slider: a thin track and a round knob, which follows the pointer while held
    if root.c.kind == 3: Rectangle {
        property <float> at: drag.pressed ? max(0, min(1, (drag.mouse-x - 8px) / (self.width - 16px))) : root.c.value;
        Rectangle {
            y: (parent.height - 4px) / 2;
            height: 4px;
            border-radius: self.height / 2;
            background: Ink.track;
        }
        Rectangle {
            x: parent.at * (parent.width - 16px);
            width: 16px;
            height: 16px;
            border-radius: self.width / 2;
            background: Ink.ink;
        }
        drag := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.slide(root.c.id, max(0, min(1, (self.mouse-x - 8px) / (self.width - 16px))));
                }
            }
            moved => {
                if (self.pressed) {
                    root.slide(root.c.id, max(0, min(1, (self.mouse-x - 8px) / (self.width - 16px))));
                }
            }
            double-clicked => { root.reset(root.c.id); }
        }
    }
    // a switch's ground
    if root.c.kind == 4: Rectangle {
        border-radius: Radius.panel;
        background: Ink.well;
    }
    // a box in its color, rounded at its ends: a mark on a track, a rule between readings
    if root.c.kind == 16: Rectangle {
        border-radius: min(self.width, self.height) / 2;
        background: root.c.color;
    }
    // a place that tells the page when the pointer is over it, under the words it covers
    if root.c.kind == 17: TouchArea {
        changed has-hover => { root.hovered(root.c.id, self.has-hover); }
    }
    // a pad to move something on, both ways at once: where the pointer is on it
    if root.c.kind == 18: TouchArea {
        mouse-cursor: move;
        changed has-hover => { root.hovered(root.c.id, self.has-hover); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pad(root.c.id, max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
            }
        }
        moved => {
            if (self.pressed) {
                root.pad(root.c.id, max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
            }
        }
    }
    // a tile, under the pieces on it
    // (style 27: a panel over the page, raised off it; 28: the page behind one,
    // dimmed; 30: the row of a menu that is in use)
    // (style 2: the Sensor Feed box with its first tab open, square under that tab)
    if root.c.kind == 9: Rectangle {
        border-radius: root.c.style == 30 ? Radius.control : Radius.box;
        border-top-left-radius: root.c.style == 2 ? 0 : root.c.style == 30 ? Radius.control : Radius.box;
        background: root.c.style == 27 ? Ink.pop : root.c.style == 28 ? #131316b8 : root.c.style == 30 ? Ink.shade4 : Ink.shade1;
        border-width: root.c.style == 27 ? 1px : 0;
        border-color: Ink.seam;
        drop-shadow-blur: root.c.style == 27 ? Shadow.float.blur : 0;
        drop-shadow-offset-y: root.c.style == 27 ? Shadow.float.y : 0;
        drop-shadow-color: root.c.style == 27 ? Shadow.float.color : transparent;
    }
    // a device's glyph on its square (style 1: the second device's, the mouse)
    if root.c.kind == 12: Rectangle {
        border-radius: Radius.panel;
        background: Ink.well;
        // (30 on Settings' 48 square, and as much of a smaller one)
        Image {
            width: floor(parent.width * 0.625 / 1px) * 1px;
            height: self.width;
            source: root.c.style == -1 ? root.glyph3 : root.c.style >= 2 ? root.glyphs[root.c.style - 2] : root.c.style == 1 ? root.glyph2 : root.glyph;
            colorize: Ink.soft;
        }
    }
    // the weather's box (style 1: a folder's path in a plugin's section, its corners
    // smaller; 2: the settings nested under one, a shade off the box)
    if root.c.kind == 13: Rectangle {
        border-radius: root.c.style == 1 ? Radius.control : Radius.panel;
        background: root.c.style == 2 ? #ffffff06 : Ink.well;
    }
    // a state's dot: 0 unknown, 1 good, 2 bad, 3 read from the weather
    if root.c.kind == 14: Rectangle {
        border-radius: min(self.width, self.height) / 2;
        background: root.c.style == 1 ? Ink.good : root.c.style == 2 ? Ink.bad : root.c.style == 3 ? Ink.warn : #5c5c66;
    }
    // a tab of the Sensor Feed box, as the Screen tab's own: rounded above, the open one in the
    // box's color and running on into it on its feet (none on the first's left, where the
    // box's corner is square), the others the page's own until the pointer is on them; an
    // amber dot after a part's name when its readings can't come in (style 1: the first
    // tab, 2: with its dot, 3: both)
    if root.c.kind == 50: tab := Rectangle {
        property <bool> first: root.c.style == 1 || root.c.style == 3;
        if root.c.on && !tab.first: Rectangle {
            x: -10px;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            background: Ink.box;
            Rectangle {
                background: Ink.base;
                border-bottom-right-radius: Radius.panel;
            }
        }
        if root.c.on: Rectangle {
            x: parent.width;
            y: parent.height - 10px;
            width: 10px;
            height: 10px;
            background: Ink.box;
            Rectangle {
                background: Ink.base;
                border-bottom-left-radius: Radius.panel;
            }
        }
        Rectangle {
            border-top-left-radius: Radius.panel;
            border-top-right-radius: Radius.panel;
            background: root.c.on || tab-ta.has-hover ? Ink.box : transparent;
        }
        tab-words := Text {
            x: 18px;
            height: parent.height;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.control;
            font-weight: Font.medium;
            color: root.c.on ? Ink.bright : tab-ta.has-hover ? Ink.dim : Ink.soft;
            vertical-alignment: center;
        }
        if root.c.style >= 2: Rectangle {
            x: tab-words.x + tab-words.width + 7px;
            y: (parent.height - 6px) / 2;
            width: 6px;
            height: 6px;
            border-radius: self.width / 2;
            background: Ink.warn;
        }
        // (the open tab is already chosen: only the others answer the pointer)
        tab-ta := TouchArea {
            enabled: !root.c.on;
            mouse-cursor: root.c.on ? MouseCursor.default : MouseCursor.pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0); }
        }
    }
    // a dot beside a label on a game's page, where the game changed the row from Every
    // game's: selecting it puts the row back; under the pointer, a well round it and, a
    // while after the pointer comes to rest, what it does (`text`), in a box like the tip's
    if root.c.kind == 54: Rectangle {
        reset-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0); }
        }
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: self.width / 2;
            background: reset-ta.has-hover ? #ffffff14 : transparent;
        }
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: self.width / 2;
            background: Ink.ink;
        }
        Tooltip {
            Rectangle {
                border-radius: Radius.control;
                background: Ink.hover-box;
                border-width: 1px;
                border-color: Ink.seam;
                drop-shadow-blur: Shadow.lift.blur;
                drop-shadow-offset-y: Shadow.lift.y;
                drop-shadow-color: Shadow.lift.color;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    Text {
                        text: root.c.text;
                        font-family: Font.ui;
                        font-size: Font.note;
                        color: Ink.bright;
                    }
                }
            }
        }
    }
    // over a device's name in the Sensor Feed box: under the pointer, a while after it comes to
    // rest, its whole name where the row's is shorter (`text`), and where its readings come
    // from (`fill`), in a box like the app's menus
    if root.c.kind == 52: Rectangle {
        Tooltip {
            Rectangle {
                border-radius: Radius.control;
                background: Ink.hover-box;
                border-width: 1px;
                border-color: Ink.seam;
                drop-shadow-blur: Shadow.lift.blur;
                drop-shadow-offset-y: Shadow.lift.y;
                drop-shadow-color: Shadow.lift.color;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 2px;
                    if root.c.text != "": Text {
                        text: root.c.text;
                        font-family: Font.ui;
                        font-size: Font.note;
                        font-weight: Font.medium;
                        color: Ink.bright;
                    }
                    Text {
                        text: root.c.fill;
                        font-family: Font.ui;
                        font-size: Font.caption;
                        color: Ink.soft;
                    }
                }
            }
        }
    }
    // a sensor in the Sensor Feed box: its checkbox, its name (as wide as `value` allows), its
    // driver's name in gray (`fill`), its reading at its right (`lines`), and under the
    // pointer a pencil to rename it, whose click is the next control's; or a run of like
    // readings folded into one line, a chevron for its checkbox, how many are checked at its
    // right (style 0: a sensor, 1: one whose reading can't be right, its reading amber, 2: a
    // run, 3: a run opened, 4: a sensor being renamed, its line to type in over it)
    if root.c.kind == 51: chip := Rectangle {
        property <bool> run: root.c.style == 2 || root.c.style == 3;
        property <bool> hot: (chip-ta.has-hover || pen-ta.has-hover) && root.c.style != 4;
        border-radius: Radius.control;
        background: self.hot ? Ink.hover-well : transparent;
        chip-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0); }
        }
        if !chip.run: Rectangle {
            x: 8px;
            y: (parent.height - 15px) / 2;
            width: 15px;
            height: 15px;
            border-radius: Radius.tiny;
            background: root.c.on ? (chip.hot ? Ink.bright : Ink.dim) : chip.hot ? Ink.hover-box : Ink.well;
            border-width: root.c.on ? 0 : 1px;
            border-color: Ink.edge;
            if root.c.on: Path {
                width: 15px;
                height: 15px;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                fill: transparent;
                stroke: Ink.base;
                stroke-width: 2.2px;
            }
        }
        if chip.run: Path {
            x: 10px;
            y: (parent.height - 10px) / 2;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: root.c.style == 3 ? "M2 3.5l3 3 3-3" : "M3.5 2l3 3-3 3";
            fill: transparent;
            stroke: Ink.soft;
            stroke-width: 1.4px;
        }
        chip-name := Text {
            x: 31px;
            width: root.c.style == 4 ? 0 : min(self.preferred-width, root.c.value * 1px - (chip.hot && !chip.run ? 30px : 0));
            height: parent.height;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.note;
            color: root.c.on || (chip.run && chip.hot) ? Ink.bright : Ink.dim;
            vertical-alignment: center;
            overflow: elide;
            visible: root.c.style != 4;
        }
        if root.c.fill != "" && root.c.style != 4: Text {
            x: chip-name.x + chip-name.width + 8px;
            height: parent.height;
            text: root.c.fill;
            font-family: Font.ui;
            font-size: Font.caption;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        chip-val := Text {
            x: parent.width - 8px - self.width - (chip.hot && !chip.run ? 30px : 0);
            height: parent.height;
            text: root.c.lines;
            font-family: Font.ui;
            font-size: Font.note;
            color: root.c.style == 1 ? Ink.warn : chip.run ? Ink.quiet : root.c.on ? Ink.dim : Ink.soft;
            vertical-alignment: center;
            visible: root.c.style != 4;
        }
        Rectangle {
            x: parent.width - 8px - 22px;
            y: (parent.height - 20px) / 2;
            width: 22px;
            height: 20px;
            border-radius: Radius.small;
            visible: chip.hot && !chip.run;
            background: pen-ta.has-hover ? Ink.pick : transparent;
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M4 20h4L19 9l-4-4L4 16z";
                fill: transparent;
                stroke: pen-ta.has-hover ? Ink.bright : Ink.soft;
                stroke-width: 1.8px;
                stroke-line-join: round;
            }
            pen-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(root.c.id + 1, root.c.index, 0, 0, 0); }
            }
        }
    }
    // a line to type in: the profile's name, or the weather's place
    // (style 7: a sensor's new name, typed on its chip: Enter, or leaving it, gives it,
    // Escape takes it back)
    if root.c.kind == 10: Rectangle {
        border-radius: root.c.style == 7 ? Radius.small : Radius.control;
        background: root.c.style == 7 ? Ink.base : Ink.well;
        border-width: root.c.style == 7 ? 1px : 0;
        border-color: Ink.edge;
        if root.c.style == 2 && input.text == "": Text {
            x: 10px;
            height: parent.height;
            text: "Find a typeface";
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        if (root.c.style == 4 || root.c.style == 5) && input.text == "": Text {
            x: 10px;
            height: 34px;
            text: "None";
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        // (style 8: a value in a plugin's section, in the face whose letters are all one
        // width, what it holds when empty in gray; Enter or leaving it gives it, Escape
        // takes it back)
        if root.c.style == 8 && input.text == "": Text {
            x: 12px;
            height: parent.height;
            text: root.c.fill;
            font-family: Font.mono;
            font-size: Font.caption;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        // (style 9: a name to give, what it holds when empty in gray, as the scene form's Name)
        if root.c.style == 9 && input.text == "": Text {
            x: 10px;
            height: parent.height;
            text: root.c.fill;
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        if root.c.style == 3 && input.text == "": Text {
            x: 10px;
            height: parent.height;
            text: "Setup name";
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        if root.c.style == 1 && input.text == "": Text {
            x: 11px;
            height: parent.height;
            text: "Search for a city or town";
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        // (a key's text: what the page sets it to, unless it is being typed in)
        property <string> shown: root.c.text;
        changed shown => {
            if (root.c.style >= 4 && !input.has-focus && input.text != self.shown) {
                input.text = self.shown;
            }
        }
        // a key's picture in place of its text (style 6): a frame, its file's
        // name, and the button that takes it off
        if root.c.style == 6: Path {
            x: 11px;
            y: (34px - 14px) / 2;
            width: 16px;
            height: 14px;
            viewbox-width: 16;
            viewbox-height: 14;
            commands: "M1.5 1.5h13v11h-13z M3.5 10.5l3.5-4 2.5 2.5 1.5-1.5 2.5 3";
            fill: transparent;
            stroke: Ink.quiet;
            stroke-width: 1.2px;
        }
        if root.c.style == 6: Text {
            x: 34px;
            width: parent.width - 34px - 36px;
            height: 34px;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        // (the box tells the page the pointer is over it, for its note)
        if root.c.style == 6: TouchArea {
            width: parent.width - 36px;
            height: parent.height;
