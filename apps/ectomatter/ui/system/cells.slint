        }
        input := TextInput {
            visible: root.c.style != 6;
            enabled: root.c.style != 6;
            property <bool> plugin-value: root.c.style == 8;
            x: self.plugin-value ? 12px : root.c.style == 1 ? 11px : root.c.style == 7 ? 8px : 10px;
            y: root.c.style == 5 ? 8px : 0;
