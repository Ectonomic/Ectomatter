        if root.c.style == 4 || root.c.style == 5: Rectangle {
            x: parent.width - 32px;
            y: 3px;
            width: 28px;
            height: 28px;
            border-radius: Radius.small;
            background: glyphs.has-hover ? #ffffff14 : transparent;
            Text {
                text: "⌘";
                font-size: Font.lead;
                color: glyphs.has-hover ? Ink.ink : Ink.quiet;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
