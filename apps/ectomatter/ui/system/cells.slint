            viewbox-height: 12;
            commands: "M3 4.5l3 3 3-3";
            fill: transparent;
            stroke: Ink.quiet;
            stroke-width: 1.6px;
        }
        dr-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a link in a sentence: its words brighter than the note round them, which select it
    if root.c.kind == 18: Text {
        text: root.c.text;
        font-family: Font.ui;
        font-size: Font.note;
        color: il-ta.has-hover ? #ffffff : Ink.bright;
        vertical-alignment: center;
        il-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
        }
    }
    // a quiet link: Reset (with its icon), Select all, Scatter colors (style 1: a text
    // button in a plugin's section, its icon on 14 units; 2: the same, not to be used now, faded)
    if root.c.kind == 47 && root.c.style == 0: LinkButton {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        icon: root.c.lines;
        units: 24;
        clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
    }
    if root.c.kind == 47 && root.c.style != 0: TextButton {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        icon: root.c.lines;
        enabled: root.c.style != 2;
        clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height); }
    }
    // a thing the firmware adds: a tick, then its name
    if root.c.kind == 49: Rectangle {
        Path {
            x: 0;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M5 12.5l4.5 4.5L19 7.5";
            fill: transparent;
            stroke: Ink.good;
            stroke-width: 2.4px;
        }
        Text {
            x: 19px;
            width: parent.width - 19px;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.dim;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // a fold's heading in a plugin's section: its chevron (turned down while open) and its
    // words, which open and shut it
    if root.c.kind == 53: Rectangle {
        Path {
            x: 0;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: root.c.on ? "M2.5 4.5l3.5 3.5 3.5-3.5" : "M4.5 2.5l3.5 3.5-3.5 3.5";
            fill: transparent;
            stroke: fold-ta.has-hover ? Ink.ink : Ink.soft;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        Text {
            x: 20px;
            width: parent.width - 20px;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.text;
            color: fold-ta.has-hover ? Ink.ink : Ink.soft;
            vertical-alignment: center;
        }
        fold-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0); }
        }
    }
    // a checkbox on a box, and its words (style 1: one that can't be changed now, faint and
    // unticked; 2: one held on by another setting, ticked in gray)
    if root.c.kind == 48: CheckBox {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        on: root.c.on;
        state: root.c.style;
        clicked => { root.pick(root.c.id, root.c.index * 2 + (root.c.on ? 0 : 1), 0, 0, 0); }
    }
}

// A box of pieces laid out in Rust, for a row of boxes: its title, the least
// width the row grows it from, how tall its pieces are at the width the row
// gave it, and the pieces themselves
export struct LaidBox {
    title: string,
    least: length,
    h: length,
    cells: [Cell],
}

// A box in a device page's row whose pieces are laid out in Rust, from what a
// core or a plugin describes (an effect's settings, a mouse's): the row places
// it as it does any box and it says how wide it came out (`resized`), so Rust
// lays its pieces out to that width. Holding more than its height, it scrolls.
export component CellBox inherits ScrollBox {
    in property <LaidBox> b;
    callback resized(length);
    callback pick(int, int, length, length, length);
    callback slide(int, float);
    callback typed(int, int, string);
    callback hovered(int, bool);
    min-width: root.b.least;
    preferred-width: root.b.least;
    preferred-height: root.b.h;
    need: root.b.h;
    init => { root.resized(self.width); }
    changed width => { root.resized(self.width); }
    PageBox {
        width: parent.width;
        height: max(root.b.h, root.height);
        fill: transparent;
        title: root.b.title;
        for c in root.b.cells: CellView {
            c: c;
            pick(id, index, x, y, h) => { root.pick(id, index, x, y, h); }
            slide(id, v) => { root.slide(id, v); }
            typed(id, index, t) => { root.typed(id, index, t); }
            hovered(i, on) => { root.hovered(i, on); }
        }
    }
}
