// The pieces the pages laid out in Rust are drawn with (the Settings page, a
// game's page, the Lighting page's boxes, a plugin's settings): Rust says where
// each goes and what it is, and each kind is drawn here once, from the tokens.

import { Space, Radius, Font, Line, Size, Part, Shadow, Ink } from "tokens.slint";
import { Typing } from "state.slint";
import { CheckBox, LinkButton, TextButton, WordButton, DropField, SegGround, SegChoice, Slider, ColorButton, FolderTab, PencilButton, Fold } from "controls.slint";
import { ScrollBox, PageBox, Tip, TipBox } from "surfaces.slint";

// a piece of the Lighting page's tile, placed by the window: text, a color
// swatch, a checkbox, a slider, a switch and its buttons, an area chip, a
// button, the reset at the foot
export struct Cell {
    kind: int,
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    // an icon drawn in place of its words, on a 24-unit square: its filled
    // shapes and its lines (2 units wide), as SVG path data (a sensor's cell,
    // kind 51, carries its driver's name and its reading in them)
    fill: string,
    lines: string,
    color: color,
    on: bool,
    value: float,
    id: int,
    index: int,
    style: int,
}

// one piece of the Lighting page's tile, drawn where the window placed it
export component CellView inherits Rectangle {
    in property <Cell> c;
    callback pick(int, int, length, length, length, length);
    callback slide(int, float);
    // typed into a box: its id, its index (which of the boxes with that id) and what it holds now
    callback typed(int, int, string);
    // a number typed into its box and set, by Enter or by leaving the box
    callback entered(int, string);
    // the pointer over a zone, or no longer; a box typed in, or no longer
    callback hovered(int, bool);
    callback focused(int, bool);
    // a slider double-clicked, to put it back as it was
    callback reset(int);
    // a pad pressed or dragged on: where, as a share of it across and down
    callback pad(int, float, float);
    in property <image> glyph;
    in property <image> glyph2;
    // each package's own glyph (a device's tile with style 2 on: the package that many past 2)
    in property <[image]> glyphs;
    // the scenes' glyph (a device glyph's style -1), and the chips a dropdown can show
    // before its words (its value, one more than the chip's place)
    in property <image> glyph3;
    in property <[image]> chips;
    x: root.c.x;
    y: root.c.y;
    width: root.c.w;
    height: root.c.h;
    // the Lighting page's words: a group's heading in small capitals (33), a color's hex
    // code (34), a setting's name (35), the words at a slider's ends (36 left, 37 right)
    // a command, as it was typed (41), cut off with an ellipsis where it runs long
    if root.c.kind == 0 && root.c.style == 41: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: Font.mono;
        font-size: Font.caption;
        color: Ink.dim;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.c.kind == 0 && root.c.style >= 33 && root.c.style != 41: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: Font.ui;
        // (39: the device a Sensors tab shows, on its first line; 42: a heading inside a
        // plugin's section, in capitals; 43: what a status says, beside its dot; 44: a
        // row's value that's only to read, quieter)
        // (33 and 42 are both a heading in capitals, as every one is)
        font-size: root.c.style == 33 || root.c.style == 42 ? Font.small : root.c.style == 34 ? Font.caption : root.c.style == 35 ? Font.note : root.c.style == 38 || root.c.style == 39 ? Font.text : root.c.style == 43 || root.c.style == 44 ? Font.text : Font.small;
        font-weight: root.c.style == 33 || root.c.style == 38 || root.c.style == 42 ? Font.strong : root.c.style == 34 || root.c.style == 39 ? Font.medium : Font.regular;
        letter-spacing: root.c.style == 33 || root.c.style == 42 ? Font.caps-tracking : 0;
        color: root.c.style == 38 || root.c.style == 39 || root.c.style == 43 ? Ink.bright : root.c.style == 35 || root.c.style == 34 ? Ink.dim : root.c.style == 44 ? Ink.soft : Ink.quiet;
        horizontal-alignment: root.c.style == 37 ? right : left;
        vertical-alignment: center;
    }
    // text: a row's name, a column's heading, a note, the empty tile's words, a slider's value
    if root.c.kind == 0 && root.c.style < 33: Text {
        x: 0;
        width: parent.width;
        text: root.c.text;
        font-family: Font.ui;
        // 0 a row's name, 1 a heading, 2 a note, 3 an empty tile's words, 4 a slider's value, 5 a value,
        // 6 a list's item, 7 the page's title, 8 a device's name, 9 its state, 10 the temperature,
        // 11 the weather's words, 12 a fact, 13 its value, 14 the credit, 19 a note in its own color,
        // 20 a menu's words in their own color, 21 a small word in its own color, 22 a stronger word in its own color
        font-size: root.c.style == 1 ? Font.control : root.c.style == 2 || root.c.style == 19 ? Font.note : root.c.style == 3 ? Font.name : root.c.style == 4 ? Font.control
            : root.c.style == 7 ? Font.title : root.c.style == 8 ? Font.tab : root.c.style == 9 || root.c.style == 22 ? Font.note : root.c.style == 10 ? Font.display
            : root.c.style == 12 || root.c.style == 13 ? Font.control : root.c.style == 14 ? Font.caption : root.c.style == 21 ? Font.caption : Font.text;
        font-weight: root.c.style == 1 || root.c.style == 8 || root.c.style == 10 || root.c.style == 13 || root.c.style == 22 ? Font.medium : root.c.style == 7 ? Font.strong : Font.regular;
        letter-spacing: root.c.style == 7 ? Font.title-tracking : root.c.style == 10 ? Font.display-tracking : 0;
        color: root.c.style >= 19 && root.c.style <= 22 ? root.c.color
            : root.c.style == 1 || root.c.style == 9 || root.c.style == 12 ? Ink.soft : root.c.style == 2 || root.c.style == 3 || root.c.style == 14 ? Ink.quiet
            : root.c.style == 5 || root.c.style == 8 ? Ink.bright : root.c.style == 7 || root.c.style == 10 ? Ink.ink : Ink.dim;
        horizontal-alignment: root.c.style == 4 ? right : left;
        vertical-alignment: center;
    }
    // a switch's ground
    if root.c.kind == 4: SegGround {}
    // a box in its color, rounded at its ends: a mark on a track, a rule between readings
    if root.c.kind == 16: Rectangle {
        border-radius: min(self.width, self.height) / 2;
        background: root.c.color;
    }
    // a place that tells the page when the pointer is over it, under the words it covers
    if root.c.kind == 17: TouchArea {
        changed has-hover => { root.hovered(root.c.id, self.has-hover); }
    }
    // a pad to move something on, both ways at once: where the pointer is on it
    if root.c.kind == 18: TouchArea {
        mouse-cursor: move;
        changed has-hover => { root.hovered(root.c.id, self.has-hover); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pad(root.c.id, max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
            }
        }
        moved => {
            if (self.pressed) {
                root.pad(root.c.id, max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
            }
        }
    }
    // a tile, under the pieces on it
    // (style 27: a panel over the page, raised off it; 28: the page behind one,
    // dimmed; 30: the row of a menu that is in use)
    // (style 2: the Sensor Feed box with its first tab open, square under that tab)
    if root.c.kind == 9: Rectangle {
        border-radius: root.c.style == 30 ? Radius.control : Radius.box;
        border-top-left-radius: root.c.style == 2 ? 0 : root.c.style == 30 ? Radius.control : Radius.box;
        background: root.c.style == 27 ? Ink.pop : root.c.style == 28 ? Ink.well.with-alpha(0.722) : root.c.style == 30 ? Ink.shade4 : Ink.shade1;
        border-width: root.c.style == 27 ? 1px : 0;
        border-color: Ink.seam;
        drop-shadow-blur: root.c.style == 27 ? Shadow.float.blur : 0;
        drop-shadow-offset-y: root.c.style == 27 ? Shadow.float.y : 0;
        drop-shadow-color: root.c.style == 27 ? Shadow.float.color : transparent;
    }
    // a device's glyph on its square (style 1: the second device's, the mouse)
    if root.c.kind == 12: Rectangle {
        border-radius: Radius.panel;
        background: Ink.well;
        // (30 on Settings' 48 square, and as much of a smaller one)
        Image {
            width: floor(parent.width * 0.625 / 1px) * 1px;
            height: self.width;
            source: root.c.style == -1 ? root.glyph3 : root.c.style >= 2 ? root.glyphs[root.c.style - 2] : root.c.style == 1 ? root.glyph2 : root.glyph;
            colorize: Ink.soft;
        }
    }
    // the weather's box (style 1: a folder's path in a plugin's section, its corners
    // smaller; 2: the settings nested under one, a shade off the box)
    if root.c.kind == 13: Rectangle {
        border-radius: root.c.style == 1 ? Radius.control : Radius.panel;
        background: root.c.style == 2 ? Ink.white.with-alpha(0.024) : Ink.well;
    }
    // a state's dot: 0 unknown, 1 good, 2 bad, 3 read from the weather
    if root.c.kind == 14: Rectangle {
        border-radius: min(self.width, self.height) / 2;
        background: root.c.style == 1 ? Ink.good : root.c.style == 2 ? Ink.bad : root.c.style == 3 ? Ink.warn : Ink.off;
    }
    // a tab of the Sensor Feed box, as the Screen tab's own: rounded above, the open one in the
    // box's color and running on into it on its feet (none on the first's left, where the
    // box's corner is square), the others the page's own until the pointer is on them; an
    // amber dot after a part's name when its readings can't come in (style 1: the first
    // tab, 2: with its dot, 3: both)
    if root.c.kind == 50: FolderTab {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        open: root.c.on;
        first: root.c.style == 1 || root.c.style == 3;
        warn: root.c.style >= 2;
        fill: Ink.box;
        clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0, 0); }
    }
    // a dot beside a label on a game's page, where the game changed the row from Every
    // game's: selecting it puts the row back; under the pointer, a well round it and, a
    // while after the pointer comes to rest, what it does (`text`), in a box like the tip's
    if root.c.kind == 54: Rectangle {
        reset-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0, 0); }
        }
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: self.width / 2;
            background: reset-ta.has-hover ? Ink.white.with-alpha(0.078) : transparent;
        }
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: self.width / 2;
            background: Ink.ink;
        }
        Tooltip {
            Tip {
                text: root.c.text;
            }
        }
    }
    // over a device's name in the Sensor Feed box: under the pointer, a while after it comes to
    // rest, its whole name where the row's is shorter (`text`), and where its readings come
    // from (`fill`), in a box like the app's menus
    if root.c.kind == 52: Rectangle {
        Tooltip {
            TipBox {
                    if root.c.text != "": Text {
                        text: root.c.text;
                        font-family: Font.ui;
                        font-size: Font.note;
                        font-weight: Font.medium;
                        color: Ink.bright;
                    }
                    Text {
                        text: root.c.fill;
                        font-family: Font.ui;
                        font-size: Font.caption;
                        color: Ink.soft;
                    }
            }
        }
    }
    // a sensor in the Sensor Feed box: its checkbox, its name (as wide as `value` allows), its
    // driver's name in gray (`fill`), its reading at its right (`lines`), and under the
    // pointer a pencil to rename it, whose click is the next control's; or a run of like
    // readings folded into one line, a chevron for its checkbox, how many are checked at its
    // right (style 0: a sensor, 1: one whose reading can't be right, its reading amber, 2: a
    // run, 3: a run opened, 4: a sensor being renamed, its line to type in over it)
    if root.c.kind == 51: chip := Rectangle {
        property <bool> run: root.c.style == 2 || root.c.style == 3;
        property <bool> hot: (chip-ta.has-hover || pen.hover) && root.c.style != 4;
        // (the pencil's room at the chip's right while it shows)
        property <length> pen-w: chip.hot && !chip.run ? Size.quiet : 0;
        // the name's room: the chip less its checkbox, its driver's name and its reading
        property <length> room: max(24px, self.width - chip-name.x - (root.c.fill != "" ? orig.preferred-width + Part.sensor-pad : 0) - Part.sensor-pad - chip-val.preferred-width - Part.sensor-pad - self.pen-w);
        border-radius: Radius.control;
        background: self.hot ? Ink.hover-well : transparent;
        chip-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0, 0); }
        }
        if !chip.run: Rectangle {
            x: Part.sensor-pad;
            y: (parent.height - Size.check) / 2;
            width: Size.check;
            height: Size.check;
            border-radius: Radius.tiny;
            background: root.c.on ? (chip.hot ? Ink.bright : Ink.dim) : chip.hot ? Ink.hover-box : Ink.well;
            border-width: root.c.on ? 0 : 1px;
            border-color: chip.hot ? Ink.edge-hover : Ink.edge;
            if root.c.on: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
                fill: transparent;
                stroke: Ink.base;
                stroke-width: 2px;
            }
        }
        if chip.run: Path {
            x: Part.sensor-pad + (Size.check - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: root.c.style == 3 ? "M2 3.5l3 3 3-3" : "M3.5 2l3 3-3 3";
            fill: transparent;
            stroke: Ink.soft;
            stroke-width: 1.4px;
        }
        chip-name := Text {
            x: Part.sensor-pad + Size.check + Part.check-gap;
            width: root.c.style == 4 ? 0 : min(self.preferred-width, chip.room);
            height: parent.height;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.note;
            color: root.c.on || (chip.run && chip.hot) ? Ink.bright : Ink.dim;
            vertical-alignment: center;
            overflow: elide;
            visible: root.c.style != 4;
        }
        orig := Text {
            x: chip-name.x + chip-name.width + Part.sensor-pad;
            height: parent.height;
            text: root.c.fill;
            font-family: Font.ui;
            font-size: Font.caption;
            color: Ink.quiet;
            vertical-alignment: center;
            visible: root.c.fill != "" && root.c.style != 4;
        }
        chip-val := Text {
            x: parent.width - Part.sensor-pad - self.width - chip.pen-w;
            height: parent.height;
            text: root.c.lines;
            font-family: Font.ui;
            font-size: Font.note;
            color: root.c.style == 1 ? Ink.warn : chip.run ? Ink.quiet : root.c.on ? Ink.dim : Ink.soft;
            vertical-alignment: center;
            visible: root.c.style != 4;
        }
        pen := PencilButton {
            x: parent.width - Part.inset - self.width;
            y: (parent.height - self.height) / 2;
            visible: chip.hot && !chip.run;
            hover-fill: Ink.pick;
            clicked => { root.pick(root.c.id + 1, root.c.index, 0, 0, 0, 0); }
        }
    }
    // a line to type in: the profile's name, or the weather's place
    // (style 7: a sensor's new name, typed on its chip: Enter, or leaving it, gives it,
    // Escape takes it back)
    if root.c.kind == 10: Rectangle {
        border-radius: root.c.style == 7 ? Radius.small : Radius.control;
        background: root.c.style == 7 ? Ink.base : Ink.well;
        border-width: root.c.style == 7 ? 1px : 0;
        border-color: Ink.edge;
        if root.c.style == 2 && input.text == "": Text {
            x: Part.field-pad;
            height: parent.height;
            text: "Find a typeface";
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        if (root.c.style == 4 || root.c.style == 5) && input.text == "": Text {
            x: Part.field-pad;
            height: Size.control;
            text: "None";
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        // (style 8: a value in a plugin's section, in the face whose letters are all one
        // width, what it holds when empty in gray; Enter or leaving it gives it, Escape
        // takes it back)
        if root.c.style == 8 && input.text == "": Text {
            x: Part.field-pad;
            height: parent.height;
            text: root.c.fill;
            font-family: Font.mono;
            font-size: Font.caption;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        // (style 9: a name to give, what it holds when empty in gray, as the scene form's Name)
        if root.c.style == 9 && input.text == "": Text {
            x: Part.field-pad;
            height: parent.height;
            text: root.c.fill;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        if root.c.style == 3 && input.text == "": Text {
            x: Part.field-pad;
            height: parent.height;
            text: "Setup name";
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        if root.c.style == 1 && input.text == "": Text {
            x: Part.field-pad;
            height: parent.height;
            text: "Search for a city or town";
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        // (a key's text: what the page sets it to, unless it is being typed in)
        property <string> shown: root.c.text;
        changed shown => {
            if (root.c.style >= 4 && !input.has-focus && input.text != self.shown) {
                input.text = self.shown;
            }
        }
        // a key's picture in place of its text (style 6): a frame, its file's
        // name, and the button that takes it off
        if root.c.style == 6: Path {
            x: Part.field-pad;
            y: (parent.height - 14px) / 2;
            width: 16px;
            height: 14px;
            viewbox-width: 16;
            viewbox-height: 14;
            commands: "M1.5 1.5h13v11h-13z M3.5 10.5l3.5-4 2.5 2.5 1.5-1.5 2.5 3";
            fill: transparent;
            stroke: Ink.quiet;
            stroke-width: 1.2px;
        }
        if root.c.style == 6: Text {
            x: 34px;
            width: parent.width - 34px - 36px;
            height: parent.height;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        // (the box tells the page the pointer is over it, for its note)
        if root.c.style == 6: TouchArea {
            width: parent.width - 36px;
            height: parent.height;
            changed has-hover => { root.hovered(root.c.id, self.has-hover); }
        }
        if root.c.style == 6: Rectangle {
            x: parent.width - 32px;
            y: 3px;
            width: 28px;
            height: 28px;
            border-radius: Radius.small;
            background: off.has-hover ? Ink.white.with-alpha(0.078) : transparent;
            Text {
                text: "×";
                font-size: Font.title;
                color: off.has-hover ? Ink.ink : Ink.quiet;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            off := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(root.c.id, 2, 0, 0, 0, 0); }
            }
        }
        // a key's text: its glyphs' button, which gives the box the keys and opens their list
        if root.c.style == 4 || root.c.style == 5: Rectangle {
            x: parent.width - 32px;
            y: 3px;
            width: 28px;
            height: 28px;
            border-radius: Radius.small;
            background: glyphs.has-hover ? Ink.white.with-alpha(0.078) : transparent;
            Text {
                text: "⌘";
                font-size: Font.lead;
                color: glyphs.has-hover ? Ink.ink : Ink.quiet;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // (the box's text chosen as it takes the keys, so a glyph takes its
            // place; with the cursor already in the box, a glyph goes there)
            glyphs := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (!input.has-focus) {
                        input.focus();
                        input.select-all();
                    }
                    root.pick(root.c.id, 1, 0, 0, 0, 0);
                }
            }
        }
        input := TextInput {
            visible: root.c.style != 6;
            enabled: root.c.style != 6;
            property <bool> plugin-value: root.c.style == 8;
            // (style 7, a name typed on a sensor's chip, close in from the chip's edge)
            x: root.c.style == 7 ? 8px : Part.field-pad;
            y: root.c.style == 5 ? 8px : 0;
            width: parent.width - 2 * self.x - (root.c.style >= 4 && root.c.style <= 6 ? 30px : 0);
            height: root.c.style == 5 ? parent.height - 16px : parent.height;
            text: root.c.text;
            font-family: self.plugin-value ? Font.mono : Font.ui;
            font-size: self.plugin-value ? Font.caption : root.c.style == 7 ? Font.note : Font.control;
            // (a value its page follows from elsewhere, in gray)
            color: self.plugin-value ? (root.c.on && !self.has-focus ? Ink.soft : Ink.dim) : root.c.style == 1 || root.c.style == 7 ? Ink.bright : Ink.ink;
            vertical-alignment: root.c.style == 5 ? top : center;
            single-line: root.c.style != 5;
            edited => { root.typed(root.c.id, root.c.index, self.text); }
            changed has-focus => {
                Typing.on = self.has-focus;
                if (root.c.style >= 4 && root.c.style <= 6) {
                    root.focused(root.c.id, self.has-focus);
                }
                if ((root.c.style == 7 || root.c.style == 10) && !self.has-focus) {
                    root.pick(root.c.id, 1, 0, 0, 0, 0);
                }
                if (self.plugin-value && !self.has-focus) {
                    root.pick(root.c.id, root.c.index, 1px, 0, 0, 0);
                }
            }
            // (style 3, a name to give, 7, and 10, the words a block on a screen says: it
            // takes the keys as it shows, all of it chosen; Enter gives it, Escape cancels)
            init => {
                if (root.c.style == 3 || root.c.style == 7 || root.c.style == 10) {
                    self.focus();
                    self.select-all();
                }
            }
            accepted => {
                if (root.c.style == 3 || root.c.style == 7 || root.c.style == 10) {
                    root.pick(root.c.id, 1, 0, 0, 0, 0);
                }
                if (self.plugin-value) {
                    self.clear-focus();
                }
            }
            key-pressed(e) => {
                if (self.plugin-value && e.text == Key.Escape) {
                    root.pick(root.c.id, root.c.index, 2px, 0, 0, 0);
                    self.text = root.c.text;
                    self.clear-focus();
                    return accept;
                }
                if ((root.c.style == 3 || root.c.style == 7 || root.c.style == 9 || root.c.style == 10) && e.text == Key.Escape) {
                    root.pick(root.c.id, 2, 0, 0, 0, 0);
                    return accept;
                }
                if (root.c.style >= 4 && root.c.style <= 6 && e.text == Key.Escape) {
                    self.clear-focus();
                    return accept;
                }
                reject
            }
        }
    }
    // a number to type, as the lab's values are: Enter or leaving the
    // box sets it, Escape puts it back as it was; set elsewhere (its slider),
    // the box follows unless it is being typed in
    if root.c.kind == 15: Rectangle {
        property <string> shown: root.c.text;
        changed shown => {
            if (!num.has-focus) {
                num.text = self.shown;
            }
        }
        // (a field's look: a well, a shade lighter while it's typed in)
        border-radius: Radius.control;
        background: num.has-focus ? Ink.hover-well : Ink.well;
        box-ta := TouchArea {
            mouse-cursor: text;
            clicked => { num.focus(); }
        }
        num := TextInput {
            x: Part.field-pad;
            width: parent.width - 2 * Part.field-pad;
            height: parent.height;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.bright;
            horizontal-alignment: right;
            vertical-alignment: center;
            single-line: true;
            accepted => {
                root.entered(root.c.id, self.text);
                self.clear-focus();
            }
            changed has-focus => {
                Typing.on = self.has-focus;
                root.focused(root.c.id, self.has-focus);
                if (self.has-focus) {
                    self.select-all();
                } else if (self.text != root.c.text) {
                    root.entered(root.c.id, self.text);
                }
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    self.text = root.c.text;
                    self.clear-focus();
                    return accept;
                }
                reject
            }
        }
    }
    // a button with words (and its glyph's lines before them, style 35): the WordButton,
    // on a box; style 33 the small one inside a card (Make main), 37 one that can't be
    // used now
    if root.c.kind == 7 && (root.c.style == 0 || root.c.style == 33 || root.c.style == 35 || root.c.style == 37): WordButton {
        width: parent.width;
        height: parent.height;
        wide: parent.width;
        on-box: true;
        small: root.c.style == 33;
        lines: root.c.style == 35 ? root.c.lines : "";
        text: root.c.text;
        enabled: root.c.style != 37;
        clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height, root.width); }
    }
    // the lab's own pieces: a switch's button that tells the page the pointer is over it, a
    // key on its map, a menu's rows, a button on a shade; and a card that opens (36)
    // (style 24: it opens a list, a chevron after its words; 25: a key on the
    // lab's map, its words small; 26: not to be chosen here, its words
    // faint; 29: the page round a menu, which shuts it, with no shade or hand)
    if (root.c.kind >= 5 && root.c.kind <= 8) && !(root.c.kind == 7 && (root.c.style == 0 || root.c.style == 33 || root.c.style == 35 || root.c.style == 37)): Rectangle {
        // (style 36: a card that opens, in the well's shade on a box: a script's; 37: a
        // button that can't be used now, faded)
        opacity: root.c.style == 37 ? 0.4 : 1;
        border-radius: root.c.style == 36 ? Radius.panel : root.c.style == 25 ? Radius.tiny : root.c.kind == 8 || root.c.style == 33 ? Radius.small : Radius.control;
        background: root.c.style == 36 ? (b.has-hover ? Ink.hover-well : Ink.well)
            : root.c.on ? (b.has-hover ? Ink.pick-hover : Ink.pick)
            : root.c.style == 26 ? transparent
            : root.c.style == 31 ? (b.has-hover ? Ink.pick : Ink.hover-box)
            : root.c.kind == 5 ? (b.has-hover ? Ink.hover-well : transparent)
            : root.c.kind == 8 ? (b.has-hover && root.c.style != 29 ? Ink.white.with-alpha(0.059) : transparent)
            : (b.has-hover ? Ink.pick : Ink.hover-box);
        // style 32: a color's button, its color in a small square before its words
        if root.c.style == 32: Rectangle {
            x: 9px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            border-radius: Radius.tiny;
            background: root.c.color;
            border-width: 1px;
            border-color: Ink.white.with-alpha(0.2);
        }
        // style 35: an icon before its words, drawn as the bar's buttons draw theirs (its lines, on 16 units)
        if root.c.style == 35: Path {
            x: 12px;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: root.c.lines;
            fill: transparent;
            stroke: Ink.ink;
            stroke-width: 1.14px;
            stroke-line-cap: round;
        }
        // style 31 with an icon's shapes: the icon, as its key prints it
        if root.c.style == 31 && (root.c.fill != "" || root.c.lines != ""): Rectangle {
            x: (parent.width - 20px) / 2;
            y: (parent.height - 20px) / 2;
            width: 20px;
            height: 20px;
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.c.fill;
                fill: b.has-hover ? Ink.white : Ink.dim;
            }
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.c.lines;
                fill: transparent;
                stroke: b.has-hover ? Ink.white : Ink.dim;
                stroke-width: 1.67px;
            }
        }
        Text {
            x: root.c.style == 32 ? 32px : root.c.style == 35 ? 12px + 14px + 7px : (parent.width - self.width) / 2 - (root.c.style == 24 ? 7px : 0);
            y: (parent.height - self.height) / 2 + (b.pressed && (root.c.kind == 7 || root.c.kind == 8) ? 1px : 0);
            text: root.c.text;
            font-family: Font.ui;
            font-size: root.c.style == 25 ? Font.small : root.c.style == 31 ? Font.title : root.c.style == 33 ? Font.caption : root.c.kind == 8 ? Font.note : Font.control;
            font-weight: root.c.kind >= 7 && root.c.style != 33 ? Font.medium : Font.regular;
            color: root.c.on ? Ink.bright : root.c.style == 26 ? Ink.off : root.c.style == 33 ? (b.has-hover ? Ink.bright : Ink.dim) : root.c.kind == 8 ? (b.has-hover ? Ink.ink : Ink.quiet) : root.c.kind == 7 ? Ink.ink : b.has-hover ? Ink.white : Ink.dim;
        }
        if root.c.style == 24 || root.c.style == 32: Path {
            x: parent.width - 19px;
            y: (parent.height - 6px) / 2;
            width: 9px;
            height: 6px;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M1 1l4 4 4-4";
            fill: transparent;
            stroke: root.c.on ? Ink.base : Ink.quiet;
            stroke-width: 1.35px;
        }
        b := TouchArea {
            enabled: root.c.style != 26 && root.c.style != 37;
            mouse-cursor: root.c.style == 29 ? MouseCursor.default : MouseCursor.pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height, root.width); }
            // style 23: it tells the page the pointer is over it, as a zone does
            changed has-hover => {
                if (root.c.style == 23 || root.c.style == 31 || root.c.style == 32) {
                    root.hovered(root.c.id, self.has-hover);
                }
            }
        }
    }
    // ---- the Lighting page's own pieces, in the shades of its boxes
    // a value in a small well; style 1, a warning's tag, as the Tag draws one
    // (style 2: on a well, a step lighter than it; 3: a card's Main card, on the box)
    // (style 4: a tag on a well, in the box's shade, its words quiet: a script's Every game)
    if root.c.kind == 40: Rectangle {
        border-radius: Radius.small;
        background: root.c.style == 1 ? Ink.warn.with-alpha(0.133) : root.c.style == 2 ? Ink.hover-box : root.c.style == 3 ? Ink.pick : root.c.style == 4 ? Ink.box : Ink.well;
        Text {
            text: root.c.text;
            font-family: Font.ui;
            font-size: root.c.style == 1 ? Font.small : root.c.style == 2 ? Font.caption : Font.caption;
            font-weight: root.c.style == 1 || root.c.style == 2 || root.c.style == 3 || root.c.style == 4 ? Font.regular : Font.medium;
            color: root.c.style == 1 ? Ink.warn : root.c.style == 2 || root.c.style == 3 ? Ink.bright : root.c.style == 4 ? Ink.quiet : Ink.dim;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // a slider, filled to its place in its color: the Slider, `style` by what it sits on
    if root.c.kind == 41: Slider {
        width: parent.width;
        height: parent.height;
        value: root.c.value;
        fill: root.c.color;
        style: root.c.style;
        moved(v) => { root.slide(root.c.id, v); }
        reset => { root.reset(root.c.id); }
    }
    // a color's dot, ringed while the picker is open on it; style 1 opens the picker for any color
    // (in a cell under 28 across, as a narrow box has them: the dot 20 across, its ring a
    // hairline of the brightest ink, kept apart from it by the box's own shade)
    if root.c.kind == 42 && root.c.style != 2: dotcell := Rectangle {
        property <bool> small: root.width < 28px;
        border-radius: self.width / 2;
        border-width: root.c.on ? (self.small ? 1.5px : 2px) : 0;
        border-color: self.small ? Ink.bright : Ink.dim;
        Rectangle {
            property <length> d: dotcell.small ? (dot-ta.has-hover ? 22px : 20px) : dot-ta.has-hover ? 26px : 24px;
            x: (parent.width - self.d) / 2;
            y: (parent.height - self.d) / 2;
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            background: root.c.style == 1 ? (dot-ta.has-hover ? Ink.hover-box : transparent) : root.c.color;
            border-width: root.c.style == 1 || !dotcell.small ? 1px : 0;
            border-color: root.c.style == 1 ? (dot-ta.has-hover ? Ink.placeholder : Ink.edge) : Ink.white.with-alpha(0.165);
            if root.c.style == 1: Path {
                width: dotcell.small ? 10px : 12px;
                height: dotcell.small ? 10px : 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M6 1.5v9M1.5 6h9";
                fill: transparent;
                stroke: dot-ta.has-hover ? Ink.bright : Ink.soft;
                stroke-width: 1.5px;
            }
        }
        dot-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height, root.width); }
        }
    }
    // style 2: a color's dot and its code as one button (the screen's default backlight)
    if root.c.kind == 42 && root.c.style == 2: ColorButton {
        width: parent.width;
        height: parent.height;
        swatch: root.c.color;
        code: root.c.text;
        open: root.c.on;
        clicked(x, y, h) => { root.pick(root.c.id, root.c.index, x, y, root.height, root.width); }
    }
    // a piece of a run of colors, from its color to the next (its red, green and blue packed in
    // `value`, as 65536 r + 256 g + b); style says which ends are round
    if root.c.kind == 43: Rectangle {
        property <color> next: rgb(floor(root.c.value / 65536), mod(floor(root.c.value / 256), 256), mod(root.c.value, 256));
        border-top-left-radius: mod(root.c.style, 2) == 1 ? self.height / 2 : 0;
        border-bottom-left-radius: mod(root.c.style, 2) == 1 ? self.height / 2 : 0;
        border-top-right-radius: root.c.style >= 2 ? self.height / 2 : 0;
        border-bottom-right-radius: root.c.style >= 2 ? self.height / 2 : 0;
        background: @linear-gradient(90deg, root.c.color 0%, self.next 100%);
    }
    // a switch's choice on its ground, its icon before its words if it has one (style 1,
    // or 26: one that can't be chosen, its words faint; 24: one that opens a list, its
    // chevron after its words; 32: a color's, its square before its words and its
    // chevron after them; 23 and 32 tell the page the pointer is on them)
    if root.c.kind == 44: SegChoice {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        icon: root.c.lines;
        on: root.c.on;
        off: root.c.style == 1 || root.c.style == 26;
        menu: root.c.style == 24 || root.c.style == 32;
        square: root.c.style == 32;
        swatch: root.c.color;
        clicked(x, y, h) => { root.pick(root.c.id, root.c.index, x, y, root.height, root.width); }
        changed hover => {
            if (root.c.style == 23 || root.c.style == 32) {
                root.hovered(root.c.id, self.hover);
            }
        }
    }
    // an area's chip: outlined, white when chosen (with a tick, style 1); it tells the page the pointer is over it
    if root.c.kind == 45: Rectangle {
        // (style 1 ticked when chosen; style 2 faded, the whole keyboard lit;
        // value 1 when the pointer is over its area on the keyboard's picture)
        property <bool> hot: ar-ta.has-hover || root.c.value > 0.5;
        border-radius: self.height / 2;
        background: root.c.on ? (self.hot ? Ink.pick-hover : Ink.pick) : self.hot ? Ink.hover-well : Ink.well;
        opacity: root.c.style == 2 && !self.hot ? 0.45 : 1;
        // (the tick, 12, and its gap, 5, take Part.chip-tick: the 3 more come out of the
        // chip's left side)
        HorizontalLayout {
            padding-left: root.c.on ? Part.chip-pad + Part.chip-tick - 17px : Part.chip-pad;
            padding-right: Part.chip-pad;
            spacing: 5px;
            if root.c.on: Path {
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M5 12.5l4.5 4.5L19 7.5";
                fill: transparent;
                stroke: Ink.bright;
                stroke-width: 2.6px;
            }
            Text {
                text: root.c.text;
                font-family: Font.ui;
                font-size: Font.note;
                color: root.c.on || ar-ta.has-hover || root.c.value > 0.5 ? Ink.bright : Ink.soft;
                vertical-alignment: center;
            }
        }
        ar-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height, root.width); }
            changed has-hover => { root.hovered(root.c.index, self.has-hover); }
        }
    }
    // a dropdown: the DropField (style 1: its value followed from elsewhere, in gray;
    // 2: its value needs choosing again, an amber line round it); a chip before its
    // words where `value` names one (one more than its place)
    if root.c.kind == 46: DropField {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        open: root.c.on;
        followed: root.c.style == 1;
        warn: root.c.style == 2;
        chip-on: root.c.value > 0;
        chip: root.c.value > 0 ? root.chips[round(root.c.value) - 1] : root.glyph;
        clicked(x, y, h) => { root.pick(root.c.id, root.c.index, x, y, root.height, root.width); }
    }
    // a link in a sentence: its words brighter than the note round them, which select it
    if root.c.kind == 18: Text {
        text: root.c.text;
        font-family: Font.ui;
        font-size: Font.note;
        color: il-ta.has-hover ? Ink.white : Ink.bright;
        vertical-alignment: center;
        il-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height, root.width); }
        }
    }
    // a quiet link: Reset (with its icon), Select all, Scatter colors (style 1: a text
    // button in a plugin's section, its icon on 14 units; 2: the same, not to be used now, faded)
    if root.c.kind == 47 && root.c.style == 0: LinkButton {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        icon: root.c.lines;
        units: 24;
        clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height, root.width); }
    }
    if root.c.kind == 47 && root.c.style != 0: TextButton {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        icon: root.c.lines;
        enabled: root.c.style != 2;
        clicked => { root.pick(root.c.id, root.c.index, self.absolute-position.x, self.absolute-position.y, root.height, root.width); }
    }
    // a thing the firmware adds: a tick, then its name
    if root.c.kind == 49: Rectangle {
        Path {
            x: 0;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M5 12.5l4.5 4.5L19 7.5";
            fill: transparent;
            stroke: Ink.good;
            stroke-width: 2.4px;
        }
        Text {
            x: 19px;
            width: parent.width - 19px;
            text: root.c.text;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.dim;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // a fold's heading in a plugin's section, which opens and shuts it: the Fold
    if root.c.kind == 53: Fold {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        open: root.c.on;
        clicked => { root.pick(root.c.id, root.c.index, 0, 0, 0, 0); }
    }
    // a checkbox on a box, and its words (style 1: one that can't be changed now, faint and
    // unticked; 2: one held on by another setting, ticked in gray)
    if root.c.kind == 48: CheckBox {
        width: parent.width;
        height: parent.height;
        text: root.c.text;
        on: root.c.on;
        state: root.c.style;
        clicked => { root.pick(root.c.id, root.c.index * 2 + (root.c.on ? 0 : 1), 0, 0, 0, 0); }
    }
}

// A box of pieces laid out in Rust, for a row of boxes: its title, the least
// width the row grows it from, how tall its pieces are at the width the row
// gave it, and the pieces themselves
export struct LaidBox {
    title: string,
    least: length,
    h: length,
    cells: [Cell],
}

// A box in a device page's row whose pieces are laid out in Rust, from what a
// core or a plugin describes (an effect's settings, a mouse's): the row places
// it as it does any box and it says how wide it came out (`resized`), so Rust
// lays its pieces out to that width. Holding more than its height, it scrolls.
export component CellBox inherits ScrollBox {
    in property <LaidBox> b;
    callback resized(length);
    callback pick(int, int, length, length, length, length);
    callback slide(int, float);
    callback typed(int, int, string);
    callback hovered(int, bool);
    min-width: root.b.least;
    preferred-width: root.b.least;
    preferred-height: root.b.h;
    need: root.b.h;
    init => { root.resized(self.width); }
    changed width => { root.resized(self.width); }
    PageBox {
        width: parent.width;
        height: max(root.b.h, root.height);
        fill: transparent;
        title: root.b.title;
        for c in root.b.cells: CellView {
            c: c;
            pick(id, index, x, y, h, w) => { root.pick(id, index, x, y, h, w); }
            slide(id, v) => { root.slide(id, v); }
            typed(id, index, t) => { root.typed(id, index, t); }
            hovered(i, on) => { root.hovered(i, on); }
        }
    }
}
