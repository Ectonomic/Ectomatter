// What lifts off a page to choose from: a menu and the color picker.

import { Space, Radius, Font, Line, Size, Part, Stroke, Shadow, Ink } from "tokens.slint";
import { Typing } from "state.slint";
import { ScrollBar, PickField, Well, FieldBox, Tag, PencilButton } from "controls.slint";

// a row in a menu: 0 a choice, 1 a heading, 2 a rule, 3 a note, 4 a choice
// in red (one that deletes), 5 a choice that can't be made now
export struct MenuRow {
    kind: int,
    label: string,
    tag: string,
    tick: bool,
    sub: string,
    // a chip before its name (a scene's colors), in a column kept for it in every row
    // of a menu that has chips (chipped, the chip left empty to keep the column);
    // a pencil at its right under the pointer, to change it (a scene of the person's own)
    chip: image,
    chipped: bool,
    edit: bool,
    // a note's lines, where it takes more than one (its words wrap, its row as tall as they need)
    lines: int,
    // an amber dot after its name: something of its own (a light with its own setup)
    dot: bool,
}

// a drop-down: its way back (on a page of it), a search, then its rows. It
// lifts off by shade and shadow, without an edge.
export component Menu inherits Rectangle {
    in property <[MenuRow]> rows;
    // whether its rows keep a column for a tick: none in a menu that never ticks what is chosen
    in property <bool> marks: true;
    in property <string> placeholder;
    in property <bool> back;
    in property <bool> search: true;
    in-out property <string> query;
    callback chose(int);
    // a row's pencil pressed
    callback edit(int);
    callback go-back();
    callback typed(string);
    callback enter();
    callback dismiss();
    callback field-done(int, string);
    border-radius: Radius.panel;
    background: Ink.shade2;
    drop-shadow-blur: Shadow.float.blur;
    drop-shadow-offset-y: Shadow.float.y;
    drop-shadow-color: Shadow.float.color;
    // (its rows, Back and its search box Part.menu-pad in from its edges; src/menu_size.rs
    // works its height out from the same tokens)
    property <length> back-h: root.back ? Size.control : 0;
    public function focus-search() {
        search.start-typing();
    }
    public function blur-search() {
        search.stop-typing();
    }
    // its list turned `y` down (as it opens: to what's chosen, else its top)
    public function scroll-to(y: length) {
        mflick.content-y = -y;
    }
    if root.back: Rectangle {
        x: Part.menu-pad;
        y: Part.menu-pad;
        width: parent.width - 2 * Part.menu-pad;
        height: Size.control;
        border-radius: Radius.control;
        background: back-ta.has-hover ? Ink.tint : transparent;
        Text {
            x: Part.menu-in + Part.glyph + Space.inline;
            height: parent.height;
            text: "‹ Back";
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        back-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.go-back(); }
        }
    }
    property <length> search-h: root.search ? Size.control + Part.menu-pad : 0;
    search := FieldBox {
        visible: root.search;
        x: Part.menu-pad;
        y: Part.menu-pad + back-h;
        width: parent.width - 2 * Part.menu-pad;
        fill: Ink.shade1;
        fill-typing: Ink.shade1;
        placeholder: root.placeholder;
        text <=> root.query;
        edited => { root.typed(self.text); }
        accepted => { root.enter(); }
        escape => { root.dismiss(); }
    }
    mflick := Flickable {
        x: Part.menu-pad;
        y: Part.menu-pad + back-h + search-h;
        width: parent.width - 2 * Part.menu-pad;
        height: parent.height - self.y - Part.menu-pad;
        content-height: list.preferred-height;
        mouse-drag-pan-enabled: false;
        list := VerticalLayout {
            for row[i] in root.rows: mrow := Rectangle {
                // (its pencil under the pointer: the row stays lit)
                property <bool> pen-hot;
                height: row.kind == 1 ? Size.menu-head : row.kind == 2 ? Size.menu-rule : row.kind == 3 && row.lines > 1 ? 2 * Space.inline + row.lines * Line.text : Size.control;
                background: (row.kind == 0 || row.kind == 4 || row.kind == 7) && (item.has-hover || (row.edit && mrow.pen-hot)) ? Ink.tint : transparent;
                border-radius: Radius.control;
                if row.kind == 1: Text {
                    x: Part.menu-in;
                    y: (Size.menu-head - self.height) / 2;
                    height: Line.note;
                    text: row.label;
                    font-family: Font.ui;
                    font-size: Font.caption;
                    color: Ink.soft;
                    vertical-alignment: center;
                }
                if row.kind == 2: Rectangle {
                    x: Space.tight;
                    y: (Size.menu-rule - self.height) / 2;
                    width: parent.width - 2 * Space.tight;
                    height: Stroke.line;
                    // (the app's line is too near the menu's own gray to be seen on it)
                    background: Ink.white.with-alpha(0.09);
                }
                if row.kind == 3: Text {
                    x: Part.menu-in;
                    width: parent.width - 2 * Part.menu-in;
                    height: parent.height;
                    text: row.label;
                    font-family: Font.ui;
                    font-size: Font.control;
                    color: Ink.quiet;
                    vertical-alignment: center;
                    wrap: row.lines > 1 ? TextWrap.word-wrap : TextWrap.no-wrap;
                }
                // a way to somewhere else to find more (the Sensor Feed box in Settings), under the choices
                if row.kind == 7: Text {
                    x: root.marks ? Part.menu-in + Part.glyph + Space.inline : Space.row;
                    height: parent.height;
                    text: row.label;
                    font-family: Font.ui;
                    font-size: Font.control;
                    color: item.has-hover ? Ink.dim : Ink.soft;
                    vertical-alignment: center;
                }
                // a choice with a number to type beside it: its label chooses, the field sets
                if row.kind == 6: HorizontalLayout {
                    padding-left: Part.menu-in;
                    padding-right: Part.menu-in;
                    spacing: Space.inline;
                    Text {
                        width: Part.glyph;
                        text: row.tick ? "✓" : "";
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.label;
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.chose(i); }
                        }
                    }
                    // (the number in a field's look: a well, a shade lighter while it's typed in)
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: Part.menu-number;
                            height: Size.quiet;
                            border-radius: Radius.small;
                            background: number.has-focus ? Ink.hover-well : Ink.well;
                            number := TextInput {
                                x: Part.pill-pad;
                                width: parent.width - 2 * Part.pill-pad;
                                height: parent.height;
                                text: row.tag;
                                font-family: Font.ui;
                                font-size: Font.control;
                                color: Ink.ink;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { root.field-done(i, self.text); }
                                changed has-focus => { Typing.on = self.has-focus; if (!self.has-focus && self.text != row.tag) { root.field-done(i, self.text); } }
                            }
                        }
                    }
                    Text {
                        text: row.sub == "" ? "ms" : row.sub;
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                }
                // (its pieces Space.inline apart; src/menu_size.rs measures a row's width from the
                // same tokens)
                if row.kind == 0 || row.kind == 4 || row.kind == 5: HorizontalLayout {
                    opacity: row.kind == 5 ? 0.35 : 1;
                    padding-left: root.marks ? Part.menu-in : Space.row;
                    padding-right: Part.menu-in;
                    spacing: Space.inline;
                    // (a column for ticks only in a menu that ticks what is chosen)
                    if root.marks: Text {
                        width: Part.glyph;
                        text: row.tick ? "✓" : "";
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                    // (its words a check's gap after it, as a check's are)
                    if row.chipped: Rectangle {
                        width: Part.glyph + Part.check-gap - Space.inline;
                        Image {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: Part.glyph;
                            height: Part.glyph;
                            source: row.chip;
                            image-fit: fill;
                        }
                    }
                    // (a tag, the Tag, before its name)
                    if row.tag != "": VerticalLayout {
                        alignment: center;
                        Tag { text: row.tag; }
                    }
                    Text {
                        horizontal-stretch: row.dot ? 0 : 1;
                        text: row.label;
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: row.kind == 4 ? Ink.bad : Ink.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // (its dot after its name)
                    if row.dot: HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: Size.dot;
                                height: Size.dot;
                                border-radius: self.width / 2;
                                background: Ink.warn;
                            }
                        }
                    }
                    // (what a row says on its right never crowds out its own name)
                    if row.sub != "": Text {
                        max-width: root.width * Part.menu-aside;
                        text: row.sub;
                        font-family: Font.ui;
                        font-size: Font.caption;
                        color: Ink.quiet;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                item := TouchArea {
                    enabled: row.kind == 0 || row.kind == 4 || row.kind == 7;
                    mouse-cursor: pointer;
                    clicked => { root.chose(i); }
                }
                // (the pencil, as everything renamed in place has, at its end under the pointer)
                if row.edit: PencilButton {
                    x: parent.width - self.width - Space.tight;
                    y: (parent.height - self.height) / 2;
                    visible: item.has-hover || self.hover;
                    hover-fill: Ink.white.with-alpha(0.078);
                    changed hover => { mrow.pen-hot = self.hover; }
                    clicked => { root.edit(i); }
                }
            }
        }
    }
    ScrollBar {
        x: parent.width - Part.scroll-in;
        y: mflick.y;
        height: mflick.height;
        view: mflick.height;
        content: mflick.content-height;
        offset: -mflick.content-y;
        framed: false;
        thumb-color: Ink.edge;
        scroll-to(o) => { mflick.content-y = -o; }
    }
}

// the color picker every swatch opens, laid out as design tools lay theirs:
// saturation across and brightness down for the chosen hue, the hue under it,
// the color as a hex code, as red, green and blue, and as hue, saturation and
// brightness, then preset colors and the ones used lately
export component Picker inherits Rectangle {
    in property <float> hue;
    in property <float> sat;
    in property <float> val;
    in property <color> now;
    in property <color> pure;
    in property <image> sv-img;
    in property <image> hue-img;
    in-out property <string> t-hex;
    in-out property <string> t-r;
    in-out property <string> t-g;
    in-out property <string> t-b;
    in-out property <string> t-h;
    in-out property <string> t-s;
    in-out property <string> t-v;
    in property <[color]> presets;
    in property <[color]> recent;
    callback sv(float, float);
    callback hue-at(float);
    callback field(int, string);
    callback well(color);
    callback enter();
    callback dismiss();
    // art: the picker's own anatomy, laid out as design tools lay theirs: the square, the
    // hue, two rows of numbers, then the wells, nine to a row
    property <length> pad: Part.menu-pad;
    property <length> gap: 10px; // art: between its parts
    property <length> square: 160px; // art: the square
    property <length> hue-h: 12px; // art: the hue's strip
    property <length> fields-h: 45px; // art: a row of numbers, its labels over its boxes
    property <length> label-h: 16px; // art: Presets, Recent
    property <length> label-gap: 6px; // art: a label over its wells
    property <length> well-gap: 5px; // art: between wells
    property <length> well-w: (root.width - 2 * root.pad - 8 * root.well-gap) / 9;
    property <length> fields-y: root.pad + root.square + root.gap + root.hue-h + root.gap;
    property <length> presets-y: root.fields-y + 2 * root.fields-h + 2 * root.gap;
    property <length> recent-y: root.presets-y + root.label-h + root.label-gap + root.well-w + root.gap;
    // how tall it is, for the window to hang it by: with the wells used lately, or without
    out property <length> natural: (root.recent.length > 0 ? root.recent-y : root.presets-y) + root.label-h + root.label-gap + root.well-w + root.pad;
    width: Size.picker;
    border-radius: Radius.panel;
    background: Ink.shade2;
    drop-shadow-blur: Shadow.float.blur;
    drop-shadow-offset-y: Shadow.float.y;
    drop-shadow-color: Shadow.float.color;
    // the square: white to the hue across, then to black downward
    Rectangle {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: root.square;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.sv-img;
            image-fit: fill;
        }
        sv-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.sv(max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
                }
            }
            moved => {
                if (self.pressed) {
                    root.sv(max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
                }
            }
        }
        Rectangle {
            x: root.sat * parent.width - 10px; // art: the square's knob
            y: (1 - root.val) * parent.height - 10px; // art: the square's knob
            width: 20px; // art: the square's knob
            height: 20px; // art: the square's knob
            border-radius: self.width / 2;
            background: Ink.black.with-alpha(0.4);
            Rectangle {
                x: 1px; // art: the square's knob
                y: 1px; // art: the square's knob
                width: 18px; // art: the square's knob
                height: 18px; // art: the square's knob
                border-radius: self.width / 2;
                background: Ink.white;
                Rectangle {
                    x: 2px; // art: the square's knob
                    y: 2px; // art: the square's knob
                    width: 14px; // art: the square's knob
                    height: 14px; // art: the square's knob
                    border-radius: self.width / 2;
                    background: root.now;
                }
            }
        }
    }
    // the hue
    Rectangle {
        x: root.pad;
        y: root.pad + root.square + root.gap;
        width: parent.width - 2 * root.pad;
        height: root.hue-h;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.hue-img;
            image-fit: fill;
        }
        hue-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.hue-at(max(0, min(1, self.mouse-x / self.width)));
                }
            }
            moved => {
                if (self.pressed) {
                    root.hue-at(max(0, min(1, self.mouse-x / self.width)));
                }
            }
        }
        Rectangle {
            x: root.hue / 360 * parent.width - 10px; // art: the hue's knob
            y: -4px;
            width: 20px; // art: the hue's knob
            height: 20px; // art: the hue's knob
            border-radius: self.width / 2;
            border-width: 1px; // art: the hue's knob
            border-color: Ink.black.with-alpha(0.4);
            Rectangle {
                x: 1px; // art: the hue's knob
                y: 1px; // art: the hue's knob
                width: 18px; // art: the hue's knob
                height: 18px; // art: the hue's knob
                border-radius: self.width / 2;
                border-width: 2px; // art: the hue's knob
                border-color: Ink.white;
            }
        }
    }
    // the color as numbers
    HorizontalLayout {
        x: root.pad;
        y: root.fields-y;
        width: parent.width - 2 * root.pad;
        height: root.fields-h;
        spacing: root.pad;
        PickField { horizontal-stretch: 1.7; label: "Hex"; which: 0; value <=> root.t-hex; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "R"; which: 1; value <=> root.t-r; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "G"; which: 2; value <=> root.t-g; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "B"; which: 3; value <=> root.t-b; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
    }
    HorizontalLayout {
        x: root.pad;
        y: root.fields-y + root.fields-h + root.gap;
        width: parent.width - 2 * root.pad;
        height: root.fields-h;
        spacing: root.pad;
        PickField { label: "H°"; which: 4; value <=> root.t-h; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { label: "S%"; which: 5; value <=> root.t-s; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { label: "B%"; which: 6; value <=> root.t-v; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
    }
    // preset colors, then the ones used lately
    Text {
        x: root.pad;
        y: root.presets-y;
        height: root.label-h;
        text: "Presets";
        font-family: Font.ui;
        font-size: Font.caption;
        color: Ink.quiet;
    }
    for c[i] in root.presets: Well {
        x: root.pad + i * (root.well-w + root.well-gap);
        y: root.presets-y + root.label-h + root.label-gap;
        width: root.well-w;
        c: c;
        clicked => { root.well(c); }
    }
    if root.recent.length > 0: Text {
        x: root.pad;
        y: root.recent-y;
        height: root.label-h;
        text: "Recent";
        font-family: Font.ui;
        font-size: Font.caption;
        color: Ink.quiet;
    }
    for c[i] in root.recent: Well {
        x: root.pad + i * (root.well-w + root.well-gap);
        y: root.recent-y + root.label-h + root.label-gap;
        width: root.well-w;
        c: c;
        clicked => { root.well(c); }
    }
}
