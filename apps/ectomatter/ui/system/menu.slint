// What lifts off a page to choose from: a menu and the color picker.

import { Space, Radius, Font, Size, Part, Shadow, Ink } from "tokens.slint";
import { Typing } from "state.slint";
import { ScrollBar, PickField, Well } from "controls.slint";

// a row in a menu: 0 a choice, 1 a heading, 2 a rule, 3 a note, 4 a choice
// in red (one that deletes), 5 a choice that can't be made now
export struct MenuRow {
    kind: int,
    label: string,
    tag: string,
    tick: bool,
    sub: string,
    // a chip before its name (a scene's colors), in a column kept for it in every row
    // of a menu that has chips (chipped, the chip left empty to keep the column);
    // a pencil at its right under the pointer, to change it (a scene of the person's own)
    chip: image,
    chipped: bool,
    edit: bool,
    // a note's lines, where it takes more than one (its words wrap, its row as tall as they need)
    lines: int,
}

// a drop-down: its way back (on a page of it), a search, then its rows. It
// lifts off by shade and shadow, without an edge.
export component Menu inherits Rectangle {
    in property <[MenuRow]> rows;
    // whether its rows keep a column for a tick: none in a menu that never ticks what is chosen
    in property <bool> marks: true;
    in property <string> placeholder;
    in property <bool> back;
    in property <bool> search: true;
    in-out property <string> query;
    callback chose(int);
    // a row's pencil pressed
    callback edit(int);
    callback go-back();
    callback typed(string);
    callback enter();
    callback dismiss();
    callback field-done(int, string);
    border-radius: Radius.panel;
    background: Ink.shade2;
    drop-shadow-blur: Shadow.float.blur;
    drop-shadow-offset-y: Shadow.float.y;
    drop-shadow-color: Shadow.float.color;
    property <length> back-h: root.back ? 33px : 0;
    public function focus-search() {
        search.focus();
    }
    public function blur-search() {
        search.clear-focus();
    }
    if root.back: Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 33px;
        border-radius: Radius.control;
        background: back-ta.has-hover ? Ink.tint : transparent;
        Text {
            x: 10px + 14px + 8px;
            height: parent.height;
            text: "‹ Back";
            font-family: Font.ui;
            font-size: Font.text;
            color: Ink.quiet;
            vertical-alignment: center;
        }
        back-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.go-back(); }
        }
    }
    property <length> search-h: root.search ? 33px + 6px : 0;
    Rectangle {
        visible: root.search;
        x: 6px;
        y: 6px + back-h;
        width: parent.width - 12px;
        height: 33px;
        border-radius: Radius.control;
        background: Ink.shade1;
        if search.text == "": Text {
            x: 10px;
            height: parent.height;
            text: root.placeholder;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.placeholder;
            vertical-alignment: center;
        }
        search := TextInput {
            changed has-focus => { Typing.on = self.has-focus; }
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.query;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.ink;
            vertical-alignment: center;
            single-line: true;
            edited => { root.typed(self.text); }
            accepted => { root.enter(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.dismiss();
                    return accept;
                }
                reject
            }
        }
    }
    mflick := Flickable {
        x: 6px;
        y: 6px + back-h + search-h;
        width: parent.width - 12px;
        height: parent.height - self.y - 6px;
        content-height: list.preferred-height;
        mouse-drag-pan-enabled: false;
        list := VerticalLayout {
            for row[i] in root.rows: Rectangle {
                height: row.kind == 1 ? 28px : row.kind == 2 ? 11px : row.kind == 3 && row.lines > 1 ? 15px + row.lines * 17px : 33px;
                background: (row.kind == 0 || row.kind == 4 || row.kind == 7) && (item.has-hover || (row.edit && pen.has-hover)) ? Ink.tint : transparent;
                border-radius: Radius.control;
                if row.kind == 1: Text {
                    x: 10px;
                    y: 7px;
                    height: 17px;
                    text: row.label;
                    font-family: Font.ui;
                    font-size: Font.caption;
                    color: Ink.soft;
                    vertical-alignment: center;
                }
                if row.kind == 2: Rectangle {
                    x: 4px;
                    y: 5px;
                    width: parent.width - 8px;
                    height: 1px;
                    // (the app's line is too near the menu's own gray to be seen on it)
                    background: Ink.white.with-alpha(0.09);
                }
                if row.kind == 3: Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: row.label;
                    font-family: Font.ui;
                    font-size: Font.control;
                    color: Ink.quiet;
                    vertical-alignment: center;
                    wrap: row.lines > 1 ? TextWrap.word-wrap : TextWrap.no-wrap;
                }
                // a way to somewhere else to find more (the Sensor Feed box in Settings), under the choices
                if row.kind == 7: Text {
                    x: root.marks ? 32px : 12px;
                    height: parent.height;
                    text: row.label;
                    font-family: Font.ui;
                    font-size: Font.control;
                    color: item.has-hover ? Ink.dim : Ink.soft;
                    vertical-alignment: center;
                }
                // a choice with a number to type beside it: its label chooses, the field sets
                if row.kind == 6: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        width: 14px;
                        text: row.tick ? "✓" : "";
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.label;
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.chose(i); }
                        }
                    }
                    Rectangle {
                        width: 64px + 6px;
                        Rectangle {
                            x: 6px;
                            y: (parent.height - 24px) / 2;
                            width: 64px;
                            height: 24px;
                            border-radius: Radius.small;
                            border-width: 1px;
                            border-color: Ink.line;
                            background: Ink.base;
                            TextInput {
                                x: 7px;
                                width: parent.width - 14px;
                                height: parent.height;
                                text: row.tag;
                                font-family: Font.ui;
                                font-size: Font.control;
                                color: Ink.ink;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { root.field-done(i, self.text); }
                                changed has-focus => { Typing.on = self.has-focus; if (!self.has-focus && self.text != row.tag) { root.field-done(i, self.text); } }
                            }
                        }
                    }
                    Text {
                        text: row.sub == "" ? "ms" : row.sub;
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                }
                if row.kind == 0 || row.kind == 4 || row.kind == 5: HorizontalLayout {
                    opacity: row.kind == 5 ? 0.35 : 1;
                    padding-left: root.marks ? 10px : 12px;
                    padding-right: 10px;
                    spacing: root.marks ? 8px : 0;
                    // (a column for ticks only in a menu that ticks what is chosen)
                    Text {
                        width: root.marks ? 14px : 0;
                        text: row.tick ? "✓" : "";
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: Ink.ink;
                        vertical-alignment: center;
                    }
                    if row.chipped: Rectangle {
                        width: 14px + 2px;
                        Image {
                            x: 0;
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                            source: row.chip;
                            image-fit: fill;
                        }
                    }
                    if row.tag != "": Rectangle {
                        width: tag.preferred-width + 12px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: tag.preferred-height + 2px;
                            border-width: 1px;
                            border-color: Ink.line;
                            border-radius: Radius.tiny;
                            tag := Text {
                                text: row.tag;
                                font-family: Font.ui;
                                font-size: Font.small;
                                color: Ink.quiet;
                            }
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: row.label;
                        font-family: Font.ui;
                        font-size: Font.text;
                        color: row.kind == 4 ? Ink.bad : Ink.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // (what a row says on its right never crowds out its own name)
                    if row.sub != "": Text {
                        max-width: root.width * 0.55;
                        text: row.sub;
                        font-family: Font.ui;
                        font-size: Font.caption;
                        color: Ink.quiet;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                item := TouchArea {
                    enabled: row.kind == 0 || row.kind == 4 || row.kind == 7;
                    mouse-cursor: pointer;
                    clicked => { root.chose(i); }
                }
                if row.edit && (item.has-hover || pen.has-hover): Rectangle {
                    x: parent.width - 30px;
                    y: (parent.height - 24px) / 2;
                    width: 24px;
                    height: 24px;
                    border-radius: Radius.small;
                    background: pen.has-hover ? Ink.white.with-alpha(0.078) : transparent;
                    Path {
                        width: 13px;
                        height: 13px;
                        viewbox-width: 14;
                        viewbox-height: 14;
                        commands: "M9.6 2.2l2.2 2.2-7 7H2.6V9.2ZM8.3 3.5l2.2 2.2";
                        fill: transparent;
                        stroke: pen.has-hover ? Ink.bright : Ink.soft;
                        stroke-width: 1.3px;
                    }
                }
                pen := TouchArea {
                    x: parent.width - 30px;
                    width: row.edit ? 24px : 0;
                    enabled: row.edit;
                    mouse-cursor: pointer;
                    clicked => { root.edit(i); }
                }
            }
        }
    }
    ScrollBar {
        x: parent.width - 12px;
        y: mflick.y;
        height: mflick.height;
        view: mflick.height;
        content: mflick.content-height;
        offset: -mflick.content-y;
        framed: false;
        thumb-color: Ink.edge;
        scroll-to(o) => { mflick.content-y = -o; }
    }
}

// the color picker every swatch opens, laid out as design tools lay theirs:
// saturation across and brightness down for the chosen hue, the hue under it,
// the color as a hex code, as red, green and blue, and as hue, saturation and
// brightness, then preset colors and the ones used lately
export component Picker inherits Rectangle {
    in property <float> hue;
    in property <float> sat;
    in property <float> val;
    in property <color> now;
    in property <color> pure;
    in property <image> sv-img;
    in property <image> hue-img;
    in-out property <string> t-hex;
    in-out property <string> t-r;
    in-out property <string> t-g;
    in-out property <string> t-b;
    in-out property <string> t-h;
    in-out property <string> t-s;
    in-out property <string> t-v;
    in property <[color]> presets;
    in property <[color]> recent;
    callback sv(float, float);
    callback hue-at(float);
    callback field(int, string);
    callback well(color);
    callback enter();
    callback dismiss();
    width: 264px;
    border-radius: Radius.panel;
    background: Ink.shade2;
    drop-shadow-blur: Shadow.float.blur;
    drop-shadow-offset-y: Shadow.float.y;
    drop-shadow-color: Shadow.float.color;
    // the square: white to the hue across, then to black downward
    Rectangle {
        x: 6px;
        y: 6px;
        width: 252px;
        height: 160px;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.sv-img;
            image-fit: fill;
        }
        sv-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.sv(max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
                }
            }
            moved => {
                if (self.pressed) {
                    root.sv(max(0, min(1, self.mouse-x / self.width)), max(0, min(1, self.mouse-y / self.height)));
                }
            }
        }
        Rectangle {
            x: root.sat * parent.width - 10px;
            y: (1 - root.val) * parent.height - 10px;
            width: 20px;
            height: 20px;
            border-radius: self.width / 2;
            background: Ink.black.with-alpha(0.4);
            Rectangle {
                x: 1px;
                y: 1px;
                width: 18px;
                height: 18px;
                border-radius: self.width / 2;
                background: Ink.white;
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    border-radius: self.width / 2;
                    background: root.now;
                }
            }
        }
    }
    // the hue
    Rectangle {
        x: 6px;
        y: 6px + 160px + 10px;
        width: 252px;
        height: 12px;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.hue-img;
            image-fit: fill;
        }
        hue-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.hue-at(max(0, min(1, self.mouse-x / self.width)));
                }
            }
            moved => {
                if (self.pressed) {
                    root.hue-at(max(0, min(1, self.mouse-x / self.width)));
                }
            }
        }
        Rectangle {
            x: root.hue / 360 * parent.width - 10px;
            y: -4px;
            width: 20px;
            height: 20px;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: Ink.black.with-alpha(0.4);
            Rectangle {
                x: 1px;
                y: 1px;
                width: 18px;
                height: 18px;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: Ink.white;
            }
        }
    }
    // the color as numbers
    HorizontalLayout {
        x: 6px;
        y: 6px + 160px + 10px + 12px + 10px;
        width: 252px;
        height: 45px;
        spacing: 6px;
        PickField { horizontal-stretch: 1.7; label: "Hex"; which: 0; value <=> root.t-hex; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "R"; which: 1; value <=> root.t-r; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "G"; which: 2; value <=> root.t-g; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { horizontal-stretch: 1; label: "B"; which: 3; value <=> root.t-b; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
    }
    HorizontalLayout {
        x: 6px;
        y: 6px + 160px + 10px + 12px + 10px + 45px + 10px;
        width: 252px;
        height: 45px;
        spacing: 6px;
        PickField { label: "H°"; which: 4; value <=> root.t-h; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { label: "S%"; which: 5; value <=> root.t-s; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
        PickField { label: "B%"; which: 6; value <=> root.t-v; edited(i, t) => { root.field(i, t); } enter => { root.enter(); } dismiss => { root.dismiss(); } }
    }
    // preset colors, then the ones used lately
    Text {
        x: 6px;
        y: 308px;
        height: 16px;
        text: "Presets";
        font-family: Font.ui;
        font-size: Font.caption;
        color: Ink.quiet;
    }
    for c[i] in root.presets: Well {
        x: 6px + i * (23.56px + 5px);
        y: 330px;
        c: c;
        clicked => { root.well(c); }
    }
    if root.recent.length > 0: Text {
        x: 6px;
        y: 363.56px;
        height: 16px;
        text: "Recent";
        font-family: Font.ui;
        font-size: Font.caption;
        color: Ink.quiet;
    }
    for c[i] in root.recent: Well {
        x: 6px + i * (23.56px + 5px);
        y: 385.56px;
        c: c;
        clicked => { root.well(c); }
    }
}
