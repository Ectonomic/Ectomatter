// Lists down a page's side: the rail's items, and the anchoring column of a
// device's page (its profiles) with its rows and its heading.

import { Space, Radius, Font, Line, Size, Part, Stroke, Shadow, Ink } from "tokens.slint";
import { Typing } from "state.slint";
import { PencilButton, MoreButton, RenameField } from "controls.slint";
import { Tip } from "surfaces.slint";

// a profile's button in the panel's head
export struct ProfileItem {
    n: int,
    name: string,
    sub: string,
    active: bool,
    current: bool,
    dirty: bool,
    // how many of its settings differ from what the keyboard holds
    unsaved: int,
    // its color sample: one color, or up to four across it
    colors: int,
    c1: color,
    c2: color,
    c3: color,
    c4: color,
}

// an item on the rail: a square (Size.rail) with its glyph, which the rail's blade
// widens to take its name; closed, the name shows beside it when pointed at
export component RailItem inherits Rectangle {
    in property <image> glyph;
    in property <string> name;
    in property <bool> on;
    in property <bool> open;
    in property <float> reveal;      // how far the blade's names have come in, 0 to 1
    out property <bool> hover: ta.has-hover;
    callback clicked;
    height: Size.rail;
    border-radius: Radius.panel;
    background: root.on ? (ta.has-hover ? Ink.pick : Ink.hover-box) : ta.has-hover ? Ink.box : transparent;
    // (its glyph at the square's middle; its name Space.row after it, sliding in as it shows)
    property <length> glyph-w: 22px; // art: a rail glyph's box
    property <length> glyph-in: (Size.rail - self.glyph-w) / 2;
    Image {
        x: root.glyph-in;
        y: root.glyph-in;
        width: root.glyph-w;
        height: root.glyph-w;
        source: root.glyph;
        colorize: (root.on || ta.has-hover) ? Ink.bright : Ink.soft;
    }
    if root.reveal > 0: Text {
        x: root.glyph-in + root.glyph-w + Space.row - 6px * (1 - root.reveal); // art: its words slide in as the rail opens
        width: parent.width - self.x - root.glyph-in;
        height: parent.height;
        text: root.name;
        font-family: Font.ui;
        font-weight: Font.medium;
        font-size: Font.text;
        color: (root.on || ta.has-hover) ? Ink.bright : Ink.soft;
        opacity: root.reveal;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover && !root.open: Tip {
        x: Size.rail + Space.row;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        text: root.name;
    }
}

// a row of the anchoring column's lists: a profile or a layer. At rest the
// well shows through; under the pointer a step lighter; chosen lighter still,
// and lighter again under the pointer.
export component AnchorRow inherits Rectangle {
    in property <bool> chosen;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    height: Size.row;
    border-radius: Radius.control;
    background: root.chosen ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover ? Ink.hover-well : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

// a small capitals heading over one of the column's lists
export component AnchorHead inherits Text {
    height: Size.list-head;
    font-family: Font.ui;
    font-size: Font.small;
    font-weight: Font.strong;
    letter-spacing: Font.caps-tracking;
    color: Ink.quiet;
    vertical-alignment: center;
}

// A row in a list down a page's or a window's side (the profiles, the macros,
// the screen layouts): its name and the line under it (and after that, in
// amber, what isn't kept yet), lit while chosen, a shade under the pointer
// (`on-well`: a well's, in a well); the bar at its left for the one in use
// (`active`); a glyph before its words moves them to `inset`; a dot after the
// name while it has changes not kept (`dirty`); `end` keeps room at its right
// for what sits there (its children: a pencil, a menu). `bare` hides its words,
// while a field takes their place.
export component ListRow inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <string> warn;
    in property <bool> chosen;
    in property <bool> active;
    in property <bool> dirty;
    in property <bool> on-well;
    in property <bool> bare;
    // (its words after the bar's room: the bar, Space.inline either side of it)
    in property <length> inset: Space.inline + Space.tight + Space.inline;
    in property <length> end: Space.row;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    callback right-clicked(length, length);
    height: Size.row;
    border-radius: Radius.control;
    background: root.chosen ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover ? (root.on-well ? Ink.hover-well : Ink.hover-box) : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.clicked(); }
    }
    // the one in use: a white bar at its left
    if root.active: Rectangle {
        x: Space.inline;
        y: (parent.height - self.height) / 2;
        width: Space.tight;
        height: Size.compact;
        border-radius: self.width / 2;
        background: Ink.bright;
    }
    if !root.bare: VerticalLayout {
        x: root.inset;
        width: parent.width - root.inset - root.end;
        alignment: center;
        HorizontalLayout {
            spacing: Part.glyph-gap;
            alignment: start;
            Text {
                text: root.name;
                font-family: Font.ui;
                font-size: Font.control;
                font-weight: Font.medium;
                color: root.chosen || ta.has-hover ? Ink.bright : Ink.dim;
                overflow: elide;
            }
            if root.dirty: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: Size.dot;
                    height: Size.dot;
                    border-radius: self.width / 2;
                    background: Ink.warn;
                }
            }
        }
        HorizontalLayout {
            spacing: Part.glyph-gap;
            alignment: start;
            Text {
                text: root.sub;
                font-family: Font.ui;
                font-size: Font.caption;
                color: Ink.quiet;
                overflow: elide;
            }
            if root.warn != "": Text {
                text: root.warn;
                font-family: Font.ui;
                font-size: Font.caption;
                color: Ink.warn;
            }
        }
    }
    @children
}

// A list in a box under its heading in small capitals: the profiles (in a well,
// a device page's first column), the mouse's lights (in a box). Its heading sits
// where a box's title does (Space.pad in, level with it), its rows 8 in from its
// sides; given more height than its rows take (as a row of boxes gives it), the
// rest is the box's own, empty.
export component ListBox inherits Rectangle {
    in property <string> heading;
    in property <brush> fill: Ink.box;
    background: root.fill;
    border-radius: Radius.box;
    min-height: list.preferred-height;
    preferred-height: list.preferred-height;
    list := VerticalLayout {
        y: 0;
        width: parent.width;
        height: self.preferred-height;
        // (its rows Space.inline in from its sides; its heading's line at the middle of a
        // box title's, so the heading sits level with the title of the box beside it)
        padding: Space.inline;
        padding-top: Part.title-top + Line.title / 2 - Size.list-head / 2;
        spacing: Space.list;
        alignment: start;
        Rectangle {
            height: Size.list-head;
            AnchorHead {
                x: Space.pad - Space.inline;
                text: root.heading;
            }
        }
        @children
    }
}

// The anchoring column under the keyboard: the profiles (the one the Z10 is
// running marked by a white bar at its edge, the one being edited lit). The
// layers are a switch over the Key library; Save and Discard are in the device's bar. Choices go top to bottom: a profile, then a layer, then a key.
// For a device whose profiles Ectomatter keeps, as many as you want (`kept`),
// the one in use has a menu beside its pencil and a last row makes a new one.
export component AnchorColumn inherits ListBox {
    in property <[ProfileItem]> profiles;
    in property <bool> kept;
    // the menu on the profile being edited, as profiles Ectomatter keeps have, for a
    // device that keeps its own (no New profile row for it)
    in property <bool> has-menu: false;
    callback choose(int);
    callback rename(string);
    callback add();
    callback menu(length, length, length);
    in-out property <bool> renaming;
    heading: "PROFILES";
    fill: Ink.well;

    // the profiles
    for p in root.profiles: ListRow {
        // (the profile the Z10 is running: the bar; the one being edited: lit)
        name: p.name;
        sub: p.sub;
        warn: p.unsaved > 0 ? "·  " + p.unsaved + " unsaved" : "";
        chosen: p.current;
        active: p.active;
        on-well: true;
        bare: p.current && root.renaming;
        // (room at its right for its pencil and, where it has one, its menu)
        end: Space.inline + Size.quiet + ((root.kept || root.has-menu) && p.current ? Space.list + Size.quiet : 0);
        clicked => { root.renaming = false; root.choose(p.n); }
        // the profile being edited, renamed in place, Space.inline in from the row's ends
        if p.current && root.renaming: RenameField {
            x: Space.inline;
            y: (parent.height - self.height) / 2;
            width: parent.width - 2 * Space.inline;
            text: p.name;
            done(kept, t) => {
                if (kept) {
                    root.rename(t);
                }
                root.renaming = false;
            }
        }
        // the pencil, on the profile being edited
        if p.current && !root.renaming: PencilButton {
            x: parent.width - Space.inline - Size.quiet - (root.kept || root.has-menu ? Space.list + Size.quiet : 0);
            y: (parent.height - self.height) / 2;
            hover-fill: Ink.pick-hover;
            clicked => { root.renaming = true; }
        }
        // and its menu: Duplicate, Use with an app, Delete
        if (root.kept || root.has-menu) && p.current && !root.renaming: MoreButton {
            x: parent.width - Space.inline - Size.quiet;
            y: (parent.height - self.height) / 2;
            hover-fill: Ink.pick-hover;
            clicked(x, y, h) => { root.menu(x, y, h); }
        }
    }
    // a new profile, last
    if root.kept: new-row := AnchorRow {
        chosen: false;
        clicked => { root.renaming = false; root.add(); }
        HorizontalLayout {
            x: Space.inline + Space.tight + Space.inline;
            spacing: Space.inline;
            alignment: start;
            Path {
                y: (parent.height - Part.chevron) / 2;
                width: Part.chevron;
                height: Part.chevron;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M6 1.5v9M1.5 6h9";
                stroke: new-row.hover ? Ink.bright : Ink.soft;
                stroke-width: 1.8px; // art: the chevron's stroke
                fill: transparent;
            }
            Text {
                text: "New profile";
                font-family: Font.ui;
                font-size: Font.control;
                color: new-row.hover ? Ink.bright : Ink.soft;
                vertical-alignment: center;
            }
        }
    }
}
