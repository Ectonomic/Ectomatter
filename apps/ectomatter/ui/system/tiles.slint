// Tiles in a grid: an effect to choose, wherever effects are chosen.

import { Space, Radius, Font, Line, Size, Part, Shadow, Ink } from "tokens.slint";

// An effect as a tile, the same wherever one is chosen (the Lighting tab, the
// mouse's, the scene form, the Screen Editor): a well with the effect's small
// picture under a film and its name under it; the chosen one lit, and its
// picture moving as the effect does (`motion`: 0 still, 1 breathing, 2
// flashing, 3 rolling, 4 twinkling, 5 a press fading) by the time `t` gives.
// The Off effect (`blank`) has no picture; a screen's (`screen`) lies across
// the tile at the screen's shape.
export component EffectTile inherits Rectangle {
    in property <string> name;
    in property <image> icon;
    in property <bool> on;
    in property <int> motion;
    in property <bool> blank;
    in property <bool> screen;
    in property <duration> t;
    callback clicked;
    height: Size.tile;
    border-radius: Radius.panel;
    background: root.on ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover ? Ink.hover-box : Ink.well;
    Rectangle {
        x: Part.tile-inset;
        y: Part.tile-inset;
        width: parent.width - 2 * Part.tile-inset;
        height: Part.tile-pic;
        border-radius: Radius.small;
        clip: true;
        background: root.blank ? Ink.hover-box : Ink.preview;
        property <float> phase: root.on && root.motion != 0 ? root.t / 1ms : 0;
        if !root.blank && !root.screen: Image {
            // rolling: a picture twice as wide, slid along and round again;
            // flashing, chosen: its five colors each as wide as the tile, one
            // shown at a time, jumping to the next as the keys do
            x: root.on && root.motion == 3 ? -mod(parent.phase / 3000, 1) * parent.width
                : root.on && root.motion == 2 ? -mod(floor(parent.phase / 700), 5) * parent.width
                : 0;
            width: root.motion == 3 ? parent.width * 2 : root.on && root.motion == 2 ? parent.width * 5 : parent.width;
            height: parent.height;
            source: root.icon;
            image-fit: fill;
            opacity: !root.on ? 1
                : root.motion == 1 ? 0.3 + 0.7 * (0.5 - 0.5 * cos(parent.phase / 3000 * 360deg))
                : root.motion == 4 ? 0.55 + 0.45 * (0.5 - 0.5 * cos(parent.phase / 1600 * 360deg))
                : root.motion == 5 ? 1 - 0.75 * min(1, mod(parent.phase, 1400) / 1400)
                : 1;
        }
        // (a screen's picture, across the tile and in its middle)
        if root.screen: Image {
            width: parent.width;
            height: parent.width / 5;
            source: root.icon;
            image-fit: fill;
        }
        // the film every picture sits under (the Off effect's blank one too)
        Rectangle {
            background: Ink.pick.with-alpha(0.35);
        }
    }
    Text {
        y: 53px;
        height: 15px;
        width: parent.width;
        text: root.name;
        font-family: Font.ui;
        font-size: Font.caption;
        font-weight: root.on ? Font.medium : Font.regular;
        color: root.on || ta.has-hover ? Ink.bright : Ink.soft;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
