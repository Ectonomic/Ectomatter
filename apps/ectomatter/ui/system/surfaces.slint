// The surfaces a page lays its parts on: a box, a box that scrolls, the stage a
// device is drawn on. Each is drawn here once, from the tokens.

import { Space, Radius, Font, Line, Size, Part, Stroke, Shadow, Ink } from "tokens.slint";
import { ScrollBar, WordButton } from "controls.slint";

// the stage a device is drawn on, the same on every device's page: its shade round
// a hole the window draws the device in (filled too, `filled`, until it's drawn),
// the box's corners rounded on its outer pieces themselves (the software renderer
// draws a piece's own corners round, but clips square)
export component Stage inherits Rectangle {
    in property <length> hole-x;
    in property <length> hole-y;
    in property <length> hole-w;
    in property <length> hole-h;
    in property <bool> filled;
    property <length> r: Radius.box;
    // left and right of the hole, the whole height, rounded at the box's corners
    Rectangle {
        x: 0;
        width: root.hole-x;
        height: root.height;
        border-top-left-radius: root.r;
        border-bottom-left-radius: root.r;
        background: Ink.stage;
    }
    Rectangle {
        x: root.hole-x + root.hole-w;
        width: root.width - self.x;
        height: root.height;
        border-top-right-radius: root.r;
        border-bottom-right-radius: root.r;
        background: Ink.stage;
    }
    // above and below it, between those
    Rectangle {
        x: root.hole-x;
        y: 0;
        width: root.hole-w;
        height: root.hole-y;
        background: Ink.stage;
    }
    Rectangle {
        x: root.hole-x;
        y: root.hole-y + root.hole-h;
        width: root.hole-w;
        height: root.height - self.y;
        background: Ink.stage;
    }
    if root.filled: Rectangle {
        x: root.hole-x;
        y: root.hole-y;
        width: root.hole-w;
        height: root.hole-h;
        background: Ink.stage;
    }
}

// A box on the page: a raised surface, no border, its title at its top left
// and anything beside the title at its top right.
export component PageBox inherits Rectangle {
    in property <string> title;
    // where the title sits: lower when something comes before it in the box
    in property <length> title-y: Part.title-top;
    // (clear inside a ScrollBox, which draws the box itself)
    in property <brush> fill: Ink.box;
    background: root.fill;
    border-radius: Radius.box;
    Text {
        x: Space.pad;
        y: root.title-y;
        height: Line.title;
        text: root.title;
        font-family: Font.ui;
        font-size: Font.text;
        font-weight: Font.strong;
        color: Ink.bright;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 120px; // art: room for what's beside the title
    }
    @children
}

// A box under the keyboard that holds more than its height: the box itself,
// rounded, and what it holds (`need` tall) scrolling inside it, with the Key
// library's scrollbar at its edge when there is more than shows.
export component ScrollBox inherits Rectangle {
    in property <length> need;
    in property <brush> fill: Ink.box;
    background: root.fill;
    border-radius: Radius.box;
    clip: true;
    sb-flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: max(root.need, root.height);
        mouse-drag-pan-enabled: false;
        @children
    }
    ScrollBar {
        x: parent.width - Part.scroll-in;
        y: Space.inline;
        height: parent.height - 2 * Space.inline;
        view: sb-flick.height;
        content: sb-flick.content-height;
        offset: -sb-flick.content-y;
        framed: false;
        thumb-color: Ink.edge;
        scroll-to(o) => { sb-flick.content-y = -o; }
    }
}

// A bar floating over what's under it, the same wherever one is (Home's while it's
// arranged, its zoom; the Screen tab's tools over the strip): a panel lifted off the
// page with a faint outline, its controls compact and Space.tight in from its edges and
// apart (its children, in a row); a press on it is its own.
export component FloatBar inherits Rectangle {
    in property <brush> fill: Ink.box;
    height: Size.compact + 2 * Space.tight;
    width: row.preferred-width;
    border-radius: Radius.panel;
    background: root.fill;
    border-width: Stroke.line;
    border-color: Ink.line;
    drop-shadow-blur: Shadow.float.blur;
    drop-shadow-offset-y: Shadow.float.y;
    drop-shadow-color: Shadow.float.color;
    TouchArea {}
    row := HorizontalLayout {
        padding: Space.tight;
        spacing: Space.tight;
        alignment: start;
        @children
    }
}

// The bay a device's screen is set into, the same wherever the screen shows (the Screen
// tab, the Screen Editor): the screen's own background color (`field`) between plain
// walls, its corners rounded inside its box's, its top edge shaded as a step down into
// it; the screen, `screen-w` by `screen-h`, Space.margin in from the walls, at
// `screen-x` and `screen-y` (where its children draw the screen and what's over it).
export component ScreenBay inherits Rectangle {
    in property <length> screen-w;
    in property <length> screen-h;
    in property <color> field;
    out property <length> screen-x: Space.margin;
    out property <length> screen-y: Space.margin;
    width: root.screen-w + 2 * Space.margin;
    height: root.screen-h + 2 * Space.margin;
    border-radius: Radius.panel;
    background: root.field;
    animate background { duration: 450ms; easing: ease; }
    border-width: Stroke.line;
    border-color: Ink.black.with-alpha(0.549);
    clip: true;
    // art: the step down into the bay, a shade at its top edge
    Rectangle {
        y: 0;
        height: 14px; // art: the step's shade
        background: @linear-gradient(180deg, Ink.black.with-alpha(0.451) 0%, Ink.black.with-alpha(0) 100%);
    }
    @children
}

// What's being carried, under the pointer, the same for every carry (a screen layout to
// the playlist, a block onto the screen): its name on a chip lifted off the page, a
// glyph before it where it has one (its children).
export component CarryChip inherits Rectangle {
    in property <string> text;
    height: Size.compact;
    width: row.preferred-width + 2 * Part.chip-pad;
    border-radius: Radius.control;
    background: Ink.hover-box;
    drop-shadow-blur: Shadow.float.blur;
    drop-shadow-offset-y: Shadow.float.y;
    drop-shadow-color: Shadow.float.color;
    row := HorizontalLayout {
        x: Part.chip-pad;
        height: parent.height;
        spacing: Part.glyph-gap;
        alignment: start;
        @children
        Text {
            text: root.text;
            font-family: Font.ui;
            font-size: Font.note;
            font-weight: Font.strong;
            color: Ink.bright;
            vertical-alignment: center;
        }
    }
}

// Under a dialog, over the whole window, the window's corners followed: a press
// on it is Cancel, and so is Escape (unless the dialog takes Escape itself,
// `escape`, as a form with a menu open does).
export component Scrim inherits Rectangle {
    in property <length> corner;
    callback cancel();
    callback escape();
    escape => { root.cancel(); }
    background: Ink.scrim;
    border-radius: root.corner;
    TouchArea {
        clicked => { root.cancel(); }
    }
    FocusScope {
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.escape();
                return accept;
            }
            reject
        }
    }
    @children
}

// A dialog's box, on its scrim, the same for a question and for a form: a box
// lifted the most, with a faint outline. What it holds sits Space.margin in from
// its edges: a title (Font.title), the line under it, then what it asks, and its
// buttons at its foot's right, the one it's for last.
export component DialogBox inherits Rectangle {
    border-radius: Radius.box;
    background: Ink.box;
    border-width: Stroke.line;
    border-color: Ink.glass;
    drop-shadow-blur: Shadow.modal.blur;
    drop-shadow-offset-y: Shadow.modal.y;
    drop-shadow-color: Shadow.modal.color;
    // (a press inside it stays inside it)
    TouchArea { }
    @children
}

// A dialog's head, the same on every dialog: its title (a page title's type, on a box
// title's line) and, Space.tight under it, the line that says what it's for.
export component DialogHead inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    spacing: Space.tight;
    Text {
        height: Line.title;
        text: root.title;
        font-family: Font.ui;
        font-size: Font.title;
        font-weight: Font.strong;
        color: Ink.bright;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    if root.text != "": Text {
        text: root.text;
        font-family: Font.ui;
        font-size: Font.control;
        color: Ink.soft;
        wrap: word-wrap;
    }
}

// A form's label, over what it labels in a dialog's stacked form or beside it in a
// form's row (a label's type, in the dim gray).
export component FormLabel inherits Text {
    font-family: Font.ui;
    font-size: Font.text;
    color: Ink.dim;
    overflow: elide;
}

// A note under what it's about in a form: a note's type, in the quiet gray, wrapped.
export component FormNote inherits Text {
    font-family: Font.ui;
    font-size: Font.note;
    color: Ink.quiet;
    wrap: word-wrap;
}

// What's wrong with what was typed, under its field in a form: a note's type, in red, wrapped.
export component FormWarning inherits Text {
    font-family: Font.ui;
    font-size: Font.note;
    color: Ink.bad;
    wrap: word-wrap;
}

// Are you sure: a question in a dialog, what it changes, and its two answers,
// keeping things as they are and doing it (in red, as it deletes)
export component Confirm inherits Scrim {
    in property <string> title;
    in property <string> body;
    in property <string> body2;
    in property <string> keep: "Cancel";
    in property <string> do;
    callback yes();
    DialogBox {
        width: min(Size.ask, root.width - 2 * Space.pad);
        height: dlg.preferred-height + 2 * Space.margin;
        dlg := VerticalLayout {
            x: Space.margin;
            y: Space.margin;
            width: parent.width - 2 * Space.margin;
            height: self.preferred-height;
            spacing: Space.margin;
            VerticalLayout {
                spacing: Space.inline;
                DialogHead {
                    title: root.title;
                    text: root.body;
                }
                if root.body2 != "": Text {
                    text: root.body2;
                    font-family: Font.ui;
                    font-size: Font.control;
                    color: Ink.soft;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: Space.inline;
                alignment: end;
                WordButton {
                    text: root.keep;
                    on-box: true;
                    clicked => { root.cancel(); }
                }
                WordButton {
                    text: root.do;
                    danger: true;
                    clicked => { root.yes(); }
                }
            }
        }
    }
}

// A form in a dialog, every one's (adding a game, an app, a script or a plugin's value
// to the Library; naming a setup in the lab): `across` wide, its head (DialogHead), Space.pad
// under it what's asked (its children), and Space.margin under that its buttons: one at the
// left where it has one (`aside`, Remove), then Cancel and the one that does it (`go`, the
// primary, or `danger` where it deletes), at the middle of their row. A press on the dim,
// Cancel or Escape cancels.
export component FormDialog inherits Scrim {
    in property <length> across: Size.dialog;
    in property <string> title;
    in property <string> text;
    in property <string> go;
    in property <bool> go-enabled: true;
    in property <string> aside;
    callback go-pressed();
    callback aside-pressed();
    DialogBox {
        width: min(root.across, root.width - 2 * Space.pad);
        height: form.preferred-height + 2 * Space.margin;
        form := VerticalLayout {
            x: Space.margin;
            y: Space.margin;
            width: parent.width - 2 * Space.margin;
            height: self.preferred-height;
            spacing: 0;
            DialogHead {
                title: root.title;
                text: root.text;
            }
            Rectangle { height: Space.pad; }
            @children
            Rectangle { height: Space.margin; }
            HorizontalLayout {
                spacing: Space.inline;
                if root.aside != "": VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: root.aside;
                        on-box: true;
                        clicked => { root.aside-pressed(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    WordButton {
                        text: "Cancel";
                        on-box: true;
                        clicked => { root.cancel(); }
                    }
                }
                WordButton {
                    primary: true;
                    text: root.go;
                    enabled: root.go-enabled;
                    clicked => { root.go-pressed(); }
                }
            }
        }
    }
}

// What an area says while it has nothing to show, the same everywhere: what's
// missing (its title), what to do about it (its words, wrapped, or `lines` as
// Rust broke them), and the way to it (its children: a button), each line
// centered. The page centers it in the area.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    in property <[string]> lines;
    width: Size.empty;
    spacing: Space.label;
    alignment: center;
    if root.title != "": Text {
        text: root.title;
        font-family: Font.ui;
        font-size: Font.name;
        font-weight: Font.strong;
        color: Ink.bright;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.text != "": Text {
        text: root.text;
        font-family: Font.ui;
        font-size: Font.control;
        color: Ink.soft;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.lines.length > 0: VerticalLayout {
        for line in root.lines: Text {
            height: Line.text;
            text: line;
            font-family: Font.ui;
            font-size: Font.control;
            color: Ink.soft;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    @children
}

// A tooltip's box, every tooltip's: a raised surface's shade and outline, lifted
// a little, what it says (its children) 10 in from its sides and 7 from its top
// and its foot.
export component TipBox inherits Rectangle {
    border-radius: Radius.control;
    background: Ink.hover-box;
    border-width: Stroke.line;
    border-color: Ink.seam;
    drop-shadow-blur: Shadow.lift.blur;
    drop-shadow-offset-y: Shadow.lift.y;
    drop-shadow-color: Shadow.lift.color;
    VerticalLayout {
        padding-left: 10px; // art: the tip's own padding
        padding-right: 10px; // art: the tip's own padding
        padding-top: 7px; // art: the tip's own padding
        padding-bottom: 7px; // art: the tip's own padding
        spacing: 2px; // art: the tip's lines
        @children
    }
}

// a tooltip of a line of words
export component Tip inherits TipBox {
    in property <string> text;
    Text {
        text: root.text;
        font-family: Font.ui;
        font-size: Font.note;
        color: Ink.bright;
    }
}
