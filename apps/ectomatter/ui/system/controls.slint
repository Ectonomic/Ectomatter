// The controls every page is built from: buttons, tabs, fields, checkboxes,
// switches, drop-downs, scrollbars. Each is drawn here once, from the tokens;
// a page sets what it says and does, never how it looks.

import { Space, Radius, Font, Line, Size, Part, Stroke, Shadow, Ink } from "tokens.slint";
import { Typing } from "state.slint";

// one of the window's own buttons: minimize, maximize, close
export component WinButton inherits Rectangle {
    in property <string> commands;
    in property <length> size: Part.glyph;
    in property <bool> danger;
    // (the close button, at the window's corner: rounded as the window is)
    in property <length> corner;
    callback clicked;
    width: Size.win-button;
    border-top-right-radius: root.corner;
    background: ta.has-hover ? (root.danger ? Ink.close : Ink.hover-box) : transparent;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        fill: transparent;
        stroke: ta.has-hover ? (root.danger ? Ink.white : Ink.bright) : Ink.soft;
        stroke-width: 1.4px * root.size / 16px; // art: the glyph's stroke, as wide as its size keeps it
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// a tab in the device's bar: quiet, then ink with its underline when chosen
export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    width: label.preferred-width + 2 * Part.tab-in;
    label := Text {
        y: 0;
        height: parent.height - Stroke.ring;
        text: root.text;
        font-family: Font.ui;
        font-size: Font.tab;
        font-weight: Font.medium;
        color: (root.selected || ta.has-hover) ? Ink.ink : Ink.quiet;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A color as a small square, a glyph's size, beside the words it's for (a pad's
// Color, a mouse light's color in its row): rounded a little, with a faint edge.
export component ColorSquare inherits Rectangle {
    in property <color> swatch;
    width: Part.glyph;
    height: Part.glyph;
    border-radius: Radius.tiny;
    background: root.swatch;
    border-width: Stroke.line;
    border-color: Ink.white.with-alpha(0.18);
}

// a button with words: filled gray (the page's ghost buttons, which here have
// no outline), primary (ink), or one that deletes (red); a pixel down under a
// press. Its gray stands off what it sits on: the page's ground, or a box
// (`on-box`, as in a dialog).
export component WordButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> on-box;
    in property <bool> enabled: true;
    in property <color> fill: root.on-box ? Ink.hover-box : Ink.box;
    in property <color> fill-hover: root.on-box ? Ink.pick : Ink.hover-box;
    // as wide as it is given, rather than as its words
    in property <length> wide: 0;
    // a filled glyph before its words, on a 14-unit square (Play's triangle), or
    // one drawn in lines, on a 16-unit square, as a bar's buttons draw theirs (Add's +)
    in property <string> icon;
    in property <string> lines;
    // the small one inside a card (Make main): its words a caption's, in gray
    in property <bool> small;
    // on a bar floating over the page (Home's while it's arranged): a compact control's height
    in property <bool> compact;
    // one that opens a menu: a chevron after its words (a pad's size)
    in property <bool> menu;
    // a color's square before its words (a pad's Color)
    in property <bool> swatched;
    in property <color> swatch;
    out property <bool> hover: ta.has-hover && root.enabled;
    out property <bool> down: ta.pressed && root.enabled;
    callback clicked;
    height: root.compact ? Size.compact : root.primary ? Size.button + Part.primary : Size.button;
    property <length> icon-w: root.icon != "" || root.lines != "" || root.swatched ? Part.glyph + Part.glyph-gap : 0;
    property <length> menu-w: root.menu ? Part.glyph-gap + Part.chevron : 0;
    width: root.wide > 0 ? root.wide : label.preferred-width + 2 * Part.button-pad + root.icon-w + root.menu-w + (root.primary ? Part.primary : 0);
    border-radius: root.small ? Radius.small : Radius.control;
    // turned off, the whole button fades to 35% over the page's ground, as the
    // web app's does; faded piece by piece, its words would come out lighter
    property <color> face: root.danger ? (ta.has-hover && root.enabled ? Ink.danger-hover : Ink.danger)
        : root.primary ? (ta.has-hover && root.enabled ? Ink.white : Ink.bright) : ta.has-hover && root.enabled ? root.fill-hover : root.fill;
    property <color> ink: root.danger ? Ink.white : root.primary ? Ink.base : root.small && !root.hover ? Ink.dim : Ink.bright;
    background: root.enabled ? root.face : root.face.mix(Ink.base, 0.35);
    if root.icon != "": Path {
        x: (parent.width - label.width - root.icon-w - root.menu-w) / 2;
        y: (parent.height - Part.glyph) / 2 + (ta.pressed && root.enabled ? Part.press : 0);
        width: Part.glyph;
        height: Part.glyph;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: root.icon;
        fill: root.enabled ? root.ink : root.ink.mix(Ink.base, 0.35);
    }
    if root.swatched: ColorSquare {
        x: (parent.width - label.width - root.icon-w - root.menu-w) / 2;
        y: (parent.height - self.height) / 2 + (ta.pressed && root.enabled ? Part.press : 0);
        swatch: root.swatch;
    }
    if root.menu: Path {
        x: (parent.width + label.width + root.icon-w - root.menu-w) / 2 + Part.glyph-gap;
        y: (parent.height - self.height) / 2 + (ta.pressed && root.enabled ? Part.press : 0);
        width: Part.chevron;
        height: Part.chevron;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M3 4.5l3 3 3-3";
        fill: transparent;
        stroke: Ink.quiet;
        stroke-width: 1.6px; // art: the chevron's stroke
    }
    if root.lines != "": Path {
        x: (parent.width - label.width - root.icon-w - root.menu-w) / 2;
        y: (parent.height - Part.glyph) / 2 + (ta.pressed && root.enabled ? Part.press : 0);
        width: Part.glyph;
        height: Part.glyph;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.lines;
        fill: transparent;
        stroke: root.enabled ? root.ink : root.ink.mix(Ink.base, 0.35);
        stroke-width: 1.14px; // art: the glyph's stroke
        stroke-line-cap: round;
    }
    label := Text {
        x: (parent.width - self.width + root.icon-w - root.menu-w) / 2;
        y: (parent.height - self.height) / 2 + (ta.pressed && root.enabled ? Part.press : 0);
        text: root.text;
        font-family: Font.ui;
        font-size: root.small ? Font.caption : Font.control;
        font-weight: root.primary || root.danger ? Font.strong : root.small ? Font.regular : Font.medium;
        color: root.enabled ? root.ink : root.ink.mix(Ink.base, 0.35);
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A quiet button with words and no fill, for a toolbar's actions (+ Key, + New,
// Record) and "Press a key" (`on`, amber while it listens); a glyph before its
// words where it has one, on a 14-unit square; faded while it can't be used. Its
// words are a button's (Font.control), a pixel down under a press.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    // its glyph's lines, and the square they're drawn on
    in property <string> icon;
    in property <float> units: 14;
    out property <bool> hover: ta.has-hover && root.enabled;
    callback clicked;
    height: Size.compact;
    width: row.preferred-width;
    border-radius: Radius.small;
    opacity: root.enabled ? 1 : 0.4;
    background: root.on ? Ink.warn.with-alpha(0.08) : root.hover ? Ink.tint : transparent;
    row := HorizontalLayout {
        padding-left: Part.quiet-pad;
        padding-right: Part.quiet-pad;
        spacing: Part.glyph-gap;
        y: ta.pressed && root.enabled ? Part.press : 0;
        if root.icon != "": Path {
            y: (parent.height - self.height) / 2;
            width: Part.glyph;
            height: Part.glyph;
            viewbox-width: root.units;
            viewbox-height: root.units;
            commands: root.icon;
            fill: transparent;
            stroke: root.on ? Ink.warn : root.hover ? Ink.bright : Ink.dim;
            stroke-width: 1.2px * root.units / 14; // art: the glyph's stroke
            stroke-line-join: round;
        }
        Text {
            text: root.text;
            font-family: Font.ui;
            font-size: Font.control;
            font-weight: Font.medium;
            color: root.on ? Ink.warn : root.hover ? Ink.bright : Ink.dim;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// the small ring that turns while the keyboard is read
export component Spinner inherits Rectangle {
    width: Size.spinner;
    height: Size.spinner;
    property <angle> a: mod(animation-tick() / 800ms, 1) * 360deg;
    Rectangle {
        border-radius: self.width / 2;
        border-width: 2px; // art: the spinner's ring
        border-color: Ink.line;
    }
    Path {
        width: Size.spinner;
        height: Size.spinner;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: transparent;
        stroke: Ink.ink;
        stroke-width: 2px; // art: the spinner's ring
        commands: "M " + (8 + 7 * cos(root.a)) + " " + (8 + 7 * sin(root.a)) + " A 7 7 0 0 1 " + (8 + 7 * cos(root.a + 90deg)) + " " + (8 + 7 * sin(root.a + 90deg));
    }
}

// A scrollbar, as WebKit drew the page's: a thin thumb in a dark rim, lighter
// while the pointer is on it or it is held. Its thumb is dragged, or a press
// on its track takes the thumb there; the wheel scrolls the area as ever. The
// area itself never scrolls by dragging it, as a web page does not.
export component ScrollBar inherits Rectangle {
    // how much of the area shows, how much there is, and how far it is scrolled
    in property <length> view;
    in property <length> content;
    in property <length> offset;
    in property <color> thumb-color: Ink.edge;
    // the page's has a dark rim round the thumb; a list's is the thumb alone
    in property <bool> framed: true;
    callback scroll-to(length);
    width: Part.scroll-in;
    visible: root.content > root.view + 1px; // art: more than a pixel to scroll
    property <length> travel: max(1px, root.content - root.view);
    property <length> th: max(24px, root.height * root.view / max(1px, root.content)); // art: the thumb at its least
    property <length> ty: min(1, max(0, root.offset / root.travel)) * (root.height - root.th);
    property <length> grab;
    property <bool> held;
    pure function at(y: length) -> length {
        max(0px, min(root.travel, (y - root.grab) / max(1px, root.height - root.th) * root.travel))
    }
    Rectangle {
        x: parent.width - 7px; // art: the thumb's track, in from the edge
        y: root.ty;
        width: 5px; // art: the thumb's track
        height: root.th;
        border-radius: 2px; // art: the thumb's track
        background: root.framed ? Ink.frame : transparent;
        Rectangle {
            x: 1px; // art: the thumb, in its track
            width: 3px; // art: the thumb
            border-radius: self.width / 2;
            background: bar-ta.has-hover || root.held ? Ink.edge-hover : root.thumb-color;
        }
    }
    bar-ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                if (self.mouse-y >= root.ty && self.mouse-y < root.ty + root.th) {
                    root.grab = self.mouse-y - root.ty;
                } else {
                    root.grab = root.th / 2;
                    root.scroll-to(root.at(self.mouse-y));
                }
                root.held = true;
            }
            if (e.kind == PointerEventKind.up) {
                root.held = false;
            }
        }
        moved => {
            if (self.pressed) {
                root.scroll-to(root.at(self.mouse-y));
            }
        }
        // the wheel over the bar scrolls the area, as it does over the area
        scroll-event(e) => {
            root.scroll-to(max(0px, min(root.travel, root.offset - e.delta-y)));
            accept
        }
    }
}

// a number or code in the color picker, its name under it
export component PickField inherits VerticalLayout {
    in-out property <string> value;
    in property <string> label;
    in property <int> which;
    callback edited(int, string);
    callback enter();
    callback dismiss();
    spacing: 3px; // art: the picker's field: its label over its box
    Rectangle {
        height: 27px; // art: the picker's field
        border-radius: Radius.small;
        background: Ink.shade1;
        border-width: input.has-focus ? Stroke.line : 0;
        border-color: Ink.edge-hover;
        input := TextInput {
            changed has-focus => { Typing.on = self.has-focus; }
            x: 6px; // art: the picker's field: its number in from its ends
            width: parent.width - 12px; // art: the picker's field
            height: parent.height;
            text <=> root.value;
            font-family: Font.ui;
            font-size: Font.note;
            font-weight: Font.medium;
            color: Ink.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(root.which, self.text); }
            accepted => { root.enter(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.dismiss();
                    return accept;
                }
                reject
            }
        }
    }
    Text {
        height: 15px; // art: the picker's field's label
        text: root.label;
        font-family: Font.ui;
        font-size: Font.small;
        color: Ink.quiet;
        horizontal-alignment: center;
    }
}

// a color to pick in one click: a preset, or one used lately
export component Well inherits Rectangle {
    in property <color> c;
    callback clicked;
    // (the picker sets how wide; a circle)
    width: 23.56px; // art: the picker's well, nine to its row
    height: self.width;
    // round, as every color dot in the app is
    border-radius: self.width / 2;
    background: root.c;
    Rectangle {
        border-radius: self.width / 2;
        border-width: Stroke.line;
        border-color: ta.has-hover ? Ink.white.with-alpha(0.6) : Ink.white.with-alpha(0.141);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A quiet link with words and no fill, smaller than a button: a box's own
// actions at its top right (Reset, Done, Collapse all), Undo in a bar, Home's
// Scenes and Arrange. A glyph before its words where it has one: its lines on a
// square of `units` (`icon`), or a picture (`chip`, a scene's colors); `lit`, its
// words at full strength (a scene that's on).
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> icon;
    in property <float> units: 14;
    in property <image> chip;
    in property <bool> chip-on;
    in property <bool> lit;
    out property <bool> hover: ta.has-hover && root.enabled;
    callback clicked;
    height: Size.quiet;
    width: row.preferred-width;
    border-radius: Radius.small;
    background: root.hover ? Ink.hover-box : transparent;
    row := HorizontalLayout {
        padding-left: Part.quiet-pad;
        padding-right: Part.quiet-pad;
        spacing: Part.glyph-gap;
        if root.chip-on: Image {
            y: (parent.height - self.height) / 2;
            width: Part.glyph;
            height: Part.glyph;
            source: root.chip;
            image-fit: fill;
        }
        if root.icon != "" && !root.chip-on: Path {
            y: (parent.height - self.height) / 2;
            width: Part.glyph;
            height: Part.glyph;
            viewbox-width: root.units;
            viewbox-height: root.units;
            commands: root.icon;
            fill: transparent;
            stroke: root.hover ? Ink.bright : Ink.soft;
            stroke-width: 1.4px * root.units / 14; // art: the glyph's stroke
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        Text {
            text: root.text;
            font-family: Font.ui;
            font-size: Font.note;
            font-weight: Font.medium;
            color: !root.enabled ? Ink.quiet.with-alpha(0.6) : root.hover || root.lit ? Ink.bright : Ink.soft;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// a key's cap, small, as the Key library shows it
export component SmallCap inherits Rectangle {
    in property <string> text;
    in property <length> size: Font.small;
    width: 34px; // art: a small cap, drawn
    height: 26px; // art: a small cap, drawn
    // the cap's edge, deeper at its front, all of it following the rounded corners
    border-radius: Radius.tiny + 1px; // art: a small cap, drawn
    background: Ink.seam;
    Rectangle {
        x: 1px; // art: a small cap, drawn
        y: 1px; // art: a small cap, drawn
        width: parent.width - 2px; // art: a small cap, drawn
        height: parent.height - 4px; // art: a small cap, drawn
        border-radius: Radius.tiny;
        background: Ink.well;
    }
    Text {
        y: 0;
        height: parent.height - 3px; // art: a small cap, drawn
        text: root.text;
        font-family: Font.ui;
        font-size: root.size;
        font-weight: Font.strong;
        color: Ink.bright;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 4px; // art: a small cap, drawn
        x: 2px; // art: a small cap, drawn
    }
}

// A line to type into, the same wherever one is: what it holds until something is
// typed in gray, a glyph before it where it has one (a search's), a shade lighter
// while it's typed in. In the typeface whose letters are all one width for a
// command (`mono`). Escape leaves it (`escape`); `read-only` shows what it holds
// with no typing (a program's path, chosen with a button beside it).
export component FieldBox inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> mono;
    in property <string> glyph;
    in property <bool> read-only;
    // Escape stays here (`escape`), or goes on to the page (a find box's, which
    // the page's own Escape answers)
    in property <bool> keeps-escape: true;
    // its words at its middle (a count to type)
    in property <bool> centered;
    // its shade, and its shade while typed in (in a menu, the box's, a step off the menu's)
    in property <brush> fill: Ink.well;
    in property <brush> fill-typing: Ink.hover-well;
    out property <bool> typing: field-in.has-focus;
    // typing in it ends, the field left
    callback left();
    callback edited();
    callback accepted();
    callback escape();
    public function start-typing() { field-in.focus(); }
    public function stop-typing() { field-in.clear-focus(); }
    height: Size.control;
    border-radius: Radius.control;
    background: field-in.has-focus ? root.fill-typing : root.fill;
    clip: true;
    property <length> words-x: root.glyph != "" ? Part.field-pad + Part.glyph + Part.glyph-gap : Part.field-pad;
    if root.glyph != "": Path {
        x: Part.field-pad;
        y: (parent.height - Part.glyph) / 2;
        width: Part.glyph;
        height: Part.glyph;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.glyph;
        fill: transparent;
        stroke: Ink.quiet;
        stroke-width: 1.5px; // art: the glyph's stroke
        stroke-line-cap: round;
    }
    if field-in.text == "": Text {
        x: root.words-x;
        width: parent.width - root.words-x - Part.field-pad;
        height: parent.height;
        text: root.placeholder;
        font-family: Font.ui;
        font-size: Font.control;
        color: Ink.placeholder;
        vertical-alignment: center;
        overflow: elide;
    }
    field-in := TextInput {
        x: root.words-x;
        width: parent.width - root.words-x - Part.field-pad;
        height: parent.height;
        text <=> root.text;
        read-only: root.read-only;
        enabled: !root.read-only;
        horizontal-alignment: root.centered ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
        font-family: root.mono ? Font.mono : Font.ui;
        font-size: root.mono ? Font.caption : Font.control;
        color: Ink.ink;
        vertical-alignment: center;
        single-line: true;
        changed has-focus => {
            Typing.on = self.has-focus;
            if (!self.has-focus) {
                root.left();
            }
        }
        edited => { root.edited(); }
        accepted => { root.accepted(); }
        key-pressed(e) => {
            if (e.text == Key.Escape && root.keeps-escape) {
                root.escape();
                return accept;
            }
            reject
        }
    }
}

// The button that records (a macro's steps, the next key pressed), the same wherever
// one is: its red dot and its words on a button's gray; while it records (`on`), a red
// tint, the dot a square, and what it says then (`on-text`: Stop, Press a key…).
export component RecordButton inherits Rectangle {
    in property <bool> on;
    in property <string> text: "Record";
    in property <string> on-text: "Stop";
    in property <bool> enabled: true;
    callback clicked(length, length, length);
    height: Size.button;
    width: row.preferred-width;
    border-radius: Radius.control;
    background: root.on ? Ink.record.with-alpha(0.2) : ta.has-hover && root.enabled ? Ink.pick-hover : Ink.pick;
    opacity: root.on || root.enabled ? 1 : 0.35;
    row := HorizontalLayout {
        padding-left: Part.button-pad - 2px; // art: its dot set in a little, to sit with its words
        padding-right: Part.button-pad;
        spacing: Part.glyph-gap;
        Rectangle {
            width: root.on ? 8px : 9px; // art: the record dot, or the stop square
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: root.on ? 8px : 9px; // art: the record dot, or the stop square
                height: self.width;
                border-radius: root.on ? 2px : self.width / 2; // art: the stop square's corners
                background: root.on ? Ink.bad : Ink.record;
            }
        }
        Text {
            text: root.on ? root.on-text : root.text;
            font-family: Font.ui;
            font-size: Font.control;
            font-weight: Font.medium;
            color: root.on ? Ink.record.mix(Ink.white, 0.35) : Ink.bright;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.on || root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}

// A tag beside what it's about, the same wherever one is: its words small on a well,
// or a warning's (`warn`: Rebound, Unofficial) in amber on its own tint.
export component Tag inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    height: Size.pill;
    width: words.preferred-width + 2 * Part.pill-pad;
    border-radius: Radius.small;
    background: root.warn ? Ink.warn.with-alpha(0.133) : Ink.well;
    words := Text {
        x: Part.pill-pad;
        height: parent.height;
        text: root.text;
        font-family: Font.ui;
        font-size: Font.small;
        color: root.warn ? Ink.warn : Ink.quiet;
        vertical-alignment: center;
    }
}

// One of a list's choices, only one chosen (what a slider controls): its ring, filled
// in for the chosen one, and its words, on a row a control's height, lit while chosen.
export component RadioRow inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: Size.control;
    border-radius: Radius.control;
    background: root.on ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover ? Ink.hover-box : transparent;
    Rectangle {
        x: Part.field-pad - 2px; // art: the ring set in a little, to sit with its words
        y: (parent.height - self.height) / 2;
        width: Part.glyph;
        height: Part.glyph;
        border-radius: self.width / 2;
        border-width: root.on ? 4px : 1.5px; // art: the ring, filled in when chosen
        border-color: root.on ? Ink.bright : Ink.edge-hover;
    }
    Text {
        x: Part.field-pad - 2px + Part.glyph + Part.field-pad - 2px; // art: its words, after the ring
        height: parent.height;
        text: root.text;
        font-family: Font.ui;
        font-size: Font.control;
        color: root.on ? Ink.bright : Ink.dim;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A heading that opens and shuts what's under it, the same wherever one is (a group
// in the Key library, a fold in a plugin's section): its chevron, turned down while
// it's open, and its words, a shade under the pointer; what it counts at its right
// (its children). `small`: a list's group, its words a caption's.
export component Fold inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    in property <bool> small;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    height: Size.list-head;
    border-radius: Radius.small;
    background: ta.has-hover ? Ink.hover-box : transparent;
    Path {
        x: Part.tile-inset;
        y: (parent.height - self.height) / 2;
        width: Part.chevron;
        height: Part.chevron;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.open ? "M3 4.5l3 3 3-3" : "M4.5 3l3 3-3 3";
        fill: transparent;
        stroke: ta.has-hover ? Ink.bright : Ink.quiet;
        stroke-width: 1.6px; // art: the chevron's stroke
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    Text {
        x: Part.fold-in + Part.tile-inset;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        font-family: Font.ui;
        font-size: root.small ? Font.caption : Font.text;
        font-weight: root.small ? Font.medium : Font.regular;
        color: ta.has-hover ? Ink.bright : Ink.soft;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

// a checkbox and its words, the same wherever one is: ticked in the words' own
// gray, lighter under the pointer; `state` 1 for one that can't be changed now
// (faint, unticked), 2 for one another setting holds on (ticked in gray)
export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <int> state;
    callback clicked;
    property <bool> off: root.state == 1;
    property <bool> held: root.state == 2;
    property <bool> hot: ta.has-hover && root.state == 0;
    height: Size.quiet;
    preferred-width: Size.check + Part.check-gap + words.preferred-width;
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: Size.check;
        height: Size.check;
        border-radius: Radius.tiny;
        background: root.held ? Ink.off : root.off ? transparent : root.on ? (root.hot ? Ink.bright : Ink.dim) : root.hot ? Ink.hover-box : Ink.well;
        border-width: (root.on && !root.off) || root.held ? 0 : Stroke.line;
        border-color: root.off ? Ink.seam : root.hot ? Ink.edge-hover : Ink.edge;
        if (root.on && !root.off) || root.held: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 18;
            viewbox-height: 18;
            commands: "M5.2 9.3 L7.9 11.9 L12.9 6.4";
            fill: transparent;
            stroke: Ink.base;
            stroke-width: 2px; // art: the tick's stroke
        }
    }
    words := Text {
        x: Size.check + Part.check-gap;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        font-family: Font.ui;
        font-size: Font.control;
        color: root.off ? Ink.off : root.hot ? Ink.bright : Ink.dim;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        enabled: root.state == 0;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// the Library's star, outlined, or filled for a favorite, on a 16-unit square
export global Star {
    out property <string> path: "M8 1.9l1.8 3.8 4.1.5-3 2.9.8 4.1L8 11.2l-3.7 2 .8-4.1-3-2.9 4.1-.5Z";
}

// a square button with the star, a button's height, for a game's page: filled once
// it's a favorite; `on-picture`, over a cover's corner, its well a little clear
export component StarButton inherits Rectangle {
    in property <bool> on;
    in property <bool> on-picture;
    out property <bool> hover: ta.has-hover;
    callback clicked;
    width: Size.button;
    height: Size.button;
    border-radius: Radius.control;
    background: root.on-picture ? (ta.has-hover ? Ink.hover-box.with-alpha(0.949) : Ink.well.with-alpha(0.851)) : ta.has-hover ? Ink.shade2 : Ink.shade1;
    Path {
        y: (parent.height - Part.glyph) / 2 + (ta.pressed ? Part.press : 0);
        width: Part.glyph;
        height: Part.glyph;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: Star.path;
        fill: root.on ? Ink.ink : transparent;
        stroke: Ink.ink;
        stroke-width: 1.3px; // art: the star's stroke
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Edit or Remove among a turn's time and buttons: a small line glyph on their dark backing
export component StripIcon inherits Rectangle {
    in property <string> commands;
    callback clicked;
    width: 20px; // art: the strip's glyph, drawn
    height: 20px; // art: the strip's glyph, drawn
    border-radius: Radius.small;
    background: ta.pressed ? Ink.pick : ta.has-hover ? Ink.hover-box : transparent;
    Path {
        x: 4px; // art: the strip's glyph, drawn
        y: 4px; // art: the strip's glyph, drawn
        width: 12px; // art: the strip's glyph, drawn
        height: 12px; // art: the strip's glyph, drawn
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: ta.has-hover ? Ink.bright : Ink.soft;
        stroke-width: 1.8px; // art: the strip's glyph, drawn
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Pause, at the head of the playlist's panel; Play while the playlist is paused
export component PlayButton inherits Rectangle {
    in property <bool> paused;
    callback clicked;
    width: Size.compact;
    height: Size.compact;
    border-radius: Radius.control;
    background: ta.pressed ? Ink.pick-hover : ta.has-hover ? Ink.pick : Ink.hover-box;
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Part.chevron;
        height: Part.chevron;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.paused ? "M8 5.5v13a1 1 0 0 0 1.5.9l10-6.5a1 1 0 0 0 0-1.7l-10-6.6A1 1 0 0 0 8 5.5z"
            : "M7 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM15 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z";
        fill: Ink.bright;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A switch's ground: a well, its corners its choices' (Radius.small) and the
// inset between them, so the two curves follow each other.
export component SegGround inherits Rectangle {
    border-radius: Radius.small + Part.inset;
    background: Ink.well;
}

// One of a switch's choices, Part.inset in from its ground: the chosen one a
// step lighter, the others lit under the pointer; its icon's lines before its
// words where it has one; `off`, one that can't be chosen now, its words faint.
export component SegChoice inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> on;
    in property <bool> off;
    // a color's dot before its words (the profile's backlight, for Default), or its
    // square (a cap's color, in the lab)
    in property <bool> swatched;
    in property <bool> square;
    in property <color> swatch;
    // one that opens a list: a chevron after its words
    in property <bool> menu;
    out property <bool> hover: ta.has-hover;
    // as wide as its words want, with Part.choice-pad either side
    out property <length> need: row.preferred-width + 2 * Part.choice-pad;
    callback clicked(length, length, length);
    border-radius: Radius.small;
    background: root.on ? (ta.has-hover ? Ink.pick-hover : Ink.pick) : ta.has-hover && !root.off ? Ink.hover-well : transparent;
    row := HorizontalLayout {
        alignment: center;
        spacing: Part.choice-gap;
        if root.swatched: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px; // art: a color's dot
                height: 9px; // art: a color's dot
                border-radius: self.width / 2;
                background: root.swatch;
                border-width: Stroke.line;
                border-color: Ink.black.with-alpha(0.122);
            }
        }
        if root.square: VerticalLayout {
            alignment: center;
            ColorSquare { swatch: root.swatch; }
        }
        if root.icon != "": Path {
            y: (parent.height - Part.glyph) / 2;
            width: Part.glyph;
            height: Part.glyph;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon;
            fill: transparent;
            stroke: root.on || ta.has-hover ? Ink.bright : Ink.soft;
            stroke-width: 1.8px; // art: the glyph's stroke
        }
        Text {
            text: root.text;
            font-family: Font.ui;
            font-size: Font.note;
            color: root.off ? Ink.off : root.on || ta.has-hover ? Ink.bright : Ink.soft;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.menu: VerticalLayout {
            alignment: center;
            Path {
                width: Part.chevron;
                height: Part.chevron;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M3 4.5l3 3 3-3";
                fill: transparent;
                stroke: root.on || ta.has-hover ? Ink.bright : Ink.quiet;
                stroke-width: 1.6px; // art: the chevron's stroke
            }
        }
    }
    ta := TouchArea {
        enabled: !root.off;
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}

// a segmented switch on a well: the chosen part a step lighter, its choices
// sharing its width (`tall`: each one's icon over its words)
export component SegSwitch inherits SegGround {
    in property <[string]> options;
    in property <[string]> icons;
    in property <int> chosen;
    in property <bool> tall;
    callback picked(int, length, length, length);
    height: root.tall ? Size.seg-tall : Size.control;
    for o[i] in root.options: Rectangle {
        x: Part.inset + i * (parent.width - 2 * Part.inset + Part.seg-gap) / root.options.length;
        y: Part.inset;
        width: (parent.width - 2 * Part.inset + Part.seg-gap) / root.options.length - Part.seg-gap;
        height: parent.height - 2 * Part.inset;
        border-radius: Radius.small;
        background: root.chosen == i ? (seg-ta.has-hover ? Ink.pick-hover : Ink.pick) : seg-ta.has-hover ? Ink.hover-well : transparent;
        if root.tall && root.icons.length > i: Path {
            x: (parent.width - 15px) / 2; // art: the tall switch: its glyph over its words
            y: 7px; // art: the tall switch: its glyph over its words
            width: 15px; // art: the tall switch: its glyph over its words
            height: 15px; // art: the tall switch: its glyph over its words
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icons[i];
            fill: transparent;
            stroke: root.chosen == i || seg-ta.has-hover ? Ink.bright : Ink.soft;
            stroke-width: 1.7px; // art: the glyph's stroke
        }
        Text {
            y: root.tall ? 25px : 0; // art: the tall switch: its words under its glyph
            width: parent.width;
            height: root.tall ? 16px : parent.height; // art: the tall switch: its words under its glyph
            text: o;
            font-family: Font.ui;
            font-size: root.tall ? Font.small : Font.note;
            color: root.chosen == i || seg-ta.has-hover ? Ink.bright : Ink.soft;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        seg-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(i, self.absolute-position.x, self.absolute-position.y, self.height); }
        }
    }
}

// A dropdown, the same wherever one is: what is chosen, and a chevron at its right;
// a shade lighter under the pointer and while its menu is open. A picture before
// its words where it has one (`chip`, a scene's colors). `followed`: its value
// follows something else, in gray; `warn`: its value needs choosing again, an
// amber line round it; `subtle`: with no well until the pointer is on it (a
// chooser at a panel's head).
export component DropField inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    in property <image> chip;
    in property <bool> chip-on;
    in property <bool> followed;
    in property <bool> warn;
    in property <bool> subtle;
    // (a subtle one on a box, lit in the box's hover shade rather than a well's)
    in property <bool> on-box;
    in property <bool> enabled: true;
    callback clicked(length, length, length);
    height: Size.control;
    border-radius: Radius.control;
    opacity: root.enabled ? 1 : 0.35;
    background: (ta.has-hover && root.enabled) || root.open ? (root.subtle && !root.on-box ? Ink.hover-well : Ink.hover-box) : root.subtle ? transparent : Ink.well;
    border-width: root.warn ? Stroke.line : 0;
    border-color: Ink.warn.with-alpha(0.502);
    if root.chip-on: Image {
        x: Part.field-pad;
        y: (parent.height - Part.glyph) / 2;
        width: Part.glyph;
        height: Part.glyph;
        source: root.chip;
        image-fit: fill;
    }
    Text {
        x: root.chip-on ? Part.field-pad + Part.glyph + Part.glyph-gap : Part.field-pad;
        width: parent.width - self.x - Part.field-pad - Part.chevron - Space.tight;
        height: parent.height;
        text: root.text;
        font-family: Font.ui;
        font-size: Font.control;
        // (a chooser at a panel's head names what the panel shows, a step heavier)
        font-weight: root.subtle ? Font.medium : Font.regular;
        color: root.followed ? Ink.soft : Ink.bright;
        vertical-alignment: center;
        overflow: elide;
    }
    Path {
        x: parent.width - Part.field-pad - Part.chevron;
        y: (parent.height - Part.chevron) / 2;
        width: Part.chevron;
        height: Part.chevron;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M3 4.5l3 3 3-3";
        fill: transparent;
        stroke: Ink.quiet;
        stroke-width: 1.6px; // art: the chevron's stroke
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}

// A slider, the same wherever one is: a line, run up to its knob in `fill` (Ecto
// green, or the color of the light it sets), and a small plain knob that follows
// the pointer while held, a step larger under the pointer; double-clicked, it goes
// back as it was (`reset`). `notch` marks its middle, its default, which holds the
// knob as it passes. `saved`, 0 to 1, marks where the value was saved while it has
// moved from there (below 0, as it is unless given, no mark).
export component Slider inherits Rectangle {
    in property <float> value;
    in property <color> fill: Ink.brand;
    in property <bool> notch;
    in property <float> saved: -1;
    callback moved(float);
    callback reset();
    height: Size.slider;
    // (the knob's half at rest: its run goes from the knob's center at one end to its center at the other)
    property <length> half: 7px; // art: the slider's knob, half across
    property <float> held: max(0, min(1, (drag.mouse-x - self.half) / (self.width - 2 * self.half)));
    property <float> at: drag.pressed ? (root.notch && abs(self.held - 0.5) <= 0.04 ? 0.5 : self.held) : root.value;
    // the line, and its run up to the knob
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 2px; // art: the slider's line
        border-radius: self.height / 2;
        background: Ink.track;
        Rectangle {
            x: 0;
            width: root.half + root.at * (parent.width - 2 * root.half);
            border-radius: self.height / 2;
            background: root.fill;
        }
    }
    // the notch: a short line across the slider at its middle, under the knob
    if root.notch: Rectangle {
        x: root.half + 0.5 * (parent.width - 2 * root.half) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 2px; // art: the slider's middle mark
        height: 12px; // art: the slider's middle mark
        border-radius: self.width / 2;
        background: Ink.quiet;
    }
    // where the value was saved: a shorter line across, under the knob
    if root.saved >= 0: Rectangle {
        x: root.half + root.saved * (parent.width - 2 * root.half) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 2px; // art: the saved value's mark
        height: 10px; // art: the saved value's mark
        border-radius: self.width / 2;
        background: Ink.placeholder;
    }
    // the knob, a step larger under the pointer and while held
    Rectangle {
        width: drag.has-hover || drag.pressed ? 2 * root.half + 2px : 2 * root.half; // art: the knob, larger under the pointer
        height: self.width;
        x: root.half + root.at * (parent.width - 2 * root.half) - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Ink.bright;
    }
    drag := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved(max(0, min(1, (self.mouse-x - root.half) / (self.width - 2 * root.half))));
            }
        }
        moved => {
            if (self.pressed) {
                root.moved(max(0, min(1, (self.mouse-x - root.half) / (self.width - 2 * root.half))));
            }
        }
        double-clicked => { root.reset(); }
    }
}

// A color's dot and its code as one button, lit under the pointer and while the
// color picker is open on it (`open`): the screen's default backlight, a layout's own.
export component ColorButton inherits Rectangle {
    in property <color> swatch;
    in property <string> code;
    in property <bool> open;
    callback clicked(length, length, length);
    height: Size.swatch;
    width: Part.swatch-words + code-t.preferred-width + Part.quiet-pad;
    border-radius: Radius.control;
    background: ta.has-hover || root.open ? Ink.hover-box : transparent;
    Rectangle {
        x: 4px; // art: its dot, 4 in (Part.swatch-words)
        y: (parent.height - self.height) / 2;
        width: 20px; // art: its dot (Part.swatch-words)
        height: 20px; // art: its dot (Part.swatch-words)
        border-radius: self.width / 2;
        background: root.swatch;
        border-width: Stroke.line;
        border-color: Ink.white.with-alpha(0.165);
    }
    code-t := Text {
        x: Part.swatch-words;
        width: parent.width - Part.swatch-words;
        height: parent.height;
        text: root.code;
        font-family: Font.ui;
        font-size: Font.control;
        color: Ink.bright;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}

// A tab over a box, the same wherever one is (the Screen tab's pages, the Sensor
// Feed's parts): rounded above; the open one in the box's color (`fill`) and running
// on into it on its feet (none on the first's left, where the box's corner is
// square), the others the page's own until the pointer is on them; an amber dot
// after its name where something under it needs seeing to (`warn`).
export component FolderTab inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    in property <bool> first;
    in property <bool> warn;
    in property <brush> fill: Ink.box;
    callback clicked;
    width: words.preferred-width + 2 * Part.tab-pad + (root.warn ? Part.glyph-gap + Size.dot : 0);
    height: Size.tab;
    if root.open && !root.first: Rectangle {
        x: -Radius.panel;
        y: parent.height - Radius.panel;
        width: Radius.panel;
        height: Radius.panel;
        background: root.fill;
        Rectangle {
            background: Ink.base;
            border-bottom-right-radius: Radius.panel;
        }
    }
    if root.open: Rectangle {
        x: parent.width;
        y: parent.height - Radius.panel;
        width: Radius.panel;
        height: Radius.panel;
        background: root.fill;
        Rectangle {
            background: Ink.base;
            border-bottom-left-radius: Radius.panel;
        }
    }
    Rectangle {
        border-top-left-radius: Radius.panel;
        border-top-right-radius: Radius.panel;
        background: root.open ? root.fill : ta.has-hover ? Ink.box : transparent;
    }
    words := Text {
        x: Part.tab-pad;
        height: parent.height;
        text: root.text;
        font-family: Font.ui;
        font-size: Font.control;
        font-weight: Font.medium;
        color: root.open ? Ink.bright : ta.has-hover ? Ink.dim : Ink.soft;
        vertical-alignment: center;
    }
    if root.warn: Rectangle {
        x: words.x + words.width + Part.glyph-gap;
        y: (parent.height - self.height) / 2;
        width: Size.dot;
        height: Size.dot;
        border-radius: self.width / 2;
        background: Ink.warn;
    }
    // (the open tab is already chosen: only the others answer the pointer)
    ta := TouchArea {
        enabled: !root.open;
        mouse-cursor: root.open ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// a button on the device's bar: its glyph, drawn in lines, and its name if it has one
export component BarButton inherits Rectangle {
    in property <string> text;
    in property <string> commands;
    // the lines' ends and corners rounded
    in property <bool> round;
    callback clicked;
    // a whole number of pixels wide, so its glyph's lines land on the pixel grid
    width: ceil(row.preferred-width / 1px) * 1px;
    Rectangle {
        x: 0;
        y: (parent.height - Size.button) / 2;
        width: parent.width;
        height: Size.button;
        border-radius: Radius.control;
        background: ta.has-hover ? Ink.shade2 : Ink.shade1;
        // (with no name, a square round its glyph)
        row := HorizontalLayout {
            padding-left: root.text == "" ? Space.inline : Part.button-pad;
            padding-right: root.text == "" ? Space.inline : Part.button-pad;
            spacing: Part.glyph-gap;
            alignment: start;
            Path {
                width: Part.glyph;
                height: Part.glyph;
                y: (Size.button - self.height) / 2;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: root.commands;
                fill: transparent;
                stroke: Ink.ink;
                stroke-width: 1.14px; // art: the glyph's stroke
                stroke-line-cap: root.round ? LineCap.round : LineCap.butt;
            }
            if root.text != "": Text {
                text: root.text;
                font-family: Font.ui;
                font-size: Font.control;
                font-weight: Font.medium;
                color: Ink.ink;
                vertical-alignment: center;
            }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// The app's own glyphs, each drawn once here: the pencil that renames a thing, on
// 24 units; the three dots of a thing's less common actions, on 14 units; a find
// box's lens; a row's way on to a page of its own.
export global Glyph {
    out property <string> pencil: "M4 20h4L19 9l-4-4L4 16z";
    out property <string> more: "M1.7 7a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0zM5.7 7a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0zM9.7 7a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0z";
    // a find box's lens, on 16 units
    out property <string> find: "M11.6 7a4.6 4.6 0 1 1-9.2 0 4.6 4.6 0 0 1 9.2 0ZM10.4 10.4 14 14";
    // a row that opens a page of its own: a chevron pointing on, on 12 units
    out property <string> onward: "M4.5 2.5l3.5 3.5-3.5 3.5";
}

// A small square button with a glyph and no words, a shade under the pointer;
// it says where it is when pressed, for the menu it opens
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <float> units: 14;
    // its glyph's shapes filled (the dots), else drawn as lines (the pencil)
    in property <bool> filled;
    in property <bool> enabled: true;
    // the shade under the pointer: a box's, or on a chosen row its own lighter one
    in property <brush> hover-fill: Ink.hover-box;
    callback clicked(length, length, length);
    property <bool> hot: ta.has-hover && root.enabled;
    out property <bool> hover: root.hot;
    width: Size.quiet;
    height: Size.quiet;
    border-radius: Radius.small;
    background: root.hot ? root.hover-fill : transparent;
    opacity: root.enabled ? 1 : 0.35;
    Path {
        width: Part.glyph;
        height: Part.glyph;
        viewbox-width: root.units;
        viewbox-height: root.units;
        commands: root.icon;
        fill: root.filled ? (root.hot ? Ink.bright : Ink.quiet) : transparent;
        stroke: root.filled ? transparent : root.hot ? Ink.bright : Ink.quiet;
        stroke-width: 1.8px * 14 / root.units; // art: the glyph's stroke, as wide as its size keeps it
        stroke-line-join: round;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y, self.height); }
    }
}

// the button that opens a thing's less common actions (Rename, Duplicate, Delete)
export component MoreButton inherits IconButton {
    icon: Glyph.more;
    filled: true;
}

// the button that renames a thing in place
export component PencilButton inherits IconButton {
    icon: Glyph.pencil;
    units: 24;
}

// A name changed in place, the same wherever one is (a profile's in its list, a
// playlist's at its panel's head, an open macro's or layout's in its editor's bar): a
// field on a box's shade, outlined, all of it chosen as it shows. Enter, the tick at
// its end (`tick`) or, with `keep-on-leave`, leaving it keeps the name (`done(true,
// …)`); Escape lets it go (`done(false, …)`). `big`: in a bar's type, as the name it
// changes is set.
export component RenameField inherits Rectangle {
    in-out property <string> text;
    in property <bool> big;
    in property <bool> tick: true;
    in property <bool> keep-on-leave;
    callback done(bool, string);
    height: Size.control;
    border-radius: Radius.control;
    background: Ink.box;
    border-width: Stroke.line;
    border-color: Ink.edge-hover;
    property <length> tick-w: root.tick ? self.height - 2 * Part.inset : 0;
    // (a press on the field, off its words and the tick, stays in it)
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { field-in.focus(); }
    }
    field-in := TextInput {
        x: Part.field-pad;
        width: parent.width - 2 * Part.field-pad - root.tick-w;
        height: parent.height;
        text <=> root.text;
        font-family: Font.ui;
        font-size: root.big ? Font.title : Font.control;
        font-weight: root.big ? Font.strong : Font.medium;
        color: Ink.bright;
        vertical-alignment: center;
        single-line: true;
        init => {
            self.focus();
            self.select-all();
        }
        changed has-focus => {
            Typing.on = self.has-focus;
            if (!self.has-focus && root.keep-on-leave) {
                root.done(true, self.text);
            }
        }
        accepted => { root.done(true, self.text); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.done(false, self.text);
                return accept;
            }
            reject
        }
    }
    // a tick at its end, which keeps the name as Enter does
    if root.tick: IconButton {
        x: parent.width - Part.inset - self.width;
        y: Part.inset;
        width: root.tick-w;
        height: root.tick-w;
        icon: "M5 12.5l4.5 4.5L19 7.5";
        units: 24;
        clicked => { root.done(true, field-in.text); }
    }
}
